{# Left panel: add text / add image / layers list / highlight toggle. All actions
   target controllers present on both the single-variant and the group editor page. #}
{# Sticky only below lg — in the app-shell layout the surrounding column is the
   scroll container, where a sticky card would offset itself as you scroll it. #}
<div class="card editor-left-panel-card">
    <div class="card-body">
        {% if fonts|length == 0 %}
            <p class="text-danger">
                <i class="text-danger uil-exclamation-triangle me-1"></i> Nejsou nahrány fonty
            </p>
        {% else %}
            <button class="btn btn-sm btn-outline-secondary w-100 mb-1 text-start" type="button" data-action="canvas-editor#showAddTextModal"><i class="uil-text-fields me-1"></i> Přidat text</button>
            <button class="btn btn-sm btn-outline-secondary w-100 mb-1 text-start" type="button" data-action="canvas-editor#showAddChecklistModal"><i class="mdi mdi-format-list-checks me-1"></i> Přidat zaškrtávací seznam</button>
        {% endif %}

        <button class="btn btn-sm btn-outline-secondary w-100 mb-2 text-start" type="button" data-action="canvas-editor#showAddImageModal"><i class="uil-image me-1"></i> Přidat obrázek</button>

        {# The highlight / snapping / rulers toggles live in the TOP bar next
           to the zoom controls — editor/_editor_toggles.html.twig. #}

        <hr class="my-2">

        {# Photoshop-style layers list (canvas_layers_controller): topmost first,
           hover highlights the object on the stage, click selects it and opens
           its property popover, arrows restack one step. Rows are built by JS
           from the live Fabric object list. #}
        <p class="small fw-bold text-muted text-uppercase mb-1"><i class="mdi mdi-layers-outline me-1"></i>Vrstvy</p>
        <div class="canvas-layers-list mb-1" data-canvas-layers-target="list" role="list" aria-label="Vrstvy plátna"></div>

        {# Containers panel (canvas_container_controller): the Vrstvy pattern
           for container zones — tree-ordered rows in the zones' depth colors,
           hover highlights the zone on the stage (everything else dims),
           click selects the container. Hidden while no containers exist. #}
        <div class="d-none" data-canvas-container-target="panel">
            <hr class="my-2">
            <p class="small fw-bold text-muted text-uppercase mb-1"><i class="mdi mdi-view-agenda-outline me-1"></i>Kontejnery</p>
            <div class="container-panel-list mb-1" data-canvas-container-target="panelList" role="list" aria-label="Kontejnery plátna"></div>
        </div>

        {% if group_mode|default(false) %}
            <hr class="my-2">
            <p class="text-muted small mb-0">
                <i class="uil-layer-group me-1"></i>Úpravy se přenáší do všech zahrnutých variant — posuny a velikosti poměrově, texty a vlastnosti přesně.
            </p>
        {% endif %}
    </div>
</div>
