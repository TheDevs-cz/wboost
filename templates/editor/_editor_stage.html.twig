{# The canvas stage: unscaled overlay layer (floating chrome anchors here),
   zoom-scaled canvas wrapper, floating mini-toolbar / multi-select bar /
   text + image popovers. Expects: canvas_width, canvas_height (px; the TRIM),
   optional canvas_bleed (px per side — the element is the bleed box, see
   canvas_viewport.js),
   gallery_directories (a GalleryFolderTree), and optional group_mode (adds the per-element
   "Přenést do ostatních variant" re-sync button targeting group-editor). #}
{# The viewport is the SCROLL CONTAINER for the stage: panning a zoomed-in
   canvas scrolls here, never the page — the left panel and the sticky toolbar
   must stay put. Max-height (the visible band below the sticky header) is
   maintained by canvas_zoom_controller. #}
<div class="canvas-viewport" data-canvas-zoom-target="viewport">
<div class="canvas-stage" data-canvas-floating-toolbar-target="layer" data-canvas-container-target="layer" data-canvas-layers-target="stage" data-canvas-snapping-target="layer" data-canvas-rulers-target="layer" data-canvas-user-move-target="layer">
    <div class="canvas-wrapper" data-canvas-zoom-target="canvasContainer">
        <canvas id="c" width="{{ canvas_width + 2 * canvas_bleed|default(0) }}" height="{{ canvas_height + 2 * canvas_bleed|default(0) }}"></canvas>
    </div>

    {# Photoshop-style rulers (canvas_rulers_controller): px-scale bars along
       the canvas top/left; drag out of a bar to place a guide, drag a guide
       off-canvas to remove it. Positioned + drawn entirely by the controller. #}
    <canvas class="canvas-ruler canvas-ruler--h d-none" data-canvas-rulers-target="hBar" data-action="mousedown->canvas-rulers#startCreateH" aria-hidden="true"></canvas>
    <canvas class="canvas-ruler canvas-ruler--v d-none" data-canvas-rulers-target="vBar" data-action="mousedown->canvas-rulers#startCreateV" aria-hidden="true"></canvas>
    <div class="canvas-ruler-corner d-none" data-canvas-rulers-target="corner" aria-hidden="true"></div>

    {# Floating per-element mini-toolbar (single selection). Quick
       actions reuse the existing clipboard / alignment / property
       controllers via data-action; the pencil opens the full
       options popover below. #}
    <div class="canvas-mini-toolbar d-none" role="toolbar" data-canvas-floating-toolbar-target="miniToolbar">
        <button type="button" class="btn btn-sm btn-light" title="Upravit" data-action="canvas-floating-toolbar#openPopover"><i class="i i-edit s16"></i></button>
        <button type="button" class="btn btn-sm btn-light d-none" title="Nahradit obrázek z galerie" data-canvas-floating-toolbar-target="replaceImageButton" data-action="canvas-editor#showReplaceImageModal"><i class="i i-image-search s16"></i></button>
        <button type="button" class="btn btn-sm btn-light" title="Duplikovat" data-action="canvas-clipboard#duplicate"><i class="i i-copy s16"></i></button>
        <button type="button" class="btn btn-sm btn-light d-none" title="Uzamknout text" data-canvas-floating-toolbar-target="lockButton" data-action="canvas-input-properties#toggleLocked canvas-floating-toolbar#refreshContextToggle"><i class="i i-unlock s16"></i></button>
        <button type="button" class="btn btn-sm btn-light d-none" title="Označit jako placeholder" data-canvas-floating-toolbar-target="placeholderButton" data-action="canvas-image-properties#togglePlaceholder canvas-floating-toolbar#refreshContextToggle"><i class="i i-image-edit s16"></i></button>
        <button type="button" class="btn btn-sm btn-light d-none" title="Uzamknout obrázek v editoru (proti posunutí)" data-canvas-floating-toolbar-target="editorLockButton" data-action="canvas-image-properties#toggleEditorLock canvas-floating-toolbar#refreshContextToggle"><i class="i i-unlock s16"></i></button>
        {# Horizontal mirror (Fabric flipX) — decorative images only: a fill
           re-places a placeholder's picture and resets its flip server-side
           (ImagePlacement), so the toolbar hides it there. #}
        <button type="button" class="btn btn-sm btn-light d-none" title="Zrcadlit vodorovně" data-canvas-floating-toolbar-target="mirrorButton" data-action="canvas-image-properties#toggleMirror canvas-floating-toolbar#refreshContextToggle"><i class="i i-flip s16"></i></button>
        {# Shapes carry the same EDITOR lock as images, but the action has to
           reach canvas-shape-properties so its popover checkbox follows. #}
        <button type="button" class="btn btn-sm btn-light d-none" title="Uzamknout tvar v editoru (proti posunutí)" data-canvas-floating-toolbar-target="shapeLockButton" data-action="canvas-shape-properties#toggleEditorLock canvas-floating-toolbar#refreshContextToggle"><i class="i i-unlock s16"></i></button>
        {% if group_mode|default(false) %}
            <button type="button" class="btn btn-sm btn-light" title="Přenést do ostatních variant — poloha, velikost, styl a text tohoto prvku přepíšou jejich úpravy" data-action="group-editor#resyncActiveObject"><i class="i i-refresh s16"></i></button>
        {% endif %}
        <span class="canvas-mini-toolbar-sep"></span>
        <button type="button" class="btn btn-sm btn-light" title="Do popředí" data-action="canvas-alignment#bringToFront"><i class="i i-front s16"></i></button>
        <button type="button" class="btn btn-sm btn-light" title="Do pozadí" data-action="canvas-alignment#sendToBack"><i class="i i-back s16"></i></button>
        <span class="canvas-mini-toolbar-sep"></span>
        <button type="button" class="btn btn-sm btn-light text-danger" title="Smazat" data-action="canvas-alignment#deleteObject"><i class="i i-trash s16"></i></button>
    </div>

    {# Floating multi-select bar (activeSelection): 6-way align +
       z-order + delete. #}
    <div class="canvas-mini-toolbar d-none" role="toolbar" data-canvas-floating-toolbar-target="multiBar">
        <button type="button" class="btn btn-sm btn-light" title="Zarovnat vlevo" data-action="canvas-alignment#alignLeft"><i class="i i-alh-l s16"></i></button>
        <button type="button" class="btn btn-sm btn-light" title="Zarovnat na střed" data-action="canvas-alignment#alignCenter"><i class="i i-alh-c s16"></i></button>
        <button type="button" class="btn btn-sm btn-light" title="Zarovnat vpravo" data-action="canvas-alignment#alignRight"><i class="i i-alh-r s16"></i></button>
        <span class="canvas-mini-toolbar-sep"></span>
        <button type="button" class="btn btn-sm btn-light" title="Zarovnat nahoru" data-action="canvas-alignment#alignTop"><i class="i i-alv-t s16"></i></button>
        <button type="button" class="btn btn-sm btn-light" title="Zarovnat na střed svisle" data-action="canvas-alignment#alignMiddle"><i class="i i-alv-m s16"></i></button>
        <button type="button" class="btn btn-sm btn-light" title="Zarovnat dolů" data-action="canvas-alignment#alignBottom"><i class="i i-alv-b s16"></i></button>
        <span class="canvas-mini-toolbar-sep"></span>
        <button type="button" class="btn btn-sm btn-light" title="Vytvořit kontejner" data-canvas-container-target="createButton" data-action="canvas-container#createFromSelection"><i class="i i-view-agenda s16"></i></button>
        {# Container-rows P6: hand-numbered copies of a row → ONE repeatable
           row that keeps the old rows' ids (saved exports stay valid). #}
        <button type="button" class="btn btn-sm btn-light is-unavailable" aria-disabled="true" title="Sloučit do opakovaného řádku" aria-label="Sloučit do opakovaného řádku" data-canvas-container-target="mergeButton" data-action="canvas-container#mergeSelectionIntoRow"><i class="i i-list s16"></i></button>
        <span class="canvas-mini-toolbar-sep"></span>
        {# One opacity for every selected element (the background excluded). #}
        <label class="canvas-mini-toolbar-opacity" data-canvas-opacity-target="row" title="Průhlednost vybraných prvků">
            <span class="visually-hidden">Průhlednost</span>
            <input type="range" class="form-range" min="0" max="100" step="1" aria-label="Průhlednost vybraných prvků" data-canvas-opacity-target="slider" data-action="input->canvas-opacity#update change->canvas-opacity#update">
            <span class="canvas-mini-toolbar-opacity__value" data-canvas-opacity-target="value">100 %</span>
        </label>
        <span class="canvas-mini-toolbar-sep" data-canvas-opacity-target="row"></span>
        <button type="button" class="btn btn-sm btn-light" title="Do popředí" data-action="canvas-alignment#bringToFront"><i class="i i-front s16"></i></button>
        <button type="button" class="btn btn-sm btn-light" title="Do pozadí" data-action="canvas-alignment#sendToBack"><i class="i i-back s16"></i></button>
        <button type="button" class="btn btn-sm btn-light text-danger" title="Smazat" data-action="canvas-alignment#deleteObject"><i class="i i-trash s16"></i></button>
    </div>

    {# Floating full-options popover: TEXT — fields driven by
       canvas-text-toolbar + canvas-input-properties (visibility
       owned by canvas-floating-toolbar). #}
    <div class="canvas-floating-popover ed-insp card d-none" data-canvas-floating-toolbar-target="textPopover">
        <div class="card-body p-2">
            <div class="ed-ph">
                <i class="i i-grip s14 canvas-popover-drag" data-popover-drag-handle role="button" aria-label="Přesunout okno" title="Přesunout okno"></i>
                <span class="ed-ph-i"><i class="i i-type s16" aria-hidden="true"></i></span>
                <span class="ed-ph-t">Text</span>
                <button type="button" class="btn btn-success btn-sm ed-ph-ok" data-action="canvas-floating-toolbar#closePopovers">{{ icon('check', 's14') }}Uložit</button>
                <button type="button" class="btn btn-ghost icon xs ed-ph-x" aria-label="Zavřít" title="Zavřít" data-action="canvas-floating-toolbar#closePopovers">{{ icon('x', 's14') }}</button>
            </div>

            {# "Vyplňuje klient" = the inverse of the input's `locked` flag
               (a locked text is never user-fillable). A proxy switch:
               canvas-input-properties keeps it and the "Uzamčeno" checkbox
               below (kept in the DOM, hidden) in step. #}
            <label class="ed-input" for="client-fills-control">
                <span class="form-check form-switch mb-0"><input type="checkbox" role="switch" id="client-fills-control" class="form-check-input" data-canvas-input-properties-target="clientFills" data-action="change->canvas-input-properties#updateClientFills change->canvas-floating-toolbar#refreshContextToggle"></span>
                <span><b>Vyplňuje klient</b><span class="cap">Klient tento text při exportu přepíše.</span></span>
            </label>

            <div class="row g-2">
                <div class="col-12"><h3 class="ed-sec-h">Text</h3></div>
                <!-- Font Family Control -->
                <div class="col-12">
                    <label for="font-family-control" class="form-label small mb-1">Písmo</label>
                    <select id="font-family-control" class="form-select form-select-sm" data-canvas-text-toolbar-target="fontFamily" data-action="change->canvas-text-toolbar#updateFontFamily change->canvas-input-properties#refreshFontChoice">
                        <!-- Options will be populated dynamically by Stimulus -->
                    </select>
                </div>

                {# Font choice ("Uživatel může přepínat písmo"): the designed
                   font is always offered (locked-checked), the checklist adds
                   faces the END USER may switch to on the fill page — the
                   WYSIWYG's face menu for rich inputs, a font select for
                   plain ones. Built by canvas-input-properties from the
                   project's faces (canvas_font_choice.js). #}
                <div class="col-12" data-font-choice-wrapper>
                    <div class="form-check mb-0">
                        <input type="checkbox" id="font-choice-control" class="form-check-input" data-canvas-input-properties-target="fontChoice" data-action="change->canvas-input-properties#toggleFontChoice">
                        <label for="font-choice-control" class="form-check-label small">Uživatel může přepínat písmo <i class="i i-info s12 ed-tip" data-canvas-input-properties-target="fontChoiceHint" title="Při vyplňování se u pole zobrazí výběr písma: použité písmo + zaškrtnutá."></i></label>
                    </div>
                    <div class="font-choice d-none mt-1" data-canvas-input-properties-target="fontChoiceList" aria-label="Písma k výběru"></div>
                    <button type="button" class="btn btn-link btn-sm p-0 mt-1 d-none" title="Zaškrtne řezy, které manuál značky povoluje" data-canvas-input-properties-target="manualPreset" data-action="canvas-input-properties#applyManualPreset"><i class="i i-book s14 me-1"></i>Použít řezy z manuálu</button>
                    <div class="form-text small d-none" data-canvas-input-properties-target="fontChoiceEmpty">Zaškrtněte alespoň jedno další písmo — jinak uživatel nemá z čeho vybírat.</div>
                </div>

                {# Colour allowlist for RICH inputs: what the WYSIWYG's swatch
                   row offers — any colour (brand swatches + free picker),
                   only the ticked swatches, or no colour change at all. #}
                <div class="col-12 d-none" data-canvas-input-properties-target="colorChoiceWrapper">
                    <label for="color-choice-mode-control" class="form-label small mb-1">Barvy pro uživatele <i class="i i-info s12 ed-tip" title="Které barvy může uživatel v editoru textu použít. Výchozí barva (barva na plátně) je k dispozici vždy."></i></label>
                    <select id="color-choice-mode-control" class="form-select form-select-sm" data-canvas-input-properties-target="colorChoiceMode" data-action="change->canvas-input-properties#updateColorChoiceMode">
                        <option value="any">Libovolná barva (vzorník + vlastní)</option>
                        <option value="list">Jen vybrané barvy</option>
                        <option value="none">Barvu nelze měnit</option>
                    </select>
                    <div class="d-none mt-1" data-canvas-input-properties-target="colorChoiceList">
                        <div class="d-flex align-items-center flex-wrap gap-1" role="group" aria-label="Povolené barvy" data-canvas-input-properties-target="colorChoiceSwatches"></div>
                        <div class="input-group input-group-sm mt-1" style="max-width: 12rem;">
                            <input type="text" class="form-control" placeholder="#rrggbb" aria-label="Přidat vlastní barvu" data-canvas-input-properties-target="colorChoiceCustom" data-action="keydown->canvas-input-properties#customColorKeydown">
                            <button type="button" class="btn btn-outline-secondary" title="Přidat barvu do výběru" data-action="canvas-input-properties#addCustomColor"><i class="i i-plus s14"></i></button>
                        </div>
                        <div class="form-text small d-none" data-canvas-input-properties-target="colorChoiceEmpty">Zaškrtněte alespoň jednu barvu — jinak uživatel nemůže barvu měnit vůbec.</div>
                    </div>
                </div>

                <!-- Font Size Control -->
                <div class="col-6">
                    <label for="font-size-control" class="form-label small mb-1">Velikost</label>
                    <input type="number" id="font-size-control" class="form-control form-control-sm" data-canvas-text-toolbar-target="fontSize" data-action="input->canvas-text-toolbar#updateFontSize">
                </div>

                <!-- Line Height Control -->
                <div class="col-6">
                    <label for="line-height-control" class="form-label small mb-1">Řádkování</label>
                    <input type="number" id="line-height-control" class="form-control form-control-sm" step="0.1" min="0.5" data-canvas-text-toolbar-target="lineHeight" data-action="input->canvas-text-toolbar#updateLineHeight">
                </div>

                <!-- Font Color Control: brand-manual swatches (suggestions, same
                     source as the WYSIWYG palette) + free picker + hex input. -->
                <div class="col-12">
                    <label for="font-color-control" class="form-label small mb-1">Barva</label>
                    {% if brand_colors is defined and brand_colors is not empty %}
                        <div class="d-flex align-items-center flex-wrap gap-1 mb-1" role="group" aria-label="Barvy z manuálu">
                            {% for color in brand_colors %}
                                <button
                                    type="button"
                                    class="fill-richtext-swatch"
                                    style="background-color: {{ color }}"
                                    title="{{ color }}"
                                    data-canvas-text-toolbar-target="swatch"
                                    data-canvas-text-toolbar-color-param="{{ color }}"
                                    data-action="canvas-text-toolbar#pickColor"
                                ></button>
                            {% endfor %}
                            <label class="fill-richtext-swatch fill-richtext-swatch--custom mb-0" title="Vlastní barva">
                                <input type="button" class="fill-richtext-swatch__input" aria-label="Vlastní barva" data-controller="color-picker" data-canvas-text-toolbar-target="colorPicker" data-action="input->canvas-text-toolbar#pickCustomColor change->canvas-text-toolbar#commitColor">
                            </label>
                        </div>
                    {% endif %}
                    <input type="text" id="font-color-control" class="form-control form-control-sm" placeholder="#000000" data-canvas-text-toolbar-target="fontColor" data-action="input->canvas-text-toolbar#updateFontColor">
                </div>

                <!-- Text Align Control -->
                <div class="col-6">
                    <label for="text-align-control" class="form-label small mb-1">Zarovnání</label>
                    <select id="text-align-control" class="form-select form-select-sm" data-canvas-text-toolbar-target="textAlign" data-action="change->canvas-text-toolbar#updateTextAlign">
                        <option value="left">Vlevo</option>
                        <option value="center">Na střed</option>
                        <option value="right">Vpravo</option>
                        <option value="justify">Do bloku</option>
                    </select>
                </div>

                <!-- Text Decoration Control -->
                <div class="col-6">
                    <label for="text-decoration-control" class="form-label small mb-1">Dekorace</label>
                    <select id="text-decoration-control" class="form-select form-select-sm" data-canvas-text-toolbar-target="textDecoration" data-action="change->canvas-text-toolbar#updateTextDecoration">
                        <option value="none">Žádná</option>
                        <option value="underline">Podtržení</option>
                        <option value="line-through">Přeškrtnutí</option>
                        <option value="overline">Nadtržení</option>
                    </select>
                </div>

                {# Admin-only design opacity (canvas-opacity, Fabric's native
                   `opacity`) — the fill page keeps it, nobody can override it. #}
                <div class="col-12" data-canvas-opacity-target="row">
                    <label for="text-opacity-control" class="form-label small mb-1">
                        Průhlednost <span class="text-muted" data-canvas-opacity-target="value">100 %</span>
                    </label>
                    <input type="range" id="text-opacity-control" class="form-range" min="0" max="100" step="1" data-canvas-opacity-target="slider" data-action="input->canvas-opacity#update change->canvas-opacity#update">
                </div>

                <div class="col-12"><h3 class="ed-sec-h">Vyplňování</h3></div>

                <!-- Max Length Control -->
                <div class="col-6">
                    <label for="max-length-control" class="form-label small mb-1">Max. délka</label>
                    <input type="number" id="max-length-control" class="form-control form-control-sm" data-canvas-text-toolbar-target="maxLength" data-action="input->canvas-text-toolbar#updateMaxLength change->canvas-text-toolbar#updateMaxLength">
                    <div class="form-text small mt-1 d-none" data-canvas-text-toolbar-target="maxLengthHint"></div>
                </div>

                <!-- Name Control -->
                <div class="col-12">
                    <label for="name-control" class="form-label small mb-1">Název pole <i class="i i-info s12 ed-tip" title="Označení pole pro uživatele při vyplňování. Text na plátně upravíte dvojklikem přímo na něj — dokud ho nezměníte, kopíruje název."></i></label>
                    <input type="text" id="name-control" class="form-control form-control-sm" placeholder="např. Nadpis, Datum…" data-canvas-input-properties-target="name" data-action="input->canvas-input-properties#updateName">
                </div>

                <!-- Description Control -->
                <div class="col-12">
                    <label for="description-control" class="form-label small mb-1">Nápověda</label>
                    <input type="text" id="description-control" class="form-control form-control-sm" data-canvas-input-properties-target="description" data-action="input->canvas-input-properties#updateDescription">
                </div>

                <!-- Flags: locked / hidable / uppercase -->
                <div class="col-12 d-flex flex-wrap column-gap-3">
                    <div class="form-check mb-0 d-none">
                        <input type="checkbox" id="locked-control" class="form-check-input" data-canvas-input-properties-target="locked" data-action="change->canvas-input-properties#updateLocked">
                        <label for="locked-control" class="form-check-label small">Uzamčeno</label>
                    </div>
                    <div class="form-check mb-0">
                        <input type="checkbox" id="hidable-control" class="form-check-input" data-canvas-input-properties-target="hidable" data-action="change->canvas-input-properties#updateHidable">
                        <label for="hidable-control" class="form-check-label small">Schovatelnost</label>
                    </div>
                    <div class="form-check mb-0">
                        <input type="checkbox" id="uppercase-control" class="form-check-input" data-canvas-input-properties-target="uppercase" data-action="change->canvas-input-properties#updateUppercase">
                        <label for="uppercase-control" class="form-check-label small">Verzálky</label>
                    </div>
                </div>

                <!-- Rich Text (WYSIWYG) Control -->
                <div class="col-12" data-richtext-wrapper>
                    <div class="form-check mb-0">
                        <input type="checkbox" id="rich-text-control" class="form-check-input" data-canvas-input-properties-target="richText" data-action="change->canvas-input-properties#updateRichText">
                        <label for="rich-text-control" class="form-check-label small">Formátovatelný text <i class="i i-info s12 ed-tip" title="Uživatel může měnit písmo, barvu a podtržení částí textu."></i></label>
                    </div>
                </div>

                {# Checklist COMPONENT capabilities — shown only for inputs
                   created via "Přidat zaškrtávací seznam" (checklist: true).
                   The rich/lists enable-toggles are hidden for them (forced
                   on); spacing + checkbox art below still apply. #}
                <div class="col-12 d-none" data-canvas-input-properties-target="checklistSection">
                    <h3 class="ed-sec-h">Zaškrtávací seznam — uživatel může</h3>
                    <div class="form-check mb-0 mt-1">
                        <input type="checkbox" id="checklist-toggle-control" class="form-check-input" data-canvas-input-properties-target="checklistToggle" data-action="change->canvas-input-properties#updateChecklistFlag" data-canvas-input-properties-prop-param="checklistToggle">
                        <label for="checklist-toggle-control" class="form-check-label small">Zaškrtávat / odškrtávat položky</label>
                    </div>
                    <div class="form-check mb-0">
                        <input type="checkbox" id="checklist-edit-text-control" class="form-check-input" data-canvas-input-properties-target="checklistEditText" data-action="change->canvas-input-properties#updateChecklistFlag" data-canvas-input-properties-prop-param="checklistEditText">
                        <label for="checklist-edit-text-control" class="form-check-label small">Upravovat text položek</label>
                    </div>
                    <div class="form-check mb-0">
                        <input type="checkbox" id="checklist-add-control" class="form-check-input" data-canvas-input-properties-target="checklistAdd" data-action="change->canvas-input-properties#updateChecklistFlag" data-canvas-input-properties-prop-param="checklistAdd">
                        <label for="checklist-add-control" class="form-check-label small">Přidávat nové položky</label>
                    </div>
                    <div class="form-check mb-0">
                        <input type="checkbox" id="checklist-remove-control" class="form-check-input" data-canvas-input-properties-target="checklistRemove" data-action="change->canvas-input-properties#updateChecklistFlag" data-canvas-input-properties-prop-param="checklistRemove">
                        <label for="checklist-remove-control" class="form-check-label small">Odebírat položky</label>
                    </div>
                </div>

                {# Lists ("odrážky a číslování") — only meaningful for rich
                   inputs; the config block shows once enabled. Blank spacing
                   fields = derived defaults from the font size
                   (ResolvedListStyle). #}
                <div class="col-12" data-lists-wrapper>
                    <div class="form-check mb-0">
                        <input type="checkbox" id="lists-control" class="form-check-input" data-canvas-input-properties-target="lists" data-action="change->canvas-input-properties#updateLists">
                        <label for="lists-control" class="form-check-label small">Povolit seznamy <i class="i i-info s12 ed-tip" title="Uživatel může vkládat odrážkové a číslované seznamy (tlačítka v editoru textu)."></i></label>
                    </div>
                </div>
                <div class="col-12 d-none" data-canvas-input-properties-target="listConfig">
                    <div class="row g-1">
                        <div class="col-12">
                            <label for="list-bullet-control" class="form-label small mb-1">Styl odrážky</label>
                            <div class="d-flex align-items-center gap-1">
                                <select id="list-bullet-control" class="form-select form-select-sm" data-canvas-input-properties-target="listBullet" data-action="change->canvas-input-properties#updateListBullet">
                                    <option value="disc">• Puntík</option>
                                    <option value="dash">– Pomlčka</option>
                                    <option value="check">✓ Fajfka</option>
                                    <option value="image">Vlastní obrázek</option>
                                </select>
                                <button type="button" class="btn btn-sm btn-outline-secondary d-none flex-shrink-0" title="Vybrat obrázek odrážky z galerie" data-canvas-input-properties-target="listBulletPick" data-action="canvas-input-properties#pickBulletImage"><i class="i i-image-search s14"></i></button>
                                <i class="i i-check-circle s14 ed-ok d-none flex-shrink-0" title="" data-canvas-input-properties-target="listBulletPreview"></i>
                            </div>
                        </div>
                        <div class="col-4">
                            <label for="list-indent-control" class="form-label small mb-1">Odsazení <i class="i i-info s12 ed-tip" title="Odsazení textu položky od levého okraje (px). Prázdné = automaticky dle velikosti písma."></i></label>
                            <input type="number" min="0" step="1" id="list-indent-control" class="form-control form-control-sm" placeholder="auto" data-canvas-input-properties-target="listIndent" data-action="change->canvas-input-properties#updateListSpacing" data-canvas-input-properties-prop-param="listIndent">
                        </div>
                        <div class="col-4">
                            <label for="list-item-spacing-control" class="form-label small mb-1">Mezi položkami <i class="i i-info s12 ed-tip" title="Mezera mezi položkami seznamu (px). Prázdné = 0."></i></label>
                            <input type="number" min="0" step="1" id="list-item-spacing-control" class="form-control form-control-sm" placeholder="auto" data-canvas-input-properties-target="listItemSpacing" data-action="change->canvas-input-properties#updateListSpacing" data-canvas-input-properties-prop-param="listItemSpacing">
                        </div>
                        <div class="col-4">
                            <label for="list-block-spacing-control" class="form-label small mb-1">Mezi bloky <i class="i i-info s12 ed-tip" title="Mezera mezi odstavcem a seznamem (px). Prázdné = automaticky dle velikosti písma."></i></label>
                            <input type="number" min="0" step="1" id="list-block-spacing-control" class="form-control form-control-sm" placeholder="auto" data-canvas-input-properties-target="listBlockSpacing" data-action="change->canvas-input-properties#updateListSpacing" data-canvas-input-properties-prop-param="listBlockSpacing">
                        </div>
                        {# Checkbox lists: user-checkable items ('cb'/'cbx'
                           lines). Without custom images the render draws a
                           rounded square in the item's text color — the
                           checked one with a white check mark. #}
                        <div class="col-12" data-checkboxes-wrapper>
                            <div class="form-check mb-0">
                                <input type="checkbox" id="list-checkboxes-control" class="form-check-input" data-canvas-input-properties-target="listCheckboxes" data-action="change->canvas-input-properties#updateListCheckboxes">
                                <label for="list-checkboxes-control" class="form-check-label small">Povolit zaškrtávací seznam <i class="i i-info s12 ed-tip" title="Uživatel může vkládat seznam se zaškrtávacími políčky a jednotlivé položky zaškrtávat/odškrtávat."></i></label>
                            </div>
                        </div>
                        <div class="col-12 d-none" data-canvas-input-properties-target="checkboxConfig">
                            <label class="form-label small mb-1">Vzhled políček <i class="i i-info s12 ed-tip" title="Bez vlastního obrázku se vykreslí čtvereček v barvě textu; zaškrtnutý s bílou fajfkou."></i></label>
                            <div class="d-flex align-items-center gap-1 mb-1">
                                <span class="small text-muted flex-shrink-0" style="width: 6.5rem;">Nezaškrtnuté</span>
                                <button type="button" class="btn btn-sm btn-outline-secondary flex-shrink-0" title="Vybrat obrázek z galerie" data-action="canvas-input-properties#pickCheckboxImage" data-canvas-input-properties-state-param="unchecked"><i class="i i-image-search s14"></i></button>
                                <i class="i i-check-circle s14 ed-ok d-none flex-shrink-0" title="" data-canvas-input-properties-target="checkboxImagePreview"></i>
                                <button type="button" class="btn btn-sm btn-outline-secondary d-none flex-shrink-0" title="Vrátit výchozí vzhled" data-canvas-input-properties-target="checkboxImageClear" data-action="canvas-input-properties#clearCheckboxImage" data-canvas-input-properties-state-param="unchecked"><i class="i i-x s14"></i></button>
                            </div>
                            <div class="d-flex align-items-center gap-1">
                                <span class="small text-muted flex-shrink-0" style="width: 6.5rem;">Zaškrtnuté</span>
                                <button type="button" class="btn btn-sm btn-outline-secondary flex-shrink-0" title="Vybrat obrázek z galerie" data-action="canvas-input-properties#pickCheckboxImage" data-canvas-input-properties-state-param="checked"><i class="i i-image-search s14"></i></button>
                                <i class="i i-check-circle s14 ed-ok d-none flex-shrink-0" title="" data-canvas-input-properties-target="checkboxCheckedImagePreview"></i>
                                <button type="button" class="btn btn-sm btn-outline-secondary d-none flex-shrink-0" title="Vrátit výchozí vzhled" data-canvas-input-properties-target="checkboxCheckedImageClear" data-action="canvas-input-properties#clearCheckboxImage" data-canvas-input-properties-state-param="checked"><i class="i i-x s14"></i></button>
                            </div>
                        </div>
                    </div>
                </div>

                {# Vzorový text — the admin-authored default fill rendered
                   whenever the export receives no value for this input. For a
                   CHECKLIST component the very same button/modal is relabeled
                   "Položky seznamu" (its sample IS the item list). #}
                <div class="col-12">
                    <button type="button" class="btn btn-sm btn-outline-secondary w-100" data-action="canvas-input-properties#openSampleModal">
                        <i class="i i-text-box s14 me-1" data-canvas-input-properties-target="sampleIcon"></i><span data-canvas-input-properties-target="sampleLabel">Vzorový text</span>
                        <span class="badge bg-info-lighten text-info d-none" data-canvas-input-properties-target="sampleBadge">nastaven</span>
                    </button>
                </div>
            </div>

            {{ include('editor/_user_move_section.html.twig', {surface: 'text'}) }}

            {# Container membership — only the ELEMENT-specific action lives
               here; the container itself (max. výška, mezery, vnoření,
               zrušení) is configured in its zone's ⚙ popover on the canvas. #}
            <div class="d-none" data-canvas-container-target="section">
                <h3 class="ed-sec-h">Kontejner</h3>
                <p class="text-muted small my-2">Tento text je součástí kontejneru. Nastavení kontejneru (max. výška, mezery, vnoření) najdete pod ⚙ na jeho rámečku na plátně.</p>
                <button type="button" class="btn btn-sm btn-outline-secondary w-100" data-action="canvas-container#removeActiveFromContainer">Odebrat z kontejneru</button>
                {# Container-rows P3: the one way to author a SINGLE-text
                   repeatable row (a column of scorers) — "Vytvořit kontejner"
                   needs 2+ items. Hidden when the rules forbid a row here. #}
                <button type="button" class="btn btn-sm btn-outline-secondary w-100 mt-2 d-none" data-canvas-container-target="rowButton" data-action="canvas-container#makeActiveRow" title="Text se stane řádkem, který si uživatel při vyplňování může přidat vícekrát (např. střelci)">Opakovat jako řádek</button>
            </div>
            <div class="ed-acts">
                <button type="button" class="btn btn-tertiary btn-sm" data-action="canvas-clipboard#duplicate">{{ icon('copy', 's14') }}Duplikovat</button>
                <button type="button" class="btn btn-ghost-danger btn-sm" data-action="canvas-alignment#deleteObject">{{ icon('trash', 's14') }}Smazat</button>
            </div>
        </div>
    </div>

    {# Floating full-options popover: IMAGE — fields driven by
       canvas-image-properties (visibility owned by
       canvas-floating-toolbar). #}
    <div class="canvas-floating-popover ed-insp card d-none" data-canvas-floating-toolbar-target="imagePopover">
        <div class="card-body p-2">
            <div class="ed-ph">
                <i class="i i-grip s14 canvas-popover-drag" data-popover-drag-handle role="button" aria-label="Přesunout okno" title="Přesunout okno"></i>
                <span class="ed-ph-i"><i class="i i-image s16" aria-hidden="true"></i></span>
                <span class="ed-ph-t">Obrázek</span>
                <button type="button" class="btn btn-success btn-sm ed-ph-ok" data-action="canvas-floating-toolbar#closePopovers">{{ icon('check', 's14') }}Uložit</button>
                <button type="button" class="btn btn-ghost icon xs ed-ph-x" aria-label="Zavřít" title="Zavřít" data-action="canvas-floating-toolbar#closePopovers">{{ icon('x', 's14') }}</button>
            </div>

            {# Placeholder = "Vyplňuje klient": the user supplies the picture. #}
            <label class="ed-input" for="image-placeholder-control">
                <span class="form-check form-switch mb-0"><input type="checkbox" role="switch" id="image-placeholder-control" class="form-check-input" data-canvas-image-properties-target="placeholder" data-action="change->canvas-image-properties#updatePlaceholder"></span>
                <span><b>Vyplňuje klient</b><span class="cap">Placeholder — klient sem při exportu vloží vlastní obrázek.</span></span>
            </label>

            {# Name for EVERY image, placeholder or not: it labels the row in
               the "Vrstvy" panel (unnamed images fall back to a numbered
               "Obrázek N" there) and, once the image is a placeholder, doubles
               as the field tag the user sees while filling. #}
            <div class="mb-2">
                <label for="image-name-control" class="form-label small mb-1">Název <i class="i i-info s12 ed-tip" title="Zobrazí se v panelu Vrstvy. U placeholderu je to zároveň označení pole pro uživatele při vyplňování. Prázdný název = „Obrázek“ s pořadovým číslem."></i></label>
                <input type="text" id="image-name-control" class="form-control form-control-sm" placeholder="např. Fotka, Logo…" data-canvas-image-properties-target="name" data-action="input->canvas-image-properties#updateName">
            </div>

            {# "Velikost a poloha" — the editor twin of the fill page's image-adjust
               panel (_fill_image_adjust.html.twig): size slider (100 % =
               Přizpůsobit = contained in the canvas; logarithmic), exact
               Š / V / X / Y in the variant's unit with an aspect lock, rotation,
               Vyplnit. Writes the same native Fabric
               geometry the handles do — canvas-image-properties, math in
               canvas_geometry.js. Hidden for the background layer. Text fields
               (not type=number) so a Czech decimal comma is accepted; Enter
               commits and never submits the editor form. #}
            <div class="ed-geo d-none" data-canvas-image-properties-target="geometry">
                <h3 class="ed-sec-h">Velikost a poloha</h3>
                <div class="ed-geo__zoom">
                    <label class="sz-ctl ed-geo__slider" for="image-size-control" title="Velikost obrázku — 100 % = celý obrázek přizpůsobený plátnu">
                        {{ icon('image', 's12') }}
                        <span class="visually-hidden">Velikost obrázku</span>
                        <input type="range" id="image-size-control" min="0" max="1000" step="1" value="500"
                               data-canvas-image-properties-target="sizeSlider"
                               data-action="input->canvas-image-properties#slideSize change->canvas-image-properties#commitSize">
                        {{ icon('image', 's18') }}
                    </label>
                    <output class="ed-geo__value" for="image-size-control" data-canvas-image-properties-target="sizeValue">100 %</output>
                </div>
                <div class="ed-geo__grid">
                    {% for field in [
                        {key: 'width', label: 'Š', title: 'Šířka'},
                        {key: 'lock'},
                        {key: 'height', label: 'V', title: 'Výška'},
                        {key: 'x', label: 'X', title: 'Levý okraj od levého okraje plátna'},
                        {key: 'gap'},
                        {key: 'y', label: 'Y', title: 'Horní okraj od horního okraje plátna'},
                    ] %}
                        {% if field.key == 'lock' %}
                            <button type="button" class="btn btn-ghost icon xs ed-geo__lock active" aria-pressed="true"
                                    title="Poměr stran zamčený — klikněte pro volnou změnu" aria-label="Poměr stran zamčený — klikněte pro volnou změnu"
                                    data-canvas-image-properties-target="aspectLock" data-action="canvas-image-properties#toggleAspectLock">{{ icon('link', 's14') }}</button>
                        {% elseif field.key == 'gap' %}
                            <span aria-hidden="true"></span>
                        {% else %}
                            <label class="ed-geo__field" title="{{ field.title }}">
                                <span class="ed-geo__key" aria-hidden="true">{{ field.label }}</span>
                                <input type="text" class="form-control form-control-sm" inputmode="decimal" autocomplete="off"
                                       aria-label="{{ field.title }}" data-geo="{{ field.key }}"
                                       data-canvas-image-properties-target="geoField"
                                       data-action="change->canvas-image-properties#commitField keydown->canvas-image-properties#fieldKeydown">
                                <span class="ed-geo__unit" aria-hidden="true" data-canvas-image-properties-target="geoUnit">px</span>
                            </label>
                        {% endif %}
                    {% endfor %}
                    <label class="ed-geo__field" title="Otočení ve stupních (kolem středu)">
                        <span class="ed-geo__key" aria-hidden="true">{{ icon('refresh', 's12') }}</span>
                        <input type="text" class="form-control form-control-sm" inputmode="decimal" autocomplete="off"
                               aria-label="Otočení ve stupních" data-geo="angle"
                               data-canvas-image-properties-target="geoField"
                               data-action="change->canvas-image-properties#commitField keydown->canvas-image-properties#fieldKeydown">
                        <span class="ed-geo__unit" aria-hidden="true">°</span>
                    </label>
                </div>
                <div class="ed-geo__actions">
                    <button type="button" class="btn btn-tertiary xs" data-geo-action="cover" data-action="canvas-image-properties#fillCanvas"
                            title="Zvětšit tak, aby obrázek pokryl celé plátno (včetně spadávky), a vycentrovat">Vyplnit</button>
                </div>
                <p class="cap ed-geo__hint d-none" data-canvas-image-properties-target="geoHint"></p>
            </div>

            <div class="mb-2 form-check">
                <input type="checkbox" id="image-editor-locked-control" class="form-check-input" data-canvas-image-properties-target="editorLocked" data-action="change->canvas-image-properties#updateEditorLock">
                <label for="image-editor-locked-control" class="form-check-label small">Zamknout v editoru <span class="text-muted">(chrání před náhodným posunutím — kliknutí prochází skrz, prvek pak vyberete v panelu Vrstvy; neovlivní export)</span></label>
            </div>

            {# Design opacity — decorative images AND placeholders (the user's
               picture keeps it); hidden for the background layer. #}
            <div class="mb-2" data-canvas-opacity-target="row">
                <label for="image-opacity-control" class="form-label small mb-1">
                    Průhlednost <span class="text-muted" data-canvas-opacity-target="value">100 %</span>
                </label>
                <input type="range" id="image-opacity-control" class="form-range" min="0" max="100" step="1" data-canvas-opacity-target="slider" data-action="input->canvas-opacity#update change->canvas-opacity#update">
            </div>


            <div data-canvas-image-properties-target="details" style="display: none;">
                <div class="mb-2">
                    <label for="image-description-control" class="form-label small mb-1">Nápověda</label>
                    <input type="text" id="image-description-control" class="form-control form-control-sm" data-canvas-image-properties-target="description" data-action="input->canvas-image-properties#updateDescription">
                </div>

                <label class="form-label small mb-1">Povolit uživateli:</label>
                {# Background layers: fill = fixed top-left cover, so the transform
                   limits are hidden (the hint below shows instead). #}
                <p class="small text-muted mb-1" data-canvas-image-properties-target="backgroundHint" style="display: none;">Pozadí se vyplní automaticky přes celé plátno (bez posunu, změny velikosti a rotace).</p>
                <div class="row g-1 mb-2">
                    {# "Posun obrázku v rámečku" — pans the user's PICTURE inside the
                       frame; the frame itself never moves (not to be confused
                       with "Uživatel může posunout" on texts / shapes). #}
                    <div class="col-12" data-canvas-image-properties-target="transformLimit">
                        <div class="form-check mb-0">
                            <input type="checkbox" id="image-allow-move-control" class="form-check-input" data-canvas-image-properties-target="allowMove" data-action="change->canvas-image-properties#updateAllowMove">
                            <label for="image-allow-move-control" class="form-check-label small">Posun obrázku v rámečku</label>
                        </div>
                    </div>
                    <div class="col-6" data-canvas-image-properties-target="transformLimit">
                        <div class="form-check mb-0">
                            <input type="checkbox" id="image-allow-resize-control" class="form-check-input" data-canvas-image-properties-target="allowResize" data-action="change->canvas-image-properties#updateAllowResize">
                            <label for="image-allow-resize-control" class="form-check-label small">Změnu velikosti</label>
                        </div>
                    </div>
                    <div class="col-6" data-canvas-image-properties-target="transformLimit">
                        <div class="form-check mb-0">
                            <input type="checkbox" id="image-allow-rotate-control" class="form-check-input" data-canvas-image-properties-target="allowRotate" data-action="change->canvas-image-properties#updateAllowRotate">
                            <label for="image-allow-rotate-control" class="form-check-label small">Rotaci</label>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="form-check mb-0">
                            <input type="checkbox" id="image-hidable-control" class="form-check-input" data-canvas-image-properties-target="hidable" data-action="change->canvas-image-properties#updateHidable">
                            <label for="image-hidable-control" class="form-check-label small">Schování</label>
                        </div>
                    </div>
                </div>

                {# The gallery's folder tree (same order). Ticking a folder opens its
                   whole sub-tree to the user — its descendants show as included. #}
                <div class="ed-ftree" role="group" aria-labelledby="image-dir-heading">
                    <p class="form-label small mb-1" id="image-dir-heading">Složky galerie pro uživatele:</p>
                    {% if gallery_directories.nodes is not empty %}
                        <p class="ed-ftree__hint">Zaškrtnutá složka zpřístupní i všechny své podsložky.</p>
                        {{ include('editor/_image_folder_branch.html.twig', {tree: gallery_directories, parent_id: null}) }}
                    {% else %}
                        <p class="ed-ftree__hint">Galerie projektu zatím nemá žádné složky.</p>
                    {% endif %}
                </div>

                {# Live guidance: empty allow-list = "offer all folders"; no folders at all = dead end. #}
                <div class="alert alert-warning py-1 px-2 small mt-1 mb-0" role="alert" data-canvas-image-properties-target="warning" style="display: none;"></div>
            </div>

            {{ include('editor/_user_move_section.html.twig', {surface: 'image'}) }}

            {# Container membership for an image member — decorative OR a
               fillable slot (plan P2a): mirrors the textbox popover's section
               (both are plural `section` targets): only the element-specific
               action, the container is configured in its zone's ⚙ popover. #}
            <div class="d-none" data-canvas-container-target="section">
                <h3 class="ed-sec-h">Kontejner</h3>
                <p class="text-muted small my-2">Obrázek se posouvá spolu s textem, který překrývá (ikona či logo u řádku); obrázek mimo texty tvoří vlastní řádek toku. U pole pro obrázek se posouvá celý rámeček — obrázek, který vybere klient, v něm zůstane tak, jak si ho umístil. Nastavení kontejneru najdete pod ⚙ na jeho rámečku.</p>
                <button type="button" class="btn btn-sm btn-outline-secondary w-100" data-action="canvas-container#removeActiveFromContainer">Odebrat z kontejneru</button>
            </div>
            <div class="ed-acts">
                <button type="button" class="btn btn-tertiary btn-sm" data-action="canvas-clipboard#duplicate">{{ icon('copy', 's14') }}Duplikovat</button>
                <button type="button" class="btn btn-ghost-danger btn-sm" data-action="canvas-alignment#deleteObject">{{ icon('trash', 's14') }}Smazat</button>
            </div>
        </div>
    </div>

    {# Floating full-options popover: SHAPE — fields driven by
       canvas-shape-properties (visibility owned by canvas-floating-toolbar).
       Everything here writes a NATIVE Fabric property, so it round-trips
       through the canvas JSONB and renders identically in the export. #}
    <div class="canvas-floating-popover ed-insp card d-none" data-canvas-floating-toolbar-target="shapePopover">
        <div class="card-body p-2">
            <div class="ed-ph">
                <i class="i i-grip s14 canvas-popover-drag" data-popover-drag-handle role="button" aria-label="Přesunout okno" title="Přesunout okno"></i>
                <span class="ed-ph-i"><i class="i i-shape s16" aria-hidden="true"></i></span>
                <span class="ed-ph-t"><span data-canvas-shape-properties-target="kindLabel">Tvar</span></span>
                <button type="button" class="btn btn-success btn-sm ed-ph-ok" data-action="canvas-floating-toolbar#closePopovers">{{ icon('check', 's14') }}Uložit</button>
                <button type="button" class="btn btn-ghost icon xs ed-ph-x" aria-label="Zavřít" title="Zavřít" data-action="canvas-floating-toolbar#closePopovers">{{ icon('x', 's14') }}</button>
            </div>

            {# --- Výplň: plná barva nebo přechod ------------------------- #}
            <div class="d-flex align-items-center justify-content-between mb-1">
                <label class="form-label small mb-0">Výplň</label>
                <div class="btn-group btn-group-sm" role="group" aria-label="Typ výplně">
                    <button type="button" class="btn btn-outline-secondary active" data-canvas-shape-properties-target="solidButton" data-action="canvas-shape-properties#setFillMode" data-canvas-shape-properties-mode-param="solid">Barva</button>
                    <button type="button" class="btn btn-outline-secondary" data-canvas-shape-properties-target="gradientButton" data-action="canvas-shape-properties#setFillMode" data-canvas-shape-properties-mode-param="gradient">Přechod</button>
                </div>
            </div>

            <div data-canvas-shape-properties-target="solidSection">
                {% if brand_colors is defined and brand_colors is not empty %}
                    <div class="d-flex align-items-center flex-wrap gap-1 mb-1" role="group" aria-label="Barvy z manuálu">
                        {% for color in brand_colors %}
                            <button
                                type="button"
                                class="fill-richtext-swatch"
                                style="background-color: {{ color }}"
                                title="{{ color }}"
                                data-canvas-shape-properties-target="swatch"
                                data-canvas-shape-properties-color-param="{{ color }}"
                                data-action="canvas-shape-properties#pickFillColor"
                            ></button>
                        {% endfor %}
                        <label class="fill-richtext-swatch fill-richtext-swatch--custom mb-0" title="Vlastní barva">
                            <input type="button" class="fill-richtext-swatch__input" aria-label="Vlastní barva" data-controller="color-picker" data-canvas-shape-properties-target="fillPicker" data-action="input->canvas-shape-properties#pickCustomFill change->canvas-shape-properties#commitColor">
                        </label>
                    </div>
                {% else %}
                    <label class="fill-richtext-swatch fill-richtext-swatch--custom mb-1" title="Vlastní barva">
                        <input type="button" class="fill-richtext-swatch__input" aria-label="Vlastní barva" data-controller="color-picker" data-canvas-shape-properties-target="fillPicker" data-action="input->canvas-shape-properties#pickCustomFill change->canvas-shape-properties#commitColor">
                    </label>
                {% endif %}
                <input type="text" id="shape-fill-control" class="form-control form-control-sm" placeholder="#000000" aria-label="Barva výplně" data-canvas-shape-properties-target="fillColor" data-action="input->canvas-shape-properties#updateFillHex">
            </div>

            <div class="d-none" data-canvas-shape-properties-target="gradientSection">
                {# Stop rows are rendered by canvas-shape-properties#_renderGradientStops.
                   Each stop: colour, opacity (Krytí) and position — e.g. white 0 % →
                   white 100 % is a fade-in overlay over a photo. #}
                <div class="d-flex align-items-center gap-1 mb-1">
                    <div class="shape-gradient-preview flex-grow-1" data-canvas-shape-properties-target="gradientPreview" aria-hidden="true"></div>
                    <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-1" title="Obrátit přechod" aria-label="Obrátit přechod" data-action="canvas-shape-properties#swapGradient"><i class="i i-swap-horizontal s14" aria-hidden="true"></i></button>
                </div>
                <div class="shape-gradient-stop shape-gradient-stop--head text-muted small">
                    <span>Barva</span><span>Krytí</span><span>Pozice</span><span></span>
                </div>
                <div data-canvas-shape-properties-target="gradientStops"></div>
                <button type="button" class="btn btn-sm btn-link px-0 py-0 mb-1" data-canvas-shape-properties-target="gradientAdd" data-action="canvas-shape-properties#addGradientStop"><i class="i i-plus s14" aria-hidden="true"></i> Přidat barvu</button>
                <div class="row g-1 align-items-end">
                    <div class="col-12">
                        <label for="shape-gradient-type-control" class="form-label small mb-1">Typ</label>
                        <select id="shape-gradient-type-control" class="form-select form-select-sm" data-canvas-shape-properties-target="gradientType" data-action="change->canvas-shape-properties#updateGradient">
                            <option value="linear">Lineární</option>
                            <option value="radial">Radiální</option>
                        </select>
                    </div>
                    <div class="col-12" data-canvas-shape-properties-target="gradientAngleRow">
                        <label for="shape-gradient-angle-control" class="form-label small mb-1">
                            Úhel <span class="text-muted" data-canvas-shape-properties-target="gradientAngleValue">90°</span>
                        </label>
                        <input type="range" id="shape-gradient-angle-control" class="form-range" min="0" max="359" step="1" data-canvas-shape-properties-target="gradientAngle" data-action="input->canvas-shape-properties#updateGradient change->canvas-shape-properties#updateGradient">
                    </div>
                </div>
            </div>

            <hr class="my-2">

            {# --- Obrys -------------------------------------------------- #}
            <div class="d-flex align-items-center justify-content-between mb-1">
                <label class="form-label small mb-0">Obrys</label>
                <button type="button" class="btn btn-sm btn-link p-0 text-muted d-none" style="font-size: .75rem;" data-canvas-shape-properties-target="strokeClear" data-action="canvas-shape-properties#clearStroke">Bez obrysu</button>
            </div>
            <div class="row g-1 align-items-end">
                <div class="col-auto">
                    <label class="fill-richtext-swatch fill-richtext-swatch--custom mb-0" title="Barva obrysu">
                        <input type="button" class="fill-richtext-swatch__input" aria-label="Barva obrysu" data-controller="color-picker" data-canvas-shape-properties-target="strokePicker" data-action="input->canvas-shape-properties#pickStrokeColor change->canvas-shape-properties#commitColor">
                    </label>
                </div>
                <div class="col">
                    <input type="text" id="shape-stroke-control" class="form-control form-control-sm" placeholder="bez obrysu" aria-label="Barva obrysu" data-canvas-shape-properties-target="strokeColor" data-action="input->canvas-shape-properties#updateStrokeHex">
                </div>
                <div class="col-4">
                    <label for="shape-stroke-width-control" class="form-label small mb-1">Šířka</label>
                    <input type="number" min="0" step="1" id="shape-stroke-width-control" class="form-control form-control-sm" placeholder="0" data-canvas-shape-properties-target="strokeWidth" data-action="input->canvas-shape-properties#updateStrokeWidth change->canvas-shape-properties#updateStrokeWidth">
                </div>
                <div class="col-8">
                    <label for="shape-stroke-style-control" class="form-label small mb-1">Styl</label>
                    <select id="shape-stroke-style-control" class="form-select form-select-sm" data-canvas-shape-properties-target="strokeStyle" data-action="change->canvas-shape-properties#updateStrokeStyle">
                        <option value="solid">Plný</option>
                        <option value="dashed">Čárkovaný</option>
                        <option value="dotted">Tečkovaný</option>
                    </select>
                </div>
            </div>

            <hr class="my-2">

            {# --- Barva pro uživatele: the end user may recolour this shape
               (fill / border / both) on the fill page + API. Custom props
               colorChoice / allowedColors / colorFree, resolved server-side by
               ShapeColorInput. #}
            <div class="mb-1">
                <label for="shape-color-choice-control" class="form-label small mb-1">Barva pro uživatele <i class="i i-info s12 ed-tip" title="Uživatel může při vyplňování šablony tvar přebarvit jednou barvou. Navržená barva je k dispozici vždy (návrat k původní)."></i></label>
                <select id="shape-color-choice-control" class="form-select form-select-sm" data-canvas-shape-properties-target="colorChoice" data-action="change->canvas-shape-properties#updateColorChoice">
                    <option value="">Uživatel barvu nemění</option>
                    <option value="fill">Může měnit barvu výplně</option>
                    <option value="stroke">Může měnit barvu obrysu</option>
                    <option value="both">Může měnit výplň i obrys (jednou barvou)</option>
                </select>
                <div class="form-text small text-warning d-none" data-canvas-shape-properties-target="colorChoiceWarning"></div>
                <div class="d-none mt-1" data-canvas-shape-properties-target="colorChoiceList">
                    <div class="d-flex align-items-center flex-wrap gap-1" role="group" aria-label="Barvy pro uživatele" data-canvas-shape-properties-target="colorChoiceSwatches"></div>
                    <div class="input-group input-group-sm mt-1" style="max-width: 12rem;">
                        <input type="text" class="form-control" placeholder="#rrggbb" aria-label="Přidat vlastní barvu" data-canvas-shape-properties-target="colorChoiceCustom" data-action="keydown->canvas-shape-properties#customColorKeydown">
                        <button type="button" class="btn btn-outline-secondary" title="Přidat barvu do výběru" data-action="canvas-shape-properties#addCustomColor"><i class="i i-plus s14"></i></button>
                    </div>
                    <div class="form-check mt-1 mb-0">
                        <input type="checkbox" id="shape-color-free-control" class="form-check-input" data-canvas-shape-properties-target="colorFree" data-action="change->canvas-shape-properties#updateColorFree">
                        <label for="shape-color-free-control" class="form-check-label small">Povolit i libovolnou barvu <span class="text-muted">(vybrané barvy jsou pak jen návrh)</span></label>
                    </div>
                </div>
            </div>

            <hr class="my-2">

            <div class="row g-2">
                {# Zaoblení = rx/ry, a rectangle affordance only: on an Ellipse
                   the same two keys ARE the radii, so offering it there would
                   silently resize the shape. #}
                <div class="col-6 d-none" data-canvas-shape-properties-target="cornerRadiusRow">
                    <label for="shape-corner-radius-control" class="form-label small mb-1">Zaoblení rohů</label>
                    <input type="number" min="0" step="1" id="shape-corner-radius-control" class="form-control form-control-sm" data-canvas-shape-properties-target="cornerRadius" data-action="input->canvas-shape-properties#updateCornerRadius change->canvas-shape-properties#updateCornerRadius">
                </div>
                <div class="col-6">
                    <label for="shape-opacity-control" class="form-label small mb-1">
                        Průhlednost <span class="text-muted" data-canvas-shape-properties-target="opacityValue">100 %</span>
                    </label>
                    <input type="range" id="shape-opacity-control" class="form-range" min="0" max="100" step="1" data-canvas-shape-properties-target="opacity" data-action="input->canvas-shape-properties#updateOpacity change->canvas-shape-properties#updateOpacity">
                </div>

                <div class="col-12">
                    <label for="shape-name-control" class="form-label small mb-1">Název vrstvy <i class="i i-info s12 ed-tip" title="Pro orientaci v panelu Vrstvy. Když uživatel může tvar přebarvit, zobrazí se mu tento název u výběru barvy."></i></label>
                    <input type="text" id="shape-name-control" class="form-control form-control-sm" placeholder="např. Podklad, Linka…" data-canvas-shape-properties-target="name" data-action="input->canvas-shape-properties#updateName">
                </div>

                <div class="col-12">
                    <div class="form-check mb-0">
                        <input type="checkbox" id="shape-editor-locked-control" class="form-check-input" data-canvas-shape-properties-target="editorLocked" data-action="change->canvas-shape-properties#updateEditorLock">
                        <label for="shape-editor-locked-control" class="form-check-label small">Zamknout v editoru <span class="text-muted">(chrání před náhodným posunutím — kliknutí prochází skrz, prvek pak vyberete v panelu Vrstvy; neovlivní export)</span></label>
                    </div>
                </div>
            </div>

            {{ include('editor/_user_move_section.html.twig', {surface: 'shape'}) }}

            {# Container membership for a DECORATIVE shape member — mirrors the
               textbox / image popovers (all three are plural `section`
               targets). #}
            <div class="d-none" data-canvas-container-target="section">
                <h3 class="ed-sec-h">Kontejner</h3>
                <p class="text-muted small my-2">Tvar se posouvá spolu s textem, který překrývá (linka pod nadpisem); tvar mimo texty tvoří vlastní řádek toku. Nastavení kontejneru najdete pod ⚙ na jeho rámečku.</p>
                <button type="button" class="btn btn-sm btn-outline-secondary w-100" data-action="canvas-container#removeActiveFromContainer">Odebrat z kontejneru</button>
            </div>
            <div class="ed-acts">
                <button type="button" class="btn btn-tertiary btn-sm" data-action="canvas-clipboard#duplicate">{{ icon('copy', 's14') }}Duplikovat</button>
                <button type="button" class="btn btn-ghost-danger btn-sm" data-action="canvas-alignment#deleteObject">{{ icon('trash', 's14') }}Smazat</button>
            </div>
        </div>
    </div>
</div>
</div>

{# Pointer-modifier cheatsheet (canvas_editor_controller#applyPointerModifiers):
   Ctrl/⌘ follows Photoshop's Move-tool auto-select, Alt/⌥ the diagram-editor
   marquee-through convention. Opened from the "Nápověda" button in the top bar
   (editor/_editor_toggles.html.twig) — as a line under the canvas it cost the
   stage vertical space on every screen. Shared partial, so the single-variant
   editor and the group editor show the same help. #}
<div class="modal fade" id="editorHelpModal" tabindex="-1" aria-labelledby="editorHelpModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editorHelpModalLabel">Ovládání plátna</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Zavřít"></button>
            </div>
            <div class="modal-body">
                <dl class="row mb-0 small">
                    <dt class="col-sm-4">Alt/⌥ + tažení</dt>
                    <dd class="col-sm-8">Výběr oblasti i přes objekty</dd>

                    <dt class="col-sm-4">Ctrl/⌘ + tažení</dt>
                    <dd class="col-sm-8">Uchopí objekt pod kurzorem (i obrázek přes celé plátno)</dd>

                    <dt class="col-sm-4">⌘ + tažení</dt>
                    <dd class="col-sm-8">Dočasně vypne přichytávání k prvkům</dd>

                    <dt class="col-sm-4">Esc</dt>
                    <dd class="col-sm-8 mb-0">Zrušit výběr</dd>
                </dl>
            </div>
        </div>
    </div>
</div>

{# Photoshop-style navigator (canvas_navigator_controller): fixed mini-map
   with the visible-area rectangle; click/drag pans by scrolling the
   .canvas-viewport scroll container. The grip bar on top moves the panel
   itself (it used to sit over whatever the designer worked on in the
   bottom-right corner); double-click returns it to the corner. #}
<div class="canvas-navigator d-none" data-canvas-navigator-target="panel">
    <div class="canvas-navigator__handle" title="Přesunout navigátor (dvojklik vrátí do rohu)" aria-label="Přesunout navigátor"
         data-action="pointerdown->canvas-navigator#beginMove dblclick->canvas-navigator#resetPosition">
        <i class="i i-grip s14" aria-hidden="true"></i><span>Navigátor</span>
    </div>
    <div class="canvas-navigator__map" data-action="mousedown->canvas-navigator#beginPan">
        <canvas data-canvas-navigator-target="thumb" aria-label="Navigátor plátna"></canvas>
        <div class="canvas-navigator__rect" data-canvas-navigator-target="rect"></div>
    </div>
</div>

{# "Vzorový text" modal: the admin-authored default fill. Rich inputs get a
   FRESH fill-page WYSIWYG per open — canvas_input_properties clones the
   <template> below, stamps the active textbox's values on the clone and
   appends it into sampleHost (Stimulus connects on insert), so runs + lists
   behave exactly like on the fill page. Plain inputs use the textarea.
   CHECKLIST components reuse the modal with the fill page's per-item editor
   and the title/hint/footer relabeled ("Položky seznamu"). #}
<div class="modal fade" id="sampleTextModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h5 class="modal-title" data-canvas-input-properties-target="sampleTitle">Vzorový text</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Zavřít"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small" data-canvas-input-properties-target="sampleHint">Zobrazí se v náhledu i exportu, dokud uživatel pole nevyplní. Podporuje vše co vyplňování — u formátovatelných polí včetně stylů a seznamů.</p>
                <div data-canvas-input-properties-target="sampleHost"></div>
                <textarea class="form-control form-control-sm d-none" rows="4" placeholder="Vzorový text…" data-canvas-input-properties-target="samplePlain"></textarea>
            </div>
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-sm btn-outline-danger me-auto" data-canvas-input-properties-target="sampleClear" data-action="canvas-input-properties#clearSample">Smazat vzorový text</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Zrušit</button>
                <button type="button" class="btn btn-sm btn-primary" data-action="canvas-input-properties#saveSample">Uložit</button>
            </div>
        </div>
    </div>
</div>

{# Per-item checklist editor — the SAME controller the fill page uses, but
   with every capability on: the four flags gate the user, not the designer
   authoring the defaults. Its hidden mirror gets `data-text-mirror` stamped
   with the object's inputId so checklist-editor's own sync finds it. #}
<template data-canvas-input-properties-target="checklistTemplate">
    <div data-controller="checklist-editor"
         data-checklist-editor-can-toggle-value="true"
         data-checklist-editor-can-edit-text-value="true"
         data-checklist-editor-can-add-value="true"
         data-checklist-editor-can-remove-value="true">
        <div class="d-flex flex-column gap-1" data-checklist-editor-target="rows"></div>
        <button type="button" class="btn btn-sm btn-outline-secondary mt-2" data-checklist-editor-target="addButton" data-action="checklist-editor#addItem"><i class="i i-plus s14 me-1"></i>Přidat položku</button>
        <div class="d-flex justify-content-between mt-1">
            <small class="text-muted">Enter = nová položka</small>
            <small class="text-muted" data-checklist-editor-target="counter"></small>
        </div>
        <input type="hidden" data-sample-mirror>
    </div>
</template>

{% if rich_toolbar is defined and rich_toolbar %}
    <template data-canvas-input-properties-target="sampleTemplate">
        <div data-controller="rich-text-editor"
             data-rich-text-editor-fonts-value="{{ rich_toolbar.fonts|json_encode }}"
             data-rich-text-editor-colors-value="{{ rich_toolbar.colors|json_encode }}">
            <div class="fill-richtext-toolbar d-flex align-items-center flex-wrap gap-1 mb-1">
                <select class="form-select form-select-sm fill-richtext-toolbar__font" aria-label="Písmo" data-rich-text-editor-target="fontSelect" data-action="change->rich-text-editor#applyFont">
                    <option value="">Výchozí písmo</option>
                    {% for group in rich_toolbar.fontGroups %}
                        <optgroup label="{{ group.name }}">
                            {% for face in group.faces %}
                                <option value="{{ face.family }}" style="font-family: '{{ face.family }}'">{{ face.faceName }}</option>
                            {% endfor %}
                        </optgroup>
                    {% endfor %}
                </select>
                <div class="btn-group btn-group-sm" role="group" aria-label="Řez a podtržení">
                    <button type="button" class="btn btn-outline-secondary fw-bold" title="Tučně (Ctrl+B)" data-rich-text-editor-target="bold" data-action="rich-text-editor#toggleBold">B</button>
                    <button type="button" class="btn btn-outline-secondary fst-italic" title="Kurzíva (Ctrl+I)" data-rich-text-editor-target="italic" data-action="rich-text-editor#toggleItalic">I</button>
                    <button type="button" class="btn btn-outline-secondary text-decoration-underline" title="Podtržení (Ctrl+U)" data-rich-text-editor-target="underline" data-action="rich-text-editor#toggleUnderline">U</button>
                </div>
                <div class="btn-group btn-group-sm d-none" role="group" aria-label="Seznamy" data-sample-lists>
                    <button type="button" class="btn btn-outline-secondary" title="Odrážkový seznam" data-rich-text-editor-target="ulButton" data-action="rich-text-editor#toggleBulletList">{{ icon('list-bullet', 's16') }}</button>
                    <button type="button" class="btn btn-outline-secondary" title="Číslovaný seznam" data-rich-text-editor-target="olButton" data-action="rich-text-editor#toggleNumberedList">{{ icon('list-ordered', 's16') }}</button>
                    <button type="button" class="btn btn-outline-secondary d-none" title="Zaškrtávací seznam" data-sample-checkboxes data-rich-text-editor-target="cbButton" data-action="rich-text-editor#toggleCheckboxList">{{ icon('list', 's16') }}</button>
                </div>
                <button type="button" class="btn btn-sm btn-outline-secondary" title="Výchozí styl — odstraní veškeré formátování" data-action="rich-text-editor#clearFormatting">{{ icon('format-clear', 's16') }}</button>
            </div>
            <div class="fill-richtext-toolbar__swatches d-flex align-items-center flex-wrap gap-1 mb-1" role="group" aria-label="Barva textu">
                <button type="button" class="fill-richtext-swatch fill-richtext-swatch--auto" title="Výchozí barva" data-action="rich-text-editor#pickColor" data-rich-text-editor-color-param=""></button>
                {% for color in rich_toolbar.colors %}
                    <button type="button" class="fill-richtext-swatch" style="background-color: {{ color }}" title="{{ color }}" data-action="rich-text-editor#pickColor" data-rich-text-editor-color-param="{{ color }}"></button>
                {% endfor %}
                <label class="fill-richtext-swatch fill-richtext-swatch--custom" title="Vlastní barva">
                    <input type="button" class="fill-richtext-swatch__input" aria-label="Vlastní barva" data-controller="color-picker" data-rich-text-editor-target="colorInput" data-action="change->rich-text-editor#applyCustomColor">
                </label>
            </div>
            <div class="form-control form-control-sm fill-richtext-editor" contenteditable="true" role="textbox" aria-multiline="true" aria-label="Vzorový text"
                 data-rich-text-editor-target="editor"
                 data-action="input->rich-text-editor#input beforeinput->rich-text-editor#beforeInput keydown->rich-text-editor#keydown paste->rich-text-editor#paste compositionstart->rich-text-editor#compositionStart compositionend->rich-text-editor#compositionEnd click->rich-text-editor#editorClick"></div>
            <div class="d-flex justify-content-between mt-1">
                <small class="text-muted">Enter = nový řádek</small>
                <small class="text-muted" data-rich-text-editor-target="counter"></small>
            </div>
            <input type="hidden" data-sample-mirror>
        </div>
    </template>
{% endif %}
