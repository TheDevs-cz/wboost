{# Compact editor toggle group in the TOP bar next to the zoom controls
   (shared by the single-variant and the group editor). The element IDs are
   load-bearing: canvas_floating_toolbar (#highlight-editable-control),
   canvas_snapping (#snap-enabled-control on connect) and canvas_rulers
   (#ruler-enabled-control) key off them. Both editor roots wrap the header,
   so the data-actions reach the same controllers as before the move. #}
<div class="d-inline-block align-middle ms-3">
    <div class="form-check form-switch form-check-inline my-0 me-3 align-middle">
        <input class="form-check-input" type="checkbox" role="switch" id="highlight-editable-control" checked data-action="change->canvas-floating-toolbar#toggleHighlight">
        <label class="form-check-label small" for="highlight-editable-control">Zobrazit editovatelné prvky</label>
    </div>
    <div class="form-check form-switch form-check-inline my-0 me-3 align-middle">
        <input class="form-check-input" type="checkbox" role="switch" id="snap-enabled-control" checked data-action="change->canvas-snapping#toggleSnapping">
        <label class="form-check-label small" for="snap-enabled-control">Přichytávání k prvkům <span class="text-muted">(⌘ = vypnout)</span></label>
    </div>
    <div class="form-check form-switch form-check-inline my-0 align-middle">
        <input class="form-check-input" type="checkbox" role="switch" id="ruler-enabled-control" checked data-action="change->canvas-rulers#toggle">
        <label class="form-check-label small" for="ruler-enabled-control">Pravítka a vodítka</label>
    </div>
</div>
