{% extends 'base_auth.html.twig' %}

{% block title %}Přihlášení{% endblock %}

{% block auth_body %}
    <div class="auth-top">
        <h1>Přihlášení</h1>
        <p>Zadejte e-mail a heslo ke svému účtu.</p>
    </div>

    {{ include('_flashes.html.twig') }}

    {% if error %}
        <div class="alert alert-danger" role="alert">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
    {% endif %}

    <form action="{{ path('login') }}" method="post" class="auth-form">
        <label class="field" for="emailaddress">
            <span>E-mail</span>
            <span class="inp">
                {{ icon('mail', 's18') }}
                <input type="email" id="emailaddress" name="_username" required="required" placeholder="jmeno@firma.cz" value="{{ last_username }}" autocomplete="username" autofocus>
            </span>
        </label>

        <div class="field">
            <span class="field-l"><label for="password">Heslo</label><a href="{{ path('forgotten_password') }}" class="auth-link">Zapomněli jste heslo?</a></span>
            <span class="inp">
                {{ icon('lock', 's18') }}
                <input type="password" id="password" name="_password" placeholder="Vaše heslo" autocomplete="current-password">
                <button type="button" class="auth-eye" data-password="false" aria-label="Zobrazit heslo">{{ icon('eye', 's18') }}{{ icon('eye-off', 's18') }}</button>
            </span>
        </div>

        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

        <button class="btn btn-primary auth-submit" type="submit">Přihlásit se</button>
    </form>

    <div class="auth-or" role="separator"><span>nebo</span></div>

    <a href="{{ path('oauth_facebook_login') }}" class="btn btn-tertiary auth-submit">{{ icon('facebook', 's16') }}Přihlásit se přes Facebook</a>
{% endblock %}

{% block auth_below %}Nemáte účet? <a href="{{ path('registration') }}">Požádejte o registraci</a>{% endblock %}
