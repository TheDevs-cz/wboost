{# Interactive mockup page editor shared by the add + edit pages.

   Context:
   - form: ManualMockupPageFormType view
   - layouts_geometry: MockupPageLayout::exportGeometry()
   - fixed_layout: MockupPageLayout|null — set on edit (layout locked)
   - existing_images: list<string|null> — per-slot uploaded_asset URLs (edit)
   - existing_downloads: list<{name, size}|null> — per-slot attached files (edit)
   - existing_page_download: {name, size}|null — the whole page's attached file (edit)
     (passed to the controller as two SCALARS, never as an object — Twig encodes
     an empty hash as `[]` and Stimulus' Object reader THROWS on an array,
     which aborted connect() and left the editor half-wired)
   - submit_label: string
#}
{% set existing_images = existing_images|default([]) %}
{% set existing_downloads = existing_downloads|default([]) %}
{% set existing_page_download = existing_page_download|default(null) %}
{% set fixed_layout = fixed_layout|default(null) %}

{# The two size caps mirror ManualMockupPageFormType — Symfony reads the `m`
   suffix as DECIMAL MB, so these are the very same byte counts. #}
{{ form_start(form, {'attr': {
    'data-controller': 'mockup-page-editor',
    'data-mockup-page-editor-geometry-value': layouts_geometry|json_encode,
    'data-mockup-page-editor-existing-images-value': existing_images|json_encode,
    'data-mockup-page-editor-existing-downloads-value': existing_downloads|json_encode,
    'data-mockup-page-editor-page-download-name-value': existing_page_download ? existing_page_download.name : '',
    'data-mockup-page-editor-page-download-size-value': existing_page_download ? existing_page_download.size : 0,
    'data-mockup-page-editor-fixed-layout-value': fixed_layout ? fixed_layout.value : '',
    'data-mockup-page-editor-max-file-size-value': 10000000,
    'data-mockup-page-editor-max-download-size-value': 20000000,
    'data-action': 'submit->mockup-page-editor#formSubmitted',
}}) }}

    <div class="man-editor">
        <section class="man-sec" aria-labelledby="mockup-name-title">
            <div class="man-sech"><h2 id="mockup-name-title">Název stránky</h2></div>
            <div class="man-name">
                {{ form_row(form.name, {'label': false, 'attr': {'placeholder': 'Např. Vizitky a hlavičkový papír', 'aria-labelledby': 'mockup-name-title'}}) }}
            </div>
        </section>

        {% if form.layout is defined %}
            <section class="man-sec" aria-labelledby="mockup-layout-title">
                <div class="man-sech">
                    <h2 id="mockup-layout-title">Rozložení stránky</h2>
                    <span class="cap">Vyberte, jak budou obrázky na stránce manuálu uspořádané. Rozložení můžete změnit i po nahrání obrázků — nahrané obrázky zůstanou zachované.</span>
                </div>

                {{ form_errors(form.layout) }}

                <div class="mockup-layout-picker">
                    {% for child in form.layout %}
                        {% set slot_count = layouts_geometry[child.vars.value]|length %}
                        <label class="mockup-layout-option" data-mockup-page-editor-target="layoutOption" data-layout="{{ child.vars.value }}">
                            {{ form_widget(child, {'attr': {
                                'class': 'mockup-layout-radio',
                                'data-mockup-page-editor-target': 'layoutRadio',
                                'data-action': 'mockup-page-editor#layoutChanged',
                            }}) }}
                            <span class="mockup-mini-grid" aria-hidden="true">
                                {% for slot in layouts_geometry[child.vars.value] %}
                                    <span data-slot-index="{{ loop.index0 }}" style="grid-column: {{ slot.column }} / span {{ slot.columnSpan }}; grid-row: {{ slot.row }} / span {{ slot.rowSpan }};"></span>
                                {% endfor %}
                            </span>
                            <span class="mockup-layout-count">{{ slot_count }} {{ slot_count == 1 ? 'obrázek' : (slot_count < 5 ? 'obrázky' : 'obrázků') }}</span>
                        </label>
                    {% endfor %}
                </div>
            </section>
        {% elseif fixed_layout %}
            <section class="man-sec" aria-labelledby="mockup-layout-title">
                <div class="man-sech">
                    <h2 id="mockup-layout-title">Rozložení stránky</h2>
                </div>
                <div class="man-fixed-layout">
                    <span class="mockup-layout-option mockup-layout-option-static" data-mockup-page-editor-target="layoutOption" data-layout="{{ fixed_layout.value }}">
                        <span class="mockup-mini-grid" aria-hidden="true">
                            {% for slot in layouts_geometry[fixed_layout.value] %}
                                <span data-slot-index="{{ loop.index0 }}" style="grid-column: {{ slot.column }} / span {{ slot.columnSpan }}; grid-row: {{ slot.row }} / span {{ slot.rowSpan }};"></span>
                            {% endfor %}
                        </span>
                    </span>
                    <span class="cap">Rozložení nelze po vytvoření stránky změnit.</span>
                </div>
            </section>
        {% endif %}

        <section class="man-sec" aria-labelledby="mockup-images-title">
            <div class="man-sech">
                <h2 id="mockup-images-title">Obrázky</h2>
                <span class="cap">Klikněte na pole (nebo do něj přetáhněte soubor) a nahrajte obrázek. U každého pole vidíte doporučené rozměry — obrázek v jiném poměru stran se při zobrazení ořízne.</span>
            </div>

            {% for imageField in form.images %}
                {% if imageField.vars.errors|length > 0 %}
                    <div class="alert alert-danger">
                        <strong>Obrázek {{ loop.index }}:</strong> {{ form_errors(imageField) }}
                    </div>
                {% endif %}
            {% endfor %}

            <div class="alert alert-warning d-none" data-mockup-page-editor-target="extraNotice">
                Zvolené rozložení má méně polí — obrázky a soubory navíc se neuloží. Přepnutím zpět na větší rozložení o ně nepřijdete.
            </div>

            <div class="mockup-editor-desk">
                <div class="mockup-editor-stage-container">
                    <div class="mockup-editor-page" data-mockup-page-editor-target="stage"></div>
                </div>
                <div class="mockup-editor-no-layout d-none" data-mockup-page-editor-target="stageEmpty">
                    {{ icon('grid') }}
                    <span>Nejdříve vyberte rozložení stránky výše.</span>
                </div>
            </div>
        </section>

        <section class="man-sec" aria-labelledby="mockup-files-title">
            <div class="man-sech">
                <h2 id="mockup-files-title">Soubory ke stažení <span class="pill neutral">Nepovinné</span></h2>
                <span class="cap">Přiložte podklad, který si čtenář manuálu stáhne — tiskové PDF, zdrojová data, balíček. Soubor pro jednotlivý obrázek přidáte přímo v něm (lišta „Soubor ke stažení“ dole v poli), soubor pro celou stránku níže. U každého se pak v manuálu objeví tlačítko ke stažení.</span>
            </div>

            {% if form.downloadFile.vars.errors|length > 0 %}
                <div class="alert alert-danger">
                    <strong>Soubor stránky:</strong> {{ form_errors(form.downloadFile) }}
                </div>
            {% endif %}
            {% for downloadField in form.imageDownloads %}
                {% if downloadField.vars.errors|length > 0 %}
                    <div class="alert alert-danger">
                        <strong>Soubor u obrázku {{ loop.index }}:</strong> {{ form_errors(downloadField) }}
                    </div>
                {% endif %}
            {% endfor %}

            {# Rendered server-side, not built by JS: an empty button is exactly
               the failure this card had while the controller was crashing. #}
            <div class="mockup-page-file man-att-row">
                <span class="mockup-page-file-label">
                    {{ icon('file', 's16') }}Soubor pro celou stránku
                </span>
                <span class="mockup-page-file-state" data-mockup-page-editor-target="pageFileState">Bez souboru</span>
                <span class="mockup-page-file-actions">
                    <button type="button" class="btn btn-ghost btn-sm text-danger" hidden
                            data-mockup-page-editor-target="pageFileRemove"
                            data-action="mockup-page-editor#removePageDownload">
                        <span class="i i-trash s16" aria-hidden="true"></span>Odebrat
                    </button>
                    <button type="button" class="btn btn-ghost btn-sm" hidden
                            data-mockup-page-editor-target="pageFileRestore"
                            data-action="mockup-page-editor#restorePageDownload">
                        <span class="i i-undo s16" aria-hidden="true"></span>Vrátit původní
                    </button>
                    <button type="button" class="btn btn-tertiary sm"
                            data-mockup-page-editor-target="pageFilePick"
                            data-action="mockup-page-editor#pickPageDownload">
                        <span class="i i-paperclip s16" aria-hidden="true"></span>Vybrat soubor
                    </button>
                </span>
                <span class="mockup-page-file-error text-danger" hidden data-mockup-page-editor-target="pageFileError"></span>
            </div>
        </section>

            <div class="d-none">
                {% for imageField in form.images %}
                    {{ form_widget(imageField, {'attr': {
                        'accept': 'image/*',
                        'data-mockup-page-editor-target': 'fileInput',
                        'data-action': 'change->mockup-page-editor#fileChanged',
                    }}) }}
                {% endfor %}
                {% for removeField in form.removeImages %}
                    {{ form_widget(removeField, {'attr': {
                        'data-mockup-page-editor-target': 'removeFlag',
                    }}) }}
                {% endfor %}

                {{ form_widget(form.downloadFile, {'attr': {
                    'data-mockup-page-editor-target': 'pageDownloadInput',
                    'data-action': 'change->mockup-page-editor#downloadChanged',
                }}) }}
                {{ form_widget(form.removeDownloadFile, {'attr': {
                    'data-mockup-page-editor-target': 'pageDownloadRemoveFlag',
                }}) }}
                {% for downloadField in form.imageDownloads %}
                    {{ form_widget(downloadField, {'attr': {
                        'data-mockup-page-editor-target': 'downloadInput',
                        'data-action': 'change->mockup-page-editor#downloadChanged',
                    }}) }}
                {% endfor %}
                {% for removeField in form.removeImageDownloads %}
                    {{ form_widget(removeField, {'attr': {
                        'data-mockup-page-editor-target': 'downloadRemoveFlag',
                    }}) }}
                {% endfor %}
            </div>

        <div class="mockup-editor-savebar man-savebar" data-mockup-page-editor-target="saveBar">
            <span class="cap" data-mockup-page-editor-target="fillSummary"></span>
            <span class="mockup-editor-dirty d-none" data-mockup-page-editor-target="dirtyBadge">
                <span class="mockup-editor-dirty-dot"></span> Neuložené změny
            </span>
            <button class="btn btn-primary sm" type="submit">
                {{ icon('check', 's16') }}{{ submit_label|default('Uložit stránku') }}
            </button>
        </div>
    </div>

{{ form_end(form) }}
