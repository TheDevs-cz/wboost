{% extends 'base.html.twig' %}

{% block title %}Upravit dokument{% endblock %}
{% set active_menu_item = 'templates' %}

{% block breadcrumb %}
    <ol class="breadcrumb m-0 pt-0">
        <li class="breadcrumb-item"><a href="{{ path('template_document', {'documentId': document.id}) }}">{{ document.name }}</a></li>
        <li class="breadcrumb-item active">{{ block('title') }}</li>
    </ol>
{% endblock %}

{% block content %}
    {{ form_start(form, {attr: {class: 'tp-form'}}) }}
    {{ form_errors(form) }}
    <section class="tp-sec">
        <div class="tp-formgrid">
            {{ form_row(form.name) }}
            {{ form_row(form.category) }}
        </div>
        <p class="tp-hint">Formát stránek ({{ document.dimension.label }}) po vytvoření měnit nelze — každá stránka je pro něj navržená.</p>
    </section>
    {{ form_rest(form) }}
    <div class="tp-foot">
        <a href="{{ path('template_document', {'documentId': document.id}) }}" class="btn btn-tertiary sm">Zrušit</a>
        <button class="btn btn-primary sm" type="submit">Uložit</button>
    </div>
    {{ form_end(form) }}
{% endblock %}
