{% extends 'base.html.twig' %}

{% block title %}Nahrát písma{% endblock %}
{% set active_menu_item = 'fonts' %}

{% block breadcrumb %}
    <ol class="breadcrumb m-0 pt-0">
        <li class="breadcrumb-item"><i class="uil-home-alt"></i> <a href="{{ path('projects') }}">Projekty</a></li>
        <li class="breadcrumb-item"><a href="{{ path('project_dashboard', {'id': project.id}) }}">{{ project.name }}</a></li>
        <li class="breadcrumb-item"><a href="{{ path('fonts_list', {'id': project.id}) }}">Fonty</a></li>
        <li class="breadcrumb-item active">{{ block('title') }}</li>
    </ol>
{% endblock %}

{% block content %}
    <div class="card">
        <div class="card-body">
            <p class="text-muted">Vyberte jeden nebo více souborů (TTF, OTF, WOFF). Každý soubor je jeden řez; do rodiny se zařadí podle názvu uvnitř souboru.</p>

            {{ form_start(form) }}
            {{ form_row(form.fonts) }}

            <input type="submit" name="submit" value="Nahrát" class="btn btn-primary">

            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
