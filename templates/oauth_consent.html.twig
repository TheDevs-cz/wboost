{% extends 'base_auth.html.twig' %}

{% block title %}Propojení aplikace{% endblock %}

{#
    Standalone decision screen, laid out like the login page (same centred
    card, no app shell): the user is mid-flow in a connector's browser window
    and the only thing they should be doing here is reading and deciding. The
    app shell's navigation would just be somewhere else to click.
#}
{% block auth_card_class %}wide{% endblock %}

{% block auth_body %}
    <div class="auth-top">
        <span class="ico-c">{{ icon('plug') }}</span>
        <h1>Povolit přístup aplikaci?</h1>
        <p>
            Aplikace <strong class="auth-strong text-break">{{ pending.clientName }}</strong>
            žádá o přístup k vašemu účtu ve WBoostu.
        </p>
    </div>

    {{ include('_flashes.html.twig') }}

    {# The name is chosen by the application itself — under dynamic client
       registration it is the one field an attacker fully controls — so it is
       never presented as an identity on its own. The redirect host is what
       actually receives the access, and it is checked against the client's
       registration by the authorization server. #}
    <div class="alert alert-warning" role="note">
        Název aplikace si určuje aplikace sama.
        {% if pending.redirectHost %}
            Přístup dostane server <strong class="text-break">{{ pending.redirectHost }}</strong>
            — pokud tuto adresu neznáte, přístup nepovolujte.
        {% else %}
            Pokud jste propojení právě sami nespustili, přístup nepovolujte.
        {% endif %}
    </div>

    <div class="auth-account">
        <span class="av">{{ initials(app.user.name ?: app.user.email) }}</span>
        <span class="who">
            <span>Propojujete účet</span>
            <b class="text-break">{{ app.user.email }}{% if app.user.name %} <small>({{ app.user.name }})</small>{% endif %}</b>
        </span>
        <a href="{{ path('logout') }}" class="auth-link">Nejste to vy? Odhlásit se</a>
    </div>

    <div class="auth-sec">
        <h2>Aplikace bude moci:</h2>

        {% if scopes|filter(scope => not scope.known)|length > 0 %}
            <div class="alert alert-danger" role="alert">
                Aplikace žádá i o oprávnění, která tato verze WBoostu nezná (viz níže).
                Nedokážeme popsat, co vám umožní — přístup povolte jen tehdy, pokud aplikaci opravdu důvěřujete.
            </div>
        {% endif %}

        <ul class="auth-scopes">
            {% for scope in scopes %}
                <li class="auth-scope{{ scope.known ? '' : ' unknown' }}">
                    {% if scope.known %}
                        <span class="chk">{{ icon('check') }}</span>
                    {% else %}
                        <span class="chk bad">{{ icon('help') }}</span>
                    {% endif %}
                    <span class="who">
                        <b>{{ scope.title }}</b>
                        <span>{{ scope.description }}</span>
                        {% if scope.impliedBy %}
                            <em>Je součástí oprávnění „{{ scope.impliedBy }}“.</em>
                        {% endif %}
                    </span>
                </li>
            {% endfor %}
        </ul>
    </div>

    <p class="auth-note">
        Oprávnění platí ve všech projektech, ke kterým máte přístup, a nikdy vám neumožní více,
        než na co máte právo sami. Přístup můžete kdykoli odebrat v sekci
        <a href="{{ path('connected_apps') }}">Propojené aplikace</a>.
    </p>

    <form action="{{ path('oauth_consent') }}" method="post" class="auth-actions">
        <input type="hidden" name="_token" value="{{ csrf_token(csrfTokenId) }}">

        <button type="submit" name="deny" value="1" class="btn btn-tertiary">Odmítnout</button>
        <button type="submit" name="approve" value="1" class="btn btn-primary">{{ icon('check', 's16') }}Povolit přístup</button>
    </form>
{% endblock %}
