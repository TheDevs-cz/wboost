{# The rows of the "Historie exportů" dropdown — a partial of its own, owning
   `#export-history-menu-body`, because it is what a pin / rename re-renders
   in place: the Turbo Stream answer to the fill pages' curation POSTs
   (Services/Template/ExportVersionTurboStream) REPLACES this element while
   the dropdown shell around it (`_export_history_menu.html.twig`: Bootstrap's
   toggle + the open menu) stays untouched. Every row: the load link, the
   badges, a pencil that flips the label into the inline rename field
   (`export-version-row` Stimulus controller; Enter / ✓ submit, Escape / ×
   cancel) and the pin toggle.

   Expects the menu's context:
   - history, loaded_version, route_name, route_params, history_url, redirect_url #}
{% import _self as menu %}
<div id="export-history-menu-body">
    {% if history.pinned|length > 0 %}
        <h6 class="dropdown-header"><i class="mdi mdi-pin"></i> Připnuté verze</h6>
        {% for version in history.pinned %}
            {{ menu.row(version, loaded_version, route_name, route_params, redirect_url) }}
        {% endfor %}
    {% endif %}
    {% set recent = history.recent %}
    {% if recent|length > 0 %}
        <h6 class="dropdown-header">Poslední exporty</h6>
        {% for version in recent %}
            {{ menu.row(version, loaded_version, route_name, route_params, redirect_url) }}
        {% endfor %}
    {% endif %}
    <div class="dropdown-divider"></div>
    <a class="dropdown-item" href="{{ history_url }}" title="Celá historie: všechny verze, pojmenování a připnutí">
        <i class="mdi mdi-format-list-bulleted"></i> Zobrazit vše ({{ history.total }})
    </a>
    {% if loaded_version %}
        <a class="dropdown-item" href="{{ path(route_name, route_params) }}">
            <i class="mdi mdi-restore"></i> Zpět na výchozí hodnoty
        </a>
    {% endif %}
</div>

{% macro row(version, loaded_version, route_name, route_params, redirect_url) %}
    {% set active = loaded_version and loaded_version.id.equals(version.id) %}
    {% set tone = active ? 'text-white' : null %}
    <div class="dropdown-item d-flex align-items-center gap-2 py-2 pe-2{{ active ? ' active' }}" data-controller="export-version-row" data-export-version-row="{{ version.id }}">
        <a class="flex-grow-1 text-reset text-decoration-none" style="min-width: 0;"
           href="{{ path(route_name, route_params|merge({'version': version.id})) }}"
           title="Načíst hodnoty této verze do formuláře"
           data-export-version-row-target="view">
            <div class="text-truncate{{ version.name ? ' fw-semibold' }}">
                {{ version.name ?: version.lastExportedAt|date('d.m.Y H:i') }}
            </div>
            <small class="{{ active ? '' : 'text-muted' }}">
                {% if version.name %}{{ version.lastExportedAt|date('d.m.Y H:i') }} · {% endif %}{{ version.exportedBy ? version.exportedBy.displayName : 'Neznámý uživatel' }}
            </small>
        </a>
        {# The inline rename editor — hidden until the pencil; the same
           partial the banner and the history page use, in its row flavour. #}
        <span class="flex-grow-1" style="min-width: 0;" data-export-version-row-target="editor" hidden>
            {{ include('_export_version_rename_form.html.twig', {version: version, redirect_url: redirect_url, turbo: true, row: true}) }}
        </span>
        <span class="text-nowrap" data-export-version-row-target="view">
            {% if version.channel.value != 'web' %}
                <span class="badge bg-secondary-lighten text-secondary">{{ version.channel.label }}</span>
            {% endif %}
            {% if version.exportCount > 1 %}
                <span class="badge bg-secondary-lighten text-secondary" title="Exportováno {{ version.exportCount }}×">{{ version.exportCount }}×</span>
            {% endif %}
        </span>
        <button type="button" class="btn btn-link btn-sm p-0 px-1 lh-1 {{ tone ?? 'text-muted' }}" title="Přejmenovat verzi" aria-label="Přejmenovat verzi"
                data-action="export-version-row#edit" data-export-version-row-target="view pencil">
            <i class="mdi mdi-pencil-outline font-16"></i>
        </button>
        {{ include('_export_version_pin_button.html.twig', {version: version, redirect_url: redirect_url, tone: tone, turbo: true}) }}
    </div>
{% endmacro %}
