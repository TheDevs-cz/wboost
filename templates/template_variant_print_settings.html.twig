{% extends 'base.html.twig' %}

{% block title %}Tiskové nastavení{% endblock %}
{% set active_menu_item = 'templates' %}

{% block title_count %}{{ variant.dimension.label }}{% endblock %}
{% block page_lead %}Spadávka a ořezové značky se projeví v exportu do PDF; obrázek PNG zůstává přesně ve formátu.{% endblock %}

{% block breadcrumb %}
    <ol class="breadcrumb m-0 pt-0">
        <li class="breadcrumb-item"><a href="{{ path('template_variants', {'templateId': template.id}) }}">{{ template.name }}</a></li>
        <li class="breadcrumb-item active">{{ block('title') }}</li>
    </ol>
{% endblock %}

{% block content %}
    {{ form_start(form, {attr: {class: 'tp-form'}}) }}
    {{ form_errors(form) }}
    <section class="tp-sec">
        <div class="tp-sech">
            <h2>{{ icon('file', 's18') }}Formát {{ variant.dimension.label }}</h2>
            <p class="cap">{{ variant.dimension.width }} × {{ variant.dimension.height }} px na plátně</p>
        </div>

        {{ include('_print_settings_fields.html.twig', { bleed_field: form.bleed, crop_marks_field: form.cropMarks }) }}

        <p class="tp-hint">Grafiku, která má sahat až k okraji, protáhněte v editoru přes hranu formátu až k červené čáře spadávky.</p>
    </section>

    {{ form_rest(form) }}

    <div class="tp-foot">
        <a class="btn btn-tertiary sm" href="{{ path('template_variants', {'templateId': template.id}) }}">Zpět</a>
        <button class="btn btn-primary sm" type="submit">Uložit</button>
    </div>
    {{ form_end(form) }}
{% endblock %}
