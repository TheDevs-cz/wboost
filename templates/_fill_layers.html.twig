{#
    Layers panel (Vrstvy) of the fill pages: Photoshop-style list of the
    variant's FILLABLE placeholders, topmost first (canvas stacking order via
    FillTextPlaceholders::layers() — locked texts, decorative images and the
    background are admin-editor-only). Hovering a row highlights its box(es)
    over the preview(s); clicking opens the same popover / modal the box's
    pencil opens. Rows are design-fixed, and the eye buttons carry
    data-hide-toggle so the controller's _reflectHide keeps them in sync with
    the box eyes — the whole aside can live in data-live-ignore (image hide
    state is client-only and must never be morphed away). JS-only chrome:
    hidden without .fill-js.

    Parameters: layers (the rows).
#}
{% if layers|length > 0 %}
    <aside class="fill-layers" data-live-ignore aria-label="Vrstvy šablony">
        <p class="fill-layers__title"><i class="mdi mdi-layers-outline me-1" aria-hidden="true"></i>Vrstvy</p>
        <div class="fill-layers__list" role="list">
            {% for layer in layers %}
                <div
                    class="fill-layer-row"
                    role="listitem"
                    data-action="mouseenter->variant-fill-overlay#highlightLayer mouseleave->variant-fill-overlay#unhighlightLayer"
                    data-variant-fill-overlay-inputid-param="{{ layer.inputId }}"
                >
                    {% if layer.interactive %}
                        <button
                            type="button"
                            class="fill-layer-row__main"
                            title="{{ layer.label }} — kliknutím upravíte"
                            data-action="variant-fill-overlay#{{ layer.kind == 'image' ? 'openImageModal' : 'openPopover' }} focus->variant-fill-overlay#highlightLayer blur->variant-fill-overlay#unhighlightLayer"
                            data-variant-fill-overlay-inputid-param="{{ layer.inputId }}"
                        >
                            <i class="fill-layer-row__icon mdi {{ layer.icon }}" aria-hidden="true"></i>
                            <span class="fill-layer-row__label">{{ layer.label }}</span>
                        </button>
                    {% else %}
                        <span class="fill-layer-row__main" title="{{ layer.label }}">
                            <i class="fill-layer-row__icon mdi {{ layer.icon }}" aria-hidden="true"></i>
                            <span class="fill-layer-row__label">{{ layer.label }}</span>
                        </span>
                    {% endif %}
                    {% if layer.hidable %}
                        <button
                            type="button"
                            class="fill-layer-row__eye{{ layer.hidden ? ' is-active' : '' }}"
                            data-hide-toggle="{{ layer.inputId }}"
                            aria-pressed="{{ layer.hidden ? 'true' : 'false' }}"
                            title="{{ layer.hidden ? 'Zobrazit prvek' : 'Schovat prvek' }}"
                            aria-label="{{ layer.hidden ? 'Zobrazit prvek' : 'Schovat prvek' }}"
                            data-action="variant-fill-overlay#toggleHide"
                            data-variant-fill-overlay-inputid-param="{{ layer.inputId }}"
                        ><i class="mdi {{ layer.hidden ? 'mdi-eye-off-outline' : 'mdi-eye-outline' }}" aria-hidden="true"></i></button>
                    {% endif %}
                </div>
            {% endfor %}
        </div>
    </aside>
{% endif %}
