{# Add / edit a manual font (ManualFontsFormType: font, type, color) as one
   settings box. Expects `form`, `manual`, `submit_label`. #}
{{ form_start(form, {'attr': {'class': 'man-sec man-formbox'}}) }}
    {{ form_errors(form) }}
    <div class="man-formgrid">
        {{ form_row(form.font) }}
        {{ form_row(form.type) }}
    </div>
    {{ form_row(form.color, {'help': 'HEX bez mřížky, např. 1D2A5C. Prázdné = výchozí barva textu.', 'attr': {'placeholder': 'např. 1D2A5C'}}) }}
    {{ form_rest(form) }}
    <div class="man-formfoot">
        <a href="{{ path('fonts_list', {'id': manual.project.id}) }}#manual-fonts-{{ manual.id }}" class="btn btn-tertiary sm">Zrušit</a>
        <button class="btn btn-primary sm" type="submit">{{ submit_label }}</button>
    </div>
{{ form_end(form) }}
