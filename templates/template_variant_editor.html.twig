{#
    Admin canvas editor for template variants (Šablony module). The rendering
    controller supplies:

      menu_item             active left-nav key ('templates')
      module_label          breadcrumb label ('Šablony')
      module_templates_url  URL of the module's template list
      module_variants_url   URL of the template's variant list
      edit_variant_url      POST target for background changes
      export_url            the user-fill page URL
      dimension_label       human label of the variant's dimension

    plus the editor data itself: project, template, variant, fonts, editor_form,
    font_faces, gallery_directories. The variant only needs `canvas`,
    `backgroundImage` and `dimension.width/height` (pixels).

    The stage / left panel / fonts / scripts / modals markup is shared with the
    template-group editor via the templates/editor/_editor_*.html.twig partials.
#}
{% extends 'base.html.twig' %}

{% set active_menu_item = menu_item %}

{% block title %}Editor - Varianta {{ dimension_label }}{% endblock %}

{# Full-height editor (Nocturne `.ed`): no page header — the editor's own top
   bar carries the eyebrow + name, and every pixel above the stage is canvas
   height the designer loses. The breadcrumb block is emptied for the same
   reason; the trail lives in the top bar's eyebrow (`.breadcrumb.ed-crumb`). #}
{% block page_title_row %}{% endblock %}
{% block breadcrumb %}{% endblock %}
{% block inner_class %}inner-wide ed-inner{% endblock %}

{% block content %}
    {{ include('editor/_editor_scripts.html.twig') }}
    {{ include('editor/_editor_fonts.html.twig') }}

    <div
        id="canvas-container"
        class="editor-shell ed"
        data-controller="editor-chrome canvas-editor canvas-history canvas-clipboard canvas-zoom canvas-text-toolbar canvas-input-properties canvas-image-properties canvas-shape-properties canvas-opacity canvas-alignment canvas-floating-toolbar canvas-container canvas-layers canvas-snapping canvas-rulers canvas-navigator"
        {# Canvas-mode only: layer-mode backgrounds live inside the canvas JSON
           as an isBackground object — a canvas-level override would shadow them. #}
        data-canvas-editor-background-image-value="{{ variant.backgroundMode.value == 'canvas' and variant.backgroundImage ? uploaded_asset(variant.backgroundImage) }}"
        data-canvas-editor-background-mode-value="{{ variant.backgroundMode.value }}"
        data-canvas-editor-custom-fonts-value='{{ font_faces|json_encode }}'
        data-canvas-editor-font-options-value='{{ (rich_toolbar ? rich_toolbar.fonts : [])|json_encode }}'
        data-canvas-editor-default-font-family-value="{{ font_defaults.defaultFamily ?? '' }}"
        data-canvas-text-toolbar-default-font-family-value="{{ font_defaults.defaultFamily ?? '' }}"
        data-canvas-input-properties-manual-faces-value='{{ font_defaults.manualFaces|json_encode }}'
        {# Brand palette for freshly added shapes (same list the text popover and the fill WYSIWYG offer). #}
        data-canvas-editor-brand-colors-value='{{ (brand_colors|default([]))|json_encode }}'
        data-canvas-editor-canvas-json="{{ variant.canvas }}"
        data-canvas-editor-bleed-value="{{ variant.dimension.bleedPixels }}"
        data-canvas-editor-edit-variant-url-value="{{ edit_variant_url }}"
        data-canvas-history-canvas-editor-outlet="#canvas-container"
        data-canvas-clipboard-canvas-editor-outlet="#canvas-container"
        data-canvas-text-toolbar-canvas-editor-outlet="#canvas-container"
        data-canvas-input-properties-canvas-editor-outlet="#canvas-container"
        data-canvas-input-properties-font-faces-value='{{ (rich_toolbar ? rich_toolbar.fonts : [])|json_encode }}'
        data-canvas-image-properties-canvas-editor-outlet="#canvas-container"
        data-canvas-shape-properties-canvas-editor-outlet="#canvas-container"
        data-canvas-opacity-canvas-editor-outlet="#canvas-container"
        data-canvas-alignment-canvas-editor-outlet="#canvas-container"
        data-canvas-floating-toolbar-canvas-editor-outlet="#canvas-container"
        data-canvas-container-canvas-editor-outlet="#canvas-container"
        data-canvas-layers-canvas-editor-outlet="#canvas-container"
        data-canvas-layers-canvas-floating-toolbar-outlet="#canvas-container"
        data-canvas-layers-canvas-input-properties-outlet="#canvas-container"
        data-canvas-layers-canvas-image-properties-outlet="#canvas-container"
        data-canvas-layers-canvas-shape-properties-outlet="#canvas-container"
        data-canvas-snapping-canvas-editor-outlet="#canvas-container"
        data-canvas-rulers-canvas-editor-outlet="#canvas-container"
        data-canvas-navigator-canvas-editor-outlet="#canvas-container"
        data-action="
            canvas-editor:selection:changed->canvas-clipboard#onSelectionChanged
            canvas-editor:selection:changed->canvas-text-toolbar#updateFromSelection
            canvas-editor:selection:changed->canvas-input-properties#updateFromSelection
            canvas-editor:selection:changed->canvas-image-properties#updateFromSelection
            canvas-editor:selection:changed->canvas-shape-properties#updateFromSelection
            canvas-editor:selection:changed->canvas-opacity#updateFromSelection
            canvas-editor:selection:changed->canvas-alignment#onSelectionChanged
            canvas-editor:selection:changed->canvas-floating-toolbar#onSelectionChanged
            canvas-editor:selection:changed->canvas-container#onSelectionChanged
            canvas-editor:selection:changed->canvas-layers#onSelectionChanged
            canvas-editor:canvas:loaded->canvas-container#onCanvasLoaded
            canvas-editor:canvas:loaded->canvas-history#onCanvasLoaded
            canvas-editor:canvas:loaded->canvas-layers#onCanvasLoaded
            canvas-editor:dirty->canvas-layers#onCanvasDirty
            canvas-zoom:changed->canvas-layers#unhover
            canvas-zoom:changed->canvas-floating-toolbar#reposition
            canvas-zoom:changed->canvas-container#repositionZones
            canvas-zoom:changed->canvas-rulers#refresh
            canvas-zoom:changed->canvas-navigator#refresh
            canvas-editor:canvas:loaded->canvas-navigator#refresh
            canvas-editor:canvas:loaded->canvas-rulers#onCanvasLoaded
            canvas-editor:canvas:loaded->canvas-zoom#fitToScreen
            canvas-editor:copy->canvas-clipboard#copy
            canvas-editor:paste->canvas-clipboard#paste
            asset-selected@window->canvas-editor#onAssetSelected
        "
    >
        {{ form_start(editor_form) }}

        {# Editor chrome (prototype renderTpEd): top bar, format tabs, tool row.
           `data-editor-header` wraps all three — the floating toolbar keeps its
           chrome below it and the stacked (< lg) zoom fit subtracts its height. #}
        <div class="ed-head" data-editor-header>
            <header class="ed-top">
                {% set back_url = document_page ? path('template_document', {'documentId': document_page.document.id, 'page': template.id}) : module_templates_url %}
                <a href="{{ back_url }}" class="btn btn-tertiary icon sm ed-back" data-action="editor-chrome#navigate"
                   title="{{ document_page ? 'Zpět do dokumentu' : 'Zpět na šablony' }}" aria-label="{{ document_page ? 'Zpět do dokumentu' : 'Zpět na šablony' }}">{{ icon('arrow-left', 's16') }}</a>
                <div class="ed-title">
                    <nav class="breadcrumb ed-crumb" aria-label="Drobečková navigace">
                        <a href="{{ path('project_dashboard', {'id': project.id}) }}" data-action="editor-chrome#navigate">{{ project.name }}</a>
                        <span aria-hidden="true">·</span>
                        <a href="{{ module_templates_url }}" data-action="editor-chrome#navigate">{{ module_label }}</a>
                        {% if document_page %}
                            <span aria-hidden="true">·</span>
                            <a href="{{ path('template_document', {'documentId': document_page.document.id, 'page': template.id}) }}" data-action="editor-chrome#navigate">{{ document_page.document.name }}</a>
                            <span aria-hidden="true">·</span>
                            <span>Strana {{ document_page.position + 1 }}</span>
                        {% endif %}
                    </nav>
                    <h1 class="ed-name" title="{{ template.name }}">{{ template.name }}</h1>
                </div>
                {% if variant.group and is_granted('ROLE_DESIGNER') %}
                    <a href="{{ path('template_group_editor', {'groupId': variant.group.id}) }}" class="pill ed-sync" title="Tato varianta vznikla ve skupině — otevřít skupinový editor">{{ icon('refresh', 's14') }}Skupina: {{ variant.group.name }}</a>
                {% endif %}
                <div class="ed-hist">
                    {# "Pozadí" lives in the tool row with the other compose actions. #}
                    <button class="btn btn-ghost icon xs disabled" type="button" title="Zpět (Ctrl+Z)" aria-label="Zpět (Ctrl+Z)" data-canvas-history-target="undoButton" data-action="canvas-history#undo">{{ icon('undo', 's16') }}</button>
                    <button class="btn btn-ghost icon xs disabled" type="button" title="Znovu (Ctrl+Shift+Z)" aria-label="Znovu (Ctrl+Shift+Z)" data-canvas-history-target="redoButton" data-action="canvas-history#redo">{{ icon('redo', 's16') }}</button>
                    <button class="btn icon xs ed-clean" type="button" aria-pressed="false" title="Čistý náhled — skrýt pomocné prvky" aria-label="Čistý náhled — skrýt pomocné prvky" data-editor-chrome-target="cleanButton" data-action="editor-chrome#toggleClean">{{ icon('eye', 's16') }}</button>
                </div>

                <span class="ed-sp"></span>

                {# Save state: the badge is canvas-editor's (markUnsaved/markSaved
                   toggle d-none); "Vše uloženo" shows whenever it is hidden (CSS :has). #}
                <span class="ed-state ed-state--saved">{{ icon('check-circle', 's14') }}<span class="ed-lbl">Vše uloženo</span></span>
                <p data-canvas-editor-target="unsavedChangesMessage" class="ed-state ed-state--dirty d-none">{{ icon('history', 's14') }}<span class="ed-lbl">Neuložené změny</span></p>

                {{ include('editor/_editor_toggles.html.twig') }}

                <a href="{{ export_url }}" class="btn btn-tertiary sm ed-fill" data-action="canvas-editor#confirmExport" title="Vyplnit a exportovat">{{ icon('download', 's16') }}<span class="ed-lbl">Vyplnit a exportovat</span></a>

                <button class="btn btn-success sm ed-save" type="button" data-action="canvas-editor#submitForm">Uložit</button>
            </header>

            <div class="ed-vars" role="tablist" aria-label="Formáty šablony">
                {% if document_page %}
                    {# Multi-page document page strip: back to the document,
                       jump to a sibling page. Leaving with unsaved changes
                       asks first (document-page-strip). #}
                    <span class="document-page-strip ed-pages" data-controller="document-page-strip">
                        <a href="{{ path('template_document', {'documentId': document_page.document.id, 'page': template.id}) }}" class="ed-var ed-var--back" data-action="document-page-strip#navigate" title="Zpět do dokumentu">{{ icon('arrow-left', 's14') }}{{ document_page.document.name }}</a>
                        {% for sibling in document_pages %}
                            {% if sibling.id == document_page.id %}
                                <span class="ed-var on" role="tab" aria-selected="true" title="{{ sibling.template.name }}"><b>{{ loop.index }}</b><span class="cap">{{ sibling.template.name }}</span></span>
                            {% else %}
                                <a href="{{ path('template_variant_editor', {'variantId': sibling.variant.id, 'document': document_page.document.id}) }}" class="ed-var" role="tab" aria-selected="false" data-action="document-page-strip#navigate" title="{{ sibling.template.name }}"><b>{{ loop.index }}</b></a>
                            {% endif %}
                        {% endfor %}
                    </span>
                    <span class="ed-var-meta cap">{{ variant.dimension.label }} · {{ variant.dimension.width }} × {{ variant.dimension.height }} px</span>
                {% else %}
                    {# Formats of this template = its variants (each one has its own
                       editor; a tab is a link, guarded against unsaved work). #}
                    {% for sibling in template.variants|filter(v => v.group is null) %}
                        {% if sibling.id == variant.id %}
                            <span class="ed-var on" role="tab" aria-selected="true"><b>{{ sibling.dimension.label }}</b><span class="cap">{{ sibling.dimension.width }} × {{ sibling.dimension.height }}</span></span>
                        {% else %}
                            <a href="{{ path('template_variant_editor', {'variantId': sibling.id}) }}" class="ed-var" role="tab" aria-selected="false" data-action="editor-chrome#navigate"><b>{{ sibling.dimension.label }}</b><span class="cap">{{ sibling.dimension.width }} × {{ sibling.dimension.height }}</span></a>
                        {% endif %}
                    {% endfor %}
                    {% if is_granted('template_edit', template) %}
                        <a href="{{ path('add_template_variant', {'templateId': template.id}) }}" class="ed-var add" data-action="editor-chrome#navigate">{{ icon('plus', 's14') }}Přidat rozměr</a>
                    {% endif %}
                {% endif %}
            </div>

            {{ include('editor/_editor_tools.html.twig') }}
        </div>

        <div class="row editor-shell-row ed-body">
            <div class="col-12 col-lg-2 editor-left-panel">
                {{ include('editor/_editor_left_panel.html.twig') }}
            </div>

            <div class="col-12 col-lg-10 editor-stage-col">
                {{ include('editor/_editor_stage.html.twig', {
                    'canvas_width': variant.dimension.width,
                    'canvas_height': variant.dimension.height,
                    'canvas_bleed': variant.dimension.bleedPixels,
                }) }}

                {{ form_widget(editor_form.canvas, { attr: { 'data-canvas-editor-target': 'canvas' } }) }}
                {{ form_widget(editor_form.textInputs, { attr: { 'data-canvas-editor-target': 'textInputs' } }) }}
                {{ form_widget(editor_form.imageInputs, { attr: { 'data-canvas-editor-target': 'imageInputs' } }) }}
                {{ form_widget(editor_form.imagePreview, { attr: { 'data-canvas-editor-target': 'previewImage' } }) }}
            </div>
        </div>

        {{ form_end(editor_form) }}

        {{ include('editor/_editor_modals.html.twig') }}

        {# Shown when Export is clicked with unsaved canvas changes. The export
           renders from the last saved variant, so we let the user save first. #}
        <div class="modal fade" id="exportUnsavedModal" tabindex="-1" aria-labelledby="exportUnsavedModalLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="exportUnsavedModalLabel">Neuložené změny</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <p class="mb-0">Máte neuložené změny. Export se vytvoří z naposledy uložené verze, takže vaše poslední úpravy se v něm neprojeví. Chcete změny nejdříve uložit?</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Zrušit</button>
                        <button type="button" class="btn btn-outline-danger" data-action="canvas-editor#exportWithoutSaving">Pokračovat bez uložení</button>
                        <button type="button" class="btn btn-primary" data-action="canvas-editor#saveAndExport">Uložit a exportovat</button>
                    </div>
                </div>
            </div>
        </div>

    </div>
{% endblock %}
