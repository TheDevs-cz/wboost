{# Multi-file font dropzone (font-uploader controller). Expects `project`;
   optional `compact` (bool) for a slimmer strip and `hint` text. One request
   per file to `upload_font`; the page reloads once a batch added a face.
   Nocturne `.gal-drop` look; the controller toggles `gallery-dropzone--over`. #}
<div
    class="fn-uploader"
    data-controller="font-uploader"
    data-font-uploader-url-value="{{ path('upload_font', {'id': project.id}) }}"
>
    <input type="hidden" name="upload_font_form[_token]" value="{{ csrf_token('upload_font') }}">

    <div
        class="gal-drop{% if compact|default(false) %} gal-drop-compact{% endif %}"
        id="{{ dropzone_id|default('font-dropzone') }}"
        data-font-uploader-target="dropzone"
        data-action="
            click->font-uploader#browse
            keydown->font-uploader#keydown
            dragover->font-uploader#dragOver
            dragleave->font-uploader#dragLeave
            drop->font-uploader#drop
        "
        role="button"
        tabindex="0"
        aria-label="Nahrát soubory písem"
    >
        {{ icon('font') }}
        <span><b>Přetáhněte soubory písem sem</b> nebo <u>vyberte z počítače</u></span>
        <span class="cap">{{ hint|default('TTF, OTF nebo WOFF · víc souborů najednou · max. 10 MB na soubor · řezy se zařadí do rodiny podle názvu uvnitř souboru · variabilní písmo se rozloží na jednotlivé řezy') }}</span>
    </div>

    <input
        type="file"
        name="upload_font_form[file]"
        class="d-none"
        accept=".ttf,.otf,.woff,font/ttf,font/otf,font/woff"
        multiple
        data-font-uploader-target="input"
        data-action="change->font-uploader#filesChosen"
    >

    <div class="fn-ups" data-font-uploader-target="queue"></div>
</div>
