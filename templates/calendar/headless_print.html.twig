<!doctype html>
<html lang="cs">
<head>
    <meta charset="utf-8">
    <title>{{ title }}</title>
    {# Pages of a calendar PRINTED to a PDF by Gotenberg's Chromium
       (Services/Calendar/CalendarPdfRenderer): one .sheet per page, exactly the
       size of the PDF page, so the page SVG stays vector — text as text with the
       project fonts embedded, shapes as paths, pictures at their own pixels.
       Self-contained like headless_render.html.twig. #}
    <style>
        {# Chromium rounds a PDF page to whole points; the page is the next whole
           point up and the exact sheet sits in its top-left corner (CalendarPdfPlan). #}
        @page { size: {{ page_width }}pt {{ page_height }}pt; margin: 0; }
        html, body { margin: 0; padding: 0; background: #FFFFFF; }
        .sheet { width: {{ sheet_width }}mm; height: {{ sheet_height }}mm; overflow: hidden; break-after: page; break-inside: avoid; }
        .sheet:last-child { break-after: auto; }
        .sheet svg { display: block; width: 100%; height: 100%; }
    </style>
    <script type="importmap">{{ import_map|raw }}</script>
    <script type="application/json" id="boot">{{ boot|raw }}</script>
    <script type="application/json" id="fonts">{{ font_faces|raw }}</script>
</head>
<body>
    <div id="pages"></div>
    <script type="module">
        import { renderHeadlessSheets } from 'wbcal/headless/render.js';

        const boot = JSON.parse(document.getElementById('boot').textContent);
        // FontFace objects before anything is measured — see headless_render.html.twig
        const fontFaces = JSON.parse(document.getElementById('fonts').textContent);
        await Promise.all(fontFaces.map(async (face) => {
            try {
                const fontFace = new FontFace(face.family, 'url("' + face.src + '")');
                await fontFace.load();
                document.fonts.add(fontFace);
            } catch (fontError) {
                console.warn('Font load failed: ' + face.family, fontError);
            }
        }));
        // An uncaught rejection is what tells Gotenberg (failOnConsoleExceptions) the render failed.
        await renderHeadlessSheets(boot, document.getElementById('pages'));
        await new Promise((resolve) => setTimeout(resolve, 50));
        window.calendarRendered = true;
    </script>
</body>
</html>
