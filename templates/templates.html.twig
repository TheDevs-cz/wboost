{% extends 'base.html.twig' %}

{% set active_menu_item = 'templates' %}

{% block title %}Šablony{% endblock %}

{% block breadcrumb %}
    <ol class="breadcrumb m-0 pt-0">
        <li class="breadcrumb-item"><i class="uil-home-alt"></i> <a href="{{ path('projects') }}">Projekty</a></li>
        <li class="breadcrumb-item"><a href="{{ path('project_dashboard', {'id': project.id}) }}">{{ project.name }}</a></li>
        <li class="breadcrumb-item active">{{ block('title') }}</li>
    </ol>
{% endblock %}

{% block content %}

    {# "Can add a template here" — TemplateVoter::ADD only supports Template
       instances, so the project-level equivalent is the gate AddTemplateController
       itself enforces: project_edit. Group creation stays a designer tool. #}
    {% if is_granted('project_edit', project) %}
        <div class="row mb-2">
            <div class="col-sm-12">
                <a href="{{ path('add_template', {'id': project.id}) }}" class="btn btn-outline-primary rounded-pill mb-3"><i class="mdi mdi-plus"></i> Nová šablona</a>

                {% if is_granted('ROLE_DESIGNER') %}
                    <a href="{{ path('add_template_group', {'projectId': project.id}) }}" class="ms-2 btn btn-sm btn-outline-secondary rounded-pill mb-3"><i class="uil-layer-group"></i> Nová synchronizovaná šablona</a>

                    <a href="{{ path('template_group_from_template', {'projectId': project.id}) }}" class="ms-2 btn btn-sm btn-outline-secondary rounded-pill mb-3"><i class="mdi mdi-content-copy"></i> Vytvořit z existující</a>
                {% endif %}

                {% if template_documents_enabled() and is_granted('ROLE_DESIGNER') %}
                    <a href="{{ path('add_template_document', {'projectId': project.id}) }}" class="ms-2 btn btn-sm btn-outline-secondary rounded-pill mb-3"><i class="mdi mdi-book-open-page-variant-outline"></i> Nový dokument</a>
                {% endif %}

                <a href="{{ path('template_categories', {'projectId': project.id}) }}" class="ms-2 btn btn-sm btn-outline-secondary rounded-pill mb-3"><i class="ri-list-view"></i> Kategorie</a>

                <a href="{{ path('project_gallery', {'projectId': project.id}) }}" class="ms-2 btn btn-sm btn-outline-secondary rounded-pill mb-3"><i class="mdi mdi-image-multiple"></i> Galerie</a>
            </div>
        </div>
    {% endif %}

    {% if categories|length == 0 and uncategorized|length == 0 %}
        <div class="card">
            <div class="card-body text-center text-muted py-5">
                <i class="uil-postcard" style="font-size: 2rem;"></i>
                <p class="mb-1 mt-2"><strong>Zatím tu nejsou žádné šablony.</strong></p>
                <p class="mb-0">Šablona je grafika, kterou pak kdokoli z projektu jen vyplní vlastními texty a obrázky a stáhne hotový export.</p>
                {% if is_granted('project_edit', project) %}
                    <a href="{{ path('add_template', {'id': project.id}) }}" class="btn btn-outline-primary rounded-pill mt-3"><i class="mdi mdi-plus"></i> Nová šablona</a>
                {% endif %}
            </div>
        </div>
    {% endif %}

    {# One sortable row per category: templates and multi-page documents share
       the sort space (SortTemplatesHandler resolves either kind of id). #}
    {% for entry in categories %}
        <h3>{{ entry.category.name }}</h3>

        <div class="row"
             data-controller="dragula"
             data-dragula-sort-url-value="{{ path('sort_templates', {'projectId': project.id}) }}"
             data-dragula-direction-value="horizontal"
             data-dragula-target="container"
        >
            {% for item in entry.items %}
                {% if item.document %}
                    {{ include('_document.html.twig', { document: item.document }) }}
                {% else %}
                    {{ include('_template.html.twig', { template: item.template }) }}
                {% endif %}
            {% endfor %}
        </div>
    {% endfor %}

    {% if categories|length > 0 and uncategorized|length > 0 %}
        <h3>Nezařazené</h3>
    {% endif %}

    <div class="row"
         data-controller="dragula"
         data-dragula-sort-url-value="{{ path('sort_templates', {'projectId': project.id}) }}"
         data-dragula-direction-value="horizontal"
         data-dragula-target="container"
    >
        {% for item in uncategorized %}
            {% if item.document %}
                {{ include('_document.html.twig', { document: item.document }) }}
            {% else %}
                {{ include('_template.html.twig', { template: item.template }) }}
            {% endif %}
        {% endfor %}
    </div>
{% endblock %}
