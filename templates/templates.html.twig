{% extends 'base.html.twig' %}

{% set active_menu_item = 'templates' %}

{# "Can add a template here" — TemplateVoter::ADD only supports Template
   instances, so the project-level equivalent is the gate AddTemplateController
   itself enforces: project_edit. Groups + documents stay designer tools. #}
{% set can_create = is_granted('project_edit', project) %}
{% set total = categories|reduce((sum, entry) => sum + entry.items|length, uncategorized|length) %}
{% set group_count = categories|length + (uncategorized is not empty ? 1 : 0) %}

{% block title %}Šablony{% endblock %}
{% block title_count %}{{ total }}{% endblock %}

{% block page_lead %}
    {% if can_create %}
        Šablony příspěvků, tiskovin a grafik. Kategorie sbalíte klikem na název, šablony v kategorii přeskládáte přetažením za úchyt.
    {% else %}
        Vyberte šablonu, doplňte texty a obrázky a exportujte.
    {% endif %}
{% endblock %}

{% block breadcrumb %}
    <ol class="breadcrumb m-0 pt-0">
        <li class="breadcrumb-item"><a href="{{ path('project_dashboard', {'id': project.id}) }}">{{ project.name }}</a></li>
        <li class="breadcrumb-item active">{{ block('title') }}</li>
    </ol>
{% endblock %}

{% block mobile_primary_action %}
    {% if can_create %}
        <button type="button" class="btn btn-primary icon" data-bs-toggle="modal" data-bs-target="#templateNewModal" aria-label="Nová šablona">{{ icon('plus') }}</button>
    {% endif %}
{% endblock %}

{% block content %}
    {# Collapse state, search and card size are client-side view tools
       (templates_list_controller, remembered per browser). Sorting stays the
       shared Sortable `dragula` controller, one per category grid — templates
       and multi-page documents share the sort space (SortTemplatesHandler
       resolves either kind of id). #}
    <div class="tp-page"
         data-controller="templates-list"
         data-templates-list-project-value="{{ project.id }}">

        {% if total > 0 or can_create %}
            <div class="gal-nav tp-nav">
                {% if can_create %}
                    <button type="button" class="btn btn-primary sm" data-bs-toggle="modal" data-bs-target="#templateNewModal" aria-haspopup="dialog">{{ icon('plus', 's16') }}Nová šablona</button>
                    <a href="{{ path('template_categories', {'projectId': project.id}) }}" class="btn btn-tertiary sm">{{ icon('folder', 's16') }}Kategorie</a>
                {% endif %}
                <span class="gal-nav-sp" aria-hidden="true"></span>
                {% if total > 0 %}
                    {% if group_count > 1 %}
                        <button type="button" class="btn btn-ghost sm" data-templates-list-target="all" data-action="templates-list#toggleAll">{{ icon('chev-up', 's16') }}<span>Sbalit vše</span></button>
                    {% endif %}
                    <label class="sz-ctl" title="Velikost náhledů">
                        {{ icon('image', 's12') }}
                        <input type="range" min="0" max="100" step="1" value="35" aria-label="Velikost náhledů" data-templates-list-target="size" data-action="input->templates-list#resize">
                        {{ icon('image', 's18') }}
                    </label>
                    <label class="inp sm tp-search">
                        {{ icon('search', 's16') }}
                        <input type="search" placeholder="Hledat šablonu" aria-label="Hledat šablonu" autocomplete="off" data-templates-list-target="search" data-action="input->templates-list#search">
                    </label>
                {% endif %}
            </div>
        {% endif %}

        {% if total == 0 %}
            <div class="empty">
                <span class="ico-c">{{ icon('template') }}</span>
                <h2>Zatím tu nejsou žádné šablony</h2>
                <p>Šablona je grafika, kterou pak kdokoli z projektu jen vyplní vlastními texty a obrázky a stáhne hotový export.</p>
                {% if can_create %}
                    <a href="{{ path('add_template', {'id': project.id}) }}" class="btn btn-primary sm">{{ icon('plus', 's16') }}Nová šablona</a>
                {% endif %}
            </div>
        {% else %}
            {% if top is not empty %}
                <section class="tp-top" data-templates-list-target="group" data-key="top" data-top aria-labelledby="tpc-top">
                    <div class="tp-gh">
                        <button type="button" class="tp-tg" data-action="templates-list#toggle" aria-expanded="true" aria-controls="tpb-top">
                            <span class="tp-top-ico" aria-hidden="true">{{ icon('star-f', 's16') }}</span>
                            <h2 id="tpc-top" title="Systém sem sám řadí šablony s nejvíce exporty za posledních 30 dní">Nejpoužívanější</h2>
                            <span class="tp-chev" aria-hidden="true">{{ icon('chev-down', 's16') }}</span>
                        </button>
                    </div>
                    <div class="tp-body" id="tpb-top">
                        <ul class="tp-grid">
                            {% for entry in top %}
                                {% if entry.item.document %}
                                    {{ include('_document.html.twig', { document: entry.item.document, is_top: true, uses: entry.uses }) }}
                                {% else %}
                                    {{ include('_template.html.twig', { template: entry.item.template, is_top: true, uses: entry.uses }) }}
                                {% endif %}
                            {% endfor %}
                        </ul>
                    </div>
                </section>
            {% endif %}

            <div class="tp-groups">
                {% set groups = [] %}
                {% for entry in categories %}
                    {% set groups = groups|merge([{key: entry.category.id.toString, name: entry.category.name, items: entry.items}]) %}
                {% endfor %}
                {% if uncategorized is not empty %}
                    {% set groups = groups|merge([{key: 'none', name: categories is empty ? 'Šablony' : 'Nezařazené', items: uncategorized}]) %}
                {% endif %}

                {% for group in groups %}
                    <section class="tp-group" data-templates-list-target="group" data-key="{{ group.key }}" aria-labelledby="tpc-{{ group.key }}">
                        <div class="tp-gh">
                            <button type="button" class="tp-tg" data-action="templates-list#toggle" aria-expanded="true" aria-controls="tpb-{{ group.key }}">
                                <h2 id="tpc-{{ group.key }}">{{ group.name }}</h2>
                                <span class="pd-n" data-count>{{ group.items|length }}</span>
                                <span class="tp-chev" aria-hidden="true">{{ icon('chev-down', 's16') }}</span>
                            </button>
                        </div>
                        <div class="tp-body" id="tpb-{{ group.key }}">
                            <ul class="tp-grid"
                                data-controller="dragula"
                                data-dragula-sort-url-value="{{ path('sort_templates', {'projectId': project.id}) }}"
                                data-dragula-direction-value="horizontal"
                                data-dragula-target="container">
                                {% for item in group.items %}
                                    {% if item.document %}
                                        {{ include('_document.html.twig', { document: item.document, is_top: false }) }}
                                    {% else %}
                                        {{ include('_template.html.twig', { template: item.template, is_top: false }) }}
                                    {% endif %}
                                {% endfor %}
                            </ul>
                        </div>
                    </section>
                {% endfor %}
            </div>

            <div class="empty" data-templates-list-target="none" hidden>
                <span class="ico-c">{{ icon('search') }}</span>
                <h2>Nic jsme nenašli</h2>
                <p>Zkuste jiný název šablony.</p>
            </div>
        {% endif %}
    </div>

    {% if can_create %}
        {{ include('_template_new_dialog.html.twig') }}
    {% endif %}
{% endblock %}
