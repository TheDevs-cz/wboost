{#
    Shown when an export cannot be rendered because of what the user filled in
    (an unsupported image, a value the renderer refuses) — i.e. a 400, not a
    crash. The generic error page would say "Něco se pokazilo" and offer a link
    to the dashboard, which throws the whole filled-in form away; the message
    plus a Back button keeps the reason visible AND the form values restorable
    (the browser re-populates the previous page from history).
#}
{% extends 'base.html.twig' %}

{% set active_menu_item = 'templates' %}

{% block title %}Export se nezdařil{% endblock %}

{# The headline lives in the card — no page header. #}
{% block page_title_row %}{% endblock %}

{% block content %}
    <div class="empty tp-failed c-danger">
        <span class="ico-c">{{ icon('alert') }}</span>
        <h2>Export se nezdařil</h2>
        <p>Zkontrolujte vyplněné hodnoty a zkuste to znovu.</p>
        <p class="tp-failed-reason">{{ reason }}</p>
        <div class="tp-failed-acts">
            <button type="button" class="btn btn-primary sm" onclick="history.back()">{{ icon('arrow-left', 's16') }}Zpět k vyplnění</button>
            <a href="{{ back_url }}" class="btn btn-tertiary sm">Začít znovu</a>
        </div>
    </div>
{% endblock %}
