{% extends 'base.html.twig' %}

{% block title %}Nový dokument{% endblock %}
{% set active_menu_item = 'templates' %}

{% block page_lead %}Vícestránkový dokument spojí několik šablon do jednoho souboru — vyplníte je na jedné stránce a stáhnete jako jedno PDF (pro tisk i k odeslání) nebo ZIP obrázků.{% endblock %}

{% block breadcrumb %}
    <ol class="breadcrumb m-0 pt-0">
        <li class="breadcrumb-item"><a href="{{ path('templates', {'projectId': project.id}) }}">Šablony</a></li>
        <li class="breadcrumb-item active">{{ block('title') }}</li>
    </ol>
{% endblock %}

{% block content %}
    {{ form_start(form, {attr: {class: 'tp-form'}}) }}
    {{ form_errors(form) }}

    <section class="tp-sec">
        <div class="tp-sech"><h2>{{ icon('book', 's18') }}Dokument</h2></div>
        <div class="tp-formgrid">
            {{ form_row(form.name) }}
            {{ form_row(form.category) }}
        </div>
    </section>

    <section class="tp-sec" data-controller="template-dimension">
        <div class="tp-sech">
            <h2>{{ icon('grid', 's18') }}Formát stránek</h2>
            <p class="cap">Všechny stránky dokumentu mají stejný formát. Připojit lze šablony, které mají variantu v tomto formátu.</p>
        </div>

        {{ include('_template_dimension_fields.html.twig', {
            preset: form.dimension.preset,
            unit: form.dimension.unit,
            width: form.dimension.width,
            height: form.dimension.height,
            print_first: true,
            social_label: 'Sociální sítě (karusel)',
        }) }}

        {{ include('_print_settings_fields.html.twig', { bleed_field: form.dimension.bleed, crop_marks_field: form.dimension.cropMarks }) }}
    </section>

    {{ form_rest(form) }}

    <div class="tp-foot">
        <a href="{{ path('templates', {'projectId': project.id}) }}" class="btn btn-tertiary sm">Zrušit</a>
        <button class="btn btn-primary sm" type="submit">Vytvořit a připojit stránky</button>
    </div>

    {{ form_end(form) }}
{% endblock %}
