{# "Nová šablona" — one type picker over the existing create routes
   (prototype #dlgTpNew / TP_TYPES): blank template (add_template,
   project_edit), synchronized template (add_template_group — designers; plus
   "z existující šablony" → template_group_from_template), multi-page
   document (add_template_document — designers), and the Premium "Šablona
   z obrázku" card (AI sken — ai_scan/_entry_card.html.twig: enabled, locked →
   access request, or inert).
   Each card is one stretched link (the CTA's ::after covers the card); the
   secondary link sits above it. Needs `project`. #}
{% set is_designer = is_granted('ROLE_DESIGNER') %}
<div class="modal fade" id="templateNewModal" tabindex="-1" aria-labelledby="templateNewTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered tp-new-dlg">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title" id="templateNewTitle">Nová šablona</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Zavřít"></button>
            </div>
            <div class="modal-body">
                <div class="tp-types">
                    <div class="tp-type">
                        <span class="tp-type-wf"><svg viewBox="0 0 200 120" aria-hidden="true"><rect class="wf-card" x="62" y="14" width="76" height="96" rx="6"/><rect class="wf-ph" x="68" y="20" width="64" height="46" rx="3"/><circle class="wf-b" cx="84" cy="34" r="5"/><path class="wf-b" d="M74 60l14-14 10 10 6-6 12 10z"/><rect class="wf-acc" x="68" y="74" width="34" height="5" rx="2.5"/><rect class="wf-b" x="68" y="84" width="58" height="3.5" rx="1.75"/><rect class="wf-b" x="68" y="92" width="46" height="3.5" rx="1.75"/><rect class="wf-card" x="146" y="44" width="30" height="38" rx="4"/><rect class="wf-ph" x="149" y="47" width="24" height="18" rx="2"/><rect class="wf-card" x="24" y="52" width="30" height="30" rx="4"/><rect class="wf-ph" x="27" y="55" width="24" height="14" rx="2"/></svg></span>
                        <span class="tp-type-b">
                            <span class="tp-type-t"><b>Prázdná šablona</b></span>
                            <span class="cap">Jeden design s variantami formátů (4:5, 9:16, A4…). Texty a obrázky doplní uživatel před exportem.</span>
                            <a href="{{ path('add_template', {'id': project.id}) }}" class="btn btn-tertiary sm tp-type-go">{{ icon('plus', 's16') }}Vytvořit<span class="sr"> — Prázdná šablona</span></a>
                        </span>
                    </div>

                    {% if is_designer %}
                        <div class="tp-type">
                            <span class="tp-type-wf"><svg viewBox="0 0 200 120" aria-hidden="true"><rect class="wf-card" x="22" y="18" width="62" height="78" rx="6"/><rect class="wf-ph" x="28" y="24" width="50" height="36" rx="3"/><rect class="wf-acc" x="28" y="66" width="30" height="5" rx="2.5"/><rect class="wf-b" x="28" y="76" width="44" height="3.5" rx="1.75"/><rect class="wf-card" x="128" y="10" width="50" height="94" rx="6"/><rect class="wf-ph" x="134" y="16" width="38" height="50" rx="3"/><rect class="wf-acc" x="134" y="72" width="26" height="5" rx="2.5"/><rect class="wf-b" x="134" y="82" width="34" height="3.5" rx="1.75"/><path class="wf-line" d="M92 48c8-8 20-8 28 0M120 66c-8 8-20 8-28 0"/><path class="wf-arrow" d="M116 42l5 6-7 2M96 72l-5-6 7-2"/></svg></span>
                            <span class="tp-type-b">
                                <span class="tp-type-t"><b>Synchronizovaná šablona</b></span>
                                <span class="cap">Varianty pro různé formáty jsou propojené — změna textu nebo obrázku v jedné se sama propíše do všech ostatních.</span>
                                <a href="{{ path('template_group_from_template', {'projectId': project.id}) }}" class="tp-type-alt">{{ icon('copy', 's14') }}Vyjít z existující šablony</a>
                                <a href="{{ path('add_template_group', {'projectId': project.id}) }}" class="btn btn-tertiary sm tp-type-go">{{ icon('plus', 's16') }}Vytvořit<span class="sr"> — Synchronizovaná šablona</span></a>
                            </span>
                        </div>

                        <div class="tp-type">
                            <span class="tp-type-wf"><svg viewBox="0 0 200 120" aria-hidden="true"><rect class="wf-card op" x="78" y="10" width="64" height="88" rx="5"/><rect class="wf-card op2" x="70" y="16" width="64" height="88" rx="5"/><rect class="wf-card" x="62" y="22" width="64" height="88" rx="5"/><rect class="wf-ph" x="68" y="28" width="52" height="30" rx="3"/><rect class="wf-acc" x="68" y="64" width="28" height="5" rx="2.5"/><rect class="wf-b" x="68" y="74" width="50" height="3.5" rx="1.75"/><rect class="wf-b" x="68" y="82" width="42" height="3.5" rx="1.75"/><rect class="wf-b" x="68" y="90" width="46" height="3.5" rx="1.75"/></svg></span>
                            <span class="tp-type-b">
                                <span class="tp-type-t"><b>Vícestránkový dokument</b></span>
                                <span class="cap">Více stránek v jednom souboru — prezentace, katalog, menu nebo leták. Exportuje se do PDF.</span>
                                <a href="{{ path('add_template_document', {'projectId': project.id}) }}" class="btn btn-tertiary sm tp-type-go">{{ icon('plus', 's16') }}Vytvořit<span class="sr"> — Vícestránkový dokument</span></a>
                            </span>
                        </div>
                    {% endif %}

                    {# "Šablona z obrázku" (AI sken, docs/ai-scan/ux.md T1): the card's
                       state comes from ai_scan_entry(); `ai_entry` is set by the page. #}
                    {{ include('ai_scan/_entry_card.html.twig', { entry: ai_entry ?? ai_scan_entry(project) }) }}
                </div>
            </div>
        </div>
    </div>
</div>
