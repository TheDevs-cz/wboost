{% extends 'base.html.twig' %}

{% block title %}Nový manuál{% endblock %}
{% set active_menu_item = 'manuals' %}

{% block page_lead %}Brand manuál obsahuje i písma a stránky s mockupy, logo manuál jen logotypy a barvy.{% endblock %}

{% block breadcrumb %}
    <ol class="breadcrumb m-0 pt-0">
        <li class="breadcrumb-item"><a href="{{ path('manuals_list', {'id': project.id}) }}">Manuály</a></li>
        <li class="breadcrumb-item active">{{ block('title') }}</li>
    </ol>
{% endblock %}

{% block content %}
    {{ include('_manual_form.html.twig', {
        'submit_label': 'Vytvořit manuál',
        'cancel_url': path('manuals_list', {'id': project.id}),
    }) }}
{% endblock %}
