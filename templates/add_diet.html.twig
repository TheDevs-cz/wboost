{% extends 'base.html.twig' %}

{% set active_menu_item = 'weekly_menus' %}
{% set active_submenu_item = 'diets' %}

{% block title %}Nová dieta{% endblock %}

{% block page_title_row %}
    <a href="{{ path('diets', {'projectId': project.id}) }}" class="back">{{ icon('arrow-left', 's16') }}Diety</a>
{% endblock %}

{% block content %}
    {{ form_start(form, {'attr': {'class': 'adm-sheet wm-sheet'}}) }}
        <div class="adm-sheet-h"><h1 class="page-title adm-sheet-title">Nová dieta</h1></div>
        <div class="adm-sheet-b">
            {{ form_widget(form) }}
        </div>
        <div class="adm-sheet-f">
            <a href="{{ path('diets', {'projectId': project.id}) }}" class="btn btn-tertiary sm">Zrušit</a>
            <button class="btn btn-primary sm" type="submit">Vytvořit</button>
        </div>
    {{ form_end(form) }}
{% endblock %}
