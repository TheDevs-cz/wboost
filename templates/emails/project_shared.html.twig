{% extends 'emails/_layout.html.twig' %}
{% import 'emails/_ui.html.twig' as ui %}

{% block title %}Sdílený projekt {{ projectName }}{% endblock %}
{% block preheader %}{% if sharedByName %}{{ sharedByName }} s vámi sdílí{% else %}Byl vám nasdílen{% endif %} projekt {{ projectName }}.{% endblock %}
{% block eyebrow %}Sdílený projekt{% endblock %}
{% block heading %}Máte přístup k projektu {{ projectName }}{% endblock %}

{% block content %}
    <p {{ ui.a('p') }}>Dobrý den,</p>
    <p {{ ui.a('p') }}>{% if sharedByName %}<strong {{ ui.a('strong') }}>{{ sharedByName }}</strong> s vámi sdílí{% else %}byl vám nasdílen{% endif %} projekt <strong {{ ui.a('strong') }}>{{ projectName }}</strong> v aplikaci WBoost. Najdete ho mezi svými projekty.</p>

    {{ ui.button(projectUrl, 'Otevřít projekt') }}

    {{ ui.signoff() }}
{% endblock %}

{% block footer_note %}Tento e-mail jste dostali, protože s vámi někdo sdílel projekt v aplikaci WBoost.{% endblock %}
