{% extends 'emails/_layout.html.twig' %}
{% import 'emails/_ui.html.twig' as ui %}

{% block title %}Obnovení hesla{% endblock %}
{% block preheader %}Nové heslo si nastavíte jedním kliknutím. Odkaz platí 8 hodin.{% endblock %}
{% block eyebrow %}Obnovení hesla{% endblock %}
{% block heading %}Nastavte si nové heslo{% endblock %}

{% block content %}
    <p {{ ui.a('p') }}>Dobrý den,</p>
    <p {{ ui.a('p') }}>obdrželi jsme žádost o obnovení hesla k vašemu účtu <strong {{ ui.a('strong') }}>{{ user.email }}</strong>. Nové heslo si zvolíte přes tlačítko níže.</p>

    {{ ui.button(setPasswordUrl, 'Nastavit nové heslo') }}

    <p {{ ui.a('p') }}>Odkaz platí <strong {{ ui.a('strong') }}>8 hodin</strong> a lze ho použít jen jednou.</p>

    {{ ui.callout('Pak tento e-mail klidně ignorujte — vaše současné heslo zůstává beze změny.', 'lav', 'Nežádali jste o obnovení?') }}

    {{ ui.signoff() }}
    {{ ui.fallback_link(setPasswordUrl) }}
{% endblock %}

{% block footer_note %}
    Tento e-mail jste dostali, protože někdo zadal vaši adresu do formuláře pro obnovení hesla.
{% endblock %}
