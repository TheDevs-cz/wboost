{% extends 'emails/_layout.html.twig' %}
{% import 'emails/_ui.html.twig' as ui %}

{% set approved = result == 'approved' %}

{% block title %}Jídelníček byl {{ approved ? 'schválen' : 'zamítnut' }}{% endblock %}
{% block preheader %}{{ menu.approvalEmail }} {{ approved ? 'schválil(a)' : 'zamítl(a)' }} jídelníček {{ menu.name }}.{% endblock %}
{% block eyebrow %}Schvalování jídelníčku{% endblock %}

{% block content %}
    {% set verdict %}Jídelníček <strong>{{ menu.name }}</strong> byl {{ approved ? 'schválen' : 'zamítnut' }} uživatelem <strong>{{ menu.approvalEmail }}</strong>.{% endset %}
    {{ ui.callout(verdict, approved ? 'mnt' : 'rose', approved ? 'Schváleno' : 'Zamítnuto') }}

    {{ ui.facts([
        ['Jídelníček', menu.name],
        ['Platnost', menu.validFrom|date('j. n. Y') ~ ' – ' ~ menu.validTo|date('j. n. Y')],
    ]) }}

    {% if comment is not empty %}
        <p {{ ui.a('small') }}>Komentář:</p>
        <p class="e-p" style="{{ ui.style('p') }} padding: 0 0 0 14px; border-left: 3px solid #DAD5E1; white-space: pre-line;">{{ comment }}</p>
    {% endif %}
{% endblock %}
