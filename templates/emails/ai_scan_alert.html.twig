{% extends 'emails/_layout.html.twig' %}
{% import 'emails/_ui.html.twig' as ui %}

{% block title %}{{ subject }}{% endblock %}
{% block preheader %}{{ what }}{% endblock %}
{% block eyebrow %}Provoz · AI sken{% endblock %}

{% block content %}
    {# `rows` (label → value) replaces the "since" line: a mail about one project and one day. #}
    {% set factRows = [] %}
    {% if rows is defined and rows %}
        {% for label, value in rows %}{% set factRows = factRows|merge([[label, value]]) %}{% endfor %}
    {% else %}
        {% set factRows = factRows|merge([[kind == 'cleared' ? 'Trvalo od' : 'Trvá od', since ~ (until ? ' do ' ~ until : '')]]) %}
    {% endif %}
    {% set factRows = factRows|merge([['Provozní režim', mode], ['Kód', code]]) %}

    <p {{ ui.a('p') }}>{{ what }}</p>

    {{ ui.facts(factRows) }}

    {% if todo %}
        {% set todoHtml %}{{ todo }}{% endset %}
        {{ ui.callout(todoHtml, kind == 'cleared' ? 'mnt' : 'pch', 'Co udělat:') }}
    {% endif %}
    {% if kind == 'reminder' %}
        <p {{ ui.a('p') }}>Připomínáme jednou denně, dokud stav trvá.</p>
    {% endif %}

    {{ ui.button(url, button|default('Otevřít AI skeny v administraci')) }}
{% endblock %}

{% block footer_note %}Provozní zpráva aplikace WBoost pro administrátory.{% if footer is defined and footer %} {{ footer }}{% elseif kind != 'cleared' %} O konci tohoto stavu vám dáme vědět.{% endif %}{% endblock %}
