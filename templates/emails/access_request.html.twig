{% extends 'emails/_layout.html.twig' %}
{% import 'emails/_ui.html.twig' as ui %}

{% block title %}Nová žádost o registraci{% endblock %}
{% block preheader %}O přístup do WBoostu žádá {{ requesterEmail }}.{% endblock %}
{% block eyebrow %}Pro administrátory{% endblock %}

{% block content %}
    <p {{ ui.a('p') }}>O přístup do aplikace WBoost požádal tento e-mail:</p>

    {{ ui.facts([['E-mail', requesterEmail]], '30%') }}

    <p {{ ui.a('p') }}>Žádost vyřídíte v administraci v sekci „Žádosti o registraci“ — žadatele odtud můžete pozvat, nebo žádost zamítnout.</p>

    {{ ui.button(adminUrl, 'Zobrazit žádosti o registraci') }}
{% endblock %}

{% block footer_note %}Provozní zpráva aplikace WBoost pro administrátory.{% endblock %}
