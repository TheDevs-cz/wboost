{% extends 'emails/_layout.html.twig' %}
{% import 'emails/_ui.html.twig' as ui %}

{% block title %}AI sken je zapnutý{% endblock %}
{% block preheader %}V projektu {{ projectName }} teď z obrázku hotové grafiky vznikne upravitelná šablona.{% endblock %}
{% block eyebrow %}AI sken{% endblock %}

{% block content %}
    <p {{ ui.a('p') }}>Dobrý den,</p>
    <p {{ ui.a('p') }}>pro projekt <strong {{ ui.a('strong') }}>{{ projectName }}</strong> jsme zapnuli AI sken. Nahrajte obrázek hotové grafiky a AI z něj poskládá upravitelnou šablonu — texty, tvary, barvy a místa pro obrázky.</p>

    {{ ui.button(url, 'Vyzkoušet') }}

    {{ ui.signoff() }}
{% endblock %}

{% block footer_note %}Tento e-mail jste dostali, protože jste v aplikaci WBoost požádali o AI sken.{% endblock %}
