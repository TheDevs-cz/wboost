{% extends 'emails/_layout.html.twig' %}
{% import 'emails/_ui.html.twig' as ui %}

{% block title %}{{ subject }}{% endblock %}
{% block preheader %}{% if kind == 'ready' %}Návrh z obrázku {{ file }} je připravený ke kontrole.{% elseif kind == 'reminder' %}Návrh z obrázku {{ file }} pořád čeká na kontrolu.{% else %}Obrázek {{ file }} se nepodařilo zpracovat. Nezapočítal se.{% endif %}{% endblock %}
{% block eyebrow %}AI sken{% endblock %}

{% block content %}
    <p {{ ui.a('p') }}>
        {% if kind == 'ready' and calendar|default(false) %}
            Z obrázku <strong {{ ui.a('strong') }}>{{ file }}</strong> jsme v projektu <strong {{ ui.a('strong') }}>{{ project }}</strong> připravili návrh rozvržení pro kalendář <strong {{ ui.a('strong') }}>„{{ name }}“</strong>.
        {% elseif kind == 'ready' %}
            Z obrázku <strong {{ ui.a('strong') }}>{{ file }}</strong> jsme v projektu <strong {{ ui.a('strong') }}>{{ project }}</strong> připravili návrh šablony <strong {{ ui.a('strong') }}>„{{ name }}“</strong>.
        {% elseif kind == 'reminder' %}
            Návrh z obrázku <strong {{ ui.a('strong') }}>{{ file }}</strong> v projektu <strong {{ ui.a('strong') }}>{{ project }}</strong> čeká na kontrolu.{% if expires %} {{ expires }} ho i původní obrázek smažeme.{% endif %}
        {% elseif kind == 'stopped' %}
            Obrázek <strong {{ ui.a('strong') }}>{{ file }}</strong> se k rozpoznání nehodí: {{ reason }} Nezapočítal se.
        {% else %}
            Obrázek <strong {{ ui.a('strong') }}>{{ file }}</strong> se nám nepodařilo zpracovat: {{ reason }} Nezapočítal se.
        {% endif %}
    </p>

    {% if kind == 'ready' %}
        <p {{ ui.a('p') }}>{% if calendar|default(false) %}Kalendář se nezmění, dokud rozvržení nepoužijete.{% else %}{% if toDecide %}{{ toDecide }} {% endif %}Šablona vznikne, až návrh potvrdíte.{% endif %}</p>
    {% endif %}

    {{ ui.button(url, kind == 'stopped' ? 'Nahrát jiný obrázek' : (kind == 'failed' ? 'Otevřít sken' : 'Zkontrolovat návrh')) }}

    {% if kind == 'ready' and expires %}
        {{ ui.callout('Návrh i původní obrázek uchováme do ' ~ expires ~ '; potom je smažeme.', 'pch', 'Do kdy návrh platí') }}
    {% endif %}
{% endblock %}

{% block footer_note %}Tento e-mail jste dostali, protože jste v aplikaci WBoost spustili AI sken.{% endblock %}
