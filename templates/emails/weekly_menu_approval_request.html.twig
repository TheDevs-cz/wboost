{% extends 'emails/_layout.html.twig' %}
{% import 'emails/_ui.html.twig' as ui %}

{% block title %}Žádost o schválení jídelníčku{% endblock %}
{% block preheader %}{{ requestedByEmail }} vás žádá o schválení jídelníčku {{ menu.name }}.{% endblock %}
{% block eyebrow %}Ke schválení{% endblock %}
{% block heading %}Schválíte jídelníček?{% endblock %}

{% block content %}
    <p {{ ui.a('p') }}>Dobrý den,</p>
    <p {{ ui.a('p') }}>uživatel <strong {{ ui.a('strong') }}>{{ requestedByEmail }}</strong> vás žádá o schválení jídelníčku:</p>

    {{ ui.facts([
        ['Jídelníček', menu.name],
        ['Platnost', menu.validFrom|date('j. n. Y') ~ ' – ' ~ menu.validTo|date('j. n. Y')],
    ]) }}

    <p {{ ui.a('p') }}>Na další stránce jídelníček schválíte, nebo zamítnete, a můžete k tomu připsat komentář.</p>

    {{ ui.button(approvalUrl, 'Zobrazit a rozhodnout') }}

    <p {{ ui.a('p') }}>Chcete se nejdřív jen podívat? <a href="{{ publicUrl }}" target="_blank" {{ ui.a('link') }}>Zobrazit jídelníček</a></p>
    {{ ui.fallback_link(approvalUrl) }}
{% endblock %}

{% block footer_note %}Odkaz ke schválení je určen výhradně pro vás — e-mail prosím nepřeposílejte.{% endblock %}
