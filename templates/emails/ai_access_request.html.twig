{% extends 'emails/_layout.html.twig' %}
{% import 'emails/_ui.html.twig' as ui %}

{% block title %}Žádost o AI sken{% endblock %}
{% block preheader %}{{ userName }} žádá o AI sken pro projekt {{ projectName }}.{% endblock %}
{% block eyebrow %}Pro administrátory{% endblock %}

{% block content %}
    <p {{ ui.a('p') }}>Uživatel žádá o zapnutí AI skenu pro svůj projekt:</p>

    {{ ui.facts([
        ['Projekt', projectName],
        ['Uživatel', userName ~ (userName != userEmail ? ' (' ~ userEmail ~ ')' : '')],
        ['Odkud', origin == 'calendars' ? 'Kalendáře — Naskenovat design' : 'Šablony — Šablona z obrázku'],
        ['K čemu ho chce použít', message ?: null],
    ]) }}

    <p {{ ui.a('p') }}>AI sken zapnete (nebo žádost zamítnete) v nastavení projektu v kartě „Moduly projektu“.</p>

    {{ ui.button(projectUrl, 'Otevřít nastavení projektu') }}
{% endblock %}

{% block footer_note %}Provozní zpráva aplikace WBoost pro administrátory.{% endblock %}
