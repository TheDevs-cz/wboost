{% extends 'emails/_layout.html.twig' %}
{% import 'emails/_ui.html.twig' as ui %}

{% block title %}Zapnutý modul {{ moduleLabel }}{% endblock %}
{% block preheader %}{{ userName }} si v projektu {{ projectName }} zapnul(a) modul {{ moduleLabel }}.{% endblock %}
{% block eyebrow %}Pro administrátory{% endblock %}

{% block content %}
    <p {{ ui.a('p') }}>Uživatel si v nabídce „Objevte další moduly“ sám zapnul nový modul:</p>

    {{ ui.facts([
        ['Modul', moduleLabel],
        ['Projekt', projectName],
        ['Uživatel', userName ~ (userName != userEmail ? ' (' ~ userEmail ~ ')' : '')],
    ], '30%') }}

    <p {{ ui.a('p') }}>Pokud to není v pořádku, modul vypnete v nastavení projektu v kartě „Moduly projektu“ — žádná data se tím nesmažou.</p>

    {{ ui.button(projectUrl, 'Otevřít moduly projektu') }}
{% endblock %}

{% block footer_note %}Provozní zpráva aplikace WBoost pro administrátory.{% endblock %}
