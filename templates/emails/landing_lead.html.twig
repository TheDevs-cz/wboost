{% extends 'emails/_layout.html.twig' %}
{% import 'emails/_ui.html.twig' as ui %}

{% block title %}Nová poptávka z wboost.cz{% endblock %}
{% block preheader %}{{ lead.name ?: lead.email }} — {{ lead.source.label }}{% endblock %}
{% block eyebrow %}Pro administrátory{% endblock %}

{% block content %}
    <p {{ ui.a('p') }}>Odkud: <strong {{ ui.a('strong') }}>{{ lead.source.label }}</strong>.{% if lead.email %} Na tento e-mail stačí odpovědět — odpověď půjde přímo tazateli.{% endif %}</p>

    {{ ui.facts([
        ['Jméno', lead.name],
        ['E-mail', lead.email],
        ['Telefon', lead.phone],
        ['Firma nebo organizace', lead.company],
        ['Web nebo portfolio', lead.website],
        ['Zájem', lead.interests|length > 0 ? lead.interests|join(', ') : null],
        ['Mají grafika', lead.hasDesigner is same as(true) ? 'ano' : (lead.hasDesigner is same as(false) ? 'ne' : null)],
        ['Jméno grafika', lead.designerName],
        ['E-mail grafika', lead.designerEmail],
    ]) }}

    {% if lead.message %}
        <p {{ ui.a('small') }}>Zpráva:</p>
        <p class="e-p" style="{{ ui.style('p') }} margin: 0 0 24px; padding: 0 0 0 14px; border-left: 3px solid #DAD5E1; white-space: pre-wrap;">{{ lead.message }}</p>
    {% endif %}

    {{ ui.button(adminUrl, 'Všechny poptávky v administraci') }}
{% endblock %}

{% block footer_note %}Provozní zpráva aplikace WBoost pro administrátory.{% endblock %}
