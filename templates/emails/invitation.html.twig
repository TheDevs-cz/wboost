{% extends 'emails/_layout.html.twig' %}
{% import 'emails/_ui.html.twig' as ui %}

{% set inviter = invitedByName is defined and invitedByName ? invitedByName : null %}
{% set projects = projectNames is defined ? projectNames : [] %}

{% block title %}Pozvánka do aplikace WBoost{% endblock %}
{% block preheader %}{% if inviter %}{{ inviter }} vás zve do WBoostu.{% else %}Máte nový účet ve WBoostu.{% endif %} Nastavte si heslo a můžete začít.{% endblock %}
{% block eyebrow %}Pozvánka{% endblock %}
{% block heading %}Vítejte ve WBoostu{% endblock %}

{% block content %}
    <p {{ ui.a('p') }}>Dobrý den,</p>
    <p {{ ui.a('p') }}>{% if inviter %}Pozvánku vám posílá <strong {{ ui.a('strong') }}>{{ inviter }}</strong>. {% endif %}Byl vám vytvořen účet <strong {{ ui.a('strong') }}>{{ user.email }}</strong> v aplikaci WBoost.</p>

    {% if projects is not empty %}
        {{ ui.facts([[projects|length == 1 ? 'Čeká na vás projekt' : 'Čekají na vás projekty', projects|join(', ')]], '45%') }}
    {% endif %}

    <p {{ ui.a('p') }}>Účet aktivujete tím, že si nastavíte heslo. Hned potom budete přihlášeni{% if projects is not empty %} a {{ projects|length == 1 ? 'projekt najdete' : 'projekty najdete' }} mezi svými projekty{% endif %}.</p>

    {{ ui.button(setPasswordUrl, 'Nastavit heslo a aktivovat účet') }}

    <p {{ ui.a('p') }}>Odkaz platí <strong {{ ui.a('strong') }}>7 dní</strong> a lze ho použít jen jednou. Když vyprší, požádejte o novou pozvánku toho, kdo vás pozval.</p>

    {{ ui.signoff() }}
    {{ ui.fallback_link(setPasswordUrl) }}
{% endblock %}

{% block footer_note %}Tento e-mail jste dostali, protože vás někdo pozval do aplikace WBoost. Pokud pozvánku nečekáte, můžete ji ignorovat.{% endblock %}
