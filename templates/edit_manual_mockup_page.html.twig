{% extends 'base_manual.html.twig' %}

{% block title %}{{ mockup_page.name }}{% endblock %}
{% set active_menu_item = 'manuals' %}

{% block page_lead %}Změny uložíte tlačítkem dole; v online manuálu se projeví hned.{% endblock %}

{% block breadcrumb %}
    <ol class="breadcrumb m-0 pt-0">
        <li class="breadcrumb-item"><a href="{{ path('manual_mockup_pages', {'id': manual.id}) }}">{{ manual.name }} · Stránky</a></li>
        <li class="breadcrumb-item active">{{ block('title') }}</li>
    </ol>
{% endblock %}

{% block content %}

    {% set existing_images = [] %}
    {% set existing_downloads = [] %}
    {% for slot in mockup_page.layout.slots %}
        {% set image = mockup_page.images[loop.index0] ?? null %}
        {% set existing_images = existing_images|merge([image ? uploaded_asset(image) : null]) %}

        {% set download = mockup_page.imageDownload(loop.index0) %}
        {% set existing_downloads = existing_downloads|merge([
            download ? {'name': download.fileName, 'size': download.size} : null
        ]) %}
    {% endfor %}

            {{ include('_mockup_page_form_editor.html.twig', {
                'form': form,
                'layouts_geometry': layouts_geometry,
                'fixed_layout': mockup_page.layout,
                'existing_images': existing_images,
                'existing_downloads': existing_downloads,
                'existing_page_download': mockup_page.downloadFile
                    ? {'name': mockup_page.downloadFile.fileName, 'size': mockup_page.downloadFile.size}
                    : null,
                'submit_label': 'Uložit změny',
            }) }}
{% endblock %}
