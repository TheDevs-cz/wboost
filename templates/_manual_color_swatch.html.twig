{# One colour swatch on a manual's palette page. Only the codes the designer
   actually filled are printed, each on its own line.

   Params: color (ManualColor). #}
<div class="manual-preview-color rounded-4 {{ color.color.white ? 'text-secondary' }}" style="background: {{ '#' ~ color.color }};">
    <div><strong>HEX:</strong> {{ color.color }}</div>

    {% if color.cmyk %}
        <div><strong>CMYK:</strong> {{ color.cmyk[0] ~ '-' ~ color.cmyk[1] ~ '-' ~ color.cmyk[2] ~ '-' ~ color.cmyk[3] }}</div>
    {% endif %}

    {% if color.pantone %}
        <div><strong>Pantone:</strong> {{ color.pantone }}</div>
    {% endif %}

    {% if color.ral %}
        <div><strong>RAL:</strong> {{ color.ral }}</div>
    {% endif %}
</div>
