{% extends 'base.html.twig' %}

{% block title %}Objevte další moduly{% endblock %}
{% set active_menu_item = 'project_modules' %}

{% block breadcrumb %}
    <ol class="breadcrumb m-0 pt-0">
        <li class="breadcrumb-item"><a href="{{ path('project_dashboard', {'id': project.id}) }}">{{ project.name }}</a></li>
        <li class="breadcrumb-item active">{{ block('title') }}</li>
    </ol>
{% endblock %}

{% block page_lead %}
    WBoost umí víc, než teď v projektu {{ project.name }} používáte.
    {% if is_granted('project_edit', project) %}
        Modul, který se vám hodí, zapnete jedním kliknutím — najdete ho pak v levém menu.
    {% else %}
        Moduly může zapnout správce projektu.
    {% endif %}
{% endblock %}

{#
    "Objevte další moduly" (docs/architecture/app-shell.md): the project's
    switched-off modules as rows (icon tile, name, description, Vypnuto +
    switch). The switch submits the existing project_module_enable form
    (project editors); read-only members are told an editor can do it.
#}
{% block content %}
    {% set can_enable = is_granted('project_edit', project) %}
    {# modules still in preview (ProjectModule::isInPreview) are offered to admins only #}
    {% set offered_modules = project.disabledModules|filter(m => not m.inPreview or is_granted('ROLE_ADMIN')) %}

    <section class="pd-box" aria-labelledby="modsH">
        <div class="pd-box-h">
            <div>
                <h2 id="modsH">Dostupné moduly <span class="pd-n">{{ offered_modules|length }}</span></h2>
                <span class="cap">Zapnutím se modul objeví v menu projektu. O zapnutí dostanou e-mail administrátoři; vypnout ho mohou jen oni a žádná data se tím nesmažou.</span>
            </div>
        </div>

        <div class="pd-mods">
            {% for module in offered_modules %}
                <div class="pd-mod" data-module="{{ module.value }}">
                    <span class="pd-ico" aria-hidden="true">{{ icon(module.icon) }}</span>
                    <span class="who"><b>{{ module.label }}</b><span class="cap">{{ module.description }}</span></span>
                    {% if can_enable %}
                        <span class="pd-st">Vypnuto</span>
                        <form method="post" action="{{ path('project_module_enable', {'projectId': project.id, 'module': module.value}) }}" class="pd-mod-f">
                            <input type="hidden" name="_token" value="{{ csrf_token('project_module_enable') }}">
                            <button type="submit" class="sw" role="switch" aria-checked="false" aria-label="Zapnout modul {{ module.label }}" title="Zapnout modul"></button>
                        </form>
                    {% else %}
                        <span class="pd-st pd-st-ro">{{ icon('lock', 's14') }}Zapne správce projektu</span>
                    {% endif %}
                </div>
            {% endfor %}
        </div>

        <p class="cap pd-foot">{{ icon('info', 's14') }}Galerie a Fonty jsou vždy zapnuté — čerpají z nich ostatní moduly.</p>
    </section>
{% endblock %}
