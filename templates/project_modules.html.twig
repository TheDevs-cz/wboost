{% extends 'base.html.twig' %}

{% block title %}Objevte další moduly{% endblock %}
{% set active_menu_item = 'project_modules' %}

{% block breadcrumb %}
    <ol class="breadcrumb m-0 pt-0">
        <li class="breadcrumb-item"><i class="uil-home-alt"></i> <a href="{{ path('projects') }}">Projekty</a></li>
        <li class="breadcrumb-item"><a href="{{ path('project_dashboard', {'id': project.id}) }}">{{ project.name }}</a></li>
        <li class="breadcrumb-item active">{{ block('title') }}</li>
    </ol>
{% endblock %}

{% block content %}
    {% set can_enable = is_granted('project_edit', project) %}

    <div class="card bg-dark text-white">
        <div class="card-body p-4 d-flex flex-wrap align-items-center gap-3">
            <div class="avatar-md flex-shrink-0">
                <span class="avatar-title bg-white bg-opacity-10 text-white rounded-circle font-24">
                    <i class="ri-sparkling-2-line"></i>
                </span>
            </div>
            <div class="flex-grow-1" style="min-width: 260px;">
                <h3 class="mt-0 mb-1 text-white">Objevte další moduly</h3>
                <p class="mb-0 text-white-50 fs-15">
                    WBoost umí víc, než teď v projektu {{ project.name }} používáte.
                    {% if can_enable %}
                        Modul, který se vám hodí, zapnete jedním kliknutím.
                    {% else %}
                        Moduly může zapnout správce projektu.
                    {% endif %}
                </p>
            </div>
        </div>
    </div>

    <div class="row g-3">
        {% for module in project.disabledModules %}
            <div class="col-md-6 col-xl-4 d-flex">
                <div class="card h-100 mb-0 w-100" data-module="{{ module.value }}">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <div class="avatar-sm flex-shrink-0">
                                <span class="avatar-title bg-primary-lighten text-primary rounded">
                                    <i class="{{ module.icon }} font-20"></i>
                                </span>
                            </div>
                            <h4 class="my-0">{{ module.label }}</h4>
                        </div>
                        <p class="text-muted mb-3 flex-grow-1">{{ module.description }}</p>

                        {% if can_enable %}
                            <form method="post" action="{{ path('project_module_enable', {'projectId': project.id, 'module': module.value}) }}" class="mb-0">
                                <input type="hidden" name="_token" value="{{ csrf_token('project_module_enable') }}">
                                <button type="submit" class="btn btn-primary rounded-pill">
                                    <i class="uil-plus me-1"></i>Zapnout modul
                                </button>
                            </form>
                        {% else %}
                            <p class="text-muted font-13 mb-0"><i class="uil-info-circle me-1"></i>Modul může zapnout správce projektu.</p>
                        {% endif %}
                    </div>
                </div>
            </div>
        {% endfor %}

        <div class="col-md-6 col-xl-4 d-flex">
            <div class="card h-100 mb-0 w-100">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
                        <div class="avatar-sm flex-shrink-0">
                            <span class="avatar-title bg-primary-lighten text-primary rounded">
                                <i class="uil-calendar-alt font-20"></i>
                            </span>
                        </div>
                        <h4 class="my-0">Kalendáře</h4>
                        <span class="badge badge-warning-lighten rounded-pill">Připravujeme</span>
                    </div>
                    <p class="text-muted mb-3 flex-grow-1">Firemní kalendáře v brandu projektu, připravené k tisku.</p>
                    <a href="{{ path('calendars', {'projectId': project.id}) }}" class="btn btn-outline-primary rounded-pill align-self-start">Zjistit víc</a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
