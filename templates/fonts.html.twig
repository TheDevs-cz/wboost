{% extends 'base.html.twig' %}

{% block title %}Fonty{% endblock %}
{% set active_menu_item = 'fonts' %}

{% set can_upload = is_granted(constant('WBoost\\Web\\Services\\Security\\ProjectVoter::EDIT'), project) %}
{% set cut_count = fonts|reduce((carry, f) => carry + f.faces|length, 0) %}

{% block page_lead %}Písma značky. Šablony nabízejí jen řezy nahrané tady{% if fonts|length > 0 %} — teď {{ fonts|length == 1 ? '1 rodina' : fonts|length ~ (fonts|length <= 4 ? ' rodiny' : ' rodin') }}, {{ cut_count }} {{ cut_count == 1 ? 'řez' : (cut_count >= 2 and cut_count <= 4 ? 'řezy' : 'řezů') }}{% endif %}.{% endblock %}

{% block breadcrumb %}
    <ol class="breadcrumb m-0 pt-0">
        <li class="breadcrumb-item"><a href="{{ path('project_dashboard', {'id': project.id}) }}">{{ project.name }}</a></li>
        <li class="breadcrumb-item active">{{ block('title') }}</li>
    </ol>
{% endblock %}

{% block content %}
    {# Every project face as @font-face — the specimens below render in the
       real glyphs, the same registration the editor and fill pages use. #}
    {{ include('editor/_editor_fonts.html.twig', {'fonts': fonts}) }}

    <div class="stack fn-page" data-controller="font-specimen">
        {# Shared specimen controls: sample text (remembered per browser) and a
           size slider, rewriting every row at once. #}
        <div class="gal-nav fn-nav" role="toolbar" aria-label="Fonty">
            {% if can_upload %}
                <button type="button" class="btn btn-primary sm" onclick="document.getElementById('font-dropzone').click()">{{ icon('upload', 's16') }}Nahrát písma</button>
            {% endif %}
            <label class="inp fn-sample" for="font-specimen-text" title="Ukázkový text pro všechny náhledy">
                {{ icon('font', 's16') }}
                <input type="text" id="font-specimen-text" placeholder="Napište ukázkový text" autocomplete="off" aria-label="Ukázkový text" data-font-specimen-target="input" data-action="input->font-specimen#input">
            </label>
            <label class="fn-size" for="font-specimen-size">
                <span class="cap">Velikost</span>
                <input type="range" id="font-specimen-size" min="14" max="72" step="2" value="28" data-font-specimen-target="size" data-action="input->font-specimen#resize">
                <b data-font-specimen-target="sizeLabel">28 px</b>
            </label>
        </div>

        {% if can_upload %}
            {{ include('_font_uploader.html.twig', {'project': project, 'hint': 'TTF, OTF, WOFF · víc souborů najednou · max. 10 MB na soubor · řezy se zařadí do rodiny podle názvu uvnitř souboru'}) }}
        {% endif %}

        {# References no project face satisfies: a deleted face, or the editor's
           "Arial" default from before the project had fonts. Those texts render
           in a fallback font — link straight to the editors that carry them.
           Only for people who can act on it: the editor links 403 for
           read-only members (P10b). #}
        {% if usage.hasMissing and can_upload %}
            <div class="alert c-warning fn-missing">
                {{ icon('alert') }}
                <div>
                    <div class="alert-t">Písma mimo projekt</div>
                    <div class="alert-d">Tyto šablony používají písmo, které v projektu není (smazaný řez, nebo výchozí písmo editoru). V exportu se vykreslí náhradním písmem — otevřete šablonu a zvolte písmo projektu, nebo písmo nahrajte.</div>
                    <ul class="fn-missing-l">
                        {% for family, sites in usage.missing %}
                            <li>
                                <span class="font-wire">{{ family }}</span>
                                —
                                {% for site in sites %}
                                    <a href="{{ site.groupId ? path('template_group_editor', {'groupId': site.groupId}) : path('template_variant_editor', {'variantId': site.variantId}) }}">{{ site.templateName }} ({{ site.dimensionLabel }})</a>{{ not loop.last ? ',' }}
                                {% endfor %}
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
        {% endif %}

        {% if fonts|length == 0 %}
            <div class="empty">
                <span class="ico-c">{{ icon('font') }}</span>
                <h2>Projekt zatím nemá žádná písma</h2>
                <p>{% if can_upload %}Bez písem se šablony vysází náhradním písmem. Nahrajte soubory písem značky — nabídne je editor šablon i vyplňování.{% else %}Písma značky specifikuje grafik.{% endif %}</p>
                {% if can_upload %}
                    <button type="button" class="btn btn-primary btn-sm" onclick="document.getElementById('font-dropzone').click()">{{ icon('upload', 's16') }}Nahrát písma</button>
                {% endif %}
            </div>
        {% endif %}

        <div class="fn-grid">
            {% for font in fonts %}
                {% set can_edit = is_granted('font_edit', font) %}
                {% set fontTemplates = usage.templateNamesFor(font.faces|map(f => font.faceFamily(f))|merge([font.name])) %}
                {% set head_family = font.faces is not empty ? font.faceFamily(font.faces|first) : font.name %}
                <section class="fn-fam" aria-labelledby="fnh-{{ font.id }}">
                    <div class="fn-fam-h">
                        <div class="fn-fam-t">
                            <h2 id="fnh-{{ font.id }}" style="font-family: '{{ head_family }}', var(--font);">{{ font.name }}</h2>
                            <span class="cap">{{ font.faces|length }} {{ font.faces|length == 1 ? 'řez' : (font.faces|length < 5 ? 'řezy' : 'řezů') }} · {% if fontTemplates|length > 0 %}použito v {{ fontTemplates|length }} {{ fontTemplates|length == 1 ? 'šabloně' : 'šablonách' }}{% else %}zatím nepoužito v šablonách{% endif %}</span>
                        </div>
                        {% if can_edit %}
                            <div class="dropdown">
                                <button type="button" class="btn btn-ghost icon xs" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Možnosti rodiny {{ font.name }}">{{ icon('more', 's16') }}</button>
                                <div class="dropdown-menu dropdown-menu-end">
                                    {% if can_upload %}
                                        <button type="button" class="dropdown-item" onclick="document.getElementById('font-dropzone').click()">{{ icon('upload', 's16') }}Nahrát další řezy</button>
                                    {% endif %}
                                    <a href="{{ path('rename_font', {'fontId': font.id}) }}" class="dropdown-item">{{ icon('edit', 's16') }}Přejmenovat</a>
                                    <div class="dropdown-divider"></div>
                                    <a href="#"
                                       class="dropdown-item text-danger"
                                       data-modal-id="{{ font.id }}"
                                       data-action="click->confirm-modal#showModal">{{ icon('trash', 's16') }}Smazat rodinu</a>
                                </div>
                            </div>

                            <twig:ConfirmModal
                                id="{{ font.id }}"
                                url="{{ path('delete_font', {'fontId': font.id}) }}"
                                confirmationText="Opravdu chcete smazat písmo {{ font.name }} včetně všech řezů?{% if fontTemplates|length > 0 %} Používá ho {{ fontTemplates|length }} {{ fontTemplates|length == 1 ? 'šablona' : (fontTemplates|length < 5 ? 'šablony' : 'šablon') }} ({{ fontTemplates|slice(0, 5)|join(', ') }}{% if fontTemplates|length > 5 %} a další{% endif %}) — vykreslí se náhradním písmem.{% else %} Žádná šablona ho nepoužívá.{% endif %}" />
                        {% endif %}
                    </div>

                    {# Weight axis: which of the nine weights the font carries,
                       upright (filled) and italic (slanted mark) — gaps at a
                       glance, e.g. why the WYSIWYG's "I" button is disabled for a
                       family with no italic. #}
                    <div class="weight-axis" aria-label="Dostupné tloušťky">
                        {% for step in 1..9 %}
                            {% set weight = step * 100 %}
                            {% set uprights = font.faces|filter(f => f.weight == weight and not f.isItalic) %}
                            {% set italics = font.faces|filter(f => f.weight == weight and f.isItalic) %}
                            <span class="weight-axis__cell{% if uprights|length > 0 %} weight-axis__cell--upright{% endif %}{% if italics|length > 0 %} weight-axis__cell--italic{% endif %}"
                                  title="{{ weight }}{% if uprights|length > 0 %} · {{ uprights|map(f => f.name)|join(', ') }}{% endif %}{% if italics|length > 0 %} · {{ italics|map(f => f.name)|join(', ') }}{% endif %}{% if uprights|length == 0 and italics|length == 0 %} · chybí{% endif %}">
                                <span class="weight-axis__label">{{ weight }}</span>
                            </span>
                        {% endfor %}
                    </div>

                    <ul class="fn-cuts"
                        data-controller="dragula"
                        data-dragula-sort-url-value="{{ path('sort_font_faces', {'fontId': font.id}) }}"
                        data-dragula-target="container">
                        {% for font_face in font.faces %}
                            {% set family = font.faceFamily(font_face) %}
                            {% set faceTemplates = usage.templateNamesFor([family]) %}
                            <li class="fn-cut" data-entity-id="{{ font_face.name }}">
                                {% if can_edit %}
                                    <span class="dragula-handle fn-grip" title="Přetažením změníte pořadí">{{ icon('grip', 's16') }}</span>
                                {% endif %}
                                <div class="fn-cut-b">
                                    <p class="fn-prev" style="font-family: '{{ family }}', sans-serif;" data-font-specimen-target="specimen" title="{{ font_face.name }}">Příliš žluťoučký kůň úpěl ďábelské ódy 0123456789</p>
                                    <div class="fn-meta">
                                        <b>{{ font_face.name }}</b>
                                        <span class="fn-tag" title="Tloušťka (usWeightClass)">{{ font_face.weight }}</span>
                                        <span class="fn-tag" title="Styl řezu">{{ font_face.style }}</span>
                                        <span class="fn-tag" title="Formát souboru">{{ font_face.format }}</span>
                                        {% if font_face.fileSizeLabel %}<span class="cap" title="Velikost souboru">{{ font_face.fileSizeLabel }}</span>{% endif %}
                                        {% if faceTemplates|length > 0 %}
                                            <span class="fn-use" title="{{ faceTemplates|join(', ') }}">{{ icon('template') }}{{ faceTemplates|length }} {{ faceTemplates|length == 1 ? 'šablona' : (faceTemplates|length < 5 ? 'šablony' : 'šablon') }}</span>
                                        {% else %}
                                            <span class="fn-use none" title="Žádná šablona tento řez nepoužívá">nepoužito</span>
                                        {% endif %}
                                        <span class="font-wire" title="Přesný název písma pro API, MCP a JSON plátna">{{ family }}</span>
                                    </div>
                                </div>
                                <div class="fn-cut-a">
                                    <button type="button" class="btn btn-ghost icon xs" title="Zkopírovat název písma pro API / MCP" aria-label="Zkopírovat název písma" data-action="font-specimen#copy" data-font-specimen-family-param="{{ family }}">{{ icon('copy', 's16') }}</button>
                                    <button type="button" class="btn btn-ghost xs fn-css" title="Zkopírovat CSS (font-family)" aria-label="Zkopírovat CSS" data-action="font-specimen#copy" data-font-specimen-family-param="font-family: '{{ family }}', sans-serif;">{{ icon('copy', 's16') }}CSS</button>
                                    {% if can_edit %}
                                        <a href="#"
                                           class="btn btn-ghost icon xs fn-del"
                                           title="Smazat řez"
                                           aria-label="Smazat řez {{ font_face.name }}"
                                           data-modal-id="{{ font.id }}-{{ loop.index }}"
                                           data-action="click->confirm-modal#showModal">{{ icon('trash', 's16') }}</a>

                                        <twig:ConfirmModal
                                            id="{{ font.id }}-{{ loop.index }}"
                                            url="{{ path('delete_font_face', {'fontId': font.id, 'fontFaceName': font_face.name}) }}"
                                            confirmationText="Opravdu chcete smazat řez {{ font_face.name }}?{% if faceTemplates|length > 0 %} Používá ho {{ faceTemplates|length }} {{ faceTemplates|length == 1 ? 'šablona' : (faceTemplates|length < 5 ? 'šablony' : 'šablon') }} ({{ faceTemplates|slice(0, 5)|join(', ') }}{% if faceTemplates|length > 5 %} a další{% endif %}) — vykreslí se náhradním písmem.{% else %} Žádná šablona ho nepoužívá.{% endif %}" />
                                    {% endif %}
                                </div>
                            </li>
                        {% endfor %}
                    </ul>
                </section>
            {% endfor %}
        </div>

        {# "Písma v manuálech" (F8, 2026-11-05 — replaces the manual's Fonty
           tab): per BRAND manual its ManualFonts — role, display colour,
           enabled cuts (switched in place, update_manual_font_faces), order
           (drag, sort_manual_fonts) — the data the customer manual preview
           and the editor's font defaults read. Add / edit / delete keep their
           routes and redirect back to #manual-fonts-{manualId}. #}
        {% if manual_fonts is not empty %}
            <section class="pd-box fn-mans" id="manual-fonts" aria-labelledby="fn-mans-h">
                <div class="pd-box-h">
                    <div>
                        <h2 id="fn-mans-h">Písma v manuálech</h2>
                        <span class="cap">Která písma manuál představí jako primární a sekundární, jakou barvou se vysází jejich ukázka a které řezy se v manuálu ukážou. Řezy se ukládají hned po kliknutí, pořadí změníte přetažením.</span>
                    </div>
                </div>

                {% for entry in manual_fonts %}
                    {% set manual = entry.manual %}
                    {% set can_edit_manual = is_granted('manual_edit', manual) %}
                    <div class="fn-man" id="manual-fonts-{{ manual.id }}">
                        <div class="fn-man-h">
                            {{ icon('copy', 's16') }}
                            <a href="{{ path('manual_logos', {'id': manual.id}) }}" class="fn-man-n">{{ manual.name }}</a>
                            <span class="pd-n" title="Písma v manuálu">{{ entry.fonts|length }}</span>
                            {% if can_edit_manual %}
                                <a href="{{ path('add_manual_font', {'id': manual.id}) }}" class="btn btn-tertiary sm">{{ icon('plus', 's16') }}Přidat písmo</a>
                            {% endif %}
                        </div>

                        {% if entry.fonts is empty %}
                            <p class="cap fn-man-empty">Manuál zatím nepředstavuje žádné písmo{% if can_edit_manual %} — přidejte primární a sekundární písmo značky{% endif %}.</p>
                        {% else %}
                            <ul class="fn-mrows"{% if can_edit_manual %}
                                data-controller="dragula"
                                data-dragula-sort-url-value="{{ path('sort_manual_fonts', {'manualId': manual.id}) }}"
                                data-dragula-target="container"{% endif %}>
                                {% for manual_font in entry.fonts %}
                                    {% set mf_font = manual_font.font %}
                                    {% set can_edit_mf = is_granted('manual_font_edit', manual_font) %}
                                    {% set mf_family = mf_font.faces is not empty ? mf_font.faceFamily(mf_font.faces|first) : mf_font.name %}
                                    {% set mf_color = (manual_font.color ?? '6c757d')|upper %}
                                    <li class="fn-mrow" data-entity-id="{{ manual_font.id }}">
                                        {% if can_edit_mf %}
                                            <span class="dragula-handle fn-grip" title="Přetažením změníte pořadí">{{ icon('grip', 's16') }}</span>
                                        {% endif %}
                                        <div class="fn-mrow-t">
                                            <b style="font-family: '{{ mf_family }}', var(--font);">{{ mf_font.name }}</b>
                                            <span class="pill{{ manual_font.secondary ? ' neutral' }}">{{ manual_font.primary ? 'Primární' : 'Sekundární' }}</span>
                                            <span class="fn-mrow-c" title="Barva ukázky v manuálu{{ manual_font.color is null ? ' (výchozí)' }}"><span class="fn-dot" style="background: #{{ mf_color }};"></span>#{{ mf_color }}</span>
                                        </div>
                                        <div class="fn-mcuts" role="group" aria-label="Řezy v manuálu"{% if can_edit_mf %} data-controller="manual-font-faces-toggle" data-manual-font-faces-toggle-url-value="{{ path('update_manual_font_faces', {'manualFontId': manual_font.id}) }}"{% endif %}>
                                            {% for font_face in mf_font.faces %}
                                                <label class="chip sm fn-mcut" title="{{ can_edit_mf ? 'Zobrazit řez v manuálu' : 'Řez ' ~ (manual_font.faceEnabled(font_face.name) ? 'se v manuálu ukáže' : 'se v manuálu neukáže') }}">
                                                    <input type="checkbox" class="sr" value="{{ font_face.name }}"{% if can_edit_mf %} data-manual-font-faces-toggle-target="checkbox"{% else %} disabled{% endif %}{% if manual_font.faceEnabled(font_face.name) %} checked{% endif %}>
                                                    {{ icon('check', 's14') }}<span style="font-family: '{{ mf_font.faceFamily(font_face) }}', var(--font);">{{ font_face.name }}</span>
                                                </label>
                                            {% else %}
                                                <span class="cap">Písmo nemá žádný řez.</span>
                                            {% endfor %}
                                        </div>
                                        {% if can_edit_mf %}
                                            <div class="dropdown">
                                                <button type="button" class="btn btn-ghost icon xs" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Možnosti písma {{ mf_font.name }} v manuálu {{ manual.name }}">{{ icon('more', 's16') }}</button>
                                                <div class="dropdown-menu dropdown-menu-end">
                                                    <a href="{{ path('edit_manual_font', {'id': manual_font.id}) }}" class="dropdown-item">{{ icon('edit', 's16') }}Upravit roli a barvu</a>
                                                    <div class="dropdown-divider"></div>
                                                    <a href="#"
                                                       class="dropdown-item text-danger"
                                                       data-modal-id="mf-{{ manual_font.id }}"
                                                       data-action="click->confirm-modal#showModal">{{ icon('trash', 's16') }}Odebrat z manuálu</a>
                                                </div>
                                            </div>
                                            <twig:ConfirmModal
                                                id="mf-{{ manual_font.id }}"
                                                url="{{ path('delete_manual_font', {'id': manual_font.id}) }}"
                                                confirmationText="Opravdu chcete odebrat písmo {{ mf_font.name }} z manuálu {{ manual.name }}? Písmo zůstane v projektu." />
                                        {% endif %}
                                    </li>
                                {% endfor %}
                            </ul>
                        {% endif %}
                    </div>
                {% endfor %}
            </section>
        {% endif %}
    </div>
{% endblock %}
