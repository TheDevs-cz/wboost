{% extends 'base.html.twig' %}

{% block title %}{{ document.name }}{% endblock %}
{% set active_menu_item = 'templates' %}
{% set page_count = pages|length %}
{% set page_word = page_count == 1 ? 'strana' : (page_count >= 2 and page_count <= 4 ? 'strany' : 'stran') %}

{% block page_lead %}
    <span class="td-meta">
        <span class="tp-var tp-var-doc">{{ icon('book', 's12') }}Dokument {{ document.dimension.label }}</span>
        <span class="tp-var">{{ page_count }} {{ page_word }}</span>
        {% if document.dimension.isPrintFormat and document.dimension.cropMarks %}
            <span class="tp-var">ořezové značky</span>
        {% endif %}
    </span>
{% endblock %}

{% block title_actions %}
    {% if can_edit %}
        <a href="{{ path('edit_template_document', {'documentId': document.id}) }}" class="btn btn-tertiary sm">{{ icon('type', 's16') }}Upravit název</a>
        {% if document.dimension.isPrintFormat %}
            <button type="button" class="btn btn-tertiary sm" data-bs-toggle="modal" data-bs-target="#documentPrintSettingsModal">{{ icon('file', 's16') }}Tiskové nastavení</button>
        {% endif %}
        <button type="button" class="btn btn-ghost-danger sm" data-bs-toggle="modal" data-bs-target="#deleteDocumentModal">{{ icon('trash', 's16') }}Smazat dokument</button>
    {% endif %}
    {% if pages is not empty %}
        <a href="{{ path('template_document_fill', {'documentId': document.id}) }}" class="btn btn-primary sm">{{ icon('download', 's16') }}Vyplnit a exportovat</a>
    {% endif %}
{% endblock %}

{% block breadcrumb %}
    <ol class="breadcrumb m-0 pt-0">
        <li class="breadcrumb-item"><a href="{{ path('templates', {'projectId': project.id}) }}">Šablony</a></li>
        <li class="breadcrumb-item active">{{ block('title') }}</li>
    </ol>
{% endblock %}

{#
    The document page — Apple Preview style: page thumbnails on the left
    (drag to reorder via the shared Sortable `dragula` controller, which posts
    the template ids in order), the selected page large on the right. Every
    action is a plain POST form carrying the `template_document` CSRF token;
    pages ARE templates, so "Upravit stránku" opens the ordinary editor with
    the document's page strip (`?document=`).
#}
{% block content %}
    {% set csrf = csrf_token('template_document') %}

    <div class="td-layout">
        <aside class="td-pages">
            <div class="tp-sech"><h2>Stránky <span class="pd-n">{{ page_count }}</span></h2></div>

            {% if pages is empty %}
                <p class="tp-hint">Dokument zatím nemá žádné stránky.</p>
            {% endif %}

            <ol class="document-pages"
                {% if can_edit %}
                    data-controller="dragula"
                    data-dragula-sort-url-value="{{ path('sort_template_document_pages', {'documentId': document.id}) }}"
                    data-dragula-target="container"
                {% endif %}
            >
                {% for page in pages %}
                    {% set thumb = page.variant.previewImagePath ?: page.variant.backgroundImage %}
                    <li class="document-pages__item {{ selected_page and selected_page.id == page.id ? 'is-active' : '' }}" data-entity-id="{{ page.template.id }}">
                        <a class="document-pages__thumb" href="{{ path('template_document', {'documentId': document.id, 'page': page.template.id}) }}" title="{{ page.template.name }}"{{ selected_page and selected_page.id == page.id ? ' aria-current="page"' }}>
                            <img src="{{ thumb ? uploaded_asset(thumb) : asset('images/manual-placeholder.png') }}" alt="" loading="lazy">
                        </a>
                        <div class="td-pl">
                            {% if can_edit %}<span class="dragula-handle man-grip" title="Přetažením změníte pořadí">{{ icon('grip', 's14') }}</span>{% endif %}
                            <b>{{ loop.index }}</b><span>{{ page.template.name }}</span>
                        </div>
                    </li>
                {% endfor %}
            </ol>

            {% if can_edit %}
                <div class="td-pages-acts">
                    <button type="button" class="btn btn-tertiary sm" data-bs-toggle="modal" data-bs-target="#attachPagesModal">{{ icon('link', 's16') }}Připojit existující</button>
                    <button type="button" class="btn btn-tertiary sm" data-bs-toggle="modal" data-bs-target="#newPageModal">{{ icon('plus', 's16') }}Nová stránka</button>
                </div>
            {% endif %}
        </aside>

        <div class="td-main">
            {% if selected_page %}
                {% set page = selected_page %}
                {% set thumb = page.variant.previewImagePath ?: page.variant.backgroundImage %}
                <section class="tp-sec">
                    <div class="td-pageh">
                        <h2>Strana {{ page.position + 1 }} — {{ page.template.name }}</h2>

                        {% if can_edit %}
                            <div class="td-pageacts">
                                <a href="{{ path('template_variant_editor', {'variantId': page.variant.id, 'document': document.id}) }}" class="btn btn-primary sm">{{ icon('edit', 's16') }}Upravit stránku</a>

                                <form method="post" action="{{ path('duplicate_template_document_page', {'documentId': document.id, 'templateId': page.template.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf }}">
                                    <button type="submit" class="btn btn-tertiary sm">{{ icon('copy', 's16') }}Duplikovat</button>
                                </form>

                                <form method="post" action="{{ path('detach_template_document_page', {'documentId': document.id, 'templateId': page.template.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf }}">
                                    <button type="submit" class="btn btn-tertiary sm" title="Stránka se vrátí mezi šablony jako samostatná šablona">{{ icon('link', 's16') }}Odpojit</button>
                                </form>

                                <button type="button" class="btn btn-ghost-danger sm" data-bs-toggle="modal" data-bs-target="#deletePageModal">{{ icon('trash', 's16') }}Smazat stránku</button>
                            </div>
                        {% endif %}
                    </div>

                    <div class="document-page-preview td-preview">
                        <img src="{{ thumb ? uploaded_asset(thumb) : asset('images/manual-placeholder.png') }}" alt="{{ page.template.name }}">
                    </div>
                </section>

                {% if can_edit %}
                    <div class="modal fade" id="deletePageModal" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                            <form class="modal-content" method="post" action="{{ path('delete_template_document_page', {'documentId': document.id, 'templateId': page.template.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf }}">
                                <div class="modal-header">
                                    <h4 class="modal-title">Smazat stránku „{{ page.template.name }}“?</h4>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Zavřít"></button>
                                </div>
                                <div class="modal-body tp-delmodes">
                                    <p>Šablona stránky se nevratně smaže. Chcete-li ji jen vyjmout z dokumentu a ponechat mezi šablonami, použijte <b>Odpojit</b>.</p>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-tertiary sm" data-bs-dismiss="modal">Zpět</button>
                                    <button type="submit" class="btn btn-danger sm">Smazat stránku</button>
                                </div>
                            </form>
                        </div>
                    </div>
                {% endif %}
            {% endif %}

            {% if shared_fields %}
                {{ include('_document_shared_fields.html.twig', {document: document, shared_fields: shared_fields, csrf: csrf}) }}
            {% endif %}

            {% if not selected_page %}
                <div class="empty">
                    <span class="ico-c">{{ icon('book') }}</span>
                    <h2>Dokument je zatím prázdný</h2>
                    <p>Připojte existující šablony ve formátu {{ document.dimension.label }}, nebo založte novou stránku.</p>
                </div>
            {% endif %}
        </div>
    </div>

    {% if can_edit %}
        <div class="modal fade" id="attachPagesModal" tabindex="-1" aria-hidden="true"
             {% if open_attach and attachable is not empty %}data-controller="auto-open-modal"{% endif %}>
            <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
                <form class="modal-content" method="post" action="{{ path('attach_template_document_pages', {'documentId': document.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf }}">
                    <div class="modal-header">
                        <h4 class="modal-title">Připojit existující šablony</h4>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Zavřít"></button>
                    </div>
                    <div class="modal-body">
                        {% if attachable is empty %}
                            <p class="tp-hint">Žádná další šablona nemá variantu ve formátu {{ document.dimension.label }}. (Synchronizované šablony a stránky jiných dokumentů připojit nelze.)</p>
                        {% else %}
                            <p class="tp-hint">Vybrané šablony se připojí na konec dokumentu v pořadí, v jakém jsou zde. Z přehledu šablon zmizí, dokud je neodpojíte.{% if document.dimension.isPrintFormat %} Převezmou tiskové nastavení dokumentu.{% endif %}</p>
                            <div class="td-attach">
                                {% for entry in attachable %}
                                    <label class="td-attach-tile">
                                        <img src="{{ entry.thumbnail ? uploaded_asset(entry.thumbnail) : asset('images/manual-placeholder.png') }}" alt="" loading="lazy">
                                        <span class="form-check">
                                            <input class="form-check-input" type="checkbox" name="templateIds[]" value="{{ entry.template.id }}">
                                            <span class="form-check-label">{{ entry.template.name }}</span>
                                        </span>
                                    </label>
                                {% endfor %}
                            </div>
                        {% endif %}
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-tertiary sm" data-bs-dismiss="modal">Zavřít</button>
                        {% if attachable is not empty %}
                            <button type="submit" class="btn btn-primary sm">Připojit vybrané</button>
                        {% endif %}
                    </div>
                </form>
            </div>
        </div>

        <div class="modal fade" id="newPageModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <form class="modal-content" method="post" action="{{ path('add_template_document_page', {'documentId': document.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf }}">
                    <div class="modal-header">
                        <h4 class="modal-title">Nová stránka</h4>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Zavřít"></button>
                    </div>
                    <div class="modal-body">
                        <label class="form-label" for="newPageName">Název stránky</label>
                        <input class="form-control" id="newPageName" type="text" name="name" maxlength="30" placeholder="Strana {{ pages|length + 1 }}">
                        <p class="text-muted small mt-2 mb-0">Prázdná stránka ve formátu {{ document.dimension.label }} se otevře v editoru.</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-tertiary sm" data-bs-dismiss="modal">Zpět</button>
                        <button type="submit" class="btn btn-primary sm">Vytvořit a upravit</button>
                    </div>
                </form>
            </div>
        </div>

        {% if document.dimension.isPrintFormat %}
            <div class="modal fade" id="documentPrintSettingsModal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <form class="modal-content" method="post" action="{{ path('template_document_print_settings', {'documentId': document.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf }}">
                        <div class="modal-header">
                            <h4 class="modal-title">Tiskové nastavení dokumentu</h4>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Zavřít"></button>
                        </div>
                        <div class="modal-body">
                            <div class="form-check">
                                <input class="form-check-input" id="documentCropMarks" type="checkbox" name="cropMarks" value="1" {{ document.dimension.cropMarks ? 'checked' : '' }}>
                                <label class="form-check-label" for="documentCropMarks">Ořezové značky</label>
                            </div>
                            <p class="text-muted small mt-2 mb-0">Grafika vždy přesahuje za hranu formátu o pevné 3&nbsp;mm. Ořezové značky se kreslí do pevného 5mm okraje vně tohoto přesahu.</p>
                            <p class="text-muted small mt-1 mb-0">Platí pro celý dokument — uloží se i do všech jeho stránek, aby tiskové PDF nemíchalo různá nastavení.</p>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-tertiary sm" data-bs-dismiss="modal">Zpět</button>
                            <button type="submit" class="btn btn-primary sm">Uložit</button>
                        </div>
                    </form>
                </div>
            </div>
        {% endif %}

        <div class="modal fade" id="deleteDocumentModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <form class="modal-content" method="post" action="{{ path('delete_template_document', {'documentId': document.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf }}">
                    <div class="modal-header">
                        <h4 class="modal-title">Smazat dokument „{{ document.name }}“?</h4>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Zavřít"></button>
                    </div>
                    <div class="modal-body tp-delmodes">
                        <p><b>Zrušit pouze dokument</b> — všechny stránky zůstanou zachovány a vrátí se mezi šablony jako samostatné šablony.</p>
                        <p class="tp-danger"><b>Smazat včetně stránek</b> — nevratně smaže dokument i všechny šablony jeho stránek.</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-tertiary sm" data-bs-dismiss="modal">Zpět</button>
                        <button type="submit" name="deletePages" value="0" class="btn btn-tertiary sm">Zrušit pouze dokument</button>
                        <button type="submit" name="deletePages" value="1" class="btn btn-danger sm">Smazat včetně stránek</button>
                    </div>
                </form>
            </div>
        </div>
    {% endif %}
{% endblock %}
