{% extends 'base_auth.html.twig' %}

{% block title %}Obnovení hesla{% endblock %}

{% block auth_body %}
    <div class="auth-top">
        <h1>Obnova hesla</h1>
        <p>Zadejte e-mail svého účtu a pošleme vám odkaz pro nastavení nového hesla.</p>
    </div>

    {{ include('_flashes.html.twig') }}

    {{ form_start(form, {'attr': {'class': 'auth-form'}}) }}
        {{ form_row(form.email, {'attr': {'placeholder': 'jmeno@firma.cz', 'autocomplete': 'email'}}) }}
        <button class="btn btn-primary auth-submit" type="submit">Obnovit heslo</button>
    {{ form_end(form) }}
{% endblock %}

{% block auth_below %}Zpět na <a href="{{ path('login') }}">přihlášení</a>{% endblock %}
