{% extends 'base_manual.html.twig' %}

{% block title %}{{ manual.name }}{% endblock %}
{% set active_menu_item = 'manuals' %}

{% block page_lead %}Barvy značky pro manuál, šablony a tisk. Kliknutím na barevný vzorek zkopírujete HEX. Změny uložíte tlačítkem Uložit.{% endblock %}

{#
    One colour card (prototype `.pal-card`): swatch (click = copy HEX) +
    HEX, role, computed RGB, CMYK with "Dopočítat z HEX", Pantone and RAL.
    Detected colours carry their HEX in a hidden field (the logo decides it);
    custom ones are editable and removable. Field names are unchanged —
    ManualColorsControllerTest reads them. `.form-group` is what the
    form-collection controller counts and removes.
#}
{% macro color_card(f, detected) %}
    <article class="pal-card{{ detected ? '' : ' form-group' }}" data-controller="custom-color" data-order-field-target>
        <button type="button" class="pal-sw" data-custom-color-target="colorDisplay" data-action="custom-color#copy" title="Kliknutím zkopírujete HEX" aria-label="Zkopírovat HEX">
            <span class="pal-src">{{ detected ? 'Z logotypu' : 'Vlastní' }}</span>
            {{ icon('copy', 's16') }}
        </button>
        <div class="pal-body">
            <div class="pal-row1">
                {% if detected %}
                    <div class="pal-f hex">
                        <span>HEX</span>
                        <span class="pal-hex-ro">#{{ f.color.vars.value|upper }}</span>
                    </div>
                    {{ form_widget(f.color, {'attr': {'data-custom-color-target': 'input'}}) }}
                {% else %}
                    <label class="pal-f hex">
                        <span>HEX</span>
                        {{ form_widget(f.color, {'attr': {'placeholder': 'např. D03F50', 'data-custom-color-target': 'input', 'data-action': 'input->custom-color#updateColor'}}) }}
                    </label>
                {% endif %}
                <label class="pal-f role">
                    <span>Role</span>
                    {{ form_widget(f.type) }}
                </label>
                <span class="pal-acts">
                    <span class="dragula-handle pal-grip" title="Přetažením změníte pořadí">{{ icon('grip', 's16') }}</span>
                    {% if not detected %}
                        <button type="button" class="btn ghost danger icon xs" title="Odebrat barvu" aria-label="Odebrat barvu" data-action="form-collection#remove">{{ icon('trash', 's16') }}</button>
                    {% endif %}
                </span>
            </div>
            <span class="cap pal-rgb" data-custom-color-target="rgb">RGB —</span>
            <div class="pal-cmyk">
                {% for channel in ['c', 'm', 'y', 'k'] %}
                    <label class="pal-f">
                        <span>{{ channel|upper }}</span>
                        {{ form_widget(f[channel], {'attr': {'placeholder': '', 'inputmode': 'numeric', 'data-custom-color-target': 'cmyk', 'data-action': 'input->custom-color#updateColor'}}) }}
                    </label>
                {% endfor %}
                <button type="button" class="btn ghost xs pal-calc" data-action="custom-color#calc">Dopočítat z HEX</button>
            </div>
            <div class="pal-row3">
                <label class="pal-f"><span>Pantone</span>{{ form_widget(f.pantone, {'attr': {'placeholder': 'např. 534 C'}}) }}</label>
                <label class="pal-f"><span>RAL</span>{{ form_widget(f.ral, {'attr': {'placeholder': 'např. RAL 5003'}}) }}</label>
            </div>
            {{ form_errors(f.color) }}
        </div>
        {{ form_widget(f.order) }}
    </article>
{% endmacro %}

{% block content %}
<div class="stack">
    {{ include('_manual_nav.html.twig') }}

    {% set all_colors = form.detectedColors|merge(form.customColors) %}
    {% set no_cmyk = all_colors|filter(f => f.c.vars.value is empty and f.m.vars.value is empty and f.y.vars.value is empty and f.k.vars.value is empty)|length %}
    {% set no_role = all_colors|filter(f => f.type.vars.value is empty)|length %}

    {{ form_start(form, {'attr': {'class': 'man-form'}}) }}
    {{ form_errors(form) }}
    <div class="man-form" data-controller="form-collection" data-form-collection-append-value="true">
        <div class="gal-nav" role="toolbar" aria-label="Paleta barev">
            <button type="button" class="btn btn-primary sm" data-action="form-collection#add">{{ icon('plus', 's16') }}Přidat barvu</button>
            <span class="gal-nav-sp" aria-hidden="true"></span>
            {% if all_colors is not empty %}
                <span class="pal-strip" aria-label="Náhled palety">
                    {% for f in all_colors %}<span style="background: #{{ f.color.vars.value }};" title="#{{ f.color.vars.value|upper }}"></span>{% endfor %}
                </span>
            {% endif %}
        </div>

        {% if manual.colorsCount < 3 %}
            <div class="alert c-warning">
                {{ icon('alert') }}
                <div>
                    <div class="alert-t">Manuál potřebuje alespoň 3 barvy</div>
                    <div class="alert-d">Přidejte vlastní barvu, aby se paleta v manuálu zobrazila správně.</div>
                </div>
            </div>
        {% elseif no_cmyk > 0 or no_role > 0 %}
            <div class="alert c-info">
                {{ icon('info') }}
                <div class="alert-d">
                    {% if no_cmyk > 0 %}{{ no_cmyk == 1 ? '1 barvě chybí' : no_cmyk ~ ' barvám chybí' }} CMYK pro tisk{% endif %}{% if no_cmyk > 0 and no_role > 0 %} · {% endif %}{% if no_role > 0 %}{{ no_role == 1 ? '1 barva nemá' : no_role ~ (no_role < 5 ? ' barvy nemají' : ' barev nemá') }} roli{% endif %}. Bez role šablona neví, kam barvu použít.
                </div>
            </div>
        {% endif %}

        <section class="pal-group" aria-labelledby="pal-detected">
            <div class="pal-gh"><h2 id="pal-detected">Detekováno z logotypu <span class="pd-n">{{ form.detectedColors|length }}</span></h2></div>
            {% if form.detectedColors is empty %}
                <p class="cap pal-none">Z nahraných logotypů zatím nejsou rozpoznané žádné barvy.</p>
            {% endif %}
            <div class="pal-grid" data-controller="colors-dragula" data-colors-dragula-target="container">
                {% for detectedColorForm in form.detectedColors %}
                    {{ _self.color_card(detectedColorForm, true) }}
                {% endfor %}
            </div>
        </section>

        {% set custom_prototype %}{{ _self.color_card(form.customColors.vars.prototype, false) }}{% endset %}
        <section class="pal-group" aria-labelledby="pal-custom">
            <div class="pal-gh">
                <h2 id="pal-custom">Vlastní barvy <span class="pd-n">{{ form.customColors|length }}</span></h2>
                <span class="cap">Barvy, které v logu nejsou — doplňkové, textové, pozadí.</span>
            </div>
            <div class="pal-grid"
                 data-controller="colors-dragula"
                 data-colors-dragula-target="container"
                 data-form-collection-target="collection"
                 data-prototype="{{ custom_prototype|e('html_attr') }}">
                {% for customColorForm in form.customColors %}
                    {{ _self.color_card(customColorForm, false) }}
                {% endfor %}
            </div>
        </section>

        <div class="man-savebar">
            <span class="cap">Změny v paletě se uloží až tlačítkem.</span>
            <button class="btn btn-primary sm" type="submit">{{ icon('check', 's16') }}Uložit</button>
        </div>
    </div>
    {{ form_end(form) }}
</div>
{% endblock %}
