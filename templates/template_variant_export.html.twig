{% extends 'base.html.twig' %}

{% block title %}Export - Varianta {{ variant.dimension.label }} ({{ variant.dimension.width }}x{{ variant.dimension.height }}px){% endblock %}
{% set active_menu_item = 'templates' %}

{% block title_actions %}
    <div class="text-sm-end mb-3 d-flex justify-content-sm-end gap-2">
        {{ include('_export_history_menu.html.twig', {
            versions: export_versions,
            loaded_version: loaded_version,
            route_name: 'template_variant_export',
            route_params: {'variantId': variant.id},
        }) }}
        {% if is_granted('template_variant_edit', variant) %}
            <a href="{{ path('template_variant_editor', {'variantId': variant.id}) }}" class="btn btn-primary"><i class="mdi mdi-pencil"></i> Zpět na editor</a>
        {% endif %}
    </div>
{% endblock %}

{% block breadcrumb %}
    <ol class="breadcrumb m-0 pt-0">
        <li class="breadcrumb-item"><i class="uil-home-alt"></i> <a href="{{ path('homepage') }}">Projekty</a></li>
        <li class="breadcrumb-item"><a href="{{ path('project_dashboard', {'id': project.id}) }}">{{ project.name }}</a></li>
        <li class="breadcrumb-item"><a href="{{ path('templates', {'projectId': project.id}) }}">Šablony</a></li>
        <li class="breadcrumb-item"><a href="{{ path('template_variants', {'templateId': template.id}) }}">{{ template.name }}</a></li>
        <li class="breadcrumb-item active">{{ block('title') }}</li>
    </ol>
{% endblock %}

{% block content %}
    {# Shared editor modules (classic scripts, window globals) + the project
       @font-face declarations — the fill overlay measures wrapped text with
       the same Fabric patches and fonts the headless render uses, and the
       text echo paints with them. Loaded HERE, on the page, because the
       component below mounts with loading="defer" and scripts inserted by a
       Live morph never execute. #}
    <div hidden>
        <script src="{{ asset('editor/fabric_break_word.js') }}"></script>
        <script src="{{ asset('editor/container_layout.js') }}"></script>
        <script src="{{ asset('editor/rich_text_runs.js') }}"></script>
        <script src="{{ asset('editor/rich_text_blocks.js') }}"></script>
        <script src="{{ asset('editor/fill_text_echo.js') }}"></script>
        <style>
            {% for face in font_faces %}
                @font-face {
                    font-family: '{{ face.family }}';
                    src: url('{{ face.url }}');
                }
            {% endfor %}
        </style>
    </div>

    {% if loaded_version %}
        {{ include('_export_history_banner.html.twig', {
            loaded_version: loaded_version,
            clear_url: path('template_variant_export', {'variantId': variant.id}),
        }) }}
    {% endif %}

    {# The fill UI is driven by a Live Component; it renders its own preview
       server-side (Gotenberg PNG → base64 data URI). `loading="defer"` keeps
       those Gotenberg calls OUT of this page request — the shell paints
       instantly and the component arrives via a follow-up Live request (see
       the placeholder macro in the component template). The seed props carry
       a loaded export version's fill state (empty otherwise) — postMount's
       `??=` sample-seeding fills only what the version left blank. #}
    <twig:Template:VariantFiller
        :variant="variant"
        :facebookConnected="facebookConnected"
        :textValues="seed_text_values"
        :hiddenValues="seed_hidden_values"
        :seedImageValues="seed_image_values"
        loading="defer"
    />
{% endblock %}
