{% extends 'base.html.twig' %}

{% set active_menu_item = 'templates' %}

{% block title %}Synchronizovaná šablona z existující{% endblock %}
{% block page_lead %}Vyberte variantu, která poslouží jako výchozí design nové skupiny. Design se <b>zkopíruje</b> do všech rozměrů skupiny (poměrově přepočítaný) — původní šablona zůstane beze změny.{% endblock %}

{% block title_actions %}
    <a href="{{ path('add_template_group', {'projectId': project.id}) }}" class="btn btn-tertiary">{{ icon('plus', 's16') }}Raději začít od nuly</a>
{% endblock %}

{% block breadcrumb %}
    <ol class="breadcrumb m-0 pt-0">
        <li class="breadcrumb-item"><a href="{{ path('templates', {'projectId': project.id}) }}">Šablony</a></li>
        <li class="breadcrumb-item active">{{ block('title') }}</li>
    </ol>
{% endblock %}

{% block content %}
    {% if templates|length == 0 %}
        <div class="empty">
            <span class="ico-c">{{ icon('image') }}</span>
            <h2>Zatím není z čeho vyjít</h2>
            <p>Vytvořte nejdřív šablonu — nebo založte skupinu s prázdným plátnem.</p>
            <a href="{{ path('add_template_group', {'projectId': project.id}) }}" class="btn btn-primary sm">{{ icon('plus', 's16') }}Nová skupina od nuly</a>
        </div>
    {% endif %}

    <div class="tp-srclist">
        {% for template in templates %}
            <section class="tp-src">
                <div class="tp-src-h">
                    <b>{{ template.name }}</b>
                    {% if template.category %}<span class="pill neutral">{{ template.category.name }}</span>{% endif %}
                    {% if template.group %}<span class="pill">{{ icon('refresh', 's12') }}Skupina: {{ template.group.name }}</span>{% endif %}
                </div>
                <div class="tp-src-tiles">
                    {% for variant in template.variants %}
                        {% set thumb = variant.previewImagePath ?: variant.backgroundImage %}
                        <a href="{{ path('add_template_group', {'projectId': project.id, 'sourceVariantId': variant.id}) }}"
                           class="tp-src-tile"
                           title="Použít tento design jako výchozí">
                            <span class="tp-src-thumb" style="aspect-ratio: {{ variant.dimension.width }} / {{ variant.dimension.height }};{% if thumb %} background-image: url('{{ uploaded_asset(thumb) }}');{% endif %}"></span>
                            <span class="tp-src-l">{{ variant.dimension.label }}</span>
                            <span class="tp-src-cta">Použít {{ icon('arrow-right', 's12') }}</span>
                        </a>
                    {% endfor %}
                </div>
            </section>
        {% endfor %}
    </div>
{% endblock %}
