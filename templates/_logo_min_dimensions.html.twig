{# One card of the "minimální rozměry" page — the logo with its width/height
   annotations. Params: logo (SvgImage), slot (string), logo_variant (string);
   the last two size the card through the shared logo-image partial. #}
<div class="col-12">
    <div class="border border-1 p-4 rounded-4 mb-4 manual-image-wrapper manual-image-vertical-big" style="background: #ffffff;">
        {% set colorsMapping = {} %}

        <div class="{{ logo.widthInfo ? 'with-width-info' }} {{ logo.heightInfo ? 'with-height-info' }} d-inline-block">
            <div class="position-relative d-inline-block">
                {% if logo.widthInfo %}
                    <div class="logo-width-info">
                        {{ logo.widthInfo }}
                    </div>
                {% endif %}

                {% if logo.heightInfo %}
                    <div class="logo-height-info">
                        <div>
                            {{ logo.heightInfo }}
                        </div>
                    </div>
                {% endif %}

                {{ include('_manual_logo_image.html.twig', {'logo': logo, 'slot': slot, 'logo_variant': logo_variant}) }}
            </div>
        </div>
    </div>
</div>
