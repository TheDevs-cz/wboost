{% extends 'base.html.twig' %}

{% set active_menu_item = 'weekly_menus' %}

{% block title %}Jídelníčky{% endblock %}
{% block title_count %}{{ menus|length }}{% endblock %}
{% block page_lead %}Týdenní jídelníčky sestavené z vašeho seznamu jídel — s veřejným odkazem, PDF ke stažení a schválením od klienta.{% endblock %}

{% block title_actions %}
    {% if is_granted('project_edit', project) %}
        <a href="{{ path('add_weekly_menu', {'projectId': project.id}) }}" class="btn btn-primary">{{ icon('plus', 's16') }}Nový jídelníček</a>
    {% endif %}
{% endblock %}

{% block mobile_primary_action %}
    {% if is_granted('project_edit', project) %}
        <a href="{{ path('add_weekly_menu', {'projectId': project.id}) }}" class="btn btn-primary icon" aria-label="Nový jídelníček">{{ icon('plus') }}</a>
    {% endif %}
{% endblock %}

{% block breadcrumb %}
    <ol class="breadcrumb m-0 pt-0">
        <li class="breadcrumb-item"><a href="{{ path('project_dashboard', {'id': project.id}) }}">{{ project.name }}</a></li>
        <li class="breadcrumb-item active">{{ block('title') }}</li>
    </ol>
{% endblock %}

{% block content %}
    <div class="wm-page">
        {{ include('weekly_menu/_nav.html.twig') }}

        {% if menus|length == 0 %}
            <div class="empty">
                <span class="ico-c">{{ icon('calendar') }}</span>
                <h2>Zatím tu nejsou žádné jídelníčky</h2>
                <p>Jídelníček je týden rozdělený na dny a chody. Jídla do něj vybíráte ze seznamu jídel.</p>
                {% if is_granted('project_edit', project) %}
                    <a href="{{ path('add_weekly_menu', {'projectId': project.id}) }}" class="btn btn-primary btn-sm">{{ icon('plus', 's16') }}Vytvořit první jídelníček</a>
                {% endif %}
            </div>
        {% else %}
            <ul class="wm-grid">
                {% for menu in menus %}
                    {# Read-only members (project shared for reading) get the public
                       view instead of the planner/edit links, which 403 for them (P10b). #}
                    {% set can_edit_menu = is_granted('weekly_menu_edit', menu) %}
                    {% set menu_href = can_edit_menu ? path('weekly_menu_planner', {'menuId': menu.id}) : path('public_weekly_menu', {'menuId': menu.id}) %}
                    <li class="wm-card">
                        <div class="wm-card-h">
                            <span class="wm-ico">{{ icon('calendar', 's18') }}</span>
                            <div class="wm-card-t">
                                <h2 class="wm-name"><a href="{{ menu_href }}"{{ can_edit_menu ? '' : ' target="_blank"' }}>{{ menu.name }}</a></h2>
                                <span class="cap">{{ menu.validFrom|date('j. n. Y') }} – {{ menu.validTo|date('j. n. Y') }}</span>
                            </div>
                            <div class="dropdown wm-acts">
                                <button type="button" class="btn btn-ghost icon xs" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Možnosti jídelníčku">{{ icon('more', 's16') }}</button>
                                <div class="dropdown-menu dropdown-menu-end">
                                    {% if can_edit_menu %}
                                        <a href="{{ path('edit_weekly_menu', {'menuId': menu.id}) }}" class="dropdown-item">{{ icon('edit', 's16') }}Upravit</a>
                                    {% endif %}
                                    <a href="{{ path('download_weekly_menu_pdf', {'menuId': menu.id}) }}" class="dropdown-item">{{ icon('download', 's16') }}Stáhnout PDF</a>
                                    <a href="{{ path('public_weekly_menu', {'menuId': menu.id}) }}" class="dropdown-item" target="_blank">{{ icon('link', 's16') }}Veřejný odkaz</a>
                                    {% if is_granted('project_edit', project) and menu.approvalEmail is not null and menu.approvalStatus.value in ['not_requested', 'denied'] %}
                                        <div class="dropdown-divider"></div>
                                        <form action="{{ path('request_weekly_menu_approval', {'menuId': menu.id}) }}" method="post">
                                            <button type="submit" class="dropdown-item" onclick="return confirm('Odeslat žádost o schválení na {{ menu.approvalEmail }}?');">{{ icon('mail', 's16') }}Požádat o schválení</button>
                                        </form>
                                    {% endif %}
                                    {% if is_granted('project_edit', project) %}
                                        <form action="{{ path('duplicate_weekly_menu', {'menuId': menu.id}) }}" method="post">
                                            <button type="submit" class="dropdown-item">{{ icon('copy', 's16') }}Duplikovat</button>
                                        </form>
                                        <div class="dropdown-divider"></div>
                                        <form action="{{ path('delete_weekly_menu', {'menuId': menu.id}) }}" method="post" onsubmit="return confirm('Opravdu chcete smazat tento jídelníček?');">
                                            <button type="submit" class="dropdown-item text-danger">{{ icon('trash', 's16') }}Smazat</button>
                                        </form>
                                    {% endif %}
                                </div>
                            </div>
                        </div>

                        {% if menu.approvalEmail is not null %}
                            <div class="wm-approval">
                                {{ include('weekly_menu/_status_pill.html.twig', {status: menu.approvalStatus}) }}
                                {% if menu.approvalStatus.value in ['approved', 'denied'] and menu.approvalRespondedAt %}
                                    <span class="cap">{{ menu.approvalEmail }} · {{ menu.approvalRespondedAt|date('j. n. Y H:i') }}</span>
                                {% endif %}
                                {% if menu.approvalComment is not empty %}
                                    <q class="wm-quote">{{ menu.approvalComment }}</q>
                                {% endif %}
                            </div>
                        {% endif %}

                        <div class="wm-card-f">
                            <span class="cap">
                                Vytvořeno {{ menu.createdAt|date('j. n. Y') }}{% if menu.updatedAt %} · upraveno {{ menu.updatedAt|date('j. n. Y H:i') }}{% endif %}
                            </span>
                            {% if can_edit_menu %}
                                <a href="{{ path('weekly_menu_planner', {'menuId': menu.id}) }}" class="btn btn-tertiary btn-sm wm-build">{{ icon('edit', 's16') }}Sestavit</a>
                            {% else %}
                                <a href="{{ menu_href }}" class="btn btn-tertiary btn-sm wm-build" target="_blank">{{ icon('eye', 's16') }}Zobrazit</a>
                            {% endif %}
                        </div>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </div>
{% endblock %}
