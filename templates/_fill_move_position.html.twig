{#
    "Poloha" — exact values of ONE user-movable element's offset, in the
    variant's unit (px whole, mm / cm at 300 DPI like the image adjust panel).
    Rendered in the element's text / shape popover, the container sheet
    head, the "Všechna pole" card of an element without a popover, and the
    move-mode chip — every copy is synced from the element's two
    `offsetValues[<id>][x|y]` mirrors by fill_element_move.js, which also
    wires the steppers, the inputs and "Vrátit" by delegation (no names: the
    mirrors are the only form fields).

    Params:
    - m:    one FillMovableElements row
    - unit: the variant's DimensionUnit value ('px' | 'mm' | 'cm')
#}
{% set step = unit == 'px' ? '1' : (unit == 'cm' ? '0.01' : '0.1') %}
{% set axes = [] %}
{% if m.allowance.vertical %}
    {% set axes = axes|merge([{axis: 'y', key: '↕', label: 'Svisle', less: 'Nahoru', more: 'Dolů', less_icon: 'arrow-up', more_icon: 'arrow-down', hint: m.hints.vertical, aria: 'Svislý posun v ' ~ unit ~ ' (kladný = dolů)'}]) %}
{% endif %}
{% if m.allowance.horizontal %}
    {% set axes = axes|merge([{axis: 'x', key: '↔', label: 'Vodorovně', less: 'Doleva', more: 'Doprava', less_icon: 'arrow-left', more_icon: 'arrow-right', hint: m.hints.horizontal, aria: 'Vodorovný posun v ' ~ unit ~ ' (kladný = doprava)'}]) %}
{% endif %}
<div class="fill-move-pos" data-move-position="{{ m.id }}" role="group" aria-label="Poloha: {{ m.name }}">
    <div class="fill-move-pos__head">
        <span class="fill-move-pos__title">Poloha</span>
        <button type="button" class="btn btn-ghost xs fill-move-pos__reset" data-move-reset="{{ m.id }}" title="Vrátit na původní místo" disabled>{{ icon('undo', 's14') }}Vrátit</button>
    </div>
    {% for a in axes %}
        <div class="fill-move-pos__axis">
            <span class="fill-move-pos__label" title="{{ a.hint }}"><span aria-hidden="true">{{ a.key }}</span> {{ a.label }}</span>
            <button type="button" class="btn btn-ghost icon xs fill-move-pos__step" data-move-step="{{ m.id }}" data-move-axis="{{ a.axis }}" data-move-dir="-1" title="{{ a.less }}" aria-label="{{ a.less }}">{{ icon(a.less_icon, 's14') }}</button>
            <label class="fill-adjust__field fill-move-pos__field">
                <input type="number" class="form-control" step="{{ step }}" inputmode="decimal" value="0"
                       data-move-input="{{ m.id }}" data-move-axis="{{ a.axis }}" aria-label="{{ a.aria }}">
                <span class="fill-adjust__unit" aria-hidden="true">{{ unit }}</span>
            </label>
            <button type="button" class="btn btn-ghost icon xs fill-move-pos__step" data-move-step="{{ m.id }}" data-move-axis="{{ a.axis }}" data-move-dir="1" title="{{ a.more }}" aria-label="{{ a.more }}">{{ icon(a.more_icon, 's14') }}</button>
        </div>
        <p class="cap fill-move-pos__hint">{{ a.hint }}</p>
    {% endfor %}
</div>
