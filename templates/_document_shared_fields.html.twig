{#
    "Společná pole" on the document page (designers only): the shared fields
    with their bound pages, one-click suggestions, and the add / edit modal.
    Every action POSTs to `template_document_fields` (the full list is rebuilt
    server-side), carrying the `template_document` CSRF token. Each modal is
    its own <form> — none is nested in another.

    Parameters: document, shared_fields (DocumentFieldsView::build()), csrf.
#}
<section class="tp-sec td-fields" id="shared-fields">
    <div class="td-pageh">
        <div class="tp-sech">
            <h2>{{ icon('link', 's18') }}Společná pole</h2>
            <p class="cap">Stránky se vyplňují každá zvlášť — i když mají stejná pole. Společné pole se vyplní jednou a propíše se do všech propojených stránek.</p>
        </div>
        <button type="button" class="btn btn-tertiary sm" data-bs-toggle="modal" data-bs-target="#documentFieldModal-new">{{ icon('plus', 's16') }}Přidat pole</button>
    </div>

    {% if shared_fields.fields is empty %}
        <p class="tp-hint">Zatím žádná společná pole.</p>
    {% else %}
        <ul class="td-fieldlist">
            {% for entry in shared_fields.fields %}
                {% set field = entry.field %}
                <li class="td-field" data-document-field="{{ field.id }}">
                    <div class="td-field-b">
                        <div class="td-field-t">
                            <b>{{ field.name }}</b>
                            <span class="pill neutral" data-document-field-kind>{{ entry.textMode ? entry.textMode.label : field.kind.label }}</span>
                            {% if entry.stale > 0 %}
                                <span class="pill pch" data-document-field-stale title="Propojený prvek na stránce už neexistuje — při příštím uložení pole se propojení odstraní.">
                                    {{ icon('alert', 's12') }}{{ entry.stale }}× neplatné propojení
                                </span>
                            {% endif %}
                        </div>
                        <span class="cap">
                            {% for binding in entry.bindings %}
                                <span class="{{ binding.stale ? 'text-decoration-line-through' : '' }}">{% if binding.pageNumber %}Strana {{ binding.pageNumber }}{% else %}{{ binding.pageName }}{% endif %} · {{ binding.inputName }}</span>{{ not loop.last ? ', ' }}
                            {% else %}
                                Nepropojeno s žádnou stránkou.
                            {% endfor %}
                        </span>
                    </div>
                    <button type="button" class="btn btn-ghost sm" data-bs-toggle="modal" data-bs-target="#documentFieldModal-{{ field.id }}">{{ icon('edit', 's16') }}Upravit</button>
                </li>
            {% endfor %}
        </ul>
    {% endif %}

    {% if shared_fields.suggestions is not empty %}
        <div class="tp-hint">{{ icon('sparkle', 's14') }} Návrhy — stejné pole na více stránkách:</div>
        <div class="td-suggest">
            {% for suggestion in shared_fields.suggestions %}
                <form method="post" action="{{ path('template_document_fields', {'documentId': document.id}) }}" data-document-field-suggestion>
                    <input type="hidden" name="_token" value="{{ csrf }}">
                    <input type="hidden" name="name" value="{{ suggestion.name }}">
                    <input type="hidden" name="kind" value="{{ suggestion.kind }}">
                    {% for binding in suggestion.bindings %}
                        <input type="hidden" name="bindings[{{ binding.templateId }}]" value="{{ binding.inputId }}">
                    {% endfor %}
                    <button type="submit" class="btn btn-tertiary sm" title="Vytvořit společné pole „{{ suggestion.name }}“ ({{ suggestion.label }})">
                        {{ icon('link', 's16') }}{{ suggestion.name }} <span class="cap">({{ suggestion.label }})</span>
                    </button>
                </form>
            {% endfor %}
        </div>
    {% endif %}
</section>

{% set text_mode_suffix = {rich: ' (formátovaný)', list: ' (se seznamy)', checklist: ' (zaškrtávací seznam)'} %}
{% set field_modals = [{id: 'new', field: null, selected: {}}] %}
{% for entry in shared_fields.fields %}
    {% set field_modals = field_modals|merge([{id: entry.field.id ~ '', field: entry.field, selected: entry.selected}]) %}
{% endfor %}

{% for modal in field_modals %}
    {% set field = modal.field %}
    {% set kind = field ? field.kind.value : 'text' %}
    <div class="modal fade" id="documentFieldModal-{{ modal.id }}" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
            <form class="modal-content" method="post" action="{{ path('template_document_fields', {'documentId': document.id}) }}"
                  data-controller="document-field-form">
                <input type="hidden" name="_token" value="{{ csrf }}">
                <input type="hidden" name="fieldId" value="{{ field ? field.id : '' }}">
                <div class="modal-header">
                    <h4 class="modal-title">{{ field ? 'Upravit společné pole' : 'Nové společné pole' }}</h4>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Zavřít"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label" for="documentFieldName-{{ modal.id }}">Název</label>
                    <input class="form-control mb-2" id="documentFieldName-{{ modal.id }}" type="text" name="name" maxlength="100" required value="{{ field ? field.name : '' }}" placeholder="např. Jméno klienta">

                    <label class="form-label" for="documentFieldKind-{{ modal.id }}">Typ</label>
                    <select class="form-select mb-3" id="documentFieldKind-{{ modal.id }}" name="kind"
                            data-document-field-form-target="kind" data-action="document-field-form#kindChanged">
                        <option value="text" {{ kind == 'text' ? 'selected' }}>Text</option>
                        <option value="image" {{ kind == 'image' ? 'selected' }}>Obrázek</option>
                        <option value="shape" {{ kind == 'shape' ? 'selected' }}>Barva tvaru</option>
                    </select>

                    <div class="form-label">Propojení se stránkami</div>
                    {% for page in shared_fields.pages %}
                        {% set current = modal.selected[page.templateId] ?? '' %}
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <label class="small text-muted text-nowrap" style="min-width: 5.5rem;" for="documentFieldBinding-{{ modal.id }}-{{ page.number }}">Strana {{ page.number }}</label>
                            <select class="form-select form-select-sm" id="documentFieldBinding-{{ modal.id }}-{{ page.number }}" name="bindings[{{ page.templateId }}]"
                                    data-document-field-form-target="binding" title="{{ page.name }}">
                                <option value="">nepropojeno</option>
                                <optgroup label="Texty — {{ page.name }}" data-kind="text">
                                    {% for input in page.text %}
                                        <option value="{{ input.inputId }}" {{ kind == 'text' and current == input.inputId ? 'selected' }}>{{ input.name }}{{ text_mode_suffix[input.mode] ?? '' }}</option>
                                    {% endfor %}
                                </optgroup>
                                <optgroup label="Obrázky — {{ page.name }}" data-kind="image">
                                    {% for input in page.image %}
                                        <option value="{{ input.inputId }}" {{ kind == 'image' and current == input.inputId ? 'selected' }}>{{ input.name }}</option>
                                    {% endfor %}
                                </optgroup>
                                <optgroup label="Barvy tvarů — {{ page.name }}" data-kind="shape">
                                    {% for input in page.shape %}
                                        <option value="{{ input.inputId }}" {{ kind == 'shape' and current == input.inputId ? 'selected' }}>{{ input.name }}</option>
                                    {% endfor %}
                                </optgroup>
                            </select>
                        </div>
                    {% endfor %}
                    <p class="text-muted small mb-0">Na každé stránce lze pole propojit nejvýš s jedním prvkem. Společný text nabídne to, co zvládnou všechny propojené prvky: formátování a seznamy jen tehdy, když je mají všechny (jinak prostý text), písma a barvy společné všem. Zaškrtávací seznam lze propojit jen s dalšími zaškrtávacími seznamy. Obrázek se vybírá jednou, umístění se upravuje na každé stránce zvlášť; barva tvaru platí pro všechny propojené tvary.</p>
                </div>
                <div class="modal-footer">
                    {% if field %}
                        <button type="submit" name="delete" value="1" class="btn btn-ghost-danger sm me-auto" formnovalidate>Odstranit pole</button>
                    {% endif %}
                    <button type="button" class="btn btn-tertiary sm" data-bs-dismiss="modal">Zpět</button>
                    <button type="submit" class="btn btn-primary sm">Uložit</button>
                </div>
            </form>
        </div>
    </div>
{% endfor %}
