{% extends 'base.html.twig' %}

{% block title %}{{ variant.name }}{% endblock %}
{% set active_menu_item = 'emails' %}

{% block eyebrow %}{{ email_template.name }} · Varianta podpisu{% endblock %}

{% block title_actions %}
    <button type="button" class="btn btn-tertiary" data-bs-toggle="modal" data-bs-target="#demo-variant-{{ variant.id }}">{{ icon('mail', 's16') }}Odeslat zkušební e-mail</button>
{% endblock %}

{% block breadcrumb %}
    <ol class="breadcrumb m-0 pt-0">
        <li class="breadcrumb-item"><a href="{{ path('email_signature_templates', {'id': project.id}) }}">E-maily</a></li>
        <li class="breadcrumb-item"><a href="{{ path('email_signature_variants', {'id': email_template.id}) }}">{{ email_template.name }}</a></li>
        <li class="breadcrumb-item active">{{ variant.name }}</li>
    </ol>
{% endblock %}

{% block content %}
    {# The signature is HTML somebody typed (the template: the project's owner or an admin; a variant's
       texts: anyone the project is shared with). It is shown in a frame of its own, sandboxed WITHOUT
       allow-scripts, under a policy that allows no script, frame, request or form: nothing in it runs
       in the app and its styles stay in the frame. `allow-same-origin` only lets this page size the
       frame to its content — without allow-scripts the content cannot use it.
       The rule and the mechanics: assets/controllers/email_signature_export_controller.js #}
    {% set preview_policy = "default-src 'none'; img-src * data:; media-src *; style-src 'unsafe-inline' http: https:; font-src http: https: data:; form-action 'none'" %}
    <div class="es-edit" data-controller="email-signature-export" data-email-signature-export-preview-policy-value="{{ preview_policy }}" data-email-signature-export-source-html-value="{{ email_template.code }}" data-email-signature-export-variant-name-value="{{ variant.name }}" data-email-signature-export-vcard-qr-url-value="{{ url('email_signature_variant_vcard_qr_code', {'variantId': variant.id}) }}">
        {{ form_start(form, {'attr': {'class': 'es-edit-grid'}}) }}

        <section class="pd-box es-fields" aria-labelledby="es-fields-h">
            <div class="pd-box-h">
                <div>
                    <h2 id="es-fields-h">Texty podpisu</h2>
                    <p class="cap mb-0">Změny se hned propíší do náhledu. Uložte je tlačítkem dole.</p>
                </div>
            </div>

            {{ form_row(form.name) }}

            {% for input in email_template.textInputs %}
                <div class="es-field">
                    <label class="form-label" for="text-input-{{ loop.index0 }}">{{ input.content }}</label>
                    <input
                        type="text"
                        class="form-control"
                        id="text-input-{{ loop.index0 }}"
                        data-email-signature-export-target="input"
                        data-action="input->email-signature-export#update"
                        data-text-input-id="{{ input.id }}"
                        value="{{ variant.inputValue(input.id) ?? input.content }}"
                        name="textInput[{{ input.id }}]"
                    >
                </div>
            {% endfor %}

            <div class="es-fields-f">
                <a href="{{ path('email_signature_variants', {'id': email_template.id}) }}" class="btn btn-tertiary sm">Zrušit</a>
                <button class="btn btn-primary sm" type="submit">Uložit</button>
            </div>
        </section>

        <div class="es-out">
            <section class="pd-box" aria-labelledby="es-preview-h">
                <div class="pd-box-h">
                    <div>
                        <h2 id="es-preview-h">{{ icon('eye', 's18') }}Náhled</h2>
                        <p class="cap mb-0">Takhle podpis uvidí příjemce e-mailu.</p>
                    </div>
                </div>
                <div class="es-preview">
                    <iframe class="es-preview-frame" data-email-signature-export-target="preview" sandbox="allow-same-origin" referrerpolicy="no-referrer" scrolling="no" title="Náhled podpisu"></iframe>
                </div>
            </section>

            <section class="pd-box" aria-labelledby="es-code-h">
                <div class="pd-box-h">
                    <div>
                        <h2 id="es-code-h">{{ icon('file', 's18') }}HTML kód</h2>
                        <p class="cap mb-0">Vložte ho do nastavení podpisu ve svém e-mailovém programu.</p>
                    </div>
                    <button type="button" class="btn btn-tertiary sm" data-action="click->email-signature-export#downloadHtml">{{ icon('download', 's16') }}Stáhnout HTML</button>
                </div>
                {{ form_widget(form.code, { attr: { 'data-email-signature-export-target': 'codeInput', 'rows': 8, 'readonly': 'readonly', 'class': 'form-control font-monospace es-code' } }) }}
            </section>
        </div>

        {{ form_end(form) }}
    </div>

    {{ include('_email_signature_demo_modal.html.twig', {
        modal_id: 'demo-variant-' ~ variant.id,
        action: path('email_signature_variant_send_demo', {'id': variant.id}),
        subject_name: variant.name,
        note: 'Odešle se naposledy uložená verze varianty — neuložené změny nejprve uložte.',
    }) }}
{% endblock %}
