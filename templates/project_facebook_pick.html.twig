{% extends 'base.html.twig' %}

{% block title %}Vyberte facebookovou stránku{% endblock %}
{% set active_menu_item = 'social' %}

{% block breadcrumb %}
    <ol class="breadcrumb m-0 pt-0">
        <li class="breadcrumb-item"><a href="{{ path('project_dashboard', {'id': project.id}) }}">{{ project.name }}</a></li>
        <li class="breadcrumb-item"><a href="{{ path('project_social', {'projectId': project.id}) }}">Facebook a Instagram</a></li>
        <li class="breadcrumb-item active">{{ block('title') }}</li>
    </ol>
{% endblock %}

{% block page_lead %}
    Při propojení jste sdíleli víc facebookových stránek. Vyberte tu, na kterou má projekt {{ project.name }} publikovat.
{% endblock %}

{# FacebookPageConnectPickController — one POST form per account (no nesting). #}
{% block content %}
    <section class="pd-box" aria-labelledby="socPickH">
        <div class="pd-box-h">
            <div>
                <h2 id="socPickH">Facebookové stránky</h2>
                <span class="cap">Ostatní stránky zůstanou nepropojené; změnit stránku můžete kdykoli později.</span>
            </div>
        </div>
        {% for page in pages %}
            <div class="acc-row" data-facebook-pick="{{ page.name }}">
                <span class="acc-ico">{{ icon('facebook', 's16') }}</span>
                <span class="who">
                    <b>{{ page.name }}</b>
                </span>
                <form method="post" action="{{ path('project_facebook_pick', {'projectId': project.id}) }}" class="acc-acts">
                    <input type="hidden" name="_token" value="{{ csrf_token('project_facebook_pick') }}">
                    <input type="hidden" name="page" value="{{ page.id }}">
                    <button type="submit" class="btn btn-primary sm">Propojit</button>
                </form>
            </div>
        {% endfor %}
    </section>
{% endblock %}
