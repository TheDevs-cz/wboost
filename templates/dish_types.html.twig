{% extends 'base.html.twig' %}

{% set active_menu_item = 'weekly_menus' %}
{% set active_submenu_item = 'dish_types' %}

{% block title %}Druhy jídel{% endblock %}
{% block eyebrow %}Projekt · {{ project.name }} · Jídelníčky{% endblock %}
{% block title_count %}{{ dishTypes|length }}{% endblock %}
{% block page_lead %}Druhy jídel (polévka, hlavní jídlo, dezert…) pro třídění seznamu jídel.{% endblock %}

{% block title_actions %}
    {% if is_granted('project_edit', project) %}
        <a href="{{ path('add_dish_type', {'projectId': project.id}) }}" class="btn btn-primary">{{ icon('plus', 's16') }}Nový druh jídla</a>
    {% endif %}
{% endblock %}

{% block mobile_primary_action %}
    {% if is_granted('project_edit', project) %}
        <a href="{{ path('add_dish_type', {'projectId': project.id}) }}" class="btn btn-primary icon" aria-label="Nový druh jídla">{{ icon('plus') }}</a>
    {% endif %}
{% endblock %}

{% block breadcrumb %}
    <ol class="breadcrumb m-0 pt-0">
        <li class="breadcrumb-item"><a href="{{ path('weekly_menus', {'projectId': project.id}) }}">Jídelníčky</a></li>
        <li class="breadcrumb-item active">{{ block('title') }}</li>
    </ol>
{% endblock %}

{% block content %}
    <div class="wm-page">
        {{ include('weekly_menu/_nav.html.twig') }}

        {% if dishTypes|length == 0 %}
            <div class="empty">
                <span class="ico-c">{{ icon('layers') }}</span>
                <h2>Zatím tu nejsou žádné druhy jídel</h2>
                <p>Druh jídla (polévka, hlavní jídlo, dezert…) se vybírá u každého jídla.</p>
                {% if is_granted('project_edit', project) %}
                    <a href="{{ path('add_dish_type', {'projectId': project.id}) }}" class="btn btn-primary btn-sm">{{ icon('plus', 's16') }}Vytvořit první druh jídla</a>
                {% endif %}
            </div>
        {% else %}
            <ul class="wm-tiles sm">
                {% for dishType in dishTypes %}
                    <li class="wm-tile">
                        <div class="wm-tile-t"><b>{{ dishType.name }}</b></div>
                        {% if is_granted('dish_type_edit', dishType) %}
                            <div class="wm-acts">
                                <a href="{{ path('edit_dish_type', {'dishTypeId': dishType.id}) }}" class="btn btn-ghost icon xs" title="Upravit" aria-label="Upravit druh jídla {{ dishType.name }}">{{ icon('edit', 's16') }}</a>
                                <a href="#"
                                   class="btn btn-ghost-danger icon xs"
                                   title="Smazat"
                                   aria-label="Smazat druh jídla {{ dishType.name }}"
                                   data-modal-id="{{ dishType.id }}"
                                   data-action="click->confirm-modal#showModal">{{ icon('trash', 's16') }}</a>

                                <twig:ConfirmModal
                                    id="{{ dishType.id }}"
                                    url="{{ path('delete_dish_type', {'dishTypeId': dishType.id}) }}"
                                    confirmationText="Opravdu chcete smazat tento druh jídla?" />
                            </div>
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </div>
{% endblock %}
