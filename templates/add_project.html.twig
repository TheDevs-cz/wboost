{% extends 'base.html.twig' %}

{% block title %}Nový projekt{% endblock %}
{% set active_menu_item = 'projects' %}

{% block breadcrumb %}
    <ol class="breadcrumb m-0 pt-0">
        <li class="breadcrumb-item"><a href="{{ path('projects') }}">Všechny projekty</a></li>
        <li class="breadcrumb-item active">{{ block('title') }}</li>
    </ol>
{% endblock %}

{% block page_lead %}Projekt sdružuje šablony, logomanuál a e-mailové podpisy jednoho klienta.{% endblock %}

{% block content %}
    {{ include('_project_form.html.twig', {
        'form': form,
        'submit_label': 'Vytvořit projekt',
        'cancel_url': path('projects'),
        'current_icon': null,
    }) }}
{% endblock %}
