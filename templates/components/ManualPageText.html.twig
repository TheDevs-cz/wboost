{# The admin pencil for a manual page's heading + description. Renders nothing
   for a reader, so the same markup serves the public manual.

   The form is Turbo-enabled (`data-turbo="true"`, the site is
   `<html data-turbo="false">`): EditManualPageTextController answers with a
   stream replacing the title + description (and this modal's BODY — never
   the modal itself, see ManualPreviewTurboStream); `modal` closes the modal
   on a successful `turbo:submit-end`. The form wraps `.modal-content`, inside
   `.modal-dialog`, so the submit button is its descendant. #}
{% if is_granted('manual_edit', manual) %}
    {% set page = this.manualPage %}
    {% set modalId = 'manualPageTextModal-' ~ page.value %}
    {% set form = this.form %}

    <span {{ attributes }}>
        <button type="button"
                class="btn btn-sm btn-soft-primary p-1 px-2 manual-page-text-edit"
                title="Upravit texty stránky"
                data-bs-toggle="modal"
                data-bs-target="#{{ modalId }}">
            <i class="mdi mdi-pencil"></i>
        </button>

        <div class="modal fade" id="{{ modalId }}" tabindex="-1" data-controller="modal">
            <div class="modal-dialog">
                {{ form_start(form, {attr: {'data-turbo': 'true'}}) }}

                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Texty stránky – {{ page.label }}</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    {{ include('_manual_page_text_form_body.html.twig') }}

                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Zavřít</button>
                        <button type="submit" class="btn btn-primary">Uložit</button>
                    </div>
                </div>

                {{ form_end(form, {render_rest: false}) }}
            </div>
        </div>
    </span>
{% endif %}
