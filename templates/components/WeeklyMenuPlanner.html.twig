{#
    Live component: weekly menu planner (day → meal type → course → variant →
    meals). Nocturne markup; every Live action/param, id, drag target/handle
    (weekly_menu_dragula_controller.js), collapsible hook
    (collapsible_controller.js, planner_collapsible_opener_controller.js) and
    modal trigger (meal_selector / variant_count_modal) is unchanged.
    Meal-type colours (WeeklyMenuMealType::cssColor) are data coding — they
    only tint a dot / thin bar via the `--mt` custom property.
#}
<div {{ attributes.defaults({
    'class': 'wm-planner',
    'data-controller': 'planner-collapsible-opener',
    'data-planner-collapsible-opener-ids-value': openCollapsibles|json_encode
}) }}>
    {% if lastSaved %}
        <div class="wm-saved" role="status">{{ icon('check-circle', 's16') }}Uloženo {{ lastSaved }}</div>
    {% endif %}

    {% set weeklyNutrition = menu.nutritionalValues %}
    {% if weeklyNutrition.hasAnyValue %}
        <section class="nutrition-stats-weekly" aria-label="Týdenní souhrn">
            <div class="nutrition-stats-header">
                {{ icon('chart', 's16') }}
                <span>Týdenní souhrn</span>
                {% if not weeklyNutrition.isComplete %}
                    <span class="pill pch nutrition-incomplete-badge" title="Některá jídla nemají vyplněné nutriční hodnoty">{{ icon('alert', 's12') }}Neúplné</span>
                {% endif %}
            </div>
            <div class="nutrition-stats-grid">
                {% if weeklyNutrition.energyValue is not null %}
                    <div class="nutrition-stat-item"><span class="nutrition-stat-label">Energie</span><span class="nutrition-stat-value">{{ weeklyNutrition.formatEnergyValue }}</span></div>
                {% endif %}
                {% if weeklyNutrition.fats is not null %}
                    <div class="nutrition-stat-item"><span class="nutrition-stat-label">Tuky</span><span class="nutrition-stat-value">{{ weeklyNutrition.formatFats }}</span></div>
                {% endif %}
                {% if weeklyNutrition.carbohydrates is not null %}
                    <div class="nutrition-stat-item"><span class="nutrition-stat-label">Sacharidy</span><span class="nutrition-stat-value">{{ weeklyNutrition.formatCarbohydrates }}</span></div>
                {% endif %}
                {% if weeklyNutrition.proteins is not null %}
                    <div class="nutrition-stat-item"><span class="nutrition-stat-label">Bílkoviny</span><span class="nutrition-stat-value">{{ weeklyNutrition.formatProteins }}</span></div>
                {% endif %}
            </div>
        </section>
    {% endif %}

    <div class="wm-days" data-controller="weekly-menu-dragula">
        {% for day in menu.days %}
            <details id="day-{{ day.id }}" class="collapsible-section collapsible-day wm-day" data-controller="collapsible">
                <summary class="wm-day-h">
                    <span class="wm-chev">{{ icon('chev-right', 's16') }}</span>
                    <span class="wm-day-t">
                        <b>{{ day.dayLabel }}</b>
                        {% if day.date %}<span class="cap">{{ day.date|date('j. n. Y') }}</span>{% endif %}
                    </span>
                    {{ include('weekly_menu/_nutrition_pills.html.twig', {n: day.nutritionalValues}) }}
                    <button
                        type="button"
                        class="btn btn-ghost icon xs wm-del"
                        aria-label="Smazat den {{ day.dayLabel }}"
                        title="Smazat den"
                        data-controller="confirm"
                        data-confirm-message-value="Opravdu smazat celý den včetně všech jídel?"
                        data-action="click->confirm#confirm click->live#action"
                        data-live-action-param="removeDay"
                        data-live-dayid-param="{{ day.id }}"
                        onclick="event.stopPropagation();">{{ icon('trash', 's16') }}</button>
                </summary>
                <div class="collapsible-content" data-collapsible-target="content">
                    <div class="collapsible-inner">
                        <div class="wm-day-b">
                            {% for mealType in day.mealTypes %}
                                {% set mt_color = mealType.mealType.cssColor %}
                                <details id="meal-type-{{ mealType.id }}" class="collapsible-section collapsible-meal-type wm-mt" data-controller="collapsible" style="--mt: {{ mt_color }};">
                                    <summary class="wm-mt-h">
                                        <span class="wm-chev">{{ icon('chev-right', 's16') }}</span>
                                        <span class="meal-type-dot" aria-hidden="true"></span>
                                        <b class="wm-mt-t">{{ mealType.mealType.label }}</b>
                                        {{ include('weekly_menu/_nutrition_pills.html.twig', {n: mealType.nutritionalValues}) }}
                                        <span class="wm-mt-acts">
                                            <span class="dropdown">
                                                <button type="button" class="btn btn-tertiary btn-sm dropdown-toggle"
                                                        data-bs-toggle="dropdown"
                                                        aria-expanded="false"
                                                        onclick="event.stopPropagation();">{{ icon('plus', 's14') }}Chod</button>
                                                <ul class="dropdown-menu dropdown-menu-end">
                                                    <li>
                                                        <button type="button" class="dropdown-item wm-mi"
                                                                data-action="live#action"
                                                                data-live-action-param="addCourse"
                                                                data-live-mealtypeid-param="{{ mealType.id }}"
                                                                data-live-singlevariantmode-param="true">
                                                            {{ icon('utensils', 's16') }}
                                                            <span>Bez výběru<small>Jednoduchý chod</small></span>
                                                        </button>
                                                    </li>
                                                    <li>
                                                        <button type="button" class="dropdown-item wm-mi"
                                                                data-bs-toggle="modal"
                                                                data-bs-target="#variantCountModal"
                                                                data-meal-type-id="{{ mealType.id }}">
                                                            {{ icon('list', 's16') }}
                                                            <span>S výběrem variant<small>Zákazník vybírá z možností</small></span>
                                                        </button>
                                                    </li>
                                                </ul>
                                            </span>
                                            <button
                                                type="button"
                                                class="btn btn-ghost icon xs wm-del"
                                                aria-label="Smazat {{ mealType.mealType.label }}"
                                                title="Smazat"
                                                data-controller="confirm"
                                                data-confirm-message-value="Opravdu smazat toto jídlo dne?"
                                                data-action="click->confirm#confirm click->live#action"
                                                data-live-action-param="removeMealType"
                                                data-live-mealtypeid-param="{{ mealType.id }}"
                                                onclick="event.stopPropagation();">{{ icon('trash', 's16') }}</button>
                                        </span>
                                    </summary>
                                    <div class="collapsible-content" data-collapsible-target="content">
                                        <div class="collapsible-inner">
                                            <div class="wm-mt-b"
                                                 data-weekly-menu-dragula-target="coursesContainer"
                                                 data-meal-type-id="{{ mealType.id }}">
                                                {% if mealType.courses|length == 0 %}
                                                    <p class="wm-hint">Zatím žádné chody. Přidejte je tlačítkem „+ Chod“.</p>
                                                {% else %}
                                                    {% for course in mealType.courses %}
                                                        <details id="course-{{ course.id }}" class="collapsible-section collapsible-course wm-course" data-course-id="{{ course.id }}" data-controller="collapsible">
                                                            <summary class="wm-course-h">
                                                                <span class="wm-chev">{{ icon('chev-right', 's14') }}</span>
                                                                {% if mealType.courses|length > 1 %}
                                                                    <span class="course-drag-handle wm-grip" title="Přetáhněte pro změnu pořadí" onclick="event.stopPropagation();">{{ icon('grip', 's14') }}</span>
                                                                {% endif %}
                                                                <b>Chod {{ loop.index }}</b>
                                                                {% if not course.singleVariantMode %}
                                                                    <span class="pill neutral">{{ course.variants|length }} {{ course.variants|length == 1 ? 'varianta' : (course.variants|length < 5 ? 'varianty' : 'variant') }}</span>
                                                                {% endif %}
                                                                {{ include('weekly_menu/_nutrition_pills.html.twig', {n: course.nutritionalValues}) }}
                                                                <button
                                                                    type="button"
                                                                    class="btn btn-ghost icon xs wm-del"
                                                                    aria-label="Smazat chod {{ loop.index }}"
                                                                    title="Smazat chod"
                                                                    data-controller="confirm"
                                                                    data-confirm-message-value="Opravdu smazat tento chod?"
                                                                    data-action="click->confirm#confirm click->live#action"
                                                                    data-live-action-param="removeCourse"
                                                                    data-live-courseid-param="{{ course.id }}"
                                                                    onclick="event.stopPropagation();">{{ icon('trash', 's14') }}</button>
                                                            </summary>
                                                            <div class="collapsible-content" data-collapsible-target="content">
                                                                <div class="collapsible-inner">
                                                                    <div class="wm-course-b"
                                                                         data-weekly-menu-dragula-target="variantsContainer"
                                                                         data-course-id="{{ course.id }}">
                                                                        {% if course.variants|length == 0 %}
                                                                            <p class="wm-hint">Zatím žádné varianty. Přidejte je tlačítkem „+ Varianta“.</p>
                                                                        {% else %}
                                                                            {% for variant in course.variants %}
                                                                                <div class="wm-variant{{ course.singleVariantMode ? ' single' }}" data-variant-id="{{ variant.id }}">
                                                                                    {% if not course.singleVariantMode %}
                                                                                        <div class="wm-variant-h">
                                                                                            {% if course.variants|length > 1 %}
                                                                                                <span class="variant-drag-handle wm-grip" title="Přetáhněte pro změnu pořadí">{{ icon('grip', 's14') }}</span>
                                                                                            {% endif %}
                                                                                            <input
                                                                                                type="text"
                                                                                                class="form-control form-control-sm wm-variant-name"
                                                                                                placeholder="Název varianty…"
                                                                                                aria-label="Název varianty"
                                                                                                value="{{ variant.name }}"
                                                                                                data-variant-id="{{ variant.id }}"
                                                                                                data-action="change->variant-name#save"
                                                                                                data-controller="variant-name">
                                                                                            <button
                                                                                                type="button"
                                                                                                class="btn btn-ghost icon xs wm-del"
                                                                                                aria-label="Smazat variantu"
                                                                                                title="Smazat variantu"
                                                                                                data-controller="confirm"
                                                                                                data-confirm-message-value="Opravdu smazat tuto variantu?"
                                                                                                data-action="click->confirm#confirm click->live#action"
                                                                                                data-live-action-param="removeVariant"
                                                                                                data-live-variantid-param="{{ variant.id }}">{{ icon('trash', 's14') }}</button>
                                                                                            <span class="cap wm-variant-help">Jídla, mezi kterými si zákazník vybírá (např. A, B, C nebo 1, 2, 3).</span>
                                                                                        </div>
                                                                                    {% endif %}

                                                                                    {% if variant.meals|length > 0 %}
                                                                                        <div class="meal-selector-grid"
                                                                                             data-weekly-menu-dragula-target="mealsContainer"
                                                                                             data-variant-id="{{ variant.id }}">
                                                                                            {% for variantMeal in variant.meals %}
                                                                                                <div class="meal-selector-item planner-meal-card{% if variant.meals|length > 1 %} draggable{% endif %}"
                                                                                                     style="--mt: {{ variantMeal.meal.mealType.cssColor }};"
                                                                                                     data-variant-meal-id="{{ variantMeal.id }}">
                                                                                                    {% include 'partials/_meal_card.html.twig' with {
                                                                                                        meal: variantMeal.meal,
                                                                                                        showCloseButton: true,
                                                                                                        closeButtonAction: 'live#action',
                                                                                                        closeButtonParam: variantMeal.id
                                                                                                    } only %}
                                                                                                </div>
                                                                                            {% endfor %}
                                                                                            <button
                                                                                                type="button"
                                                                                                class="meal-selector-item add-meal-btn"
                                                                                                data-bs-toggle="modal"
                                                                                                data-bs-target="#mealSelectorModal"
                                                                                                data-variant-id="{{ variant.id }}">
                                                                                                {{ icon('plus', 's16') }}<span>Přidat jídlo</span>
                                                                                            </button>
                                                                                        </div>
                                                                                        {% set variantNutrition = variant.nutritionalValues %}
                                                                                        {% if variantNutrition.hasAnyValue and variant.meals|length > 1 %}
                                                                                            <div class="nutrition-summary nutrition-summary-variant">
                                                                                                <span class="nutrition-label">Celkem varianta</span>
                                                                                                {{ include('weekly_menu/_nutrition_pills.html.twig', {n: variantNutrition}) }}
                                                                                            </div>
                                                                                        {% endif %}
                                                                                    {% else %}
                                                                                        <div class="meal-selector-grid">
                                                                                            <button
                                                                                                type="button"
                                                                                                class="meal-selector-item add-meal-btn"
                                                                                                data-bs-toggle="modal"
                                                                                                data-bs-target="#mealSelectorModal"
                                                                                                data-variant-id="{{ variant.id }}">
                                                                                                {{ icon('plus', 's16') }}<span>Přidat jídlo</span>
                                                                                            </button>
                                                                                        </div>
                                                                                    {% endif %}
                                                                                </div>
                                                                            {% endfor %}
                                                                            {% if not course.singleVariantMode %}
                                                                                <button
                                                                                    type="button"
                                                                                    class="btn btn-tertiary btn-sm wm-add-variant"
                                                                                    data-action="live#action"
                                                                                    data-live-action-param="addVariant"
                                                                                    data-live-courseid-param="{{ course.id }}"
                                                                                    data-live-name-param="">{{ icon('plus', 's14') }}Varianta</button>
                                                                            {% endif %}
                                                                        {% endif %}
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </details>
                                                    {% endfor %}
                                                {% endif %}
                                            </div>
                                        </div>
                                    </div>
                                </details>
                            {% else %}
                                <p class="wm-hint">Zatím žádné typy jídel pro tento den.</p>
                            {% endfor %}

                            {% set availableMealTypesForDay = this.availableMealTypesForDay(day) %}
                            {% if availableMealTypesForDay|length > 0 %}
                                <div class="dropdown wm-add-mt">
                                    <button class="btn btn-tertiary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">{{ icon('plus', 's14') }}Přidat typ jídla</button>
                                    <ul class="dropdown-menu">
                                        {% for mealTypeOption in availableMealTypesForDay %}
                                            <li>
                                                <button
                                                    type="button"
                                                    class="dropdown-item d-flex align-items-center"
                                                    data-action="live#action"
                                                    data-live-action-param="addMealType"
                                                    data-live-dayid-param="{{ day.id }}"
                                                    data-live-mealtype-param="{{ mealTypeOption.value }}">
                                                    <span class="meal-type-dot" style="--mt: {{ mealTypeOption.cssColor }};" aria-hidden="true"></span>
                                                    {{ mealTypeOption.label }}
                                                </button>
                                            </li>
                                        {% endfor %}
                                    </ul>
                                </div>
                            {% else %}
                                <p class="wm-hint ok">{{ icon('check-circle', 's16') }}Všechny typy jídel jsou přidány</p>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </details>
        {% endfor %}
    </div>

    <!-- Meal Selector Modal -->
    <div class="modal fade wm-modal" id="mealSelectorModal" tabindex="-1" aria-labelledby="mealSelectorModalLabel" aria-hidden="true"
         data-controller="meal-selector">
        <div class="modal-dialog modal-xl modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title" id="mealSelectorModalLabel">Vybrat jídlo</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Zavřít"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" data-meal-selector-target="variantId" value="">

                    {% set allMeals = this.meals %}
                    {% set allDiets = this.diets %}
                    {% set allMealTypes = this.availableMealTypes %}
                    {% if allMeals|length == 0 %}
                        <div class="empty wm-empty-sm">
                            <span class="ico-c">{{ icon('utensils') }}</span>
                            <h3>Zatím tu nejsou žádná jídla</h3>
                            <p>Jídla do jídelníčku vybíráte ze seznamu jídel projektu.</p>
                            <a href="{{ path('meals', {'projectId': menu.project.id}) }}" class="btn btn-primary btn-sm">{{ icon('plus', 's16') }}Vytvořit jídla</a>
                        </div>
                    {% else %}
                        <div class="wm-filters">
                            <label class="inp sm wm-search">
                                {{ icon('search', 's14') }}
                                <input type="text"
                                       placeholder="Hledat jídlo…"
                                       aria-label="Hledat jídlo"
                                       data-meal-selector-target="searchInput"
                                       data-action="input->meal-selector#filter">
                            </label>
                            <select class="form-select form-select-sm"
                                    aria-label="Typ jídla"
                                    data-meal-selector-target="mealTypeFilter"
                                    data-action="change->meal-selector#filter">
                                <option value="">Všechny typy jídel</option>
                                {% for mealType in allMealTypes %}
                                    <option value="{{ mealType.value }}">{{ mealType.label }}</option>
                                {% endfor %}
                            </select>
                            <select class="form-select form-select-sm"
                                    aria-label="Dieta"
                                    data-meal-selector-target="dietFilter"
                                    data-action="change->meal-selector#filter">
                                <option value="">Všechny diety</option>
                                {% for diet in allDiets %}
                                    <option value="{{ diet.id }}">{{ diet.name }} ({{ diet.codesLabel }})</option>
                                {% endfor %}
                            </select>
                        </div>

                        <div class="meal-selector-grid wm-pick-grid" data-meal-selector-target="mealsContainer">
                            {% for meal in allMeals %}
                                <div class="meal-selector-item"
                                     data-meal-selector-target="mealCard"
                                     data-meal-type="{{ meal.mealType.value }}"
                                     data-diet-ids="{{ meal.diets|map(d => d.id)|join(',') }}"
                                     data-search-text="{{ meal.internalName|lower }} {{ meal.name|lower }} {{ meal.dietCodesLabel|lower }}"
                                     data-meal-id="{{ meal.id }}"
                                     data-action="click->meal-selector#selectMeal"
                                     style="--mt: {{ meal.mealType.cssColor }};">
                                    {% include 'partials/_meal_card.html.twig' with {meal: meal} only %}
                                </div>
                            {% endfor %}
                        </div>

                        <p class="wm-noresults d-none" data-meal-selector-target="noResults">Žádná jídla neodpovídají zadaným filtrům.</p>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <!-- Variant Count Modal -->
    <div class="modal fade wm-modal" id="variantCountModal" tabindex="-1" aria-labelledby="variantCountModalLabel" aria-hidden="true"
         data-controller="variant-count-modal">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title" id="variantCountModalLabel">Počet variant</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Zavřít"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" data-variant-count-modal-target="mealTypeId" value="">
                    <label class="field" for="variantCountInput">
                        <span>Kolik variant chcete vytvořit?</span>
                        <input type="number" id="variantCountInput" class="form-control" min="2" max="10" value="2"
                               data-variant-count-modal-target="variantCount">
                    </label>
                    <p class="cap mt-2 mb-0">Zákazník si vybere jednu z variant.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-tertiary sm" data-bs-dismiss="modal">Zrušit</button>
                    <button type="button" class="btn btn-primary sm" data-action="variant-count-modal#confirm">{{ icon('check', 's16') }}Vytvořit</button>
                </div>
            </div>
        </div>
    </div>
</div>
