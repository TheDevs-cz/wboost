{# The "Mapování barev loga" pencil in a logo card's corner. Only the button:
   the modal it opens is rendered OUTSIDE the card
   (components/LogoColorsMappingModal.html.twig via
   `_manual_logo_colors_modals.html.twig`), so the Turbo Stream answering a
   save can replace the whole card while the modal is open. #}
{% props manual, logoVariant, colorVariant %}
{% if is_granted('manual_edit', manual) %}
    <button type="button" class="btn btn-sm btn-soft-primary p-1 px-2 position-absolute" style="right: 55px; top: 10px;"
            title="Mapování barev loga"
            data-bs-toggle="modal" data-bs-target="#logoColorsModal-{{ logoVariant }}-{{ colorVariant }}">
        <i class="mdi mdi-pencil"></i>
    </button>
{% endif %}
