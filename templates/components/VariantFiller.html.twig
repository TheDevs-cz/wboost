{#
    User-fill / export page for canvas template variants. Rendered by
    Template:VariantFiller — the component supplies the routes via
    this.downloadPath() / this.uploadPath().

    CLICK-INTO-PREVIEW OVERLAY (variant-fill-overlay controller)
    Editing happens ON the preview: every text + image placeholder is drawn as a
    dashed box with a pencil; the pencil opens a floating popover holding that
    placeholder's editor. The export PNG is ALWAYS the full server render, so it
    stays authoritative regardless of the live preview.

    - TEXT: the popover input is a plain field that mirrors its value into a
      Live-bound hidden field (`data-text-mirror` / `data-hide-mirror`, with the
      form `name`). Those hidden mirrors — the only Live-bound bits — drive the
      same server backdrop re-render (debounce 600ms) the old left-panel form did
      and carry the values on the plain form POST to the download route.
    - IMAGE (hybrid): when the variant has fillable image slots the preview is an
      interactive Fabric canvas (`variant-image-fill`) whose backgroundImage is
      the server backdrop with the placeholders hidden (`backdropDataUri`); the
      user's chosen pictures float on top as live objects, mirrored into hidden
      `images[<uuid>][...]` fields. The image popover holds the gallery picker /
      upload / hide wired to that controller.

    `data-live-ignore` subtrees: the canvas + its placement fields AND the whole
    overlay (boxes + popovers) survive Live re-renders; only the hidden text
    mirrors and the Live-updated preview/backdrop source live in the Live region.

    Progressive enhancement: without JS the `.fill-overlay` is a plain stacked,
    editable list of the popovers and the boxes are hidden; the controller adds
    `.fill-js` on connect to switch to the floating overlay.

    DEFERRED FIRST RENDER: the export page mounts this component with
    `loading="defer"` — the page GET paints the shell + the placeholder macro
    below instantly, and this template's expensive first render (1-3 Gotenberg
    calls for the preview/backdrop/slices) happens in the follow-up Live
    request. Rendering it inline used to burn the page request's whole
    execution budget when the renderer was busy (the biggest single source of
    the 30s MaxExecutionTimeError fatals). Note this makes the page hard-
    require JS — which the Live-bound fill flow effectively already did.
#}
{% macro placeholder(props) %}
    <div class="d-flex flex-column align-items-center justify-content-center text-muted py-5" style="min-height: 45vh;">
        <span class="spinner-border mb-2" role="status" aria-hidden="true"></span>
        Připravuji šablonu k vyplnění…
    </div>
{% endmacro %}
{% set hasImages = this.hasImagePlaceholders() %}
{% set textPlaceholders = this.textPlaceholders() %}
{% set imagePlaceholders = hasImages ? this.imagePlaceholders() : [] %}
{# Render the (slow) server preview ONCE — reused by the preview source span and
   the <img> below. Only the text-only branch has a server preview <img>. #}
{% set previewSrc = hasImages ? null : this.previewDataUri() %}

{% set fontFaces = this.fontFaces() %}
{% set richToolbar = this.richTextToolbar() %}
{% set layers = this.layers() %}

<div {{ attributes }}>
    {# Shared editor modules (classic scripts, window globals) + the project
       @font-face declarations — the overlay measures wrapped text heights with
       the same Fabric build, the same break-word patch and the same fonts the
       headless export render uses, so its container reflow is pixel-identical.
       Inside data-live-ignore so a Live re-render never re-injects them. #}
    <div data-live-ignore hidden>
        <script src="{{ asset('editor/fabric_break_word.js') }}"></script>
        <script src="{{ asset('editor/container_layout.js') }}"></script>
        <script src="{{ asset('editor/rich_text_runs.js') }}"></script>
        <script src="{{ asset('editor/rich_text_blocks.js') }}"></script>
        <style>
            {% for face in fontFaces %}
                @font-face {
                    font-family: '{{ face.family }}';
                    src: url('{{ face.url }}');
                }
            {% endfor %}
        </style>
    </div>

    <form
        method="POST"
        action="{{ this.downloadPath() }}"
        data-turbo="false"
        class="fill-form fill-highlight-on fill-captions-on"
        data-controller="variant-fill-overlay{% if hasImages %} variant-image-fill{% endif %}{% if this.canPublish() and this.facebookConnected %} variant-publish{% endif %}"
        data-variant-fill-overlay-canvas-width-value="{{ variant.dimension.width }}"
        data-variant-fill-overlay-text-layout-value="{{ this.textLayoutData()|json_encode }}"
        data-variant-fill-overlay-fonts-value="{{ fontFaces|map(face => face.family)|json_encode }}"
        data-action="rich-text-editor:changed->variant-fill-overlay#richTextChanged checklist-editor:changed->variant-fill-overlay#richTextChanged variant-image-fill:frame-changed->variant-fill-overlay#imageFrameChanged"
        {% if hasImages %}
            data-variant-image-fill-placeholders-value="{{ imagePlaceholders|json_encode }}"
            data-variant-image-fill-width-value="{{ variant.dimension.width }}"
            data-variant-image-fill-height-value="{{ variant.dimension.height }}"
            data-variant-image-fill-backdrop-id-value="variant-backdrop-source"
            data-variant-image-fill-overlays-id-value="variant-overlay-sources"
        {% endif %}
        {% if this.canPublish() and this.facebookConnected %}
            data-variant-publish-publish-url-value="{{ this.publishPath() }}"
            data-variant-publish-destinations-url-value="{{ path('social_facebook_destinations') }}"
            data-variant-publish-profile-url-value="{{ path('user_profile') }}"
        {% endif %}
    >
        {# ---- Toolbar -------------------------------------------------------
           data-live-ignore: the highlight checkbox's `checked` is a DOM PROPERTY
           toggled by the user; Live's mutation tracker only preserves
           attribute/class/style changes, so without this the box would re-check
           itself on every debounced re-render and desync from the (class-driven)
           highlight state. #}
        <div class="d-flex align-items-center gap-2 mb-2 flex-wrap" data-live-ignore>
            <div class="form-check form-switch mb-0">
                <input
                    type="checkbox"
                    class="form-check-input"
                    id="fill-highlight-toggle"
                    checked
                    data-action="change->variant-fill-overlay#toggleHighlight"
                >
                <label class="form-check-label small" for="fill-highlight-toggle">Zobrazit oblasti k vyplnění</label>
            </div>

            {# Name tags, independent of the borders above (same pair as the
               admin editor). Also `checked` as a DOM property, so it lives in
               the same data-live-ignore subtree. #}
            <div class="form-check form-switch mb-0">
                <input
                    type="checkbox"
                    class="form-check-input"
                    id="fill-captions-toggle"
                    checked
                    data-action="change->variant-fill-overlay#toggleCaptions"
                >
                <label class="form-check-label small" for="fill-captions-toggle" title="Jmenovky polí zobrazené v rohu každé oblasti">Popisky prvků</label>
            </div>

            <div class="btn-group btn-group-sm ms-auto" role="group" aria-label="Přiblížení náhledu">
                <button type="button" class="btn btn-outline-secondary" title="Oddálit" aria-label="Oddálit" data-action="variant-fill-overlay#zoomOut">
                    <i class="mdi mdi-magnify-minus-outline" aria-hidden="true"></i>
                </button>
                <button type="button" class="btn btn-outline-secondary" style="min-width: 3.5rem;" title="Obnovit na 100 %" data-action="variant-fill-overlay#zoomReset" data-variant-fill-overlay-target="zoomLabel">100&nbsp;%</button>
                <button type="button" class="btn btn-outline-secondary" title="Přiblížit" aria-label="Přiblížit" data-action="variant-fill-overlay#zoomIn">
                    <i class="mdi mdi-magnify-plus-outline" aria-hidden="true"></i>
                </button>
            </div>

            {% if this.canPublish() %}
                {% if this.facebookConnected %}
                    <button type="button" class="btn btn-outline-primary btn-sm" data-action="variant-publish#open" data-variant-publish-platform-param="facebook" title="Publikovat na facebookovou stránku">
                        <i class="mdi mdi-facebook me-1" aria-hidden="true"></i>Facebook
                    </button>
                    <button type="button" class="btn btn-outline-primary btn-sm" data-action="variant-publish#open" data-variant-publish-platform-param="instagram" title="Publikovat na instagramový profesionální účet">
                        <i class="mdi mdi-instagram me-1" aria-hidden="true"></i>Instagram
                    </button>
                {% else %}
                    {# CTA instead of dead buttons: publishing needs a connected Facebook account. #}
                    <a href="{{ path('user_profile') }}" class="btn btn-outline-secondary btn-sm" title="Publikování na sociální sítě vyžaduje propojený facebookový účet — propojte jej ve svém profilu.">
                        <i class="mdi mdi-facebook" aria-hidden="true"></i><i class="mdi mdi-instagram me-1" aria-hidden="true"></i>Publikovat — propojit účet
                    </a>
                {% endif %}
            {% endif %}
            <button type="submit" class="btn btn-primary btn-sm" data-variant-fill-overlay-target="exportButton">Export do PNG</button>
        </div>

        {# Container-overflow validation message (variant-fill-overlay). Shown —
           and the Export button disabled — while the filled texts of a container
           don't fit its max height even after reflow. Lives in the ignored
           subtree: it is pure client-side state. #}
        <div class="alert alert-danger py-1 px-2 small d-none" role="alert" aria-live="polite"
             data-variant-fill-overlay-target="overflowAlert" data-live-ignore></div>

        {# ---- Live-bound hidden mirrors (text) -------------------------------
           The ONLY Live-bound fields: they trigger the backdrop/preview
           re-render and carry the values on the plain form POST. Kept out of the
           ignored subtree so Live can read/write them; visually hidden because
           the user edits via the popovers. #}
        {% for input in variant.inputs %}
            {% if not input.locked %}
                <input
                    type="text"
                    class="visually-hidden"
                    tabindex="-1"
                    aria-hidden="true"
                    name="textValues[{{ input.inputId }}]"
                    data-text-mirror="{{ input.inputId }}"
                    data-model="on(input)|debounce(600)|textValues[{{ input.inputId }}]"
                    value="{{ this.textValues[input.inputId] ?? '' }}"
                >
                {% if input.hidable %}
                    <input
                        type="checkbox"
                        class="visually-hidden"
                        tabindex="-1"
                        aria-hidden="true"
                        name="hiddenValues[{{ input.inputId }}]"
                        value="1"
                        data-hide-mirror="{{ input.inputId }}"
                        data-model="on(change)|hiddenValues[{{ input.inputId }}]"
                        {% if this.hiddenValues[input.inputId] ?? false %}checked{% endif %}
                    >
                {% endif %}
            {% endif %}
        {% endfor %}

        {% if hasImages %}
            {# Live-updated backdrop source — read by variant-image-fill by id. #}
            <span id="variant-backdrop-source" data-src="{{ this.backdropDataUri() }}" hidden></span>
            {# Overlay slices: design content stacked ABOVE an image placeholder
               (transparent PNGs). The fill controller paints each directly over
               its placeholder's live object so the designed z-order holds. #}
            <span id="variant-overlay-sources" hidden>
                {% for slice in this.overlaySlices() %}
                    <span data-overlay-above="{{ slice.aboveInputId }}" data-src="{{ slice.dataUri }}"></span>
                {% endfor %}
            </span>
        {% else %}
            {# Live-updated preview source — read by variant-fill-overlay to keep
               the (ignored) preview <img> in sync without re-creating it. #}
            <span data-variant-fill-overlay-target="previewSource" data-src="{{ previewSrc }}" hidden></span>
        {% endif %}

        {# Renderer overloaded: the sources above came back empty. Say so rather
           than showing a blank preview — the form values are untouched and the
           next edit re-renders. #}
        {% if this.renderUnavailable() %}
            <div class="alert alert-warning" role="alert">
                <i class="mdi mdi-image-off-outline"></i>
                Náhled se teď nepodařilo vygenerovat — vykreslovací služba je vytížená.
                Vyplněné hodnoty zůstávají, zkuste to prosím za chvíli znovu.
            </div>
        {% endif %}

        <div class="fill-body">
        <div class="fill-viewport">
        <div class="fill-stage" data-variant-fill-overlay-target="stage">
            {# ---- Preview --------------------------------------------------- #}
            {% if hasImages %}
                <div data-live-ignore>
                    {# Controller mirrors each placement here, so the plain form
                       POST carries them. Pre-rendered empty; data-live-ignore
                       keeps the controller-set values across Live re-renders. #}
                    {% for ph in imagePlaceholders %}
                        <input type="hidden" name="images[{{ ph.inputId }}][imageId]" data-placeholder="{{ ph.inputId }}" data-field="imageId" value="">
                        <input type="hidden" name="images[{{ ph.inputId }}][scale]" data-placeholder="{{ ph.inputId }}" data-field="scale" value="">
                        <input type="hidden" name="images[{{ ph.inputId }}][offsetX]" data-placeholder="{{ ph.inputId }}" data-field="offsetX" value="">
                        <input type="hidden" name="images[{{ ph.inputId }}][offsetY]" data-placeholder="{{ ph.inputId }}" data-field="offsetY" value="">
                        <input type="hidden" name="images[{{ ph.inputId }}][rotation]" data-placeholder="{{ ph.inputId }}" data-field="rotation" value="">
                        <input type="hidden" name="images[{{ ph.inputId }}][hide]" data-placeholder="{{ ph.inputId }}" data-field="hide" value="">
                    {% endfor %}

                    {# Layer-mode variants may render transparent (no background) —
                       the checkerboard makes that visible, any background paints over it. #}
                    <div class="canvas-wrapper{{ variant.backgroundMode.value == 'layer' ? ' canvas-wrapper--transparent' }}" data-variant-image-fill-target="wrapper" style="position: relative;">
                        <canvas
                            data-variant-image-fill-target="canvas"
                            data-variant-fill-overlay-target="preview"
                            width="{{ variant.dimension.width }}"
                            height="{{ variant.dimension.height }}"
                        ></canvas>
                    </div>
                </div>
            {% else %}
                <div data-live-ignore>
                    {% if previewSrc %}
                        <img
                            class="fill-preview-img{{ variant.backgroundMode.value == 'layer' ? ' fill-preview-img--transparent' }}"
                            data-variant-fill-overlay-target="preview"
                            src="{{ previewSrc }}"
                            alt=""
                        >
                    {% else %}
                        <p class="text-muted">Náhled se generuje…</p>
                    {% endif %}
                </div>
            {% endif %}

            {# Live-preview spinner — shown from the moment the user edits until
               the next server render lands (covers the debounce + the Gotenberg
               render). Between the preview and the overlay in DOM so it tints the
               preview but stays below the icons/popover. #}
            <div class="fill-spinner" data-variant-fill-overlay-target="spinner" data-live-ignore>
                <div class="fill-spinner__badge">
                    <span class="fill-spinner__icon" role="status" aria-label="Generuji náhled…"></span>
                </div>
            </div>

            {# ---- Overlay: boxes + popovers (ignored so it survives renders) - #}
            <div class="fill-overlay" data-live-ignore>
                {# Boxes: an always-visible icon cluster (pencil = edit, eye =
                   hide). The dashed BORDER is the only thing the highlight toggle
                   controls. #}
                {% for ph in textPlaceholders %}
                    {% if ph.frame and not ph.locked %}
                        <div
                            class="fill-box fill-box--text"
                            data-variant-fill-overlay-target="box"
                            data-inputid="{{ ph.inputId }}"
                            data-frame-x="{{ ph.frame.x }}"
                            data-frame-y="{{ ph.frame.y }}"
                            data-frame-width="{{ ph.frame.width }}"
                            data-frame-height="{{ ph.frame.height }}"
                        >
                            <span class="fill-box__name">{{ ph.name ?: 'Text' }}</span>
                            <div class="fill-box__tools">
                                <button type="button" class="fill-box__tool fill-box__tool--edit"
                                    title="Upravit text" aria-label="Upravit text{% if ph.name %}: {{ ph.name }}{% endif %}"
                                    data-action="variant-fill-overlay#openPopover"
                                    data-variant-fill-overlay-inputid-param="{{ ph.inputId }}"
                                ><i class="mdi mdi-pencil" aria-hidden="true"></i></button>
                                {% if ph.hidable %}
                                    <button type="button"
                                        class="fill-box__tool fill-box__tool--hide{{ ph.hidden ? ' is-active' : '' }}"
                                        data-hide-toggle="{{ ph.inputId }}"
                                        aria-pressed="{{ ph.hidden ? 'true' : 'false' }}"
                                        title="{{ ph.hidden ? 'Zobrazit prvek' : 'Schovat prvek' }}"
                                        aria-label="{{ ph.hidden ? 'Zobrazit prvek' : 'Schovat prvek' }}"
                                        data-action="variant-fill-overlay#toggleHide"
                                        data-variant-fill-overlay-inputid-param="{{ ph.inputId }}"
                                    ><i class="mdi {{ ph.hidden ? 'mdi-eye-off-outline' : 'mdi-eye-outline' }}" aria-hidden="true"></i></button>
                                {% endif %}
                            </div>
                        </div>
                    {% endif %}
                {% endfor %}
                {% for ph in imagePlaceholders %}
                    {% if ph.frame %}
                        <div
                            class="fill-box fill-box--image"
                            data-variant-fill-overlay-target="box"
                            data-inputid="{{ ph.inputId }}"
                            data-frame-x="{{ ph.frame.x }}"
                            data-frame-y="{{ ph.frame.y }}"
                            data-frame-width="{{ ph.frame.width }}"
                            data-frame-height="{{ ph.frame.height }}"
                        >
                            <span class="fill-box__name">{{ ph.name ?: 'Obrázek' }}</span>
                            <div class="fill-box__tools">
                                <button type="button" class="fill-box__tool fill-box__tool--edit"
                                    title="Vybrat obrázek" aria-label="Vybrat obrázek{% if ph.name %}: {{ ph.name }}{% endif %}"
                                    data-action="variant-fill-overlay#openImageModal"
                                    data-variant-fill-overlay-inputid-param="{{ ph.inputId }}"
                                ><i class="mdi mdi-pencil" aria-hidden="true"></i></button>
                                {% if ph.hidable %}
                                    <button type="button" class="fill-box__tool fill-box__tool--hide"
                                        data-hide-toggle="{{ ph.inputId }}"
                                        aria-pressed="false"
                                        title="Schovat prvek"
                                        aria-label="Schovat prvek"
                                        data-action="variant-fill-overlay#toggleHide"
                                        data-variant-fill-overlay-inputid-param="{{ ph.inputId }}"
                                    ><i class="mdi mdi-eye-outline" aria-hidden="true"></i></button>
                                {% endif %}
                            </div>
                            {% if ph.hidable %}
                                {# Hidden checkbox the eye toggles; wired to the image
                                   controller's hide handler. #}
                                <input type="checkbox" class="visually-hidden" tabindex="-1" aria-hidden="true"
                                    data-image-hide="{{ ph.inputId }}"
                                    data-action="change->variant-image-fill#toggleHide"
                                    data-variant-image-fill-inputid-param="{{ ph.inputId }}">
                            {% endif %}
                        </div>
                    {% endif %}
                {% endfor %}
            </div>
        </div>
        </div>

        {# ---- Layers panel (Vrstvy) ------------------------------------------
           Photoshop-style list of the variant's FILLABLE placeholders, topmost
           first (canvas stacking order via this.layers() — locked texts,
           decorative images and the background are admin-editor-only).
           Hovering a row highlights its box over the preview; clicking opens
           the same popover/modal the box's pencil opens. Rows are design-fixed,
           and the eye buttons carry data-hide-toggle so the controller's
           _reflectHide keeps them in sync with the box eyes — the whole aside
           can live in data-live-ignore (image hide state is client-only and
           must never be morphed away). JS-only chrome: hidden without .fill-js. #}
        {% if layers|length > 0 %}
            <aside class="fill-layers" data-live-ignore aria-label="Vrstvy šablony">
                <p class="fill-layers__title"><i class="mdi mdi-layers-outline me-1" aria-hidden="true"></i>Vrstvy</p>
                <div class="fill-layers__list" role="list">
                    {% for layer in layers %}
                        <div
                            class="fill-layer-row"
                            role="listitem"
                            data-action="mouseenter->variant-fill-overlay#highlightLayer mouseleave->variant-fill-overlay#unhighlightLayer"
                            data-variant-fill-overlay-inputid-param="{{ layer.inputId }}"
                        >
                            {% if layer.interactive %}
                                <button
                                    type="button"
                                    class="fill-layer-row__main"
                                    title="{{ layer.label }} — kliknutím upravíte"
                                    data-action="variant-fill-overlay#{{ layer.kind == 'image' ? 'openImageModal' : 'openPopover' }} focus->variant-fill-overlay#highlightLayer blur->variant-fill-overlay#unhighlightLayer"
                                    data-variant-fill-overlay-inputid-param="{{ layer.inputId }}"
                                >
                                    <i class="fill-layer-row__icon mdi {{ layer.icon }}" aria-hidden="true"></i>
                                    <span class="fill-layer-row__label">{{ layer.label }}</span>
                                </button>
                            {% else %}
                                <span class="fill-layer-row__main" title="{{ layer.label }}">
                                    <i class="fill-layer-row__icon mdi {{ layer.icon }}" aria-hidden="true"></i>
                                    <span class="fill-layer-row__label">{{ layer.label }}</span>
                                </span>
                            {% endif %}
                            {% if layer.hidable %}
                                <button
                                    type="button"
                                    class="fill-layer-row__eye{{ layer.hidden ? ' is-active' : '' }}"
                                    data-hide-toggle="{{ layer.inputId }}"
                                    aria-pressed="{{ layer.hidden ? 'true' : 'false' }}"
                                    title="{{ layer.hidden ? 'Zobrazit prvek' : 'Schovat prvek' }}"
                                    aria-label="{{ layer.hidden ? 'Zobrazit prvek' : 'Schovat prvek' }}"
                                    data-action="variant-fill-overlay#toggleHide"
                                    data-variant-fill-overlay-inputid-param="{{ layer.inputId }}"
                                ><i class="mdi {{ layer.hidden ? 'mdi-eye-off-outline' : 'mdi-eye-outline' }}" aria-hidden="true"></i></button>
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>
            </aside>
        {% endif %}
        </div>

        {# Text popovers (all non-locked inputs, so the no-JS list works even
           when a frame is missing). OUTSIDE the zoom-scaled stage and the
           overflow-clipping .fill-viewport: the controller positions the open
           popover `fixed` in viewport coordinates and clamps it fully
           on-screen, so no ancestor can ever clip it. #}
        <div class="fill-popovers" data-live-ignore>
            {% for ph in textPlaceholders %}
                {% if not ph.locked %}
                    <div class="fill-popover card{% if ph.richText and richToolbar %} fill-popover--rich{% endif %}" role="dialog" aria-labelledby="fill-text-label-{{ ph.inputId }}" data-variant-fill-overlay-target="popover" data-inputid="{{ ph.inputId }}">
                        <div class="card-body p-2">
                            <div class="d-flex justify-content-between align-items-start mb-1">
                                <span class="d-inline-flex align-items-center" style="min-width: 0;">
                                    <i class="mdi mdi-drag fill-popover__drag me-1" data-popover-drag-handle role="button" aria-label="Přesunout okno" title="Přesunout okno"></i>
                                    <label id="fill-text-label-{{ ph.inputId }}" class="small fw-bold mb-0 text-truncate" for="fill-text-{{ ph.inputId }}">{{ ph.name ?? 'Text' }}</label>
                                </span>
                                <div class="d-flex align-items-center gap-1">
                                    <button type="button" class="btn btn-success btn-sm py-0 px-1 d-inline-flex align-items-center" style="font-size: .7rem;" data-action="variant-fill-overlay#close"><i class="mdi mdi-check me-1" aria-hidden="true"></i> Uložit</button>
                                    <button type="button" class="btn-close" style="font-size: .6rem;" aria-label="Zavřít" data-action="variant-fill-overlay#close"></button>
                                </div>
                            </div>
                            {% if ph.description %}<p class="small text-muted mb-1">{{ ph.description }}</p>{% endif %}
                            {% if ph.checklist %}
                                {# CHECKLIST component branch: fixed per-item
                                   editor (checkbox + text + remove per row),
                                   gated by the admin capability flags. Values
                                   travel as the same checkbox-list envelope
                                   the WYSIWYG writes. #}
                                <div
                                    data-controller="checklist-editor"
                                    data-checklist-editor-input-id-value="{{ ph.inputId }}"
                                    data-checklist-editor-items-value="{{ (ph.checklistItems ?? [])|json_encode }}"
                                    data-checklist-editor-can-toggle-value="{{ ph.checklistToggle ? 'true' : 'false' }}"
                                    data-checklist-editor-can-edit-text-value="{{ ph.checklistEditText ? 'true' : 'false' }}"
                                    data-checklist-editor-can-add-value="{{ ph.checklistAdd ? 'true' : 'false' }}"
                                    data-checklist-editor-can-remove-value="{{ ph.checklistRemove ? 'true' : 'false' }}"
                                    data-checklist-editor-max-length-value="{{ ph.maxLength ?? 0 }}"
                                >
                                    <div class="d-flex flex-column gap-1" data-checklist-editor-target="rows"></div>
                                    <button type="button" class="btn btn-sm btn-outline-secondary mt-2 d-none" data-checklist-editor-target="addButton" data-action="checklist-editor#addItem"><i class="mdi mdi-plus me-1"></i>Přidat položku</button>
                                    <div class="d-flex justify-content-end mt-1">
                                        <small class="text-muted" data-checklist-editor-target="counter"></small>
                                    </div>
                                </div>
                            {% elseif ph.richText and richToolbar %}
                                {# WYSIWYG branch: contenteditable + toolbar, one
                                   rich-text-editor controller per popover. Seeded
                                   from parsed runs (NEVER the raw mirror value —
                                   that may be a JSON envelope); writes the envelope
                                   back into the mirror on every edit. #}
                                <div
                                    data-controller="rich-text-editor"
                                    data-rich-text-editor-input-id-value="{{ ph.inputId }}"
                                    data-rich-text-editor-max-length-value="{{ ph.maxLength ?? 0 }}"
                                    data-rich-text-editor-uppercase-value="{{ ph.uppercase ? 'true' : 'false' }}"
                                    data-rich-text-editor-runs-value="{{ ph.runs|json_encode }}"
                                    data-rich-text-editor-lines-value="{{ (ph.lines ?? [])|json_encode }}"
                                    data-rich-text-editor-lists-value="{{ ph.lists ? 'true' : 'false' }}"
                                    data-rich-text-editor-checkboxes-value="{{ ph.listCheckboxes ? 'true' : 'false' }}"
                                    data-rich-text-editor-design-font-value="{{ ph.designFontFamily ?? '' }}"
                                    data-rich-text-editor-fonts-value="{{ richToolbar.fonts|json_encode }}"
                                    data-rich-text-editor-colors-value="{{ richToolbar.colors|json_encode }}"
                                >
                                    <div class="fill-richtext-toolbar d-flex align-items-center flex-wrap gap-1 mb-1">
                                        <select class="form-select form-select-sm fill-richtext-toolbar__font" aria-label="Písmo" data-rich-text-editor-target="fontSelect" data-action="change->rich-text-editor#applyFont">
                                            <option value="">Výchozí písmo</option>
                                            {% for group in richToolbar.fontGroups %}
                                                <optgroup label="{{ group.name }}">
                                                    {% for face in group.faces %}
                                                        <option value="{{ face.family }}" style="font-family: '{{ face.family }}'">{{ face.faceName }}</option>
                                                    {% endfor %}
                                                </optgroup>
                                            {% endfor %}
                                        </select>
                                        <div class="btn-group btn-group-sm" role="group" aria-label="Řez a podtržení">
                                            <button type="button" class="btn btn-outline-secondary fw-bold" title="Tučně (Ctrl+B) — přepne řez písma" data-rich-text-editor-target="bold" data-action="rich-text-editor#toggleBold">B</button>
                                            <button type="button" class="btn btn-outline-secondary fst-italic" title="Kurzíva (Ctrl+I) — přepne řez písma" data-rich-text-editor-target="italic" data-action="rich-text-editor#toggleItalic">I</button>
                                            <button type="button" class="btn btn-outline-secondary text-decoration-underline" title="Podtržení (Ctrl+U)" data-rich-text-editor-target="underline" data-action="rich-text-editor#toggleUnderline">U</button>
                                        </div>
                                        {% if ph.lists %}
                                            <div class="btn-group btn-group-sm" role="group" aria-label="Seznamy">
                                                <button type="button" class="btn btn-outline-secondary" title="Odrážkový seznam" data-rich-text-editor-target="ulButton" data-action="rich-text-editor#toggleBulletList"><i class="mdi mdi-format-list-bulleted" aria-hidden="true"></i></button>
                                                <button type="button" class="btn btn-outline-secondary" title="Číslovaný seznam" data-rich-text-editor-target="olButton" data-action="rich-text-editor#toggleNumberedList"><i class="mdi mdi-format-list-numbered" aria-hidden="true"></i></button>
                                                {% if ph.listCheckboxes %}
                                                    <button type="button" class="btn btn-outline-secondary" title="Zaškrtávací seznam" data-rich-text-editor-target="cbButton" data-action="rich-text-editor#toggleCheckboxList"><i class="mdi mdi-format-list-checks" aria-hidden="true"></i></button>
                                                {% endif %}
                                            </div>
                                        {% endif %}
                                        <button type="button" class="btn btn-sm btn-outline-secondary" title="Výchozí styl — odstraní veškeré formátování" data-action="rich-text-editor#clearFormatting"><i class="mdi mdi-format-clear" aria-hidden="true"></i></button>
                                    </div>
                                    <div class="fill-richtext-toolbar__swatches d-flex align-items-center flex-wrap gap-1 mb-1" role="group" aria-label="Barva textu">
                                        <button type="button" class="fill-richtext-swatch fill-richtext-swatch--auto" title="Výchozí barva" data-action="rich-text-editor#pickColor" data-rich-text-editor-color-param=""></button>
                                        {% for color in richToolbar.colors %}
                                            <button type="button" class="fill-richtext-swatch" style="background-color: {{ color }}" title="{{ color }}" data-action="rich-text-editor#pickColor" data-rich-text-editor-color-param="{{ color }}"></button>
                                        {% endfor %}
                                        <label class="fill-richtext-swatch fill-richtext-swatch--custom" title="Vlastní barva">
                                            <input type="color" class="fill-richtext-swatch__input" aria-label="Vlastní barva" data-rich-text-editor-target="colorInput" data-action="change->rich-text-editor#applyCustomColor">
                                        </label>
                                    </div>
                                    <div
                                        id="fill-text-{{ ph.inputId }}"
                                        class="form-control form-control-sm fill-richtext-editor{% if ph.uppercase %} text-uppercase{% endif %}"
                                        contenteditable="true"
                                        role="textbox"
                                        aria-multiline="true"
                                        aria-labelledby="fill-text-label-{{ ph.inputId }}"
                                        {% if ph.designFontFamily %}style="font-family: '{{ ph.designFontFamily }}'"{% endif %}
                                        data-rich-text-editor-target="editor"
                                        data-action="input->rich-text-editor#input beforeinput->rich-text-editor#beforeInput keydown->rich-text-editor#keydown paste->rich-text-editor#paste compositionstart->rich-text-editor#compositionStart compositionend->rich-text-editor#compositionEnd click->rich-text-editor#editorClick"
                                    ></div>
                                    <div class="d-flex justify-content-between mt-1" id="fill-text-hint-{{ ph.inputId }}">
                                        <small class="text-muted">{% if ph.uppercase %}Zobrazí se VELKÝMI písmeny · {% endif %}{% if ph.listCheckboxes %}Kliknutím na čtvereček (za)odškrtnete položku · {% endif %}Shift+Enter pro nový řádek</small>
                                        <small class="text-muted" data-rich-text-editor-target="counter"></small>
                                    </div>
                                </div>
                            {% else %}
                                {# Auto-growing textarea: rows="1" is the collapsed
                                   start; the controller resizes it to fit the full
                                   value so long text is never clipped/scrolled. #}
                                <textarea
                                    id="fill-text-{{ ph.inputId }}"
                                    class="form-control form-control-sm fill-popover__input"
                                    rows="1"
                                    {% if ph.maxLength %}maxlength="{{ ph.maxLength }}" aria-describedby="fill-text-hint-{{ ph.inputId }}"{% endif %}
                                    data-action="input->variant-fill-overlay#syncText keydown->variant-fill-overlay#blockEnter"
                                    data-variant-fill-overlay-inputid-param="{{ ph.inputId }}"
                                >{{- ph.value -}}</textarea>
                                <div class="d-flex justify-content-between mt-1" id="fill-text-hint-{{ ph.inputId }}">
                                    {% if ph.uppercase %}<small class="text-muted">Zobrazí se VELKÝMI písmeny</small>{% else %}<span></span>{% endif %}
                                    {% if ph.maxLength %}<small class="text-muted" data-fill-counter="{{ ph.inputId }}">{{ ph.value|length }} / {{ ph.maxLength }} znaků</small>{% endif %}
                                </div>
                            {% endif %}
                        </div>
                    </div>
                {% endif %}
            {% endfor %}
        </div>

        {# Publish modal (variant-publish) — destination picker + caption. Own
           data-live-ignore block: open state, fetched destinations and the
           typed caption must survive Live re-renders. All inputs inside are
           deliberately UNNAMED so they never leak into the form's FormData —
           the controller appends platform/targetId/caption explicitly. #}
        {% if this.canPublish() and this.facebookConnected %}
            <div data-live-ignore>
                <div class="fill-modal" data-variant-publish-target="modal" data-action="click->variant-publish#closeBackdrop">
                    <div class="fill-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="publish-modal-title" tabindex="-1">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="mb-0" id="publish-modal-title" data-variant-publish-target="title">Publikovat</h5>
                            <button type="button" class="btn-close" aria-label="Zavřít" data-action="variant-publish#close"></button>
                        </div>

                        <label class="form-label small text-muted mb-1">Kam publikovat</label>
                        <div class="mb-2" data-variant-publish-target="destinations">
                            <p class="text-muted small mb-0">Načítám…</p>
                        </div>

                        <label class="form-label small text-muted mb-1" for="publish-caption">Text příspěvku</label>
                        <textarea
                            id="publish-caption"
                            class="form-control form-control-sm mb-2"
                            rows="3"
                            maxlength="2200"
                            placeholder="Popisek příspěvku (nepovinné)"
                            data-variant-publish-target="caption"
                        ></textarea>

                        <div class="small mb-2" data-variant-publish-target="status" aria-live="polite"></div>

                        <div class="text-end">
                            <button type="button" class="btn btn-primary btn-sm" data-action="variant-publish#submit" data-variant-publish-target="submit">
                                <i class="mdi mdi-send me-1" aria-hidden="true"></i>Publikovat
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        {% endif %}

        {# Image gallery modals — opened by an image box's pencil. In their own
           data-live-ignore so the chosen folder + open state survive Live
           re-renders. #}
        {% if imagePlaceholders %}
            <div data-live-ignore>
                {% for ph in imagePlaceholders %}
                    <div
                        class="fill-modal"
                        data-variant-fill-overlay-target="modal"
                        data-image-modal="{{ ph.inputId }}"
                        data-action="click->variant-fill-overlay#closeModalBackdrop"
                    >
                        <div class="fill-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="fill-modal-title-{{ ph.inputId }}" tabindex="-1">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="mb-0" id="fill-modal-title-{{ ph.inputId }}">{{ ph.name ?? 'Vybrat obrázek' }}</h5>
                                <div class="d-flex align-items-center gap-1">
                                    <button type="button" class="btn btn-success btn-sm py-0 px-2 d-inline-flex align-items-center" style="font-size: .8rem;" data-action="variant-fill-overlay#closeModal"><i class="mdi mdi-check me-1" aria-hidden="true"></i> Uložit</button>
                                    <button type="button" class="btn-close" aria-label="Zavřít" data-action="variant-fill-overlay#closeModal"></button>
                                </div>
                            </div>
                            {% if ph.description %}<p class="small text-muted">{{ ph.description }}</p>{% endif %}

                            {% if not ph.canUpload %}
                                <p class="text-warning small mb-1">Tento obrázek zatím nelze vyplnit — šablona nemá nastavenou složku galerie. Kontaktujte správce šablony.</p>
                            {% else %}
                                {# Folder-navigable picker (fill-gallery): the admin gallery
                                   modal's UX — folders, breadcrumb, dropzone with immediate
                                   upload — over the slot's ALLOWED folders only. The server
                                   renders nothing outside the admin-defined rules; uploads
                                   re-validate the target server-side. #}
                                <div
                                    data-controller="fill-gallery"
                                    data-fill-gallery-upload-url-value="{{ this.uploadPath(ph.inputId) }}"
                                    data-fill-gallery-includes-root-value="{{ ph.includesRoot ? 'true' : 'false' }}"
                                >
                                    <nav class="d-flex align-items-center flex-wrap gap-1 mb-2 small">
                                        <button
                                            type="button"
                                            class="btn btn-sm btn-link p-0 text-decoration-none fw-bold text-body"
                                            data-fill-gallery-target="rootCrumb"
                                            data-action="fill-gallery#openRoot"
                                        ><i class="mdi mdi-folder-home"></i> Galerie</button>
                                        <span class="text-muted d-none" data-fill-gallery-target="crumbSep">/</span>
                                        <span class="fw-bold d-none" data-fill-gallery-target="crumbName"></span>
                                    </nav>

                                    {% if ph.directories is not empty %}
                                        <div class="d-flex flex-wrap gap-2 mb-2" data-fill-gallery-target="folders">
                                            {% for directory in ph.directories %}
                                                <button
                                                    type="button"
                                                    class="btn border rounded p-2 d-flex align-items-center gap-1 text-start"
                                                    data-fill-gallery-target="folderCard"
                                                    data-action="fill-gallery#openFolder"
                                                    data-fill-gallery-id-param="{{ directory.id }}"
                                                    data-fill-gallery-name-param="{{ directory.name }}"
                                                    title="{{ directory.name }}"
                                                >
                                                    <i class="mdi mdi-folder text-warning fs-4"></i>
                                                    <span class="text-truncate">{{ directory.name }}</span>
                                                </button>
                                            {% endfor %}
                                        </div>
                                    {% endif %}

                                    <div class="d-flex flex-wrap gap-2 mb-2" data-fill-gallery-target="grid">
                                        {% for img in ph.images %}
                                            <button
                                                type="button"
                                                class="btn p-0 border rounded fill-modal__thumb"
                                                title="Vybrat"
                                                data-fill-gallery-target="thumb"
                                                data-directory-id="{{ img.directoryId }}"
                                                data-action="variant-image-fill#pickImage variant-fill-overlay#closeModal"
                                                data-variant-image-fill-inputid-param="{{ ph.inputId }}"
                                                data-variant-image-fill-imageid-param="{{ img.id }}"
                                                data-variant-image-fill-url-param="{{ img.url }}"
                                            >
                                                <img crossorigin="anonymous" src="{{ img.url }}" alt="">
                                            </button>
                                        {% endfor %}
                                    </div>
                                    <p class="text-muted small mb-2 d-none" data-fill-gallery-target="emptyNote">Zatím tu nejsou žádné obrázky — nahrajte vlastní níže.</p>

                                    {# New-upload thumb markup (this page's pick wiring),
                                       cloned by fill-gallery with __ID__/__URL__ filled in. #}
                                    <template data-fill-gallery-target="thumbTemplate">
                                        <button
                                            type="button"
                                            class="btn p-0 border rounded fill-modal__thumb"
                                            title="Vybrat"
                                            data-fill-gallery-target="thumb"
                                            data-action="variant-image-fill#pickImage variant-fill-overlay#closeModal"
                                            data-variant-image-fill-inputid-param="{{ ph.inputId }}"
                                            data-variant-image-fill-imageid-param="__ID__"
                                            data-variant-image-fill-url-param="__URL__"
                                        >
                                            <img crossorigin="anonymous" src="__URL__" alt="">
                                        </button>
                                    </template>

                                    <p class="text-muted small mb-0 d-none" data-fill-gallery-target="pickFolderHint">Pro nahrání vlastního obrázku otevřete složku.</p>
                                    <div data-fill-gallery-target="uploadWrap">
                                        <div
                                            class="gallery-dropzone"
                                            data-fill-gallery-target="dropzone"
                                            data-action="
                                                click->fill-gallery#browse
                                                keydown->fill-gallery#keydown
                                                dragover->fill-gallery#dragOver
                                                dragleave->fill-gallery#dragLeave
                                                drop->fill-gallery#drop
                                            "
                                            role="button"
                                            tabindex="0"
                                        >
                                            <i class="mdi mdi-cloud-upload-outline gallery-dropzone__icon"></i>
                                            <div class="gallery-dropzone__title">Přetáhněte obrázky sem</div>
                                            <div class="text-muted small">nebo klikněte pro výběr z počítače</div>
                                            <div class="text-muted small mt-1">
                                                Nahraje se do: <strong class="text-body"><i class="mdi mdi-folder-outline"></i> <span data-fill-gallery-target="uploadTargetLabel"></span></strong>
                                                &middot; max. 10&nbsp;MB / soubor
                                            </div>
                                        </div>
                                        <input type="file" class="d-none" accept="image/*" multiple data-fill-gallery-target="fileInput" data-action="change->fill-gallery#filesChosen">
                                        <div class="mt-2 d-flex flex-column gap-2" data-fill-gallery-target="queue" aria-live="polite"></div>
                                    </div>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </form>
</div>
