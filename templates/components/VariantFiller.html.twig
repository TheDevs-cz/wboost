{#
    User-fill / export page for canvas template variants. Rendered by
    Template:VariantFiller — the component supplies the routes via
    this.downloadPath() / this.uploadPath().

    CLICK-INTO-PREVIEW OVERLAY (variant-fill-overlay controller)
    Editing happens ON the preview: every text + image placeholder is drawn as a
    dashed box with a pencil; the pencil opens a floating popover holding that
    placeholder's editor. The export PNG is ALWAYS the full server render, so it
    stays authoritative regardless of the live preview.

    - TEXT: the popover input is a plain field that mirrors its value into a
      Live-bound hidden field (`data-text-mirror` / `data-hide-mirror`, with the
      form `name`). Those hidden mirrors — the only Live-bound bits — drive the
      same server backdrop re-render (debounce 600ms) the old left-panel form did
      and carry the values on the plain form POST to the download route.
    - IMAGE (hybrid): when the variant has fillable image slots the preview is an
      interactive Fabric canvas (`variant-image-fill`) whose backgroundImage is
      the server backdrop with the placeholders hidden (`backdropSources`); the
      user's chosen pictures float on top as live objects, mirrored into hidden
      `images[<uuid>][...]` fields. The image popover holds the gallery picker /
      upload / hide wired to that controller.

    `data-live-ignore` subtrees: the canvas + its placement fields AND the whole
    overlay (boxes + popovers) survive Live re-renders; only the hidden text
    mirrors and the Live-updated preview/backdrop source live in the Live region.

    Progressive enhancement: without JS the `.fill-overlay` is a plain stacked,
    editable list of the popovers and the boxes are hidden; the controller adds
    `.fill-js` on connect to switch to the floating overlay.

    DEFERRED FIRST RENDER: the export page mounts this component with
    `loading="defer"` — the page GET paints the shell + the placeholder macro
    below instantly, and this template's expensive first render (1-3 Gotenberg
    calls for the preview/backdrop/slices) happens in the follow-up Live
    request. Rendering it inline used to burn the page request's whole
    execution budget when the renderer was busy (the biggest single source of
    the 30s MaxExecutionTimeError fatals). Note this makes the page hard-
    require JS — which the Live-bound fill flow effectively already did.
#}
{% macro placeholder(props) %}
    <div class="d-flex flex-column align-items-center justify-content-center text-muted py-5" style="min-height: 45vh;">
        <span class="spinner-border mb-2" role="status" aria-hidden="true"></span>
        Připravuji šablonu k vyplnění…
    </div>
{% endmacro %}
{% set hasImages = this.hasImagePlaceholders() %}
{% set textPlaceholders = this.textPlaceholders() %}
{% set imagePlaceholders = hasImages ? this.imagePlaceholders() : [] %}
{# Render the (slow) server preview ONCE — reused by the preview source span and
   the <img> below. Only the text-only branch has a server preview <img>.
   `src` = the settle render (the on-screen truth at rest); `baseSrc` = the
   echo base with the echo-capable texts transparent (equal to src when
   nothing is echo-capable). #}
{% set previewSources = hasImages ? null : this.previewSources() %}
{# Client-side text echo: null when no input is echo-capable — no echo chrome
   renders and every debounce stays fast. #}
{% set echoPayload = this.echoPayload() %}
{% set stateHash = this.fillStateHash() %}

{% set fontFaces = this.fontFaces() %}
{% set richToolbar = this.richTextToolbar() %}
{% set layers = this.layers() %}

<div {{ attributes }}>
    {# The shared classic scripts (fabric_break_word, container_layout,
       rich_text_runs, rich_text_blocks, fill_text_echo) and the project
       @font-face declarations are loaded by the PAGE template
       (template_variant_export.html.twig), NOT here: this component mounts
       with loading="defer", and <script> elements inserted by a Live morph
       are parser-inert — they would never execute, silently killing the
       overlay's reflow parity and the text echo. #}

    <form
        method="POST"
        action="{{ this.downloadPath() }}"
        data-turbo="false"
        class="fill-form fill-highlight-on fill-captions-on"
        data-controller="variant-fill-overlay{% if hasImages %} variant-image-fill{% endif %}{% if echoPayload %} variant-text-echo{% endif %}{% if this.canPublish() and this.facebookConnected %} variant-publish{% endif %}"
        data-variant-fill-overlay-fonts-value="{{ fontFaces|map(face => face.family)|json_encode }}"
        data-action="rich-text-editor:changed->variant-fill-overlay#richTextChanged checklist-editor:changed->variant-fill-overlay#richTextChanged variant-image-fill:frame-changed->variant-fill-overlay#imageFrameChanged variant-image-fill:picked->variant-fill-overlay#imagePicked{% if echoPayload and hasImages %} variant-text-echo:mode->variant-image-fill#echoModeChanged{% endif %}"
        {% if echoPayload %}
            data-variant-text-echo-payload-value="{{ echoPayload|json_encode }}"
            data-variant-text-echo-fonts-value="{{ fontFaces|map(face => face.family)|json_encode }}"
            data-variant-text-echo-has-images-value="{{ hasImages ? 'true' : 'false' }}"
        {% endif %}
        {% if hasImages %}
            data-variant-image-fill-placeholders-value="{{ imagePlaceholders|json_encode }}"
            data-variant-image-fill-width-value="{{ variant.dimension.width }}"
            data-variant-image-fill-height-value="{{ variant.dimension.height }}"
            data-variant-image-fill-backdrop-id-value="variant-backdrop-source"
            data-variant-image-fill-overlays-id-value="variant-overlay-sources"
        {% endif %}
        {% if this.canPublish() and this.facebookConnected %}
            data-variant-publish-publish-url-value="{{ this.publishPath() }}"
            data-variant-publish-destinations-url-value="{{ path('social_facebook_destinations') }}"
            data-variant-publish-profile-url-value="{{ path('user_profile') }}"
        {% endif %}
    >
        {# ---- Toolbar -------------------------------------------------------
           data-live-ignore: the highlight checkbox's `checked` is a DOM PROPERTY
           toggled by the user; Live's mutation tracker only preserves
           attribute/class/style changes, so without this the box would re-check
           itself on every debounced re-render and desync from the (class-driven)
           highlight state. #}
        <div class="d-flex align-items-center gap-2 mb-2 flex-wrap" data-live-ignore>
            {# The overlay switches + the "Všechna pole" panel button — the
               same partial the group fill page renders. #}
            {{ include('_fill_overlay_toggles.html.twig') }}

            <div class="btn-group btn-group-sm ms-auto" role="group" aria-label="Přiblížení náhledu">
                <button type="button" class="btn btn-outline-secondary" title="Oddálit" aria-label="Oddálit" data-action="variant-fill-overlay#zoomOut">
                    <i class="mdi mdi-magnify-minus-outline" aria-hidden="true"></i>
                </button>
                <button type="button" class="btn btn-outline-secondary" style="min-width: 3.5rem;" title="Obnovit na 100 %" data-action="variant-fill-overlay#zoomReset" data-variant-fill-overlay-target="zoomLabel">100&nbsp;%</button>
                <button type="button" class="btn btn-outline-secondary" title="Přiblížit" aria-label="Přiblížit" data-action="variant-fill-overlay#zoomIn">
                    <i class="mdi mdi-magnify-plus-outline" aria-hidden="true"></i>
                </button>
            </div>

            {% if this.canPublish() %}
                {% if this.facebookConnected %}
                    <button type="button" class="btn btn-outline-primary btn-sm" data-action="variant-publish#open" data-variant-publish-platform-param="facebook" title="Publikovat na facebookovou stránku">
                        <i class="mdi mdi-facebook me-1" aria-hidden="true"></i>Facebook
                    </button>
                    <button type="button" class="btn btn-outline-primary btn-sm" data-action="variant-publish#open" data-variant-publish-platform-param="instagram" title="Publikovat na instagramový profesionální účet">
                        <i class="mdi mdi-instagram me-1" aria-hidden="true"></i>Instagram
                    </button>
                {% else %}
                    {# CTA instead of dead buttons: publishing needs a connected Facebook account. #}
                    <a href="{{ path('user_profile') }}" class="btn btn-outline-secondary btn-sm" title="Publikování na sociální sítě vyžaduje propojený facebookový účet — propojte jej ve svém profilu.">
                        <i class="mdi mdi-facebook" aria-hidden="true"></i><i class="mdi mdi-instagram me-1" aria-hidden="true"></i>Publikovat — propojit účet
                    </a>
                {% endif %}
            {% endif %}
            <button type="submit" class="btn btn-primary btn-sm" data-variant-fill-overlay-target="exportButton">Export do PNG</button>
        </div>

        {# Container-overflow validation message (variant-fill-overlay). Shown —
           and the Export button disabled — while the filled texts of a container
           don't fit its max height even after reflow. Lives in the ignored
           subtree: it is pure client-side state. #}
        <div class="alert alert-danger py-1 px-2 small d-none" role="alert" aria-live="polite"
             data-variant-fill-overlay-target="overflowAlert" data-live-ignore></div>

        {# ---- Live-bound hidden mirrors (text) -------------------------------
           The ONLY Live-bound fields: they trigger the backdrop/preview
           re-render and carry the values on the plain form POST. Kept out of the
           ignored subtree so Live can read/write them; visually hidden because
           the user edits via the popovers. #}
        {% set echoIds = echoPayload ? echoPayload.inputs|keys : [] %}
        {% set fontChoiceIds = [] %}
        {% for ph in textPlaceholders %}
            {% if ph.fontChoice %}{% set fontChoiceIds = fontChoiceIds|merge([ph.inputId]) %}{% endif %}
        {% endfor %}
        {% for input in variant.inputs %}
            {% if not input.locked %}
                {# Echo-capable inputs settle LAZILY (the instant client echo
                   covers the gap); everything else keeps the fast debounce. #}
                <input
                    type="text"
                    class="visually-hidden"
                    tabindex="-1"
                    aria-hidden="true"
                    name="textValues[{{ input.inputId }}]"
                    data-text-mirror="{{ input.inputId }}"
                    data-model="on(input)|debounce({{ input.inputId in echoIds ? 2500 : 600 }})|textValues[{{ input.inputId }}]"
                    value="{{ this.textValues[input.inputId] ?? '' }}"
                >
                {# The whole-text FONT choice mirror (inputs the designer opened
                   up): the popover's font select writes here — same debounce
                   class as the text, the echo repaints it instantly. #}
                {% if input.inputId in fontChoiceIds %}
                    <input
                        type="text"
                        class="visually-hidden"
                        tabindex="-1"
                        aria-hidden="true"
                        name="fontValues[{{ input.inputId }}]"
                        data-font-mirror="{{ input.inputId }}"
                        data-model="on(input)|debounce({{ input.inputId in echoIds ? 2500 : 600 }})|fontValues[{{ input.inputId }}]"
                        value="{{ this.fontValues[input.inputId] ?? '' }}"
                    >
                {% endif %}
                {% if input.hidable %}
                    <input
                        type="checkbox"
                        class="visually-hidden"
                        tabindex="-1"
                        aria-hidden="true"
                        name="hiddenValues[{{ input.inputId }}]"
                        value="1"
                        data-hide-mirror="{{ input.inputId }}"
                        data-model="on(change)|hiddenValues[{{ input.inputId }}]"
                        {% if this.hiddenValues[input.inputId] ?? false %}checked{% endif %}
                    >
                {% endif %}
            {% endif %}
        {% endfor %}

        {% if hasImages %}
            {# Live-updated backdrop source — read by variant-image-fill by id.
               data-base-src = the echo base (capable texts transparent);
               data-state-hash tells the echo controller whether this settle
               matches the mirrors as they are NOW (rest) or raced the typing
               (stay on the echo). #}
            {% set backdropSources = this.backdropSources() %}
            <span id="variant-backdrop-source"
                  data-src="{{ backdropSources.src }}"
                  data-base-src="{{ backdropSources.baseSrc }}"
                  data-state-hash="{{ stateHash }}"
                  hidden></span>
            {# Overlay slices: design content stacked ABOVE an image placeholder
               (transparent PNGs). The fill controller paints each directly over
               its placeholder's live object so the designed z-order holds. #}
            <span id="variant-overlay-sources" hidden>
                {% for slice in this.overlaySlices() %}
                    <span data-overlay-above="{{ slice.aboveInputId }}" data-src="{{ slice.dataUri }}" data-base-src="{{ slice.baseDataUri }}"></span>
                {% endfor %}
            </span>
        {% else %}
            {# Live-updated preview source — read by variant-fill-overlay to keep
               the (ignored) preview <img> in sync without re-creating it, and by
               variant-text-echo for the base + the settle/rest decision. #}
            <span data-variant-fill-overlay-target="previewSource"
                  data-src="{{ previewSources.src }}"
                  data-base-src="{{ previewSources.baseSrc }}"
                  data-state-hash="{{ stateHash }}"
                  hidden></span>
        {% endif %}

        {# Renderer overloaded: the sources above came back empty. Say so rather
           than showing a blank preview — the form values are untouched and the
           next edit re-renders. #}
        {% if this.renderUnavailable() %}
            <div class="alert alert-warning" role="alert">
                <i class="mdi mdi-image-off-outline"></i>
                Náhled se teď nepodařilo vygenerovat — vykreslovací služba je vytížená.
                Vyplněné hodnoty zůstávají, zkuste to prosím za chvíli znovu.
            </div>
        {% endif %}

        <div class="fill-body">
        <div class="fill-viewport">
        <div class="fill-stage"
             data-variant-fill-overlay-target="stage surface"
             data-variant-id="{{ variant.id }}"
             data-canvas-width="{{ variant.dimension.width }}"
             data-layout="{{ this.textLayoutData()|json_encode }}">
            {# ---- Preview --------------------------------------------------- #}
            {% if hasImages %}
                <div data-live-ignore>
                    {# Controller mirrors each placement here, so the plain form
                       POST carries them. Pre-rendered from the loaded version's
                       seed (empty otherwise); data-live-ignore keeps the
                       controller-set values across Live re-renders. #}
                    {% for ph in imagePlaceholders %}
                        {% set seed = ph.seed ?? null %}
                        <input type="hidden" name="images[{{ ph.inputId }}][imageId]" data-placeholder="{{ ph.inputId }}" data-field="imageId" value="{{ seed.imageId|default('') }}">
                        <input type="hidden" name="images[{{ ph.inputId }}][scale]" data-placeholder="{{ ph.inputId }}" data-field="scale" value="{{ seed.scale|default('') }}">
                        <input type="hidden" name="images[{{ ph.inputId }}][offsetX]" data-placeholder="{{ ph.inputId }}" data-field="offsetX" value="{{ seed.offsetX|default('') }}">
                        <input type="hidden" name="images[{{ ph.inputId }}][offsetY]" data-placeholder="{{ ph.inputId }}" data-field="offsetY" value="{{ seed.offsetY|default('') }}">
                        <input type="hidden" name="images[{{ ph.inputId }}][rotation]" data-placeholder="{{ ph.inputId }}" data-field="rotation" value="{{ seed.rotation|default('') }}">
                        <input type="hidden" name="images[{{ ph.inputId }}][hide]" data-placeholder="{{ ph.inputId }}" data-field="hide" value="{{ seed.hide|default(false) ? '1' : '' }}">
                    {% endfor %}

                    {# Layer-mode variants may render transparent (no background) —
                       the checkerboard makes that visible, any background paints over it. #}
                    <div class="canvas-wrapper{{ variant.backgroundMode.value == 'layer' ? ' canvas-wrapper--transparent' }}" data-variant-image-fill-target="wrapper" style="position: relative;">
                        <canvas
                            data-variant-image-fill-target="canvas"
                            data-variant-fill-overlay-target="preview"
                            width="{{ variant.dimension.width }}"
                            height="{{ variant.dimension.height }}"
                        ></canvas>
                        {% if echoPayload %}
                            {# The client-drawn text layer, above the fill canvas
                               (the z-guard guarantees nothing may cover echoed
                               text). Visible only in echo mode; the image-fill
                               canvas swaps to the text-transparent base then. #}
                            <canvas class="fill-echo-canvas" data-variant-text-echo-target="canvas" aria-hidden="true"></canvas>
                        {% endif %}
                    </div>
                </div>
            {% else %}
                <div data-live-ignore{% if echoPayload %} style="position: relative;"{% endif %}>
                    {% if previewSources.src %}
                        <img
                            class="fill-preview-img{{ variant.backgroundMode.value == 'layer' ? ' fill-preview-img--transparent' }}"
                            data-variant-fill-overlay-target="preview"
                            src="{{ previewSources.src }}"
                            alt=""
                        >
                        {% if echoPayload %}
                            {# Echo composite (visible only in echo mode, above the
                               settle img): the text-transparent base + the
                               client-drawn text canvas. #}
                            <img class="fill-echo-base" data-variant-text-echo-target="baseImage" src="{{ previewSources.baseSrc }}" alt="" aria-hidden="true">
                            <canvas class="fill-echo-canvas" data-variant-text-echo-target="canvas" aria-hidden="true"></canvas>
                        {% endif %}
                    {% else %}
                        <p class="text-muted">Náhled se generuje…</p>
                    {% endif %}
                </div>
            {% endif %}

            {# Live-preview spinner — shown from the moment the user edits until
               the next server render lands (covers the debounce + the Gotenberg
               render). Between the preview and the overlay in DOM so it tints the
               preview but stays below the icons/popover. #}
            <div class="fill-spinner" data-variant-fill-overlay-target="spinner" data-live-ignore>
                <div class="fill-spinner__badge">
                    <span class="fill-spinner__icon" role="status" aria-label="Generuji náhled…"></span>
                </div>
            </div>

            {# ---- Overlay: boxes (ignored so it survives renders) ---------- #}
            {% set textFrames = {} %}
            {% for ph in textPlaceholders %}
                {% set textFrames = textFrames|merge({(ph.inputId): ph.frame}) %}
            {% endfor %}
            {% set imageFrames = {} %}
            {% set imageHidden = {} %}
            {% for ph in imagePlaceholders %}
                {% set imageFrames = imageFrames|merge({(ph.inputId): ph.frame}) %}
                {% set imageHidden = imageHidden|merge({(ph.inputId): (ph.seed is defined and ph.seed and ph.seed.hide|default(false))}) %}
            {% endfor %}
            <div class="fill-overlay" data-live-ignore>
                {{ include('_fill_overlay_boxes.html.twig', {
                    text_placeholders: textPlaceholders,
                    image_placeholders: imagePlaceholders,
                    text_frames: textFrames,
                    image_frames: imageFrames,
                    image_hidden: imageHidden,
                }) }}
            </div>
        </div>
        </div>

        {# ---- Layers panel (Vrstvy) — shared partial, see _fill_layers. #}
        {{ include('_fill_layers.html.twig', { layers: layers }) }}
        </div>

        {# ---- Popovers + the "Všechna pole" panel ----------------------------
           One text popover per non-locked input (so the no-JS list works even
           when a frame is missing) and one image card per slot. Floating
           mode: the popovers position `fixed` in viewport coordinates OUTSIDE
           the zoom-scaled stage and the overflow-clipping .fill-viewport, so
           no ancestor can ever clip them; the image cards are hidden. Panel
           mode (`fill-panel-open` on the form): this container docks into a
           modal listing every popover + image card as a stacked form — the
           SAME editor instances, no second copy of any field. #}
        <div class="fill-panel-backdrop" data-live-ignore data-action="click->variant-fill-overlay#closePanel"></div>
        <div class="fill-popovers" data-live-ignore data-variant-fill-overlay-target="panel" aria-labelledby="fill-panel-title">
            <div class="fill-popovers__header">
                <h5 class="mb-0" id="fill-panel-title"><i class="mdi mdi-form-textbox me-1" aria-hidden="true"></i>Všechna pole</h5>
                <button type="button" class="btn-close" aria-label="Zavřít" data-action="variant-fill-overlay#closePanel"></button>
            </div>
            {% for ph in textPlaceholders %}
                {% if not ph.locked %}
                    {{ include('_fill_text_popover.html.twig', { ph: ph, richToolbar: richToolbar }) }}
                {% endif %}
            {% endfor %}
            {% for ph in imagePlaceholders %}
                {% set seed = ph.seed ?? null %}
                {% set seedHidden = seed and seed.hide|default(false) %}
                <div class="fill-popover fill-popover--image card" data-inputid="{{ ph.inputId }}">
                    <div class="card-body p-2">
                        <div class="d-flex justify-content-between align-items-start mb-1">
                            <span class="small fw-bold text-truncate">{{ ph.name ?: 'Obrázek' }}</span>
                            {% if ph.hidable %}
                                <button type="button"
                                    class="fill-popover__eye{{ seedHidden ? ' is-active' : '' }}"
                                    data-hide-toggle="{{ ph.inputId }}"
                                    aria-pressed="{{ seedHidden ? 'true' : 'false' }}"
                                    title="{{ seedHidden ? 'Zobrazit prvek' : 'Schovat prvek' }}"
                                    aria-label="{{ seedHidden ? 'Zobrazit prvek' : 'Schovat prvek' }}"
                                    data-action="variant-fill-overlay#toggleHide"
                                    data-variant-fill-overlay-inputid-param="{{ ph.inputId }}"
                                ><i class="mdi {{ seedHidden ? 'mdi-eye-off-outline' : 'mdi-eye-outline' }}" aria-hidden="true"></i></button>
                            {% endif %}
                        </div>
                        {% if ph.description %}<p class="small text-muted mb-1">{{ ph.description }}</p>{% endif %}
                        <div class="d-flex align-items-center gap-2">
                            <span class="fill-image-card__thumb"
                                  data-variant-fill-overlay-target="imageThumb"
                                  data-inputid="{{ ph.inputId }}"
                                  {% if seed and seed.url|default('') %}style="background-image: url('{{ seed.url }}');"
                                  {% elseif ph.defaultImageUrl %}style="background-image: url('{{ ph.defaultImageUrl }}');"{% endif %}></span>
                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                    data-action="variant-fill-overlay#openImageModal"
                                    data-variant-fill-overlay-inputid-param="{{ ph.inputId }}">
                                <i class="mdi mdi-image-search-outline"></i> {{ ph.canUpload ? 'Vybrat / nahrát obrázek' : 'Vybrat obrázek' }}
                            </button>
                        </div>
                        {% if ph.hidable %}
                            {# Hidden checkbox every eye of this slot toggles; wired
                               to the image controller's hide handler. Starts checked
                               when a loaded version hid this slot. #}
                            <input type="checkbox" class="visually-hidden" tabindex="-1" aria-hidden="true"
                                data-image-hide="{{ ph.inputId }}"
                                {{ seedHidden ? 'checked' }}
                                data-action="change->variant-image-fill#toggleHide"
                                data-variant-image-fill-inputid-param="{{ ph.inputId }}">
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
            {% if textPlaceholders|filter(ph => not ph.locked)|length == 0 and imagePlaceholders|length == 0 %}
                <p class="text-muted small mb-0 fill-popovers__empty">Šablona nemá žádné vyplnitelné prvky — export stáhne návrh tak, jak je.</p>
            {% endif %}
        </div>

        {# Publish modal (variant-publish) — destination picker + caption. Own
           data-live-ignore block: open state, fetched destinations and the
           typed caption must survive Live re-renders. All inputs inside are
           deliberately UNNAMED so they never leak into the form's FormData —
           the controller appends platform/targetId/caption explicitly. #}
        {% if this.canPublish() and this.facebookConnected %}
            <div data-live-ignore>
                <div class="fill-modal" data-variant-publish-target="modal" data-action="click->variant-publish#closeBackdrop">
                    <div class="fill-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="publish-modal-title" tabindex="-1">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="mb-0" id="publish-modal-title" data-variant-publish-target="title">Publikovat</h5>
                            <button type="button" class="btn-close" aria-label="Zavřít" data-action="variant-publish#close"></button>
                        </div>

                        <label class="form-label small text-muted mb-1">Kam publikovat</label>
                        <div class="mb-2" data-variant-publish-target="destinations">
                            <p class="text-muted small mb-0">Načítám…</p>
                        </div>

                        <label class="form-label small text-muted mb-1" for="publish-caption">Text příspěvku</label>
                        <textarea
                            id="publish-caption"
                            class="form-control form-control-sm mb-2"
                            rows="3"
                            maxlength="2200"
                            placeholder="Popisek příspěvku (nepovinné)"
                            data-variant-publish-target="caption"
                        ></textarea>

                        <div class="small mb-2" data-variant-publish-target="status" aria-live="polite"></div>

                        <div class="text-end">
                            <button type="button" class="btn btn-primary btn-sm" data-action="variant-publish#submit" data-variant-publish-target="submit">
                                <i class="mdi mdi-send me-1" aria-hidden="true"></i>Publikovat
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        {% endif %}

        {# Image gallery modals — opened by an image box's pencil. In their own
           data-live-ignore so the chosen folder + open state survive Live
           re-renders. #}
        {% if imagePlaceholders %}
            <div data-live-ignore>
                {% for ph in imagePlaceholders %}
                    <div
                        class="fill-modal"
                        data-variant-fill-overlay-target="modal"
                        data-image-modal="{{ ph.inputId }}"
                        data-action="click->variant-fill-overlay#closeModalBackdrop"
                    >
                        <div class="fill-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="fill-modal-title-{{ ph.inputId }}" tabindex="-1">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="mb-0" id="fill-modal-title-{{ ph.inputId }}">{{ ph.name ?? 'Vybrat obrázek' }}</h5>
                                <div class="d-flex align-items-center gap-1">
                                    <button type="button" class="btn btn-success btn-sm py-0 px-2 d-inline-flex align-items-center" style="font-size: .8rem;" data-action="variant-fill-overlay#closeModal"><i class="mdi mdi-check me-1" aria-hidden="true"></i> Uložit</button>
                                    <button type="button" class="btn-close" aria-label="Zavřít" data-action="variant-fill-overlay#closeModal"></button>
                                </div>
                            </div>
                            {% if ph.description %}<p class="small text-muted">{{ ph.description }}</p>{% endif %}

                            {% if not ph.canUpload %}
                                <p class="text-warning small mb-1">Tento obrázek zatím nelze vyplnit — šablona nemá nastavenou složku galerie. Kontaktujte správce šablony.</p>
                            {% else %}
                                {# Folder-navigable picker (fill-gallery): the admin gallery
                                   modal's UX — folders, breadcrumb, dropzone with immediate
                                   upload — over the slot's ALLOWED folders only. The server
                                   renders nothing outside the admin-defined rules; uploads
                                   re-validate the target server-side. #}
                                <div
                                    data-controller="fill-gallery"
                                    data-fill-gallery-upload-url-value="{{ this.uploadPath(ph.inputId) }}"
                                    data-fill-gallery-includes-root-value="{{ ph.includesRoot ? 'true' : 'false' }}"
                                >
                                    <nav class="d-flex align-items-center flex-wrap gap-1 mb-2 small">
                                        <button
                                            type="button"
                                            class="btn btn-sm btn-link p-0 text-decoration-none fw-bold text-body"
                                            data-fill-gallery-target="rootCrumb"
                                            data-action="fill-gallery#openRoot"
                                        ><i class="mdi mdi-folder-home"></i> Galerie</button>
                                        <span class="text-muted d-none" data-fill-gallery-target="crumbSep">/</span>
                                        <span class="fw-bold d-none" data-fill-gallery-target="crumbName"></span>
                                    </nav>

                                    {% if ph.directories is not empty %}
                                        <div class="d-flex flex-wrap gap-2 mb-2" data-fill-gallery-target="folders">
                                            {% for directory in ph.directories %}
                                                <button
                                                    type="button"
                                                    class="btn border rounded p-2 d-flex align-items-center gap-1 text-start"
                                                    data-fill-gallery-target="folderCard"
                                                    data-action="fill-gallery#openFolder"
                                                    data-fill-gallery-id-param="{{ directory.id }}"
                                                    data-fill-gallery-name-param="{{ directory.name }}"
                                                    title="{{ directory.name }}"
                                                >
                                                    <i class="mdi mdi-folder text-warning fs-4"></i>
                                                    <span class="text-truncate">{{ directory.name }}</span>
                                                </button>
                                            {% endfor %}
                                        </div>
                                    {% endif %}

                                    <div class="d-flex flex-wrap gap-2 mb-2" data-fill-gallery-target="grid">
                                        {% for img in ph.images %}
                                            <button
                                                type="button"
                                                class="btn p-0 border rounded fill-modal__thumb"
                                                title="Vybrat"
                                                data-fill-gallery-target="thumb"
                                                data-directory-id="{{ img.directoryId }}"
                                                data-action="variant-image-fill#pickImage variant-fill-overlay#closeModal"
                                                data-variant-image-fill-inputid-param="{{ ph.inputId }}"
                                                data-variant-image-fill-imageid-param="{{ img.id }}"
                                                data-variant-image-fill-url-param="{{ img.url }}"
                                            >
                                                <img crossorigin="anonymous" src="{{ img.url }}" alt="">
                                            </button>
                                        {% endfor %}
                                    </div>
                                    <p class="text-muted small mb-2 d-none" data-fill-gallery-target="emptyNote">Zatím tu nejsou žádné obrázky — nahrajte vlastní níže.</p>

                                    {# New-upload thumb markup (this page's pick wiring),
                                       cloned by fill-gallery with __ID__/__URL__ filled in. #}
                                    <template data-fill-gallery-target="thumbTemplate">
                                        <button
                                            type="button"
                                            class="btn p-0 border rounded fill-modal__thumb"
                                            title="Vybrat"
                                            data-fill-gallery-target="thumb"
                                            data-action="variant-image-fill#pickImage variant-fill-overlay#closeModal"
                                            data-variant-image-fill-inputid-param="{{ ph.inputId }}"
                                            data-variant-image-fill-imageid-param="__ID__"
                                            data-variant-image-fill-url-param="__URL__"
                                        >
                                            <img crossorigin="anonymous" src="__URL__" alt="">
                                        </button>
                                    </template>

                                    <p class="text-muted small mb-0 d-none" data-fill-gallery-target="pickFolderHint">Pro nahrání vlastního obrázku otevřete složku.</p>
                                    <div data-fill-gallery-target="uploadWrap">
                                        <div
                                            class="gallery-dropzone"
                                            data-fill-gallery-target="dropzone"
                                            data-action="
                                                click->fill-gallery#browse
                                                keydown->fill-gallery#keydown
                                                dragover->fill-gallery#dragOver
                                                dragleave->fill-gallery#dragLeave
                                                drop->fill-gallery#drop
                                            "
                                            role="button"
                                            tabindex="0"
                                        >
                                            <i class="mdi mdi-cloud-upload-outline gallery-dropzone__icon"></i>
                                            <div class="gallery-dropzone__title">Přetáhněte obrázky sem</div>
                                            <div class="text-muted small">nebo klikněte pro výběr z počítače</div>
                                            <div class="text-muted small mt-1">
                                                Nahraje se do: <strong class="text-body"><i class="mdi mdi-folder-outline"></i> <span data-fill-gallery-target="uploadTargetLabel"></span></strong>
                                                &middot; max. 10&nbsp;MB / soubor
                                            </div>
                                        </div>
                                        <input type="file" class="d-none" accept="image/*" multiple data-fill-gallery-target="fileInput" data-action="change->fill-gallery#filesChosen">
                                        <div class="mt-2 d-flex flex-column gap-2" data-fill-gallery-target="queue" aria-live="polite"></div>
                                    </div>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </form>
</div>
