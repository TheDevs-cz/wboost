<div {{ attributes }}>
    {% import 'admin/_macros.html.twig' as adm %}
    {% set collaborators = this.collaborators() %}
    {% set candidates = this.candidateUsers() %}

    {# Triggers: the project card's ⋯ menu + user count (_project_card.html.twig)
       and "Přidat kolegu" on the project overview. Nocturne share dialog
       (prototype #dlgShare): add field with a client-side name filter over the
       candidates, then "Má přístup" (owner + collaborators). #}
    <div class="modal fade text-start" id="share-modal-{{ project.id }}" tabindex="-1" aria-labelledby="share-modal-title-{{ project.id }}">
        <div class="modal-dialog dlg-share">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="share-modal-title-{{ project.id }}">Sdílet projekt <span class="share-pn">{{ project.name }}</span></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Zavřít"></button>
                </div>
                <div class="modal-body dlg">
                    <div class="field">
                        <label class="field-l" for="share-search-{{ project.id }}">Přidat spolupracovníka</label>
                        {# One field for both cases: typing filters the registered
                           candidates (client-side); an e-mail also shows "Pozvat",
                           which shares with a registered user or invites a new one
                           to WBoost with this project pre-shared (invite()). #}
                        <span class="inp">
                            {{ icon('search', 's16') }}
                            <input type="search" id="share-search-{{ project.id }}" placeholder="Jméno nebo e-mail" autocomplete="off"
                                   data-model="norender|query" value="{{ query }}"
                                   onkeydown="if(event.key==='Enter'){event.preventDefault();var b=this.closest('.field').querySelector('[data-share-invite]:not([hidden]) button');if(b)b.click();}"
                                   oninput="var q=this.value.trim().toLowerCase(),f=this.closest('.field'),any=false;f.querySelectorAll('[data-share-name]').forEach(function(r){r.hidden=q!==''&&r.dataset.shareName.indexOf(q)===-1;if(!r.hidden)any=true;});var inv=f.querySelector('[data-share-invite]');inv.hidden=!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(q);inv.querySelector('[data-share-invite-email]').textContent=q;var e=f.querySelector('[data-share-none]');if(e)e.hidden=any||!inv.hidden;">
                        </span>
                        {% if notice %}<p class="share-msg ok" role="status">{{ icon('check', 's14') }}{{ notice }}</p>{% endif %}
                        {% if error %}<p class="share-msg err" role="alert">{{ icon('info', 's14') }}{{ error }}</p>{% endif %}
                        <ul class="share-list share-cands" aria-label="Uživatelé k nasdílení">
                            <li class="share-row share-invite" data-share-invite hidden>
                                <span class="av inv" aria-hidden="true">{{ icon('mail', 's16') }}</span>
                                <span class="who"><b data-share-invite-email></b><span>Nasdílet, nebo pozvat do WBoost e-mailem</span></span>
                                <button
                                    type="button"
                                    class="btn btn-primary xs"
                                    data-action="live#action"
                                    data-live-action-param="invite"
                                >{{ icon('mail', 's14') }}Pozvat</button>
                            </li>
                            {% for candidate in candidates %}
                                <li class="share-row" data-share-name="{{ (candidate.name ~ ' ' ~ candidate.email)|lower }}">
                                    <span class="av" aria-hidden="true">{{ initials(candidate.name|split('@')|first|replace({'.': ' ', '_': ' ', '-': ' '})|title) }}</span>
                                    <span class="who"><b>{{ candidate.name }}</b>{% if candidate.name != candidate.email %}<span>{{ candidate.email }}</span>{% endif %}</span>
                                    <button
                                        type="button"
                                        class="btn btn-tertiary xs"
                                        data-action="live#action"
                                        data-live-action-param="share"
                                        data-live-userid-param="{{ candidate.id }}"
                                    >{{ icon('plus', 's14') }}Přidat</button>
                                </li>
                            {% endfor %}
                            <li class="share-none cap" data-share-none{% if candidates is not empty %} hidden{% endif %}>Nikdo takový tu není — zadejte e-mail a pošlete pozvánku.</li>
                        </ul>
                    </div>

                    <div class="field">
                        <div class="share-head"><span class="field-l">Má přístup</span><span class="cap">{{ collaborators|length + 1 }}</span></div>
                        <ul class="share-list" aria-label="Lidé s přístupem">
                            <li class="share-row">
                                <span class="av" aria-hidden="true">{{ initials(project.owner.displayName) }}</span>
                                <span class="who"><b>{{ project.owner.displayName }}</b></span>
                                <span class="pill pch">Vlastník</span>
                            </li>
                            {% for collaborator in collaborators %}
                                <li class="share-row">
                                    {% if collaborator.pending %}
                                        {# Same pending look as Správa uživatelů (admin/_macros status). #}
                                        <span class="av inv" aria-hidden="true">{{ icon('mail', 's16') }}</span>
                                        <span class="who"><b>{{ collaborator.name }}</b><span>Pozvánka odeslána {{ adm.ago(collaborator.invitedAt) }} · čeká na přijetí</span></span>
                                        <span class="pill">Pozvánka</span>
                                        <button
                                            type="button"
                                            class="btn btn-ghost icon xs"
                                            title="Znovu poslat pozvánku"
                                            aria-label="Znovu poslat pozvánku: {{ collaborator.email }}"
                                            data-action="live#action"
                                            data-live-action-param="resend"
                                            data-live-userid-param="{{ collaborator.id }}"
                                        >{{ icon('refresh', 's16') }}</button>
                                    {% else %}
                                        <span class="av" aria-hidden="true">{{ initials(collaborator.name|split('@')|first|replace({'.': ' ', '_': ' ', '-': ' '})|title) }}</span>
                                        <span class="who"><b>{{ collaborator.name }}</b>{% if collaborator.name != collaborator.email %}<span>{{ collaborator.email }}</span>{% endif %}</span>
                                    {% endif %}
                                    <button
                                        type="button"
                                        class="btn btn-ghost-danger icon xs"
                                        title="Odebrat přístup"
                                        aria-label="Odebrat přístup: {{ collaborator.name }}"
                                        data-action="live#action"
                                        data-live-action-param="unshare"
                                        data-live-userid-param="{{ collaborator.id }}"
                                    >{{ icon('x', 's16') }}</button>
                                </li>
                            {% endfor %}
                        </ul>
                        {% if collaborators is empty %}
                            <p class="cap">Projekt zatím není nikomu nasdílen.</p>
                        {% endif %}
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-tertiary sm" data-bs-dismiss="modal">Hotovo</button>
                </div>
            </div>
        </div>
    </div>
</div>
