{% extends 'base_auth.html.twig' %}

{% set error_code = status_code|default(null) %}
{% set error_copy = {
    403: {title: 'Sem nemáte přístup', text: 'Na tuto stránku nemáte oprávnění. Pokud si myslíte, že jde o omyl, požádejte správce projektu o přístup.', icon_name: 'lock'},
    410: {title: 'Stránka už neexistuje', text: 'Obsah, který hledáte, byl odstraněn.', icon_name: 'search'},
    429: {title: 'Příliš mnoho požadavků', text: 'Chvíli počkejte a zkuste to znovu.', icon_name: 'history'},
    503: {title: 'Probíhá údržba', text: 'WBoost je na chvíli nedostupný. Zkuste to prosím za pár minut.', icon_name: 'refresh'},
} %}
{% set copy = error_copy[error_code]|default({title: 'Něco se pokazilo', text: 'Požadavek se nepodařilo dokončit. Zkuste to prosím znovu, nebo se vraťte na přehled projektů.', icon_name: 'alert'}) %}

{% block title %}{{ copy.title }}{% endblock %}

{% block auth_card_class %}err{% endblock %}

{% block auth_body %}
    {{ include('bundles/TwigBundle/Exception/_error_page.html.twig', {
        code: error_code,
        title: copy.title,
        text: copy.text,
        icon_name: copy.icon_name,
        danger: error_code is not null and error_code >= 500,
    }) }}
{% endblock %}
