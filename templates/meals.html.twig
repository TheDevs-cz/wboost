{% extends 'base.html.twig' %}

{% set active_menu_item = 'weekly_menus' %}
{% set active_submenu_item = 'meals' %}

{% block title %}Seznam jídel{% endblock %}
{% block eyebrow %}Projekt · {{ project.name }} · Jídelníčky{% endblock %}
{% block title_count %}{{ meals|length }}{% endblock %}
{% block page_lead %}Jídla, ze kterých skládáte jídelníčky — s typem, druhem, dietami a nutričními hodnotami.{% endblock %}

{% block title_actions %}
    {% if is_granted('project_edit', project) %}
        <a href="{{ path('add_meal', {'projectId': project.id}) }}" class="btn btn-primary">{{ icon('plus', 's16') }}Nové jídlo</a>
    {% endif %}
{% endblock %}

{% block mobile_primary_action %}
    {% if is_granted('project_edit', project) %}
        <a href="{{ path('add_meal', {'projectId': project.id}) }}" class="btn btn-primary icon" aria-label="Nové jídlo">{{ icon('plus') }}</a>
    {% endif %}
{% endblock %}

{% block breadcrumb %}
    <ol class="breadcrumb m-0 pt-0">
        <li class="breadcrumb-item"><a href="{{ path('weekly_menus', {'projectId': project.id}) }}">Jídelníčky</a></li>
        <li class="breadcrumb-item active">{{ block('title') }}</li>
    </ol>
{% endblock %}

{% block content %}
    <div class="wm-page" data-controller="chip-filter">
        {{ include('weekly_menu/_nav.html.twig') }}

        {% if meals|length == 0 %}
            <div class="empty">
                <span class="ico-c">{{ icon('utensils') }}</span>
                <h2>Zatím tu nejsou žádná jídla</h2>
                <p>Založte jídla jednou a pak je jen vybírejte do jednotlivých dnů jídelníčku.</p>
                {% if is_granted('project_edit', project) %}
                    <a href="{{ path('add_meal', {'projectId': project.id}) }}" class="btn btn-primary btn-sm">{{ icon('plus', 's16') }}Vytvořit první jídlo</a>
                {% endif %}
            </div>
        {% else %}
            {% set used_types = [] %}
            {% for meal in meals %}
                {% if meal.mealType not in used_types %}{% set used_types = used_types|merge([meal.mealType]) %}{% endif %}
            {% endfor %}

            {% if used_types|length > 1 %}
                <div class="fbar" role="group" aria-label="Filtrovat podle typu jídla">
                    <button type="button" class="chip on" aria-pressed="true" data-value="" data-action="chip-filter#pick">Vše <span class="n">{{ meals|length }}</span></button>
                    <span class="sep" aria-hidden="true"></span>
                    {% for type in used_types %}
                        <button type="button" class="chip" aria-pressed="false" data-value="{{ type.value }}" data-action="chip-filter#pick">
                            <span class="meal-type-dot" style="--mt: {{ type.cssColor }};" aria-hidden="true"></span>{{ type.label }}
                            <span class="n">{{ meals|filter(m => m.mealType == type)|length }}</span>
                        </button>
                    {% endfor %}
                </div>
            {% endif %}

            <div class="wm-list">
                <div class="wm-lh" aria-hidden="true">
                    <span>Jídlo</span><span>Typ a druh</span><span>Diety a varianty</span><span></span>
                </div>
                <ul>
                    {% for meal in meals %}
                        <li class="wm-row" data-chip-filter-target="item" data-group="{{ meal.mealType.value }}" style="--mt: {{ meal.mealType.cssColor }};">
                            <div class="wm-who">
                                {% if is_granted('meal_edit', meal) %}
                                    <a class="wm-nm" href="{{ path('edit_meal', {'mealId': meal.id}) }}">{{ meal.internalName }}</a>
                                {% else %}
                                    <b class="wm-nm">{{ meal.internalName }}</b>
                                {% endif %}
                                {% if meal.name and meal.name != meal.internalName %}<span class="cap">{{ meal.name }}</span>{% endif %}
                            </div>
                            <div class="wm-kind">
                                <span class="wm-type"><span class="meal-type-dot" aria-hidden="true"></span>{{ meal.mealType.label }}</span>
                                <span class="cap">{{ meal.dishType.name }}</span>
                            </div>
                            <div class="wm-tags">
                                {% for diet in meal.diets %}
                                    <span class="tag" title="{{ diet.name }}">{{ diet.name }}{% if diet.codes|length > 0 %} · {{ diet.codes|join(', ') }}{% endif %}</span>
                                {% endfor %}
                                {% for variant in meal.variants %}
                                    <span class="tag var" title="{{ variant.dietCodesLabel }}{% if variant.referenceMode %} (odkaz na jiné jídlo){% endif %}">
                                        {% if variant.referenceMode %}{{ icon('link', 's12') }}{% endif %}{{ variant.displayName }}{% if variant.dietCodesLabel %} · {{ variant.dietCodesLabel }}{% endif %}
                                    </span>
                                {% endfor %}
                                {% if not meal.hasDiets and not meal.hasVariants %}<span class="cap">—</span>{% endif %}
                            </div>
                            <div class="wm-acts">
                                {% if is_granted('meal_edit', meal) %}
                                    <a href="{{ path('edit_meal', {'mealId': meal.id}) }}" class="btn btn-ghost icon xs" title="Upravit" aria-label="Upravit {{ meal.internalName }}">{{ icon('edit', 's16') }}</a>
                                    <a href="#"
                                       class="btn btn-ghost-danger icon xs"
                                       data-modal-id="{{ meal.id }}"
                                       data-action="click->confirm-modal#showModal"
                                       title="Smazat"
                                       aria-label="Smazat {{ meal.internalName }}">{{ icon('trash', 's16') }}</a>

                                    <twig:ConfirmModal
                                        id="{{ meal.id }}"
                                        url="{{ path('delete_meal', {'mealId': meal.id}) }}"
                                        confirmationText="Opravdu chcete smazat toto jídlo?" />
                                {% endif %}
                            </div>
                        </li>
                    {% endfor %}
                </ul>
                <div class="wm-foot cap">Zobrazeno <span data-chip-filter-target="shown">{{ meals|length }}</span> z {{ meals|length }}</div>
            </div>
        {% endif %}
    </div>
{% endblock %}
