{#
    The "container sheet" chrome of every one-pencil container, rendered
    INSIDE the `.fill-popovers` container of all three fill pages (single,
    group, document). A sheet is a VIEW over the existing "Všechna pole"
    cards: variant-fill-overlay#openSheet switches `.fill-popovers` into
    `fill-sheet-open` mode, shows this sheet's head + section headings and
    the cards of its fields (by `data-inputid`, never by DOM position) and
    orders them with CSS `order` — no card moves in the DOM, so every editor
    (WYSIWYG, checklist, font select) keeps its one instance and state.

    Parameters:
    - sheets: FillContainerSheets rows (unified for the page)
    - movable / unit: (optional, single page) FillMovableElements rows by id —
      a movable container's head gets the "Poloha" row

    `data-sheet-entries` = the sheet's ordered entries ({kind: field|section|
    rowAdd, id, depth}); section headings carry the nested container's eye
    when it is hidable (the same `hiddenValues[<id>]` mirror as its panel row).

    Repeatable rows (container-rows P4): a row's materialised slots are
    sections with `row` + `slot` — headed "Řádek n" with a drag grip, Odstranit
    and a collapse toggle (fill_row_sheet.js frames head + cards as one block)
    — and a `rowAdd` entry ("+ Přidat řádek") follows the row's last slot. The
    overlay shows only the ACTIVE rows (`rowCounts[<row>]`) and enables the
    buttons (min / max / the height gate); every action is ONE undo step
    (variant-fill-overlay#addRow / removeRow, drag & grip arrow keys).
#}
{% for sheet in sheets %}
    {% set label = sheet.name ?: 'Skupina polí' %}
    {% set count = sheet.fieldIds|length %}
    <div class="fill-sheet__head" data-fill-sheet="{{ sheet.id }}" data-sheet-entries="{{ sheet.entries|json_encode }}">
        <span class="i i-grip s14 fill-popover__drag fill-sheet__drag" data-popover-drag-handle role="button" aria-label="Přesunout okno" title="Přesunout okno"></span>
        <span class="fill-sheet__lead">
            {{ icon('layers', 's16') }}
            <span class="fill-sheet__title" id="fill-sheet-title-{{ sheet.id }}">{{ label }}</span>
            <span class="fill-sheet__count">{{ count }} {{ count <= 4 ? 'pole' : 'polí' }}</span>
        </span>
        {% if sheet.hidable %}
            <button type="button"
                class="fill-sheet__eye{{ sheet.hidden ? ' is-active' : '' }}"
                data-hide-toggle="{{ sheet.id }}"
                aria-pressed="{{ sheet.hidden ? 'true' : 'false' }}"
                title="{{ sheet.hidden ? 'Zobrazit prvek' : 'Schovat prvek' }}"
                aria-label="{{ sheet.hidden ? 'Zobrazit prvek' : 'Schovat prvek' }}"
                data-action="variant-fill-overlay#toggleHide"
                data-variant-fill-overlay-inputid-param="{{ sheet.id }}"
            >{{ icon(sheet.hidden ? 'eye-off' : 'eye', 's14') }}</button>
        {% endif %}
        <button type="button" class="btn btn-success xs fill-sheet__ok" title="Uložit (Ctrl/⌘+Enter)" data-action="variant-fill-overlay#closeSheet">{{ icon('check', 's14') }}Uložit</button>
        <button type="button" class="btn btn-ghost icon xs fill-sheet__x" aria-label="Zavřít" data-action="variant-fill-overlay#closeSheet">{{ icon('x', 's16') }}</button>
        {% if (movable|default({}))[sheet.id] is defined %}
            <div class="fill-sheet__move">{{ include('_fill_move_position.html.twig', { m: movable[sheet.id], unit: unit|default('px') }) }}</div>
        {% endif %}
    </div>
    {% for entry in sheet.entries|filter(entry => entry.kind == 'rowAdd') %}
        <div class="fill-sheet__row-add" data-fill-sheet-row-add="{{ sheet.id }}" data-row-id="{{ entry.id }}" style="--sheet-depth: {{ entry.depth }}">
            <button type="button" class="btn btn-tertiary xs fill-sheet__add"
                data-row-action="add"
                data-action="variant-fill-overlay#addRow"
                data-variant-fill-overlay-row-param="{{ entry.id }}"
            >{{ icon('plus', 's14') }}Přidat řádek</button>
            <span class="fill-sheet__add-reason" data-row-add-reason hidden></span>
        </div>
    {% endfor %}
    {% for entry in sheet.entries|filter(entry => entry.kind == 'section') %}
        {% set row_slot = entry.row is defined ? entry.slot + 1 : null %}
        <div class="fill-sheet__section{{ row_slot ? ' fill-sheet__section--row' : (entry.name or entry.hidable ? '' : ' fill-sheet__section--plain') }}"
             data-fill-sheet-section="{{ sheet.id }}" data-section-id="{{ entry.id }}" style="--sheet-depth: {{ entry.depth }}"
             {% if row_slot %}data-row="{{ entry.row }}" data-slot="{{ entry.slot }}"{% endif %}>
            {% if row_slot %}
                <button type="button" class="fill-sheet__row-grip" data-row-grip
                    title="Přetažením změníte pořadí"
                    aria-label="Přesunout řádek {{ row_slot }} (šipkami nahoru a dolů)"
                >{{ icon('grip', 's14') }}</button>
                <span class="fill-sheet__row-index" aria-hidden="true">{{ row_slot }}</span>
                <span class="fill-sheet__section-name">Řádek {{ row_slot }}</span>
                <span class="fill-sheet__row-summary" data-row-summary hidden></span>
            {% elseif entry.name %}<span class="fill-sheet__section-name">{{ entry.name }}</span>{% endif %}
            {% if entry.hidable %}
                <button type="button"
                    class="fill-sheet__eye{{ entry.hidden ? ' is-active' : '' }}"
                    data-hide-toggle="{{ entry.id }}"
                    aria-pressed="{{ entry.hidden ? 'true' : 'false' }}"
                    title="{{ entry.hidden ? 'Zobrazit prvek' : 'Schovat prvek' }}"
                    aria-label="{{ entry.hidden ? 'Zobrazit prvek' : 'Schovat prvek' }}"
                    data-action="variant-fill-overlay#toggleHide"
                    data-variant-fill-overlay-inputid-param="{{ entry.id }}"
                >{{ icon(entry.hidden ? 'eye-off' : 'eye', 's14') }}</button>
            {% endif %}
            {% if row_slot %}
                <span class="fill-sheet__row-tools" role="group" aria-label="Řádek {{ row_slot }}">
                    <button type="button" class="btn btn-danger xs"
                        data-row-action="remove"
                        aria-label="Odstranit řádek {{ row_slot }}"
                        data-action="variant-fill-overlay#removeRow"
                        data-variant-fill-overlay-row-param="{{ entry.row }}"
                        data-variant-fill-overlay-slot-param="{{ entry.slot }}"
                    >Odstranit</button>
                    <button type="button" class="fill-sheet__row-btn" data-row-toggle
                        aria-expanded="true" title="Sbalit řádek" aria-label="Sbalit řádek"
                    >{{ icon('chev-down', 's14') }}</button>
                </span>
            {% endif %}
        </div>
    {% endfor %}
{% endfor %}
