{# Preview modal for weekly menu planner. The menu itself is customer output
   (_menu_display, shared with the public page) — it stays a white sheet with
   its own colours inside the Nocturne dialog. #}
<div class="modal fade wm-modal wm-preview" id="menuPreviewModal" tabindex="-1" aria-labelledby="menuPreviewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title" id="menuPreviewModalLabel">Náhled jídelníčku</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Zavřít"></button>
            </div>
            <div class="modal-body">
                <style>
                    #menuPreviewModal .weekly-menu-display {
                        font-size: 12px;
                        max-width: 1600px;
                        margin: 0 auto;
                    }

                    #menuPreviewModal .weekly-menu-display .menu-table-wrapper {
                        overflow-x: auto;
                    }

                    #menuPreviewModal .weekly-menu-display .header {
                        text-align: center;
                        margin-bottom: 15px;
                        padding-bottom: 10px;
                        border-bottom: 2px solid #333;
                    }

                    #menuPreviewModal .weekly-menu-display .header h1 {
                        font-size: 22px;
                        margin: 0 0 5px 0;
                    }

                    #menuPreviewModal .weekly-menu-display .header .dates {
                        font-size: 14px;
                        color: #555;
                    }

                    #menuPreviewModal .weekly-menu-display .menu-table {
                        width: 100%;
                        border-collapse: collapse;
                        table-layout: fixed;
                    }

                    #menuPreviewModal .weekly-menu-display .menu-table th,
                    #menuPreviewModal .weekly-menu-display .menu-table td {
                        border: 1px solid #dee2e6;
                        padding: 8px;
                        vertical-align: top;
                    }

                    #menuPreviewModal .weekly-menu-display .menu-table th {
                        color: white;
                        font-weight: bold;
                        text-align: center;
                        font-size: 14px;
                        padding: 10px 6px;
                    }

                    #menuPreviewModal .weekly-menu-display .menu-table th .date {
                        font-size: 12px;
                        font-weight: normal;
                        opacity: 0.9;
                    }

                    #menuPreviewModal .weekly-menu-display .day-column {
                        width: 14.28%;
                    }

                    #menuPreviewModal .weekly-menu-display .meal-type-section {
                        margin-bottom: 8px;
                        padding: 6px;
                        border-radius: 4px;
                    }

                    #menuPreviewModal .weekly-menu-display .meal-type-section:last-child {
                        margin-bottom: 0;
                    }

                    #menuPreviewModal .weekly-menu-display .meal-type-header {
                        font-weight: bold;
                        font-size: 12px;
                        margin-bottom: 4px;
                        padding: 3px 6px;
                        border-radius: 3px;
                    }

                    #menuPreviewModal .weekly-menu-display .course {
                        margin-bottom: 4px;
                        padding-left: 6px;
                    }

                    #menuPreviewModal .weekly-menu-display .course-label {
                        font-size: 10px;
                        color: #666;
                        font-style: italic;
                    }

                    #menuPreviewModal .weekly-menu-display .variant {
                        margin: 3px 0;
                    }

                    #menuPreviewModal .weekly-menu-display .variant-name {
                        font-weight: 600;
                        font-size: 10px;
                        color: #333;
                    }

                    #menuPreviewModal .weekly-menu-display .meal-item {
                        display: block;
                        font-size: 11px;
                        padding: 1px 0;
                    }

                    #menuPreviewModal .weekly-menu-display .meal-name {
                        color: #111;
                    }

                    #menuPreviewModal .weekly-menu-display .diet-codes {
                        color: #666;
                        font-size: 10px;
                    }

                    #menuPreviewModal .weekly-menu-display .meal-variant {
                        display: block;
                        font-size: 10px;
                        padding-left: 10px;
                        color: #555;
                    }

                    #menuPreviewModal .weekly-menu-display .meal-variant-name {
                        font-style: italic;
                    }

                    #menuPreviewModal .weekly-menu-display .empty-cell {
                        color: #999;
                        font-style: italic;
                        text-align: center;
                        padding: 15px;
                    }

                    #menuPreviewModal .weekly-menu-display .footer {
                        display: none;
                    }
                </style>
                <div class="wm-paper">
                    {% include 'weekly_menu/_menu_display.html.twig' with { menu: menu, showFooter: false } %}
                </div>
            </div>
            <div class="modal-footer">
                <a href="{{ path('public_weekly_menu', {'menuId': menu.id}) }}" target="_blank" class="btn btn-ghost sm">{{ icon('link', 's16') }}Otevřít veřejnou stránku</a>
                <span class="flex-grow-1"></span>
                <button type="button" class="btn btn-tertiary sm" data-bs-dismiss="modal">Zavřít</button>
                <a href="{{ path('download_weekly_menu_pdf', {'menuId': menu.id}) }}" class="btn btn-primary sm">{{ icon('download', 's16') }}Stáhnout PDF</a>
            </div>
        </div>
    </div>
</div>
