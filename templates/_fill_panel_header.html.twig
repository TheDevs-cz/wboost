{#
    The "Všechna pole" panel header, shared by the single-variant and group
    fill pages. `arrangeable` (admins only) adds the hint that the fields can
    be dragged into a new order — saved for everyone filling the template —
    and the fill-field-order controller's save status.
#}
<div class="fill-popovers__header">
    <div class="fill-popovers__title">
        <h2 id="fill-panel-title">Všechna pole</h2>
        <span class="cap">Vyplníte jednou, propíše se do náhledu hned.</span>
        {% if arrangeable|default(false) %}
            <span class="cap fill-popovers__arrange">
                {{ icon('grip', 's14') }}
                Pořadí polí změníte přetažením — uloží se pro všechny, kdo šablonu vyplňují.
                <span class="fill-field-order__status" data-fill-field-order-target="status" aria-live="polite"></span>
            </span>
        {% endif %}
    </div>
    {# Deliberately NOT `.btn`: openPanel focuses the first `button.btn` /
       field in document order, which must be a field, not this header. #}
    <button type="button" class="fill-panel-done" data-action="variant-fill-overlay#closePanel">Hotovo</button>
    <button type="button" class="fill-panel-x" aria-label="Zavřít" data-action="variant-fill-overlay#closePanel">{{ icon('x', 's16') }}</button>
</div>
