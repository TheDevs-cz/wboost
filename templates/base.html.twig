<!DOCTYPE html>
{#
    Nocturne app shell — contract in docs/architecture/app-shell.md.
    Blocks for pages: title, eyebrow, title_count, page_lead, title_actions,
    breadcrumb, content; full_content replaces the whole shell (auth/error
    pages); page_title_row = the page header (override empty to drop it);
    inner_class = extra classes on .inner (`inner-wide` for full-width
    workspaces); mobile_primary_action = the round + in the phone top bar.
#}
{% set shell_route = app.request.attributes.get('_route') %}
{# The canvas editors open with the sidebar collapsed to the icon rail
   (prototype `body.ed-on`); toggling it there is not persisted. #}
{% set shell_force_rail = shell_route in ['template_variant_editor', 'template_group_editor', 'calendar_workspace'] %}
<html lang="{{ app.request.locale }}" data-turbo="false" data-theme="dark" data-bs-theme="dark"{% if shell_force_rail %} class="sb-rail" data-sb-forced="1"{% endif %}>
    <head>
        <meta charset="UTF-8">
        <title>{% apply spaceless %}{% block title %}{% endblock %}{% endapply %} | WBoost</title>

        {% block meta_viewport %}
            <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
        {% endblock %}

        <meta name="turbo-prefetch" content="false">
        <meta name="turbo-refresh-method" content="morph">

        <meta name="description" content="{% apply spaceless %}{% block meta_description %}{% endblock %}{% endapply %}">
        <meta name="keywords" content="{% apply spaceless %}{% block meta_keywords %}{% endblock %}{% endapply %}">

        <meta name="msapplication-TileColor" content="#0B0A0D">
        <meta name="theme-color" content="#0B0A0D">

        {# Theme before first paint: localStorage['wb-theme'] ('dark'|'light'),
           absent → OS preference. Also restores the collapsed sidebar rail. #}
        {% block theme_script %}
        <script>(function(){var d=document.documentElement,t=null,c=null;try{t=localStorage.getItem('wb-theme');c=localStorage.getItem('wb-collapsed');}catch(e){}if(t!=='light'&&t!=='dark'){t=(window.matchMedia&&window.matchMedia('(prefers-color-scheme: light)').matches)?'light':'dark';}d.setAttribute('data-theme',t);d.setAttribute('data-bs-theme',t);if(c==='1'){d.classList.add('sb-rail');}})();</script>
        {% endblock %}

        <link rel="apple-touch-icon" sizes="57x57" href="{{ asset('apple-icon-57x57.png') }}">
        <link rel="apple-touch-icon" sizes="60x60" href="{{ asset('apple-icon-60x60.png') }}">
        <link rel="apple-touch-icon" sizes="72x72" href="{{ asset('apple-icon-72x72.png') }}">
        <link rel="apple-touch-icon" sizes="76x76" href="{{ asset('apple-icon-76x76.png') }}">
        <link rel="apple-touch-icon" sizes="114x114" href="{{ asset('apple-icon-114x114.png') }}">
        <link rel="apple-touch-icon" sizes="120x120" href="{{ asset('apple-icon-120x120.png') }}">
        <link rel="apple-touch-icon" sizes="144x144" href="{{ asset('apple-icon-144x144.png') }}">
        <link rel="apple-touch-icon" sizes="152x152" href="{{ asset('apple-icon-152x152.png') }}">
        <link rel="apple-touch-icon" sizes="180x180" href="{{ asset('apple-icon-180x180.png') }}">
        <link rel="icon" type="image/png" sizes="192x192"  href="{{ asset('android-icon-192x192.png') }}">
        <link rel="icon" type="image/png" sizes="32x32" href="{{ asset('favicon-32x32.png') }}">
        <link rel="icon" type="image/png" sizes="96x96" href="{{ asset('favicon-96x96.png') }}">
        <link rel="icon" type="image/png" sizes="16x16" href="{{ asset('favicon-16x16.png') }}">
        <link rel="manifest" href="{{ asset('manifest.json') }}">
        <meta name="msapplication-TileColor" content="#ffffff">
        <meta name="msapplication-TileImage" content="{{ asset('ms-icon-144x144.png') }}">

        <link rel="shortcut icon" type="image/x-icon" href="{{ asset('favicon.ico') }}">

        <link type="text/plain" rel="author" href="{{ asset('humans.txt') }}">

        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&display=swap">

        {% block importmap %}
            {{ importmap('app') }}
        {% endblock %}

        {% block custom_styles %}{% endblock %}
    </head>
    <body class="{% block body_class %}{% endblock %}" data-controller="confirm-modal">
    {# Block definitions rendered through block() below, so the header can be
       assembled (and skipped) as a whole. Twig hoists blocks out of the if. #}
    {% if false %}
        {% block eyebrow %}{% if project is defined %}Projekt · {{ project.name }}{% elseif active_menu_item|default('') starts with 'admin_' %}Administrace{% endif %}{% endblock %}
        {% block title_count %}{% endblock %}
        {% block page_lead %}{% endblock %}
        {% block title_actions %}{% endblock %}
        {% block breadcrumb %}{% endblock %}
        {% block inner_class %}{% endblock %}
        {% block mobile_primary_action %}{% endblock %}
    {% endif %}
    {% block full_content %}
        {% set shell_projects = shell_projects() %}
        {# The sidebar's project: the page's own `project`, else the last one
           the user opened (session, voter re-checked) — F15, app-shell.md. #}
        {% set shell_project = shell_project(project ?? null) %}
        <div class="app" id="app"
             data-controller="shell"
             data-shell-persist-value="{{ shell_force_rail ? 'false' : 'true' }}"
             data-shell-project-id-value="{{ project is defined ? project.id : '' }}"
             data-action="keydown.esc@window->shell#escape pointerdown@window->shell#outside resize@window->shell#resized">

            {{ include('_shell/_sidebar.html.twig') }}

            <main class="main" id="main">
                <div class="mbar wrap">
                    {# The phone's AI scan dot (ux.md §7): the sidebar is a closed drawer there. #}
                    {% set scan_signal = ai_scan_shell(shell_project) %}
                    <button type="button" class="btn icon ghost" data-action="shell#openDrawer" aria-label="Otevřít menu{{ scan_signal.any ? ' — sken čeká na vaši pozornost' : '' }}" aria-controls="sidebar">{{ icon('menu') }}{% if scan_signal.any %}<span class="as-ndot" data-ai-scan-signal aria-hidden="true"></span>{% endif %}</button>
                    <a href="{{ path('dashboard') }}" class="brand" aria-label="Wboost – všechny projekty">{{ include('_shell/_logo.html.twig', {}, with_context = false) }}</a>
                    <div class="mbar-side">{{ block('mobile_primary_action') }}</div>
                </div>

                <div class="wrap">
                    <div class="inner {{ block('inner_class')|trim }}" id="view">
                        {# Overridable so full-height app screens (the canvas
                           editors) can reclaim the vertical space — their
                           breadcrumb already ends with this exact title. #}
                        {% set shell_head = block('page_title_row')|trim %}
                        {% if shell_head is not empty %}
                            {{ shell_head|raw }}
                        {% else %}
                            {{ block('breadcrumb') }}
                        {% endif %}

                        {{ include('_flashes.html.twig') }}

                        <div class="page-body">
                            {% block content %}{% endblock %}
                        </div>
                    </div>
                </div>
            </main>

            <div class="scrim" data-shell-target="scrim" data-action="click->shell#closeDrawer" hidden></div>

            {# AI scan signals: polls only when rendered with an unfinished scan of
               the viewer (or after `ai-scan:changed`) — app-shell.md. #}
            {% if app.user %}
                <span hidden
                      data-controller="ai-scan-shell"
                      data-ai-scan-shell-url-value="{{ path('ai_scans_mine') }}"
                      data-ai-scan-shell-poll-value="{{ scan_signal.poll ? 'true' : 'false' }}"
                      data-ai-scan-shell-known-value="{{ scan_signal.known|keys|json_encode }}"
                      data-ai-scan-shell-project-id-value="{{ shell_project ? shell_project.id : '' }}"></span>
            {% endif %}

            {% if shell_projects is not empty %}
                {{ include('_shell/_quick_nav.html.twig') }}
            {% endif %}
        </div>

        {{ include('_social_publish_fake_door.html.twig') }}
    {% endblock %}

    {% if false %}
        {% block page_title_row %}
            {% set shell_crumbs = block('breadcrumb')|trim %}
            {% if shell_crumbs is not empty %}
                <nav class="page-crumbs" aria-label="Drobečková navigace">{{ shell_crumbs|raw }}</nav>
            {% endif %}
            <header class="head">
                <div class="head-main">
                    {% set shell_eyebrow = block('eyebrow')|trim %}
                    {% if shell_eyebrow is not empty %}<span class="lbl">{{ shell_eyebrow|raw }}</span>{% endif %}
                    {% set shell_count = block('title_count')|trim %}
                    <h1 class="page-title">{{ block('title') }}{% if shell_count is not empty %} <small>{{ shell_count|raw }}</small>{% endif %}</h1>
                    {% set shell_lead = block('page_lead')|trim %}
                    {% if shell_lead is not empty %}<span class="head-lead">{{ shell_lead|raw }}</span>{% endif %}
                </div>
                <div class="head-tools">{{ block('title_actions')|trim|raw }}</div>
            </header>
        {% endblock %}
    {% endif %}
    </body>
</html>
