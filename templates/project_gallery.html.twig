{% extends 'base.html.twig' %}

{% set active_menu_item = 'gallery' %}

{% block title %}Galerie{% endblock %}

{% block page_lead %}Sdílené obrázky projektu. Použijete je v editorech šablon a sociálních sítí přes tlačítka „Pozadí“ a „Přidat obrázek“; organizujte je do složek.{% endblock %}

{% block breadcrumb %}
    <ol class="breadcrumb m-0 pt-0">
        <li class="breadcrumb-item"><a href="{{ path('project_dashboard', {'id': project.id}) }}">{{ project.name }}</a></li>
        <li class="breadcrumb-item active">{{ block('title') }}</li>
    </ol>
{% endblock %}

{% block content %}
    <twig:Project:ImageGallery :project="project" :modal="false" />
{% endblock %}
