{% extends 'base.html.twig' %}
{% import 'admin/_macros.html.twig' as adm %}

{% set active_menu_item = 'admin_registration_requests' %}

{% block title %}Žádosti o registraci{% endblock %}
{% block title_count %}{{ requests|filter(r => r.status.value == 'pending')|length }}{% endblock %}
{% block page_lead %}Nové žádosti najdete i nahoře v seznamu uživatelů. Povolením otevřete pozvánku s předvyplněným e-mailem.{% endblock %}

{% block content %}
    {% if requests|length == 0 %}
        <div class="empty">
            <span class="ico-c">{{ icon('user-plus') }}</span>
            <h2 class="empty-t">Zatím nejsou žádné žádosti o registraci.</h2>
            <p>Jakmile někdo požádá o přístup přes registrační formulář, objeví se tady.</p>
        </div>
    {% else %}
        <div class="u-card">
            <div class="u-lh" aria-hidden="true"><span>E-mail</span><span class="u-tags"><span>Požádáno</span><span>Stav</span></span><span></span></div>
            <ul class="u-list" aria-label="Žádosti o registraci">
                {% for request in requests %}
                    {% set status = request.status.value %}
                    <li class="u-row{{ status == 'pending' ? ' req' : (status == 'dismissed' ? ' rej' : '') }}">
                        <div class="u-who">
                            <span class="av {{ status == 'pending' ? 'req' : 'inv' }}" aria-hidden="true">{{ icon(status == 'invited' ? 'mail' : 'user-plus') }}</span>
                            <span class="who"><span class="u-nm">{{ request.email }}</span></span>
                        </div>
                        <div class="u-tags">
                            <span class="u-role">{{ request.createdAt|date('j. n. Y H:i') }}</span>
                            {% if status == 'pending' %}
                                <span class="u-st"><span class="pill mint">Nová žádost</span><span class="cap">{{ adm.ago(request.createdAt) }}</span></span>
                            {% elseif status == 'invited' %}
                                <span class="u-st"><span class="pill">Pozván</span></span>
                            {% else %}
                                <span class="u-st off"><span class="dot"></span>Zamítnuto</span>
                            {% endif %}
                        </div>
                        <div class="u-acts req-acts">
                            {% if status == 'pending' %}
                                <a href="#" class="btn btn-secondary xs" data-modal-id="{{ request.id }}" data-action="click->confirm-modal#showModal">Zamítnout</a>
                                <a href="{{ path('admin_invite_user', {'email': request.email}) }}" class="btn btn-primary xs">{{ icon('check', 's14') }}Povolit</a>
                            {% endif %}
                        </div>
                    </li>
                {% endfor %}
            </ul>
        </div>

        {% for request in requests|filter(r => r.status.value == 'pending') %}
            <twig:ConfirmModal
                id="{{ request.id }}"
                url="{{ path('admin_dismiss_registration_request', {'id': request.id}) }}"
                confirmationText="Opravdu chcete zamítnout tuto žádost o registraci?" />
        {% endfor %}
    {% endif %}
{% endblock %}
