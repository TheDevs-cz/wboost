{% extends 'base.html.twig' %}
{% import 'admin/_stats_macros.html.twig' as st %}
{% import 'admin/_macros.html.twig' as adm %}

{% set active_menu_item = 'admin_usage' %}

{% block title %}Statistiky{% endblock %}

{#
    Prototype renderStats: underline tabs over the three existing report
    sections (Klienti = exports by client, Aktivita = user activity,
    Úložiště = storage inventory), KPI tiles with sparklines, chart cards and
    month heatmaps. The fourth tab, AI skeny, is its own partial
    (admin/_usage_ai_scans.html.twig, GetAiUsageOverview). Data and queries are unchanged (GetUsageOverview,
    GetUserActivity, GetStorageOverview); sparklines/levels are derived here.
    Tabs + ApexCharts theming: usage_stats_controller (charts render when their
    tab is first shown and re-theme on the light/dark switch).
#}

{% set now_month = 'now'|date('Y-m') %}

{# ---- derived per-month series for the KPI sparklines ---- #}
{% set templates_by_month = [] %}
{% set downloads_by_month = [] %}
{% set clients_by_month = [] %}
{% for month in usage.months %}
    {% set i = loop.index0 %}
    {% set t = 0 %}{% for s in usage.chartSeries %}{% set t = t + (s.data[i] ?? 0) %}{% endfor %}
    {% set d = 0 %}{% set c = 0 %}
    {% for owner in usage.owners %}
        {% set od = owner.downloadsInMonth(month) %}
        {% set d = d + od %}{% if od > 0 %}{% set c = c + 1 %}{% endif %}
    {% endfor %}
    {% set templates_by_month = templates_by_month|merge([t]) %}
    {% set downloads_by_month = downloads_by_month|merge([d]) %}
    {% set clients_by_month = clients_by_month|merge([c]) %}
{% endfor %}
{% set last_downloads = downloads_by_month|last ?: 0 %}
{% set prev_downloads = downloads_by_month|length > 1 ? downloads_by_month[downloads_by_month|length - 2] : 0 %}
{% set last_label = usage.chartCategories|last ?: '' %}

{% block page_title_row %}
    <header class="head">
        <div class="head-main">
            <span class="lbl">Administrace</span>
            <h1 class="page-title">Statistiky</h1>
        </div>
    </header>
{% endblock %}

{% block content %}
<div class="st-page" data-controller="usage-stats">
    <div class="tabs-u" role="tablist" aria-label="Statistiky">
        <button type="button" role="tab" id="st-tab-klienti" aria-controls="st-klienti" aria-selected="true" data-tab="klienti" data-action="usage-stats#select keydown->usage-stats#tabKey">{{ icon('users', 's16') }}Klienti</button>
        <button type="button" role="tab" id="st-tab-aktivita" aria-controls="st-aktivita" aria-selected="false" tabindex="-1" data-tab="aktivita" data-action="usage-stats#select keydown->usage-stats#tabKey">{{ icon('trend', 's16') }}Aktivita</button>
        <button type="button" role="tab" id="st-tab-uloziste" aria-controls="st-uloziste" aria-selected="false" tabindex="-1" data-tab="uloziste" data-action="usage-stats#select keydown->usage-stats#tabKey">{{ icon('database', 's16') }}Úložiště</button>
        <button type="button" role="tab" id="st-tab-ai-skeny" aria-controls="st-ai-skeny" aria-selected="false" tabindex="-1" data-tab="ai-skeny" data-action="usage-stats#select keydown->usage-stats#tabKey">{{ icon('sparkle', 's16') }}AI skeny{% if ai.requests is not empty %}<span class="pd-n" title="Žádosti o přístup">{{ ai.requests|length }}</span>{% endif %}</button>
    </div>

    {# =================================================================== Klienti #}
    <section class="st-pane" id="st-klienti" role="tabpanel" aria-labelledby="st-tab-klienti" data-usage-stats-target="pane" data-tab="klienti">
        <p class="cap st-lead">
            Přehled exportů šablon a sociálních sítí napříč klienty. Sleduje se každé
            stažení / export z webu i z API.
            <strong>Unikátní šablony</strong> = počet různých šablon (designů),
            <strong>varianty</strong> = počet různých variant, <strong>stažení</strong> = celkový počet exportů.
        </p>

        <div class="st-kpis">
            <div class="st-kpi">
                <span class="k">{{ icon('layers') }}Unikátní šablony</span>
                <b>{{ usage.totalUniqueTemplates }}</b>
                <span class="s">napříč {{ usage.projectCount }} {{ usage.projectCount == 1 ? 'projektem' : 'projekty' }}</span>
                {{ st.spark(templates_by_month) }}
            </div>
            <div class="st-kpi">
                <span class="k">{{ icon('template') }}Unikátní varianty</span>
                <b>{{ usage.totalUniqueVariants }}</b>
                <span class="s">různé formáty a rozměry</span>
            </div>
            <div class="st-kpi">
                <span class="k">{{ icon('download') }}Stažení celkem</span>
                <b>{{ usage.totalDownloads }}</b>
                <span class="s">
                    {% if last_label %}
                        {% if prev_downloads > 0 %}
                            {% set delta = ((last_downloads - prev_downloads) / prev_downloads * 100)|round %}
                            <span class="{{ delta >= 0 ? 'up' : 'dn' }}">{{ delta >= 0 ? '▲' : '▼' }} {{ delta|abs }} %</span>
                        {% endif %}
                        {{ last_label }}: {{ last_downloads }}
                    {% endif %}
                </span>
                {{ st.spark(downloads_by_month) }}
            </div>
            <div class="st-kpi">
                <span class="k">{{ icon('users') }}Aktivní klienti</span>
                <b>{{ usage.clientCount }}</b>
                <span class="s">{% if last_label %}{{ last_label }}: {{ clients_by_month|last }}{% endif %}</span>
                {{ st.spark(clients_by_month) }}
            </div>
        </div>

        {% if usage.isEmpty %}
            <div class="empty">
                <span class="ico-c">{{ icon('chart') }}</span>
                <p>Zatím nebyly zaznamenány žádné exporty. Jakmile uživatelé začnou stahovat
                    šablony, objeví se zde statistiky využití.</p>
            </div>
        {% else %}
            <div class="st-card">
                <div class="st-card-h">
                    <div><h2>Unikátní šablony podle klienta a měsíce</h2><span class="cap">Kolik různých šablon klienti v měsíci stáhli</span></div>
                </div>
                <div id="usage-chart" class="st-chart" data-usage-stats-target="chart" data-kind="usage"
                     data-series="{{ usage.chartSeries|json_encode }}" data-categories="{{ usage.chartCategories|json_encode }}"></div>
            </div>

            {# Levels for BOTH metrics are computed here (owner rows against the
               owner max, project rows against the project max) and rendered as
               data-ld / data-lt; the metric toggle (usage_heatmap_controller)
               only flips data-metric on the card and CSS picks the matching
               level + number — no request, no client-side recalculation. #}
            {% set owner_max_t = 1 %}{% set owner_max_d = 1 %}{% set hm_max_t = 1 %}{% set hm_max_d = 1 %}
            {% for owner in usage.owners %}{% for month in usage.months %}
                {% set owner_max_t = max(owner_max_t, owner.templatesInMonth(month)) %}
                {% set owner_max_d = max(owner_max_d, owner.downloadsInMonth(month)) %}
                {% for project in owner.projects %}
                    {% set hm_max_t = max(hm_max_t, project.templatesInMonth(month)) %}
                    {% set hm_max_d = max(hm_max_d, project.downloadsInMonth(month)) %}
                {% endfor %}
            {% endfor %}{% endfor %}
            {% set hm_cols = usage.months|length + 4 %}

            <div class="st-card hm-card" data-controller="usage-heatmap" data-metric="downloads">
                <div class="st-card-h">
                    <div><h2>Klienti po měsících</h2>
                        <span class="cap"><span data-only="downloads">Počet stažení v měsíci</span><span data-only="templates">Unikátní šablony v měsíci</span> · kliknutím na klienta zobrazíte jeho projekty</span></div>
                    <span class="hm-scale" aria-hidden="true">0 <i class="lv0"></i><i class="lv1"></i><i class="lv2"></i><i class="lv3"></i><i class="lv4"></i> <span data-only="downloads">víc stažení</span><span data-only="templates">víc šablon</span> <i class="now"></i> tento měsíc</span>
                </div>
                <div class="hm-tools">
                    <label class="inp sm hm-search" for="hm-search">
                        {{ icon('search', 's16') }}
                        <input type="search" id="hm-search" placeholder="Hledat klienta nebo projekt" autocomplete="off" aria-label="Hledat klienta nebo projekt"
                               data-usage-heatmap-target="search" data-action="input->usage-heatmap#filter search->usage-heatmap#filter keydown.esc->usage-heatmap#clearSearch">
                    </label>
                    <button type="button" class="btn btn-ghost xs hm-all" data-usage-heatmap-target="allButton" data-action="usage-heatmap#toggleAll">{{ icon('chev-down', 's14') }}<span data-usage-heatmap-target="allLabel">Rozbalit vše</span></button>
                    <div class="seg soft hm-metric" role="group" aria-label="Číslo v buňkách">
                        <button type="button" class="on" aria-pressed="true" data-usage-heatmap-target="metricButton" data-metric="downloads" data-action="usage-heatmap#setMetric">{{ icon('download', 's14') }}Stažení</button>
                        <button type="button" aria-pressed="false" data-usage-heatmap-target="metricButton" data-metric="templates" data-action="usage-heatmap#setMetric">{{ icon('layers', 's14') }}Šablony</button>
                    </div>
                </div>
                <div class="hm-scroll" data-usage-heatmap-target="scroll">
                    <table class="hm hm-clients">
                        <thead>
                            <tr>
                                <th scope="col" class="hm-name">Klient / Projekt</th>
                                {% for month in usage.months %}{{ st.month_head(month, loop.first, now_month) }}{% endfor %}
                                <th scope="col" class="hm-num">Šablony</th>
                                <th scope="col" class="hm-num">Varianty</th>
                                <th scope="col" class="hm-num">Stažení</th>
                            </tr>
                        </thead>
                        {% for owner in usage.owners %}
                            {% set n_projects = owner.projects|length %}
                            {% set projects_label = n_projects ~ ' ' ~ st.plural(n_projects, 'projekt', 'projekty', 'projektů') %}
                            <tbody class="hm-grp" data-usage-heatmap-target="group" data-owner="{{ owner.ownerId }}">
                                <tr class="hm-gap" aria-hidden="true" data-usage-heatmap-target="gap"{{ loop.first ? ' hidden' }}><td colspan="{{ hm_cols }}"></td></tr>
                                <tr class="hm-cl" data-action="click->usage-heatmap#toggle" data-q="{{ owner.displayName }} {{ owner.ownerEmail }}">
                                    <th scope="row" class="hm-name">
                                        <button type="button" class="hm-tg" aria-expanded="false" aria-controls="hm-p-{{ owner.ownerId }}" title="{{ owner.ownerEmail }}">
                                            {{ icon('chev-right', 's14 hm-chev') }}
                                            <span class="u-who"><span class="av" aria-hidden="true">{{ adm.person_initials(owner.ownerName, owner.ownerEmail) }}</span>
                                                <span class="who">
                                                    <span class="hm-nl"><b>{{ owner.displayName }}</b><span class="count" title="{{ projects_label }}" aria-hidden="true">{{ n_projects }}</span><span class="visually-hidden">, {{ projects_label }}</span></span>
                                                    {% if owner.ownerName %}<span class="hm-em">{{ owner.ownerEmail }}</span>{% endif %}
                                                </span></span>
                                        </button>
                                    </th>
                                    {% for month in usage.months %}
                                        {% set t = owner.templatesInMonth(month) %}{% set d = owner.downloadsInMonth(month) %}
                                        <td class="hm-c{{ d == 0 ? ' lv0' }}{{ month == now_month and d > 0 ? ' now' }}" data-ld="{{ st.level(d, owner_max_d) }}" data-lt="{{ st.level(t, owner_max_t) }}" title="{{ d }} stažení · {{ t }} {{ st.plural(t, 'šablona', 'šablony', 'šablon') }}">
                                            {%- if d > 0 %}<span data-only="downloads">{{ d }}</span><span data-only="templates">{{ t }}</span>{% endif -%}
                                        </td>
                                    {% endfor %}
                                    <td class="hm-num"><b>{{ owner.uniqueTemplates }}</b></td>
                                    <td class="hm-num">{{ owner.uniqueVariants }}</td>
                                    <td class="hm-num">{{ owner.downloads }}</td>
                                </tr>
                            </tbody>
                            <tbody class="hm-ps" id="hm-p-{{ owner.ownerId }}" data-usage-heatmap-target="projects" data-owner="{{ owner.ownerId }}" hidden>
                                {% for project in owner.projects %}
                                    <tr class="hm-us" data-q="{{ project.projectName }}">
                                        <th scope="row" class="hm-name"><span class="u-who">{{ icon('folder', 's14') }}<span class="who"><b>{{ project.projectName }}</b></span></span></th>
                                        {% for month in usage.months %}
                                            {% set t = project.templatesInMonth(month) %}{% set d = project.downloadsInMonth(month) %}
                                            <td class="hm-c{{ d == 0 ? ' lv0' }}{{ month == now_month and d > 0 ? ' now' }}" data-ld="{{ st.level(d, hm_max_d) }}" data-lt="{{ st.level(t, hm_max_t) }}" title="{{ d }} stažení · {{ t }} {{ st.plural(t, 'šablona', 'šablony', 'šablon') }}">
                                                {%- if d > 0 %}<span data-only="downloads">{{ d }}</span><span data-only="templates">{{ t }}</span>{% endif -%}
                                            </td>
                                        {% endfor %}
                                        <td class="hm-num">{{ project.uniqueTemplates }}</td>
                                        <td class="hm-num">{{ project.uniqueVariants }}</td>
                                        <td class="hm-num">{{ project.downloads }}</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        {% endfor %}
                    </table>
                </div>
                <div class="empty hm-none" data-usage-heatmap-target="none" hidden>
                    <span class="ico-c">{{ icon('search') }}</span>
                    <h2>Nic nenalezeno</h2>
                    <p>Žádný klient ani projekt neodpovídá „<span data-usage-heatmap-target="query"></span>“.</p>
                    <button type="button" class="btn btn-tertiary sm" data-action="usage-heatmap#clearSearch">Zrušit hledání</button>
                </div>
            </div>
        {% endif %}
    </section>

    {# =================================================================== Aktivita #}
    <section class="st-pane" id="st-aktivita" role="tabpanel" aria-labelledby="st-tab-aktivita" data-usage-stats-target="pane" data-tab="aktivita" hidden>
        <p class="cap st-lead">
            <strong>Aktivita uživatelů</strong> — kdy byl každý uživatel naposledy aktivní a jak intenzivně aplikaci používá.
            Sbírá se od nasazení této funkce — každá minuta aktivního používání se počítá
            jako jedna akce (přihlášení a běžné proklikávání aplikace).
        </p>

        {% set actions_30 = 0 %}{% for a in activity.actionsSeries %}{% set actions_30 = actions_30 + a %}{% endfor %}
        <div class="st-kpis">
            <div class="st-kpi">
                <span class="k">{{ icon('users') }}Aktivní uživatelé</span>
                <b>{{ activity.activeUserCount }} <small>z {{ activity.users|length }}</small></b>
                <span class="s">od začátku měření</span>
            </div>
            <div class="st-kpi">
                <span class="k">{{ icon('trend') }}Aktivní tento měsíc</span>
                <b>{{ activity.activeUsersInMonth(now_month) }}</b>
                <span class="s">různých uživatelů</span>
                {{ st.spark(activity.months|map(m => activity.activeUsersInMonth(m))) }}
            </div>
            <div class="st-kpi">
                <span class="k">{{ icon('chart') }}Akce za 30 dní</span>
                <b>{{ actions_30 }}</b>
                <span class="s">minuty aktivního používání</span>
                {{ st.spark(activity.actionsSeries) }}
            </div>
            <div class="st-kpi">
                <span class="k">{{ icon('user') }}Aktivní za 30 dní</span>
                <b>{{ activity.users|filter(u => u.lastActivityAt and u.lastActivityAt > date('-30 days'))|length }}</b>
                <span class="s">denně nejvýš {{ max(activity.activeUsersSeries|merge([0])) }}</span>
                {{ st.spark(activity.activeUsersSeries) }}
            </div>
        </div>

        <div class="st-card">
            <div class="st-card-h">
                <div><h2>Aktivita za posledních 30 dní</h2><span class="cap">Aktivní uživatelé a akce po dnech</span></div>
                {% if activity.hasActivity %}<span class="st-legend"><span><i></i>Aktivní uživatelé</span><span><i class="c2"></i>Akce</span></span>{% endif %}
            </div>
            {% if activity.hasActivity %}
                <div id="activity-chart" class="st-chart" data-usage-stats-target="chart" data-kind="activity"
                     data-series="{{ [{'name': 'Aktivní uživatelé', 'data': activity.activeUsersSeries}, {'name': 'Akce', 'data': activity.actionsSeries}]|json_encode }}"
                     data-categories="{{ activity.chartCategories|json_encode }}"></div>
            {% else %}
                <p class="st-none">Zatím nebyla zaznamenána žádná aktivita. Data se začnou sbírat, jakmile
                    se uživatelé přihlásí a začnou aplikaci používat.</p>
            {% endif %}
        </div>

        {% set act_max = 1 %}
        {% for user in activity.users %}{% for month in activity.months %}{% set act_max = max(act_max, user.activeDaysInMonth(month)) %}{% endfor %}{% endfor %}
        <div class="st-card hm-card">
            <div class="st-card-h">
                <div><h2>Aktivní dny podle uživatele a měsíce</h2>
                    <span class="cap">Buňka udává, kolik dní byl uživatel v daném měsíci aktivní. Řádek
                        „Aktivních uživatelů“ ukazuje, kolik různých uživatelů bylo v měsíci aktivních.</span></div>
                <span class="hm-scale" aria-hidden="true">0 <i class="lv0"></i><i class="lv1"></i><i class="lv2"></i><i class="lv3"></i><i class="lv4"></i> víc</span>
            </div>
            <div class="hm-scroll">
                <table class="hm">
                    <thead>
                        <tr>
                            <th scope="col" class="hm-name">Uživatel</th>
                            {% for month in activity.months %}{{ st.month_head(month, loop.first, now_month) }}{% endfor %}
                            <th scope="col" class="hm-num">Poslední aktivita</th>
                            <th scope="col" class="hm-num">Dní celkem</th>
                            <th scope="col" class="hm-num">Akcí</th>
                        </tr>
                        {% if activity.hasActivity %}
                            <tr class="hm-sum">
                                <th scope="row" class="hm-name"><span class="u-who">{{ icon('users', 's14') }}<span class="who"><b>Aktivních uživatelů</b></span></span></th>
                                {% for month in activity.months %}
                                    <td class="hm-sumc">{{ activity.activeUsersInMonth(month) ?: '' }}</td>
                                {% endfor %}
                                <td></td>
                                <td class="hm-num"><b>{{ activity.activeUserCount }}</b></td>
                                <td></td>
                            </tr>
                        {% endif %}
                    </thead>
                    <tbody>
                        {% for user in activity.users %}
                            <tr class="hm-us">
                                <th scope="row" class="hm-name">
                                    <span class="u-who"><span class="av" aria-hidden="true">{{ adm.person_initials(user.name, user.email) }}</span>
                                        <span class="who"><b>{{ user.displayName }}</b>{% if user.name %}<span>{{ user.email }}</span>{% endif %}</span></span>
                                </th>
                                {% for month in activity.months %}
                                    {% set v = user.activeDaysInMonth(month) %}
                                    <td class="hm-c lv{{ st.level(v, act_max) }}"><span>{{ v ?: '' }}</span></td>
                                {% endfor %}
                                <td class="hm-num hm-date">
                                    {% if user.lastActivityAt %}{{ user.lastActivityAt|date('j. n. Y H:i') }}{% else %}<span class="cap">Nikdy</span>{% endif %}
                                </td>
                                <td class="hm-num">{{ user.activeDays ?: '—' }}</td>
                                <td class="hm-num">{{ user.totalHits ?: '—' }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </section>

    {# =================================================================== Úložiště #}
    <section class="st-pane" id="st-uloziste" role="tabpanel" aria-labelledby="st-tab-uloziste" data-usage-stats-target="pane" data-tab="uloziste" hidden>
        <div class="st-bar">
            <p class="cap st-lead">
                <strong>Úložiště</strong> — kolik místa zabírají soubory jednotlivých klientů a projektů.
                <strong>Nepoužívané</strong> jsou soubory, na které už neodkazuje žádný záznam
                v databázi — typicky pozůstatky po smazaných projektech nebo po přepsání
                obrázku novým (aplikace stará data z úložiště nemaže). Data pochází z posledního
                načtení úložiště, ne z živého stavu.
            </p>
            <div class="st-scan">
                {% if storage.lastScannedAt %}
                    <span class="cap">Načteno {{ storage.lastScannedAt|date('j. n. Y H:i') }}</span>
                {% endif %}
                <form method="post" action="{{ path('admin_storage_rescan') }}" data-action="submit->usage-stats#rememberTab">
                    <input type="hidden" name="_token" value="{{ csrf_token('storage_rescan') }}">
                    <button type="submit" class="btn btn-ghost xs">{{ icon('refresh', 's14') }}Načíst znovu</button>
                </form>
            </div>
        </div>

        <div class="st-kpis">
            <div class="st-kpi">
                <span class="k">{{ icon('database') }}Celkem v úložišti</span>
                <b>{{ storage.totalSize|file_size }}</b>
                <span class="s">{{ storage.clientCount }} klientů</span>
            </div>
            <div class="st-kpi">
                <span class="k">{{ icon('file') }}Souborů</span>
                <b>{{ storage.totalFiles }}</b>
                <span class="s"><a href="{{ path('admin_storage_files') }}" class="st-link">Zobrazit jednotlivé soubory</a></span>
            </div>
            <div class="st-kpi{{ storage.orphanSize > 0 ? ' warn' }}">
                <span class="k">{{ icon('trash') }}Nepoužívané</span>
                <b>{{ storage.orphanSize|file_size }}</b>
                <span class="s">{{ storage.orphanFiles }} souborů{% if storage.orphanShare > 0 %} · {{ storage.orphanShare|number_format(0) }} % objemu{% endif %}</span>
            </div>
            <div class="st-kpi">
                <span class="k">{{ icon('help') }}Bez projektu</span>
                <b>{{ storage.unattributedSize|file_size }}</b>
                <span class="s">{{ storage.unattributedFiles }} souborů · vlastník už neexistuje</span>
            </div>
        </div>

        {% if storage.isEmpty %}
            <div class="empty">
                <span class="ico-c">{{ icon('database') }}</span>
                <p>Inventura úložiště zatím neproběhla. Spusťte ji tlačítkem „Načíst znovu“
                    nebo příkazem <code>app:storage:scan</code>.</p>
            </div>
        {% else %}
            <div class="st-card">
                <div class="st-card-h">
                    <div><h2>Zabrané místo podle klienta</h2><span class="cap">V MB, používané a nepoužívané soubory</span></div>
                    <span class="st-legend"><span><i></i>Používané</span><span><i class="c2"></i>Nepoužívané</span></span>
                </div>
                <div id="storage-chart" class="st-chart" data-usage-stats-target="chart" data-kind="storage"
                     data-series="{{ storage.chartSeries|json_encode }}" data-categories="{{ storage.chartLabels|json_encode }}"></div>
            </div>

            <div class="st-card">
                <div class="st-card-h">
                    <div><h2>Úložiště podle klienta a projektu</h2>
                        <span class="cap">Sloupce podle typu ukazují, čím je který projekt velký. Typ se odvozuje
                            z cesty v úložišti — kam který modul soubory ukládá.</span></div>
                    <a href="{{ path('admin_storage_files') }}" class="btn btn-secondary xs">Zobrazit jednotlivé soubory{{ icon('chev-right', 's14') }}</a>
                </div>
                <div class="hm-scroll">
                    <table class="st-table">
                        <thead>
                            <tr>
                                <th scope="col" class="hm-name">Klient / Projekt</th>
                                {% for row in storage.categories %}
                                    <th scope="col"><a href="{{ path('admin_storage_files', {category: row.category.value}) }}">{{ row.category.label }}</a></th>
                                {% endfor %}
                                <th scope="col">Souborů</th>
                                <th scope="col">Velikost</th>
                                <th scope="col">Nepoužito</th>
                                <th scope="col">Podíl</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for owner in storage.owners %}
                                <tr class="st-owner">
                                    <th scope="row" class="hm-name"><span class="u-who"><span class="av" aria-hidden="true">{{ adm.person_initials(null, owner.ownerEmail) }}</span><span class="who"><b>{{ owner.ownerEmail }}</b></span></span></th>
                                    {% for row in storage.categories %}
                                        {% set size = owner.sizeInCategory(row.category.value) %}
                                        <td>{{ size ? size|file_size : '' }}</td>
                                    {% endfor %}
                                    <td>{{ owner.fileCount }}</td>
                                    <td><b>{{ owner.totalSize|file_size }}</b></td>
                                    <td>{{ owner.orphanSize ? owner.orphanSize|file_size : '—' }}</td>
                                    <td>{{ owner.orphanShare > 0 ? owner.orphanShare|number_format(0) ~ ' %' : '—' }}</td>
                                </tr>
                                {% for project in owner.projects %}
                                    <tr>
                                        <th scope="row" class="hm-name st-proj">
                                            <a href="{{ path('admin_storage_files', {project: project.projectId}) }}">{{ icon('folder', 's14') }}{{ project.projectName }}</a>
                                        </th>
                                        {% for row in storage.categories %}
                                            {% set size = project.sizeInCategory(row.category.value) %}
                                            <td>
                                                {% if size %}
                                                    <a href="{{ path('admin_storage_files', {project: project.projectId, category: row.category.value}) }}">{{ size|file_size }}</a>
                                                {% else %}—{% endif %}
                                            </td>
                                        {% endfor %}
                                        <td>{{ project.fileCount }}</td>
                                        <td>{{ project.totalSize|file_size }}</td>
                                        <td>{{ project.orphanSize ? project.orphanSize|file_size : '—' }}</td>
                                        <td>{{ project.orphanShare > 0 ? project.orphanShare|number_format(0) ~ ' %' : '—' }}</td>
                                    </tr>
                                {% endfor %}
                            {% endfor %}
                            {% if storage.unattributed %}
                                {% set leftovers = storage.unattributed %}
                                <tr class="st-owner">
                                    <th scope="row" class="hm-name">
                                        <a href="{{ path('admin_storage_files', {project: leftovers.projectId}) }}" class="st-proj-a">{{ icon('help', 's14') }}Bez projektu</a>
                                        <span class="cap">(vlastník už neexistuje)</span>
                                    </th>
                                    {% for row in storage.categories %}
                                        {% set size = leftovers.sizeInCategory(row.category.value) %}
                                        <td>
                                            {% if size %}
                                                <a href="{{ path('admin_storage_files', {project: leftovers.projectId, category: row.category.value}) }}">{{ size|file_size }}</a>
                                            {% else %}—{% endif %}
                                        </td>
                                    {% endfor %}
                                    <td>{{ leftovers.fileCount }}</td>
                                    <td><b>{{ leftovers.totalSize|file_size }}</b></td>
                                    <td>{{ leftovers.orphanSize ? leftovers.orphanSize|file_size : '—' }}</td>
                                    <td>{{ leftovers.orphanShare > 0 ? leftovers.orphanShare|number_format(0) ~ ' %' : '—' }}</td>
                                </tr>
                            {% endif %}
                        </tbody>
                        <tfoot>
                            <tr>
                                <th scope="row" class="hm-name">Celkem</th>
                                {% for row in storage.categories %}
                                    <td>{{ row.totalSize|file_size }}</td>
                                {% endfor %}
                                <td>{{ storage.totalFiles }}</td>
                                <td>{{ storage.totalSize|file_size }}</td>
                                <td>{{ storage.orphanSize ? storage.orphanSize|file_size : '—' }}</td>
                                <td>{{ storage.orphanShare > 0 ? storage.orphanShare|number_format(0) ~ ' %' : '—' }}</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        {% endif %}
    </section>

    {# ================================================================== AI skeny #}
    <section class="st-pane" id="st-ai-skeny" role="tabpanel" aria-labelledby="st-tab-ai-skeny" data-usage-stats-target="pane" data-tab="ai-skeny" hidden>
        {{ include('admin/_usage_ai_scans.html.twig') }}
    </section>
</div>

{# ApexCharts is a standalone copy in public/vendor/apexcharts (no importmap
   entry); usage_stats_controller waits for window.ApexCharts. #}
<script src="{{ asset('vendor/apexcharts/apexcharts.min.js') }}"></script>
{% endblock %}
