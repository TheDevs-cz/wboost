{% extends 'base.html.twig' %}

{% set active_menu_item = 'admin_usage' %}

{% block title %}Soubory v úložišti{% endblock %}
{% block title_count %}{{ files.totalCount }}{% endblock %}

{# Statistiky › Úložiště drill-down: filter toolbar card, one bordered file
   list (rows for records), Nocturne pager. Query + filters unchanged. #}

{% block page_title_row %}
    <a href="{{ path('admin_usage') }}#uloziste" class="back">{{ icon('arrow-left', 's16') }}Statistiky</a>
    <header class="head">
        <div class="head-main">
            <span class="lbl">Administrace · Úložiště</span>
            <h1 class="page-title">Soubory v úložišti <small>{{ files.totalCount }}</small></h1>
            <span class="head-lead">Jednotlivé soubory podle poslední inventury. <strong>Nepoužívaný</strong> znamená, že na soubor neodkazuje žádný záznam v databázi.</span>
        </div>
        <div class="head-tools">
            <form method="post" action="{{ path('admin_storage_rescan') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('storage_rescan') }}">
                <input type="hidden" name="back" value="files">
                <button type="submit" class="btn btn-secondary sm">{{ icon('refresh', 's16') }}Načíst znovu</button>
            </form>
        </div>
    </header>
{% endblock %}

{% block content %}
<div class="st-page">
    <form method="get" class="sf-bar" role="search" aria-label="Filtr souborů">
        <label class="sf-f">
            <span>Projekt</span>
            <span class="inp sm sel">
                <select id="filter-project" name="project">
                    <option value="">Všechny projekty</option>
                    <option value="none" {{ filters.project == 'none' ? 'selected' }}>Bez projektu</option>
                    {% for project in files.projects %}
                        <option value="{{ project.id }}" {{ filters.project == project.id ? 'selected' }}>{{ project.name }}</option>
                    {% endfor %}
                </select>{{ icon('chev-down', 's14') }}
            </span>
        </label>
        <label class="sf-f">
            <span>Typ</span>
            <span class="inp sm sel">
                <select id="filter-category" name="category">
                    <option value="">Všechny typy</option>
                    {% for category in categories %}
                        <option value="{{ category.value }}" {{ filters.category == category.value ? 'selected' }}>{{ category.label }}</option>
                    {% endfor %}
                </select>{{ icon('chev-down', 's14') }}
            </span>
        </label>
        <label class="sf-f">
            <span>Stav</span>
            <span class="inp sm sel">
                <select id="filter-orphaned" name="orphaned">
                    <option value="">Vše</option>
                    <option value="yes" {{ filters.orphaned == 'yes' ? 'selected' }}>Jen nepoužívané</option>
                    <option value="no" {{ filters.orphaned == 'no' ? 'selected' }}>Jen používané</option>
                </select>{{ icon('chev-down', 's14') }}
            </span>
        </label>
        <label class="sf-f sf-q">
            <span>Cesta obsahuje</span>
            <span class="inp sm">{{ icon('search', 's14') }}<input type="search" id="filter-q" name="q" value="{{ filters.q }}" placeholder="např. background"></span>
        </label>
        <button type="submit" class="btn btn-primary sm">{{ icon('filter', 's16') }}Filtrovat</button>
    </form>

    <div class="u-card">
        <div class="sf-head">
            <b>{{ files.totalCount }} souborů · {{ files.totalSize|file_size }}</b>
            {% if files.pageCount > 1 %}<span class="cap">Stránka {{ files.page }} z {{ files.pageCount }}</span>{% endif %}
        </div>

        {% if files.rows is empty %}
            <p class="u-empty">Žádné soubory neodpovídají zvolenému filtru.</p>
        {% else %}
            <div class="sf-lh" aria-hidden="true"><span>Soubor</span><span>Typ</span><span>Projekt</span><span>Odkazuje</span><span>Změněno</span><span>Velikost</span></div>
            <ul class="sf-list">
                {% for file in files.rows %}
                    <li class="sf-row">
                        <span class="sf-file">
                            <span class="sf-ico">{{ icon(file.orphaned ? 'alert' : 'file', 's16') }}</span>
                            <span class="who">
                                <a href="{{ uploaded_asset(file.path) }}" target="_blank" rel="noopener">{{ file.fileName }}</a>
                                <span class="sf-path">{{ file.path }}</span>
                            </span>
                        </span>
                        <span class="sf-cat">{{ file.category.label }}</span>
                        <span class="sf-proj">
                            {% if file.projectName %}
                                <span class="who"><b>{{ file.projectName }}</b>{% if file.ownerEmail %}<span>{{ file.ownerEmail }}</span>{% endif %}</span>
                            {% else %}
                                <span class="cap">—</span>
                            {% endif %}
                        </span>
                        <span class="sf-ref">
                            {% if file.orphaned %}
                                <span class="pill pch">Nepoužívaný</span>
                            {% else %}
                                <code>{{ file.referencedBy }}</code>
                                {% if file.isShared %}
                                    <span class="pill r-user" title="Na tento soubor odkazuje více záznamů — sdílí ho např. zkopírovaná varianta šablony.">×{{ file.referenceCount }}</span>
                                {% endif %}
                            {% endif %}
                        </span>
                        <span class="sf-date cap">{{ file.lastModifiedAt ? file.lastModifiedAt|date('j. n. Y H:i') : '—' }}</span>
                        <span class="sf-size">{{ file.size|file_size }}</span>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}

        {% if files.pageCount > 1 %}
            <nav class="sf-pager" aria-label="Stránkování">
                {% if files.hasPrevious %}
                    <a class="btn btn-secondary sm" href="{{ path('admin_storage_files', filters|merge({page: files.page - 1})) }}" rel="prev">{{ icon('chev-left', 's16') }}Předchozí</a>
                {% else %}
                    <span class="btn btn-secondary sm disabled" aria-disabled="true">{{ icon('chev-left', 's16') }}Předchozí</span>
                {% endif %}
                <span class="sf-page"><b>{{ files.page }}</b> / {{ files.pageCount }}</span>
                {% if files.hasNext %}
                    <a class="btn btn-secondary sm" href="{{ path('admin_storage_files', filters|merge({page: files.page + 1})) }}" rel="next">Další{{ icon('chev-right', 's16') }}</a>
                {% else %}
                    <span class="btn btn-secondary sm disabled" aria-disabled="true">Další{{ icon('chev-right', 's16') }}</span>
                {% endif %}
            </nav>
        {% endif %}
    </div>
</div>
{% endblock %}
