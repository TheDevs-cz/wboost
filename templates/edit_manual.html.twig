{% extends 'base_manual.html.twig' %}

{% block title %}Upravit manuál{% endblock %}
{% set active_menu_item = 'manuals' %}

{% block breadcrumb %}
    <ol class="breadcrumb m-0 pt-0">
        <li class="breadcrumb-item"><a href="{{ path('manual_dashboard', {'id': manual.id}) }}">{{ manual.name }}</a></li>
        <li class="breadcrumb-item active">{{ block('title') }}</li>
    </ol>
{% endblock %}

{% block content %}
    {{ include('_manual_form.html.twig', {
        'submit_label': 'Uložit',
        'cancel_url': path('manual_dashboard', {'id': manual.id}),
        'current_image': manual.introImage ? uploaded_asset(manual.introImage) : null,
    }) }}
{% endblock %}
