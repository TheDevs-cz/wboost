{% extends 'base.html.twig' %}

{% block title %}Upravit kategorii{% endblock %}
{% set active_menu_item = 'templates' %}

{% block breadcrumb %}
    <ol class="breadcrumb m-0 pt-0">
        <li class="breadcrumb-item"><a href="{{ path('template_categories', {'projectId': project.id}) }}">Kategorie šablon</a></li>
        <li class="breadcrumb-item active">{{ block('title') }}</li>
    </ol>
{% endblock %}

{% block content %}
    {{ form_start(form, {attr: {class: 'tp-form tp-form-sm'}}) }}
    <section class="tp-sec">
        {{ form_widget(form) }}
        <div class="tp-foot">
            <a href="{{ path('template_categories', {'projectId': project.id}) }}" class="btn btn-tertiary sm">Zrušit</a>
            <button class="btn btn-primary sm" type="submit">Uložit</button>
        </div>
    </section>
    {{ form_end(form) }}
{% endblock %}
