{# Project symbol (prototype `.sym`): the project icon / brand logo on white,
   or the initials monogram (`.sym.mono`).
   Vars: logo_path (storage path|null), initials, class ('' | 'sm' | …), alt.
   A logo that fails to load (e.g. a file missing from local Minio) swaps
   itself for the monogram, so a broken-image icon never shows. #}
{% set sym_class = ('sym ' ~ class|default(''))|trim %}
{% if logo_path %}
    <span class="{{ sym_class }}" data-initials="{{ initials }}"><img src="{{ uploaded_asset(logo_path) }}" alt="{{ alt|default('') }}" onerror="var s=this.parentNode;s.classList.add('mono');s.textContent=s.dataset.initials"></span>
{%- else -%}
    <span class="{{ sym_class }} mono"{% if alt|default('') is not empty %} role="img" aria-label="{{ alt }}"{% endif %}>{{ initials }}</span>
{%- endif %}
