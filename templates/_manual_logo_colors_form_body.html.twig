{# The body of a "Mapování barev loga" modal
   (components/LogoColorsMappingModal.html.twig) — the part a Turbo Stream
   re-renders (ManualPreviewTurboStream): with the errors after an invalid
   submit, fresh after a save. It carries the rest of the form (the CSRF
   field), so the re-rendered body brings its own token.

   Params: edit (LogoColorsEditForm), form (FormView of edit.form). #}
{% set detectedColors = edit.detectedColors %}
<div class="modal-body text-start" id="logo-colors-form-{{ edit.logoVariant.value }}-{{ edit.colorVariant.value }}">
    {{ form_errors(form) }}

    <h5>Pozadí</h5>

    <div class="form-group d-flex align-items-center justify-content-between mb-2 logo-map-row" data-controller="custom-color">
        <span class="d-inline-block avatar-sm rounded-circle shadow-sm" style="border: 1px solid rgba(0, 0, 0, .1);background: {{ '#' ~ edit.defaultBackground }};"></span>

        <div style="width: 60px;">
            <span class="text-muted">HEX</span><br>{{ edit.defaultBackground|upper }}
        </div>

        <span class="d-block text-center logo-map-arrow">
            <i class="mdi mdi-arrow-right"></i>
        </span>

        <span class="d-inline-block avatar-sm rounded-circle shadow-sm" style="border: 1px solid rgba(0, 0, 0, .1);background: {{ '#' ~ form.background.vars.value }};" data-custom-color-target="colorDisplay"></span>

        <div class="form-floating" style="width: 100px;">
            {{ form_widget(form.background, {'attr': {'data-custom-color-target': 'input', 'data-action': 'input->custom-color#updateColor'}}) }}
            {{ form_label(form.background) }}
        </div>

        {# Keeps the HEX column aligned with the logo colours' (no Krytí for the background). #}
        <span class="logo-map-opacity" aria-hidden="true"></span>
    </div>
    {{ form_errors(form.background) }}

    <h5 class="mt-3">Barvy loga</h5>
    {% for colorForm in form.colors %}
        {% set opacityForm = form.opacities[colorForm.vars.name] ?? null %}
        <div class="form-group d-flex align-items-center justify-content-between mb-2 logo-map-row" data-controller="custom-color">
            <span class="d-inline-block avatar-sm rounded-circle shadow-sm" style="border: 1px solid rgba(0, 0, 0, .1);background: {{ '#' ~ detectedColors[loop.index0] ?? 'ffffff' }};"></span>

            <div style="width: 60px;">
                <span class="text-muted">HEX</span><br>{{ (detectedColors[loop.index0] ?? 'ffffff')|upper }}
            </div>

            <span class="d-block text-center logo-map-arrow">
                <i class="mdi mdi-arrow-right"></i>
            </span>

            {# Checkerboard under the colour so Krytí < 100 % reads as see-through (custom_color_controller sets --swatch). #}
            <span class="d-inline-block avatar-sm rounded-circle shadow-sm logo-map-swatch" style="--swatch: {{ '#' ~ colorForm.vars.value }};" data-custom-color-target="colorDisplay"></span>

            <div class="form-floating" style="width: 100px;">
                {{ form_widget(colorForm, {'attr': {'data-custom-color-target': 'input', 'data-action': 'input->custom-color#updateColor'}}) }}
                {{ form_label(colorForm) }}
            </div>

            {% if opacityForm %}
                <div class="form-floating logo-map-opacity">
                    {{ form_widget(opacityForm, {'attr': {'data-custom-color-target': 'opacity', 'data-action': 'input->custom-color#updateColor'}}) }}
                    {{ form_label(opacityForm) }}
                    <span class="logo-map-opacity-unit" aria-hidden="true">%</span>
                </div>
            {% endif %}
        </div>
        {{ form_errors(colorForm) }}
        {% if opacityForm %}{{ form_errors(opacityForm) }}{% endif %}
    {% endfor %}

    {{ form_rest(form) }}
</div>
