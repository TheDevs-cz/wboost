{% extends 'base_manual.html.twig' %}

{% block title %}{{ manual.name }}{% endblock %}
{% set active_menu_item = 'manuals' %}

{% block page_lead %}Písma, která manuál představí — primární a sekundární. Vybírají se z písem projektu; u každého zapnete řezy, které se v manuálu ukážou (ukládá se hned).{% endblock %}

{% block content %}
{# Every project face as @font-face so each row shows its specimen. #}
{{ include('editor/_editor_fonts.html.twig', {'fonts': project_fonts}) }}

<div class="stack" data-controller="font-specimen">
    {{ include('_manual_nav.html.twig') }}

    <div class="gal-nav" role="toolbar" aria-label="Fonty manuálu">
        <a href="{{ path('add_manual_font', {'id': manual.id}) }}" class="btn btn-primary sm">{{ icon('plus', 's16') }}Přidat font do manuálu</a>
        {% if is_granted(constant('WBoost\\Web\\Services\\Security\\ProjectVoter::EDIT'), project) %}
            {# Uploading here files the faces under the PROJECT's fonts (the one
               library the editor and the fill pages read); "Přidat font do
               manuálu" then offers the new family with a role. #}
            <button type="button" class="btn btn-tertiary sm" data-bs-toggle="collapse" data-bs-target="#fontUploadPanel" aria-expanded="false" aria-controls="fontUploadPanel">{{ icon('upload', 's16') }}Nahrát soubory písem</button>
        {% endif %}
        <span class="gal-nav-sp" aria-hidden="true"></span>
        <a href="{{ path('fonts_list', {'id': project.id}) }}" class="btn btn-ghost sm">{{ icon('font', 's16') }}Spravovat písma projektu</a>
    </div>

    {% if is_granted(constant('WBoost\\Web\\Services\\Security\\ProjectVoter::EDIT'), project) %}
        <div class="collapse" id="fontUploadPanel">
            {{ include('_font_uploader.html.twig', {'project': project, 'compact': true, 'hint': 'TTF, OTF nebo WOFF · nahraje se mezi písma projektu, poté ho přidejte do manuálu tlačítkem výše.'}) }}
        </div>
    {% endif %}

    {% if fonts is empty %}
        <div class="empty">
            <span class="ico-c">{{ icon('font') }}</span>
            <h2>Manuál zatím nepředstavuje žádné písmo</h2>
            <p>Přidejte primární a sekundární písmo značky. Vybírá se z písem nahraných do projektu.</p>
            <a href="{{ path('add_manual_font', {'id': manual.id}) }}" class="btn btn-primary btn-sm">{{ icon('plus', 's16') }}Přidat font do manuálu</a>
        </div>
    {% endif %}

    <div class="fn-grid" data-controller="dragula"
         data-dragula-sort-url-value="{{ path('sort_manual_fonts', {'manualId': manual.id}) }}"
         data-dragula-direction-value="horizontal"
         data-dragula-target="container">
        {% for manual_font in fonts %}
            <section class="fn-fam" data-entity-id="{{ manual_font.id }}">
                <div class="fn-fam-h">
                    {% if is_granted('manual_font_edit', manual_font) %}
                        <span class="dragula-handle fn-grip" title="Přetažením změníte pořadí">{{ icon('grip', 's16') }}</span>
                    {% endif %}
                    <div class="fn-fam-t">
                        <h2>{{ manual_font.font.name }}</h2>
                        <span class="fn-fam-meta">
                            <span class="pill{{ manual_font.secondary ? ' neutral' }}">{{ manual_font.primary ? 'Primární' }}{{ manual_font.secondary ? 'Sekundární' }}</span>
                            <span class="fn-dot" style="background: {{ '#' ~ (manual_font.color ?? '6c757d') }};" title="Barva ukázky #{{ (manual_font.color ?? '6c757d')|upper }}"></span>
                        </span>
                    </div>
                    {% if is_granted('manual_font_edit', manual_font) %}
                        <div class="dropdown">
                            <button type="button" class="btn btn-ghost icon xs" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Možnosti písma {{ manual_font.font.name }}">{{ icon('more', 's16') }}</button>
                            <div class="dropdown-menu dropdown-menu-end">
                                <a href="{{ path('edit_manual_font', {'id': manual_font.id}) }}" class="dropdown-item">{{ icon('edit', 's16') }}Upravit</a>
                                <div class="dropdown-divider"></div>
                                <a href="#"
                                   class="dropdown-item text-danger"
                                   data-modal-id="{{ manual_font.id }}"
                                   data-action="click->confirm-modal#showModal">{{ icon('trash', 's16') }}Odebrat z manuálu</a>
                            </div>
                        </div>
                    {% endif %}
                </div>

                <ul class="fn-cuts" data-controller="manual-font-faces-toggle" data-manual-font-faces-toggle-url-value="{{ path('update_manual_font_faces', {'manualFontId': manual_font.id}) }}">
                    {% for font_face in manual_font.font.faces %}
                        {% set family = manual_font.font.faceFamily(font_face) %}
                        {% set switch_id = manual_font.id ~ 'font-switch-' ~ loop.index %}
                        <li class="fn-cut">
                            <label class="fn-cut-sw" for="{{ switch_id }}" title="Zobrazit řez v manuálu">
                                <input class="sr" role="switch" data-manual-font-faces-toggle-target="checkbox" type="checkbox" id="{{ switch_id }}" {% if manual_font.faceEnabled(font_face.name) %}checked{% endif %} value="{{ font_face.name }}">
                                <span class="sw sm" aria-hidden="true"></span>
                            </label>
                            <div class="fn-cut-b">
                                <p class="fn-prev" style="font-family: '{{ family }}', sans-serif;" data-font-specimen-target="specimen">Příliš žluťoučký kůň úpěl ďábelské ódy 0123</p>
                                <div class="fn-meta">
                                    <b>{{ font_face.name }}</b>
                                    <span class="fn-tag">{{ font_face.weight }}</span>
                                    <span class="fn-tag">{{ font_face.style }}</span>
                                </div>
                            </div>
                        </li>
                    {% endfor %}
                </ul>

                {% if is_granted('manual_font_edit', manual_font) %}
                    <twig:ConfirmModal
                        id="{{ manual_font.id }}"
                        url="{{ path('delete_manual_font', {'id': manual_font.id}) }}"
                        confirmationText="Opravdu chcete smazat tento font z manuálu?" />
                {% endif %}
            </section>
        {% endfor %}
    </div>
</div>
{% endblock %}
