{% extends 'base_manual.html.twig' %}

{% block title %}Přidat font do manuálu{% endblock %}
{% set active_menu_item = 'manuals' %}

{% block page_lead %}Vyberte písmo projektu a jeho roli v manuálu. Barva určuje, jakou barvou se ukázka písma v manuálu vysází.{% endblock %}

{% block breadcrumb %}
    <ol class="breadcrumb m-0 pt-0">
        <li class="breadcrumb-item"><a href="{{ path('manual_fonts', {'id': manual.id}) }}">{{ manual.name }} · Fonty</a></li>
        <li class="breadcrumb-item active">{{ block('title') }}</li>
    </ol>
{% endblock %}

{% block content %}
    {{ include('_manual_font_form.html.twig', {'submit_label': 'Přidat font'}) }}
{% endblock %}
