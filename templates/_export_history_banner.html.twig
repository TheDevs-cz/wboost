{# Info banner shown while a stored export version is loaded into the fill
   form ("?version=<id>"), carrying the version's curation controls — rename
   and pin — so the user can label "the one I keep coming back to" right
   where they just loaded it. Owns `#export-history-banner`: a pin / rename
   from either fill-page surface answers with a Turbo Stream that replaces
   this element in place (Services/Template/ExportVersionTurboStream), so
   the controls here are Turbo-enabled.

   With no version loaded it renders an empty, hidden placeholder that owns
   the same id: "Uložit rozpracované" makes the saved draft the loaded
   version and its stream replaces the placeholder with the real banner.

   Expects:
   - loaded_version:  null|TemplateExportVersion
   - clear_url:       the same page without the version param
   - redirect_url:    local path the rename / pin forms return to (this page) #}
{% if loaded_version is null %}
<div id="export-history-banner" hidden></div>
{% else %}
<div id="export-history-banner" class="alert alert-info d-flex justify-content-between align-items-center flex-wrap gap-2" role="alert">
    <span>
        {% set when = loaded_version.lastExportedAt|date('d.m.Y H:i') %}
        {% set who = loaded_version.exportedBy ? loaded_version.exportedBy.displayName : null %}
        {% if loaded_version.draft %}
            <i class="mdi mdi-content-save-outline"></i>
            Pracujete na rozpracované verzi
            {% if loaded_version.name %}<strong>{{ loaded_version.name }}</strong>{% endif %}
            (uloženo <strong>{{ when }}</strong>{% if who %}, {{ who }}{% endif %}).
            „Uložit rozpracované“ ji přepíše, exportem se z ní stane exportovaná verze.
        {% else %}
            <i class="mdi mdi-history"></i>
            Formulář je předvyplněný hodnotami exportu
            {% if loaded_version.name %}
                <strong>{{ loaded_version.name }}</strong>
                ({{ when }}{% if who %}, {{ who }}{% endif %}).
            {% else %}
                z <strong>{{ when }}</strong>{% if who %}
                ({{ who }}){% endif %}.
            {% endif %}
            Hodnoty můžete dál upravit a znovu exportovat.
        {% endif %}
    </span>
    <span class="d-flex align-items-center flex-wrap gap-2">
        {{ include('_export_version_rename_form.html.twig', {version: loaded_version, redirect_url: redirect_url, turbo: true}) }}
        {{ include('_export_version_pin_button.html.twig', {version: loaded_version, redirect_url: redirect_url, labelled: true, turbo: true}) }}
        <a href="{{ clear_url }}" class="alert-link text-nowrap">Zpět na výchozí hodnoty</a>
    </span>
</div>
{% endif %}
