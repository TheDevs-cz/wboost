{% extends 'base.html.twig' %}

{% set active_menu_item = 'weekly_menus' %}

{% block title %}Nový jídelníček{% endblock %}

{% block page_title_row %}
    <a href="{{ path('weekly_menus', {'projectId': project.id}) }}" class="back">{{ icon('arrow-left', 's16') }}Jídelníčky</a>
{% endblock %}

{% block content %}
    {{ form_start(form, {'attr': {'class': 'adm-sheet wm-sheet'}}) }}
        <div class="adm-sheet-h"><h1 class="page-title adm-sheet-title">Nový jídelníček</h1></div>
        <div class="adm-sheet-b">
            {{ include('weekly_menu/_menu_form_fields.html.twig') }}
            <p class="hint cap">{{ icon('info', 's14') }}Dny a jídla přidáte po vytvoření v sestavení menu. Na e-mail pro schválení může jít žádost o schválení jídelníčku.</p>
        </div>
        <div class="adm-sheet-f">
            <a href="{{ path('weekly_menus', {'projectId': project.id}) }}" class="btn btn-tertiary sm">Zrušit</a>
            <input type="submit" name="submit" value="Vytvořit" class="btn btn-primary sm">
        </div>
    {{ form_end(form) }}
{% endblock %}
