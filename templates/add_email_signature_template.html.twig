{% extends 'base.html.twig' %}

{% block title %}Nová šablona e-mailu{% endblock %}
{% set active_menu_item = 'emails' %}

{% block page_title_row %}
    <a href="{{ path('email_signature_templates', {'id': project.id}) }}" class="back">{{ icon('arrow-left', 's16') }}E-maily</a>
{% endblock %}

{% block content %}
    {{ form_start(form, {'attr': {'class': 'adm-sheet es-sheet'}}) }}
        <div class="adm-sheet-h"><h1 class="page-title adm-sheet-title">Nová šablona e-mailu</h1></div>
        <div class="adm-sheet-b">
            {{ form_row(form.name, {'attr': {'placeholder': 'Např. Podpis zaměstnanců'}}) }}
            {{ form_row(form.backgroundImage) }}
            <p class="hint cap">{{ icon('info', 's14') }}Pozadí se v editoru šablony nabídne jako blok „Pozadí“. Vzhled a texty podpisu navrhnete po vytvoření v editoru.</p>
        </div>
        <div class="adm-sheet-f">
            <a href="{{ path('email_signature_templates', {'id': project.id}) }}" class="btn btn-tertiary sm">Zrušit</a>
            <input type="submit" name="submit" value="Vytvořit" class="btn btn-primary sm">
        </div>
    {{ form_end(form) }}
{% endblock %}
