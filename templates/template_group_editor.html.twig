{#
    Group canvas editor: edits ALL member variants of a template group at
    once. Composes the regular `canvas-editor` controller stack (minus
    canvas-history — undo/redo is group-global here) with the `group-editor`
    orchestrator that owns tabs, per-variant shadow canvases, delta
    propagation and the multi-variant save.

    Controller vars: project, group, fonts, font_faces, gallery_directories,
    menu_item, save_url, and `variants` — ordered list of
    {variant, dimension_label, edit_variant_url, export_url}.
#}
{% extends 'base.html.twig' %}

{% set active_menu_item = 'templates' %}

{% block title %}Skupinový editor — {{ group.name }}{% endblock %}

{# Full-height editor (Nocturne `.ed`): no page header — the editor's own top
   bar carries the eyebrow + name (see template_variant_editor). #}
{% block page_title_row %}{% endblock %}
{% block breadcrumb %}{% endblock %}
{% block inner_class %}{{ variants|length > 0 ? 'inner-wide ed-inner' : '' }}{% endblock %}

{% block content %}
    {% if variants|length == 0 %}
        <a href="{{ path('templates', {'projectId': project.id}) }}" class="btn btn-ghost sm mb-3">{{ icon('arrow-left', 's16') }}Zpět na šablony</a>
        <div class="empty">
            {{ icon('layers', 's32') }}
            <h2>{{ group.name }}: skupina nemá žádné varianty</h2>
            <p>Všechny členské varianty byly smazány. Přidejte nový rozměr, nebo skupinu smažte.</p>
            <a href="{{ path('add_template_group_dimension', {'groupId': group.id}) }}" class="btn btn-primary">{{ icon('plus', 's16') }}Přidat rozměr</a>
        </div>
    {% else %}

    {{ include('editor/_editor_scripts.html.twig') }}
    {{ include('editor/_editor_fonts.html.twig') }}

    {% set first = variants|first %}

    <div
        id="canvas-container"
        class="editor-shell ed"
        data-controller="editor-chrome canvas-editor canvas-clipboard canvas-zoom canvas-text-toolbar canvas-input-properties canvas-image-properties canvas-shape-properties canvas-opacity canvas-user-move canvas-alignment canvas-floating-toolbar canvas-container canvas-layers canvas-snapping canvas-rulers canvas-navigator group-editor"
        {# Canvas-mode only: a layer-mode variant's background is an isBackground
           object inside its canvas JSON — a canvas-level override would shadow it. #}
        data-canvas-editor-background-image-value="{{ first.variant.backgroundMode.value == 'canvas' and first.variant.backgroundImage ? uploaded_asset(first.variant.backgroundImage) }}"
        data-canvas-editor-background-mode-value="{{ first.variant.backgroundMode.value }}"
        data-canvas-editor-custom-fonts-value='{{ font_faces|json_encode }}'
        data-canvas-editor-font-options-value='{{ (rich_toolbar ? rich_toolbar.fonts : [])|json_encode }}'
        data-canvas-editor-default-font-family-value="{{ font_defaults.defaultFamily ?? '' }}"
        data-canvas-text-toolbar-default-font-family-value="{{ font_defaults.defaultFamily ?? '' }}"
        data-canvas-input-properties-manual-faces-value='{{ font_defaults.manualFaces|json_encode }}'
        {# Brand palette for freshly added shapes (same list the text popover and the fill WYSIWYG offer). #}
        data-canvas-editor-brand-colors-value='{{ (brand_colors|default([]))|json_encode }}'
        data-canvas-editor-canvas-json="{{ first.variant.canvas }}"
        data-canvas-editor-bleed-value="{{ first.variant.dimension.bleedPixels }}"
        data-canvas-editor-unit-value="{{ first.variant.dimension.unit.value }}"
        data-canvas-editor-edit-variant-url-value="{{ first.edit_variant_url }}"
        data-group-editor-save-url-value="{{ save_url }}"
        data-group-editor-csrf-value="{{ csrf_token('template_group_editor') }}"
        data-canvas-clipboard-canvas-editor-outlet="#canvas-container"
        data-canvas-text-toolbar-canvas-editor-outlet="#canvas-container"
        data-canvas-input-properties-canvas-editor-outlet="#canvas-container"
        data-canvas-input-properties-font-faces-value='{{ (rich_toolbar ? rich_toolbar.fonts : [])|json_encode }}'
        data-canvas-image-properties-canvas-editor-outlet="#canvas-container"
        data-canvas-shape-properties-canvas-editor-outlet="#canvas-container"
        data-canvas-opacity-canvas-editor-outlet="#canvas-container"
        data-canvas-user-move-canvas-editor-outlet="#canvas-container"
        data-canvas-alignment-canvas-editor-outlet="#canvas-container"
        data-canvas-floating-toolbar-canvas-editor-outlet="#canvas-container"
        data-canvas-container-canvas-editor-outlet="#canvas-container"
        data-canvas-layers-canvas-editor-outlet="#canvas-container"
        data-canvas-layers-canvas-floating-toolbar-outlet="#canvas-container"
        data-canvas-layers-canvas-input-properties-outlet="#canvas-container"
        data-canvas-layers-canvas-image-properties-outlet="#canvas-container"
        data-canvas-layers-canvas-shape-properties-outlet="#canvas-container"
        data-canvas-snapping-canvas-editor-outlet="#canvas-container"
        data-canvas-rulers-canvas-editor-outlet="#canvas-container"
        data-canvas-navigator-canvas-editor-outlet="#canvas-container"
        data-group-editor-canvas-editor-outlet="#canvas-container"
        data-action="
            canvas-editor:selection:changed->canvas-clipboard#onSelectionChanged
            canvas-editor:selection:changed->canvas-text-toolbar#updateFromSelection
            canvas-editor:selection:changed->canvas-input-properties#updateFromSelection
            canvas-editor:selection:changed->canvas-image-properties#updateFromSelection
            canvas-editor:selection:changed->canvas-shape-properties#updateFromSelection
            canvas-editor:selection:changed->canvas-opacity#updateFromSelection
            canvas-editor:selection:changed->canvas-user-move#updateFromSelection
            canvas-editor:selection:changed->canvas-alignment#onSelectionChanged
            canvas-editor:selection:changed->canvas-floating-toolbar#onSelectionChanged
            canvas-editor:selection:changed->canvas-container#onSelectionChanged
            canvas-editor:selection:changed->canvas-layers#onSelectionChanged
            canvas-editor:canvas:loaded->canvas-container#onCanvasLoaded
            canvas-editor:canvas:loaded->group-editor#onCanvasLoaded
            canvas-editor:canvas:loaded->canvas-layers#onCanvasLoaded
            canvas-editor:canvas:loaded->canvas-user-move#updateFromSelection
            canvas-editor:dirty->group-editor#onDirty
            canvas-editor:dirty->canvas-layers#onCanvasDirty
            canvas-zoom:changed->canvas-layers#unhover
            canvas-editor:background:changed->group-editor#onBackgroundChanged
            canvas-zoom:changed->canvas-floating-toolbar#reposition
            canvas-image-properties:geometry-live->canvas-floating-toolbar#reposition
            canvas-zoom:changed->canvas-container#repositionZones
            canvas-zoom:changed->canvas-rulers#refresh
            canvas-zoom:changed->canvas-navigator#refresh
            canvas-editor:canvas:loaded->canvas-navigator#refresh
            canvas-editor:canvas:loaded->canvas-rulers#onCanvasLoaded
            canvas-editor:canvas:loaded->canvas-zoom#fitToScreen
            canvas-editor:copy->canvas-clipboard#copy
            canvas-editor:paste->canvas-clipboard#paste
            asset-selected@window->canvas-editor#onAssetSelected
        "
    >
        {# Per-variant payload for the group-editor controller. #}
        <script type="application/json" data-group-editor-target="variantsData">[
            {%- for v in variants -%}
                {
                    "id": {{ v.variant.id.toString|json_encode|raw }},
                    "label": {{ v.dimension_label|json_encode|raw }},
                    "width": {{ v.variant.dimension.width }},
                    "height": {{ v.variant.dimension.height }},
                    "bleed": {{ v.variant.dimension.bleedPixels }},
                    "unit": {{ v.variant.dimension.unit.value|json_encode|raw }},
                    "canvas": {{ v.variant.canvas|json_encode|raw }},
                    {#- backgroundUrl deliberately null for layer-mode variants: it feeds
                        the canvas-LEVEL background re-apply sites (_loadShadow/_activate/
                        _restoreSnapshot), which must all no-op when the background is a
                        layer inside the canvas document. -#}
                    "backgroundMode": {{ v.variant.backgroundMode.value|json_encode|raw }},
                    "backgroundUrl": {{ (v.variant.backgroundMode.value == 'canvas' and v.variant.backgroundImage ? uploaded_asset(v.variant.backgroundImage) : null)|json_encode|raw }},
                    "editVariantUrl": {{ v.edit_variant_url|json_encode|raw }}
                }{{ loop.last ? '' : ',' }}
            {%- endfor -%}
        ]</script>

        {# Editor chrome (prototype renderTpEd): top bar, format tabs (= the
           variant rail), tool row. `data-editor-header` wraps all three. #}
        <div class="ed-head" data-editor-header>
            <header class="ed-top">
                <a href="{{ path('templates', {'projectId': project.id}) }}" class="btn btn-tertiary icon sm ed-back" data-action="editor-chrome#navigate" title="Zpět na šablony" aria-label="Zpět na šablony">{{ icon('arrow-left', 's16') }}</a>
                <div class="ed-title">
                    <nav class="breadcrumb ed-crumb" aria-label="Drobečková navigace">
                        <a href="{{ path('project_dashboard', {'id': project.id}) }}" data-action="editor-chrome#navigate">{{ project.name }}</a>
                        <span aria-hidden="true">·</span>
                        <a href="{{ path('templates', {'projectId': project.id}) }}" data-action="editor-chrome#navigate">Šablony</a>
                    </nav>
                    <h1 class="ed-name" title="{{ group.name }}">{{ group.name }}</h1>
                </div>
                <span class="pill ed-sync" title="Synchronizovaná šablona — jeden návrh ve více formátech">{{ icon('refresh', 's14') }}<span class="ed-lbl">Synchronizovaná</span></span>
                <div class="ed-hist">
                    <button class="btn btn-ghost icon xs disabled" type="button" title="Zpět (Ctrl+Z)" aria-label="Zpět (Ctrl+Z)" data-group-editor-target="undoButton" data-action="group-editor#undo">{{ icon('undo', 's16') }}</button>
                    <button class="btn btn-ghost icon xs disabled" type="button" title="Znovu (Ctrl+Shift+Z)" aria-label="Znovu (Ctrl+Shift+Z)" data-group-editor-target="redoButton" data-action="group-editor#redo">{{ icon('redo', 's16') }}</button>
                    <button class="btn icon xs ed-clean" type="button" aria-pressed="false" title="Čistý náhled — skrýt pomocné prvky" aria-label="Čistý náhled — skrýt pomocné prvky" data-editor-chrome-target="cleanButton" data-action="editor-chrome#toggleClean">{{ icon('eye', 's16') }}</button>
                </div>

                <span class="ed-sp"></span>

                <span class="ed-state ed-state--saved">{{ icon('check-circle', 's14') }}<span class="ed-lbl">Vše uloženo</span></span>
                <p data-canvas-editor-target="unsavedChangesMessage" class="ed-state ed-state--dirty d-none">{{ icon('history', 's14') }}<span class="ed-lbl">Neuložené změny</span></p>

                {{ include('editor/_editor_toggles.html.twig') }}

                <a href="{{ path('template_group_fill', {'groupId': group.id}) }}" class="btn btn-tertiary sm ed-fill" data-action="editor-chrome#navigate" title="Vyplnit a exportovat">{{ icon('download', 's16') }}<span class="ed-lbl">Vyplnit a exportovat</span></a>

                <button class="btn btn-success sm ed-save" type="button" data-action="group-editor#submitForm">Uložit vše</button>
            </header>

            {# Format tabs = the variant rail: one tab per dimension — switching,
               per-variant opt-in, dirty dot, overflow/off-canvas badges — then
               "Přidat rozměr" and the "Upravovat všechny formáty najednou" mode
               switch. Deliberately without a preview: the stage is the preview.

               The per-variant switches are chrome of the MODE and only render
               (CSS, `--multi` on the rail) while it is on. The mode starts ON
               with every variant included (2026-08-10). The ACTIVE variant's
               switch is always on + disabled: an edit you can see has to land
               somewhere.

               The row is the scope indicator: a lavender underline while an edit
               reaches EVERY variant (mode on + every switch on + nothing
               "Nenačteno"), plain otherwise (`group-variant-rail-card--all`).
               Initial state must match group_editor_controller's
               `multiEdit = true` default — _refreshRail() only syncs the chrome
               after shadow hydration. #}
            <div class="ed-vars group-variant-rail-card group-variant-rail-card--all"
                 data-group-editor-target="railCard"
                 title="Úpravy se přenáší do všech variant">
                <div class="group-variant-rail group-variant-rail--multi" role="tablist" aria-label="Formáty šablony" data-group-editor-target="rail">
                    {% for v in variants %}
                        <div class="group-variant-chip{{ loop.first ? ' group-variant-active' }}" data-group-editor-target="card" data-variant-id="{{ v.variant.id }}">
                            <button type="button" class="group-variant-label ed-var" role="tab" title="Přepnout na tento formát"
                                    data-action="group-editor#activateVariant"
                                    data-group-editor-id-param="{{ v.variant.id }}">
                                <b>{{ v.variant.dimension.label }}</b><span class="cap">{{ v.variant.dimension.width }} × {{ v.variant.dimension.height }}</span>
                                <span class="group-variant-dirty d-none" title="Neuložené změny" data-group-editor-target="dirtyDot" data-variant-id="{{ v.variant.id }}"></span>
                            </button>
                            <span class="badge ed-out d-none" data-group-editor-target="badge" data-variant-id="{{ v.variant.id }}"></span>
                            <div class="form-check form-switch mb-0 group-variant-include" title="Přenášet úpravy aktivního formátu i do tohoto formátu">
                                <input type="checkbox" class="form-check-input" checked {{ loop.first ? 'disabled' }}
                                       aria-label="Přenášet úpravy do formátu {{ v.variant.dimension.label }}"
                                       data-group-editor-target="includeToggle"
                                       data-variant-id="{{ v.variant.id }}"
                                       data-group-editor-id-param="{{ v.variant.id }}"
                                       data-action="change->group-editor#toggleInclude">
                            </div>
                        </div>
                    {% endfor %}
                    <a href="{{ path('add_template_group_dimension', {'groupId': group.id}) }}" class="ed-var add" data-action="editor-chrome#navigate">{{ icon('plus', 's14') }}Přidat rozměr</a>
                    <span class="ed-sp"></span>
                    {# Mode switch. group_editor_controller toggles aria-pressed (+ the
                       legacy btn-primary/btn-outline-secondary classes, neutralised
                       in editor.css); the look is a Nocturne switch. #}
                    <button type="button" class="ed-multi group-variant-mode" aria-pressed="true"
                            data-group-editor-target="multiEditButton"
                            data-action="group-editor#toggleMultiEdit"
                            title="Zapnuto: posuny, velikosti a vlastnosti se přenáší i do zaškrtnutých formátů. Přidání a smazání prvku se přenáší vždy, bez ohledu na tento přepínač.">
                        <span class="sw sm" aria-hidden="true"></span><span>Upravovat všechny formáty najednou</span>
                    </button>
                </div>
            </div>

            {{ include('editor/_editor_tools.html.twig', {'group_mode': true}) }}
        </div>

        <div class="row editor-shell-row ed-body">
            <div class="col-12 col-lg-2 editor-left-panel">
                {{ include('editor/_editor_left_panel.html.twig', {'group_mode': true}) }}
            </div>

            <div class="col-12 col-lg-10 editor-stage-col">
                {{ include('editor/_editor_stage.html.twig', {
                    'canvas_width': first.variant.dimension.width,
                    'canvas_height': first.variant.dimension.height,
                    'canvas_bleed': first.variant.dimension.bleedPixels,
                    'group_mode': true,
                }) }}
            </div>
        </div>

        {{ include('editor/_editor_modals.html.twig') }}

    </div>
    {% endif %}
{% endblock %}
