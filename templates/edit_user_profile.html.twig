{% extends 'base.html.twig' %}

{% block title %}Upravit profil{% endblock %}

{% block page_title_row %}
    <a href="{{ path('user_profile') }}" class="back">{{ icon('arrow-left', 's16') }}Můj účet</a>
{% endblock %}

{% block content %}
    {{ form_start(form, {'attr': {'class': 'adm-sheet'}}) }}
        <div class="adm-sheet-h"><h1 class="page-title adm-sheet-title">Upravit profil</h1></div>
        <div class="adm-sheet-b">
            {{ form_row(form.name) }}
            <p class="hint">{{ icon('info', 's14') }}Jméno uvidí kolegové ve sdílených projektech. E-mail změnit nejde — slouží k přihlášení.</p>
        </div>
        <div class="adm-sheet-f">
            <a href="{{ path('user_profile') }}" class="btn btn-secondary sm">Zrušit</a>
            <button class="btn btn-primary sm" type="submit">Uložit</button>
        </div>
    {{ form_end(form) }}
{% endblock %}
