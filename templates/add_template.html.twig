{% extends 'base.html.twig' %}

{% block title %}Nová šablona{% endblock %}
{% set active_menu_item = 'templates' %}

{% block page_lead %}Jeden design s variantami formátů. Začnete prvním rozměrem, další přidáte kdykoli později.{% endblock %}

{% block breadcrumb %}
    <ol class="breadcrumb m-0 pt-0">
        <li class="breadcrumb-item"><a href="{{ path('templates', {'projectId': project.id}) }}">Šablony</a></li>
        <li class="breadcrumb-item active">{{ block('title') }}</li>
    </ol>
{% endblock %}

{% block content %}
    {{ form_start(form, {attr: {class: 'tp-form'}}) }}
    {{ form_errors(form) }}

    <section class="tp-sec">
        <div class="tp-sech"><h2>{{ icon('template', 's18') }}Šablona</h2></div>
        <div class="tp-formgrid">
            {{ form_row(form.template.name) }}
            {{ form_row(form.template.category) }}
        </div>
        {{ include('_template_image_field.html.twig', { field: form.template.image, current: null }) }}
    </section>

    <section class="tp-sec" data-controller="template-dimension">
        <div class="tp-sech">
            <h2>{{ icon('grid', 's18') }}První varianta — rozměr</h2>
            <p class="cap">Vyberte formát nebo zadejte vlastní rozměr.</p>
        </div>

        {{ include('_template_dimension_fields.html.twig', {
            preset: form.variant.preset,
            unit: form.variant.unit,
            width: form.variant.width,
            height: form.variant.height,
        }) }}

        {{ include('_print_settings.html.twig', { bleed_field: form.variant.bleed, crop_marks_field: form.variant.cropMarks }) }}

        {{ include('_background_gallery_picker.html.twig', { field: form.variant.backgroundImageId }) }}
    </section>

    {{ form_rest(form) }}

    <div class="tp-foot">
        <a href="{{ path('templates', {'projectId': project.id}) }}" class="btn btn-tertiary sm">Zrušit</a>
        <button class="btn btn-primary sm" type="submit">Vytvořit</button>
    </div>

    {{ form_end(form) }}

    {{ include('_background_gallery_modal.html.twig') }}
{% endblock %}
