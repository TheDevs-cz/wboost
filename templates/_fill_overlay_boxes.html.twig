{#
    The click-into-preview boxes of ONE fill surface (a preview of one
    dimension): a dashed frame per text + image placeholder with the
    always-visible icon cluster (pencil = edit, eye = hide). Shared by the
    single-variant fill component (one surface) and the group fill page (one
    surface per dimension — the same placeholder gets a box on every preview,
    all opening the ONE shared popover).

    Parameters:
    - text_placeholders: the FillTextPlaceholders rows (inputId, name, locked,
      hidable, hidden)
    - image_placeholders: list of {inputId, name, hidable}
    - text_frames / image_frames: inputId → frame|null IN THIS SURFACE's canvas
      px — a placeholder without a frame here gets no box (the popover stays
      reachable from the panel / layers list)
    - image_hidden: inputId → bool, the initial eye state of image slots
    - image_adjust_tool: (single page) render the hidden "Upravit velikost a
      polohu" tool on adjustable image slots
    - shape_placeholders / shape_frames: (optional) the recolourable shapes
      (FillShapePlaceholders rows) + their frames in THIS surface — a box
      with a palette button opening the shape's colour popover
    - container_sheets: (optional) THIS surface's one-pencil containers
      (FillContainerSheets rows). Each gets ONE `fill-box--container` box
      (outline = the union of its members' reflowed frames, computed by the
      overlay) with the pencil opening the container sheet + the container's
      eye; its member boxes stay as thin outlines WITHOUT tools — a click on
      one opens the sheet at that field.
    - (repeatable rows, container-rows P4) a one-pencil container holding a
      row gets one "+ Řádek" chip per row (`data-row-chip`), placed by the
      overlay under the row's LAST ACTIVE slot and shown only while another
      row can be added — the sheet holds the rest (−, ↑ / ↓, the reason).
    - movable: (optional) the user-movable elements of THIS surface
      (FillMovableElements rows by id, this surface's frames). An element
      whose box is rendered here (an unlocked text, a recolourable shape, a
      one-pencil container) gets the ✥ move tool in its cluster; every
      other one (a locked text, a decorative image, a plain shape, a
      container without a sheet) gets a move-only `fill-box--move` box at
      the server's frame. fill_element_move.js drives them.
    - move_variant: (group / document page) this surface's variantId — the
      move tools carry it (`data-move-variant`): a move is per size / page.

    The dashed BORDER follows the "Zobrazit oblasti k vyplnění" switch, the
    name tag the "Popisky prvků" one (CSS on the form classes).
#}
{% set movable = movable|default({}) %}
{% set move_variant = move_variant|default(null) %}
{% set move_hosted = [] %}
{% set sheet_of = {} %}
{% for sheet in container_sheets|default([]) %}
    {% for fieldId in sheet.fieldIds %}
        {% set sheet_of = sheet_of|merge({(fieldId): sheet.id}) %}
    {% endfor %}
{% endfor %}
{% for ph in text_placeholders %}
    {% set frame = text_frames[ph.inputId] ?? null %}
    {% set sheet_id = sheet_of[ph.inputId] ?? null %}
    {% if frame and not ph.locked %}
        <div
            class="fill-box fill-box--text{{ sheet_id ? ' fill-box--sheet-member' }}"
            data-variant-fill-overlay-target="box"
            data-inputid="{{ ph.inputId }}"
            data-frame-x="{{ frame.x }}"
            data-frame-y="{{ frame.y }}"
            data-frame-width="{{ frame.width }}"
            data-frame-height="{{ frame.height }}"
            {% if sheet_id %}{{ include('_fill_sheet_member_attrs.html.twig', { sheet_id: sheet_id, input_id: ph.inputId, label: ph.name ?: 'Text' }) }}{% endif %}
        >
            <span class="fill-box__name">{{ ph.name ?: 'Text' }}</span>
            {% if not sheet_id %}
            <div class="fill-box__tools">
                <button type="button" class="fill-box__tool fill-box__tool--edit"
                    title="Upravit text" aria-label="Upravit text{% if ph.name %}: {{ ph.name }}{% endif %}"
                    data-action="variant-fill-overlay#openPopover"
                    data-variant-fill-overlay-inputid-param="{{ ph.inputId }}"
                >{{ icon('edit', 's14') }}</button>
                {% if movable[ph.inputId] is defined %}
                    {% set move_hosted = move_hosted|merge([ph.inputId]) %}
                    {{ include('_fill_move_tool.html.twig', { m: movable[ph.inputId], move_variant: move_variant }) }}
                {% endif %}
                {% if ph.hidable %}
                    <button type="button"
                        class="fill-box__tool fill-box__tool--hide{{ ph.hidden ? ' is-active' : '' }}"
                        data-hide-toggle="{{ ph.inputId }}"
                        aria-pressed="{{ ph.hidden ? 'true' : 'false' }}"
                        title="{{ ph.hidden ? 'Zobrazit prvek' : 'Schovat prvek' }}"
                        aria-label="{{ ph.hidden ? 'Zobrazit prvek' : 'Schovat prvek' }}"
                        data-action="variant-fill-overlay#toggleHide"
                        data-variant-fill-overlay-inputid-param="{{ ph.inputId }}"
                    >{{ icon(ph.hidden ? 'eye-off' : 'eye', 's14') }}</button>
                {% endif %}
            </div>
            {% endif %}
        </div>
    {% endif %}
{% endfor %}
{% for ph in image_placeholders %}
    {% set frame = image_frames[ph.inputId] ?? null %}
    {% if frame %}
        {% set hidden = image_hidden[ph.inputId] ?? false %}
        {% set sheet_id = sheet_of[ph.inputId] ?? null %}
        <div
            class="fill-box fill-box--image{{ sheet_id ? ' fill-box--sheet-member' }}"
            data-variant-fill-overlay-target="box"
            data-inputid="{{ ph.inputId }}"
            data-frame-x="{{ frame.x }}"
            data-frame-y="{{ frame.y }}"
            data-frame-width="{{ frame.width }}"
            data-frame-height="{{ frame.height }}"
            {% if sheet_id %}{{ include('_fill_sheet_member_attrs.html.twig', { sheet_id: sheet_id, input_id: ph.inputId, label: ph.name ?: 'Obrázek' }) }}{% endif %}
        >
            <span class="fill-box__name">{{ ph.name ?: 'Obrázek' }}</span>
            {% if not sheet_id %}
            <div class="fill-box__tools">
                <button type="button" class="fill-box__tool fill-box__tool--edit"
                    title="Vybrat obrázek" aria-label="Vybrat obrázek{% if ph.name %}: {{ ph.name }}{% endif %}"
                    data-action="variant-fill-overlay#openImageModal"
                    data-variant-fill-overlay-inputid-param="{{ ph.inputId }}"
                >{{ icon('image', 's14') }}</button>
                {% if image_adjust_tool|default(false) and not ph.isBackground|default(false) and (ph.allowMove|default(false) or ph.allowResize|default(false) or ph.allowRotate|default(false)) %}
                    {# Single page: keyboard / touch path to the image-adjust
                       panel; shown by variant-image-fill only once a picture
                       is picked (the designed stand-in can't be placed). #}
                    <button type="button" class="fill-box__tool fill-box__tool--adjust" hidden
                        title="Upravit velikost a polohu" aria-label="Upravit velikost a polohu{% if ph.name %}: {{ ph.name }}{% endif %}"
                        data-adjust-tool="{{ ph.inputId }}"
                        data-action="variant-image-fill#openAdjust"
                        data-variant-image-fill-inputid-param="{{ ph.inputId }}"
                    >{{ icon('fit', 's14') }}</button>
                {% endif %}
                {% if ph.hidable %}
                    <button type="button" class="fill-box__tool fill-box__tool--hide{{ hidden ? ' is-active' : '' }}"
                        data-hide-toggle="{{ ph.inputId }}"
                        aria-pressed="{{ hidden ? 'true' : 'false' }}"
                        title="{{ hidden ? 'Zobrazit prvek' : 'Schovat prvek' }}"
                        aria-label="{{ hidden ? 'Zobrazit prvek' : 'Schovat prvek' }}"
                        data-action="variant-fill-overlay#toggleHide"
                        data-variant-fill-overlay-inputid-param="{{ ph.inputId }}"
                    >{{ icon(hidden ? 'eye-off' : 'eye', 's14') }}</button>
                {% endif %}
            </div>
            {% endif %}
        </div>
    {% endif %}
{% endfor %}
{% for ph in shape_placeholders|default([]) %}
    {% set frame = shape_frames[ph.inputId] ?? null %}
    {% set sheet_id = sheet_of[ph.inputId] ?? null %}
    {% if frame %}
        <div
            class="fill-box fill-box--shape{{ sheet_id ? ' fill-box--sheet-member' }}"
            data-variant-fill-overlay-target="box"
            data-inputid="{{ ph.inputId }}"
            data-frame-x="{{ frame.x }}"
            data-frame-y="{{ frame.y }}"
            data-frame-width="{{ frame.width }}"
            data-frame-height="{{ frame.height }}"
            {% if sheet_id %}{{ include('_fill_sheet_member_attrs.html.twig', { sheet_id: sheet_id, input_id: ph.inputId, label: ph.name ?: 'Barva tvaru' }) }}{% endif %}
        >
            <span class="fill-box__name">{{ ph.name ?: 'Barva tvaru' }}</span>
            {% if not sheet_id %}
            <div class="fill-box__tools">
                <button type="button" class="fill-box__tool fill-box__tool--edit"
                    title="Změnit barvu" aria-label="Změnit barvu{% if ph.name %}: {{ ph.name }}{% endif %}"
                    data-action="variant-fill-overlay#openPopover"
                    data-variant-fill-overlay-inputid-param="{{ ph.inputId }}"
                >{{ icon('palette', 's14') }}</button>
                {% if movable[ph.inputId] is defined %}
                    {% set move_hosted = move_hosted|merge([ph.inputId]) %}
                    {{ include('_fill_move_tool.html.twig', { m: movable[ph.inputId], move_variant: move_variant }) }}
                {% endif %}
            </div>
            {% endif %}
        </div>
    {% endif %}
{% endfor %}
{# One box per one-pencil container, AFTER the member boxes so its tool
   cluster stacks above theirs. No designed frame: the overlay places it at
   the union of the members' live frames on this surface (`data-sheet-members`);
   with no member frame here it stays hidden. #}
{% for sheet in container_sheets|default([]) %}
    {% set label = sheet.name ?: 'Skupina polí' %}
    <div
        class="fill-box fill-box--container"
        data-variant-fill-overlay-target="box"
        data-inputid="{{ sheet.id }}"
        data-sheet-box="{{ sheet.id }}"
        data-sheet-members="{{ sheet.memberIds|join(' ') }}"
    >
        <span class="fill-box__name">{{ label }}</span>
        <div class="fill-box__tools">
            <button type="button" class="fill-box__tool fill-box__tool--edit"
                title="Upravit skupinu ({{ sheet.fieldIds|length }} polí)" aria-label="Upravit skupinu: {{ label }}"
                aria-haspopup="dialog"
                data-action="variant-fill-overlay#openSheet"
                data-variant-fill-overlay-sheet-param="{{ sheet.id }}"
            >{{ icon('edit', 's14') }}</button>
            {% if movable[sheet.id] is defined %}
                {% set move_hosted = move_hosted|merge([sheet.id]) %}
                {{ include('_fill_move_tool.html.twig', { m: movable[sheet.id], move_variant: move_variant }) }}
            {% endif %}
            {% if sheet.hidable %}
                <button type="button"
                    class="fill-box__tool fill-box__tool--hide{{ sheet.hidden ? ' is-active' : '' }}"
                    data-hide-toggle="{{ sheet.id }}"
                    aria-pressed="{{ sheet.hidden ? 'true' : 'false' }}"
                    title="{{ sheet.hidden ? 'Zobrazit prvek' : 'Schovat prvek' }}"
                    aria-label="{{ sheet.hidden ? 'Zobrazit prvek' : 'Schovat prvek' }}"
                    data-action="variant-fill-overlay#toggleHide"
                    data-variant-fill-overlay-inputid-param="{{ sheet.id }}"
                >{{ icon(sheet.hidden ? 'eye-off' : 'eye', 's14') }}</button>
            {% endif %}
        </div>
    </div>
    {% for rowId in sheet.rows|default([]) %}
        <button type="button" class="fill-row-chip" hidden
            data-row-chip="{{ rowId }}"
            data-row-chip-sheet="{{ sheet.id }}"
            title="Přidat řádek" aria-label="Přidat řádek: {{ label }}"
            data-action="variant-fill-overlay#addRow"
            data-variant-fill-overlay-row-param="{{ rowId }}"
        >{{ icon('plus', 's12') }}<span>Řádek</span></button>
    {% endfor %}
{% endfor %}
{# Move-only boxes: user-movable elements without a box above. The frame
   is the server's (FillMovableElements); the overlay offsets it by the
   element's current move (a container's also grows with its reflowed
   members, `data-move-members`). #}
{% for m in movable|filter(m => m.id not in move_hosted) %}
    <div
        class="fill-box fill-box--move fill-box--move-{{ m.kind }}"
        data-variant-fill-overlay-target="box"
        data-inputid="{{ m.id }}"
        data-move-box="{{ m.id }}"
        data-frame-x="{{ m.frame.x }}"
        data-frame-y="{{ m.frame.y }}"
        data-frame-width="{{ m.frame.width }}"
        data-frame-height="{{ m.frame.height }}"
        {% if m.kind == 'container' %}data-move-members="{{ m.members|join(' ') }}"{% endif %}
    >
        <span class="fill-box__name">{{ m.name }}</span>
        <div class="fill-box__tools">
            {{ include('_fill_move_tool.html.twig', { m: m, move_variant: move_variant }) }}
        </div>
    </div>
{% endfor %}
