{# Add / edit manual (ManualFormType: type, name) as one settings box.
   Expects `form`, `submit_label`, `cancel_url`; optional `intro_url`
   (edit: link to the intro page editor). The intro picture is no longer
   uploaded here (content pages P4) — it lives on the intro page. #}
{{ form_start(form, {'attr': {'class': 'man-sec man-formbox'}}) }}
    {{ form_errors(form) }}
    <div class="man-formgrid">
        {{ form_row(form.name, {'attr': {'placeholder': 'Např. Logomanuál Brušperk'}}) }}
        {{ form_row(form.type) }}
    </div>

    <p class="man-formhint">
        {{ icon('info', 's14') }}
        <span>
            {% if intro_url|default(null) %}
                Úvodní stránku (nadpis, text a obrázky) upravíte v záložce <a href="{{ intro_url }}">Úvodní stránka</a>.
            {% else %}
                Úvodní stránku (nadpis, text a obrázky) upravíte po vytvoření v záložce Úvodní stránka.
            {% endif %}
        </span>
    </p>

    {{ form_rest(form) }}
    <div class="man-formfoot">
        <a href="{{ cancel_url }}" class="btn btn-tertiary sm">Zrušit</a>
        <button class="btn btn-primary sm" type="submit">{{ submit_label }}</button>
    </div>
{{ form_end(form) }}
