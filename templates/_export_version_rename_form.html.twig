{# Inline rename of one export version: a compact input-group POSTing to the
   rename endpoint (blank = back to the date label). Like the pin toggle, the
   controls submit through an out-of-line anchor form (`form` attribute, see
   `_export_version_form_anchors.html.twig`) — this partial is included inside
   the fill form on the group page, where a nested <form> would close it.
   Enter in the name field submits the RENAME (the field's form owner), never
   the surrounding fill form.

   Expects:
   - version:       TemplateExportVersion (its anchor must be on the page)
   - redirect_url:  local path to return to after saving #}
{% set form_id = 'export-version-rename-' ~ version.id %}
<span class="input-group input-group-sm flex-nowrap" style="max-width: 22rem;" data-export-version-rename="{{ version.id }}">
    <input type="hidden" name="_token" value="{{ csrf_token('template_export_version_rename') }}" form="{{ form_id }}">
    <input type="hidden" name="redirect" value="{{ redirect_url }}" form="{{ form_id }}">
    <input type="text" name="name" form="{{ form_id }}" class="form-control" value="{{ version.name }}"
           maxlength="{{ constant('WBoost\\Web\\Entity\\TemplateExportVersion::NAME_MAX_LENGTH') }}"
           placeholder="Pojmenovat verzi…" aria-label="Název verze" autocomplete="off">
    <button type="submit" form="{{ form_id }}" class="btn btn-outline-secondary" title="Uložit název"><i class="mdi mdi-check"></i></button>
</span>
