{# A manual content page's body: the mockup grid's segments (3 × 2 tracks,
   same slots as MockupPageLayout) on a fixed 845 px page (app.css; content
   past a slot's height is cut off). One partial for the public manual
   (manual_preview.html.twig).

   Styles live in app.css (`.mcp-*`), loaded by both entrypoints; they set
   their own typography so the Nocturne editor and the plain manual agree.

   A picture moved to the gallery Koš / gone from the gallery (content pages
   P3) is not shown: readers get nothing, editors a stand-in saying why.
   The page background (optional, cover / contain, centre top) follows the
   same rule, minus the stand-in: an unavailable one is simply not drawn
   (the editor says why).

   Params: content_page (ManualContentPage), content_styles (ManualContentStyles). #}
{% set can_edit_images = is_granted('manual_edit', content_page.manual) %}
{% set background = content_page.background %}
{% set background_shows = background is not null and not manual_image_unavailable(content_page.manual, background.path, background.galleryImageId) %}
<div class="mcp-page{% if background_shows %} mcp-bg mcp-bg-{{ background.fit.value }}{% endif %}"
    {%- if background_shows %} style="background-image: url('{{ uploaded_asset(background.path)|e('css') }}');"{% endif %}>
    <div class="mcp-grid">
        {% for slot in content_page.layout.slots %}
            {% set segment = content_page.segment(loop.index0) %}
            <div class="mcp-seg mcp-rows-{{ slot.rowSpan }} mcp-va-{{ segment.verticalAlign.value }}"
                 style="grid-column: {{ slot.column }} / span {{ slot.columnSpan }}; grid-row: {{ slot.row }} / span {{ slot.rowSpan }};">
                {% for element in segment.elements %}
                    {% if element.type == 'heading' %}
                        {% if element.text is not empty %}
                            <h{{ element.level + 1 }} class="mcp-h mcp-h{{ element.level }}">{{ element.text }}</h{{ element.level + 1 }}>
                        {% endif %}
                    {% elseif element.type == 'richText' %}
                        {% if not element.doc.isEmpty() %}
                            <div class="mcp-rt">{{ manual_rich_text(element.doc, content_styles) }}</div>
                        {% endif %}
                    {% elseif element.type == 'image' and manual_image_unavailable(content_page.manual, element.path, element.galleryImageId) %}
                        {% if can_edit_images %}
                            <figure class="mcp-img mcp-img-cover" style="aspect-ratio: {{ slot.unitWidth }} / {{ slot.unitHeight }};">
                                {{ include('_manual_image_standin.html.twig', {'reason': manual_image_unavailable(content_page.manual, element.path, element.galleryImageId)}) }}
                            </figure>
                        {% endif %}
                    {% elseif element.type == 'image' %}
                        <figure class="mcp-img mcp-img-{{ element.fit.value }}"
                            {%- if element.fit.value == 'cover' %} style="aspect-ratio: {{ slot.unitWidth }} / {{ slot.unitHeight }};"{% endif %}>
                            <img src="{{ uploaded_asset(element.path) }}" alt="{{ element.alt }}" loading="lazy">
                        </figure>
                    {% endif %}
                {% endfor %}
            </div>
        {% endfor %}
    </div>
</div>
