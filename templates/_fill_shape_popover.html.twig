{#
    ONE recolourable shape's popover — the floating card the shape box's
    palette button opens, and (docked) one row of the "Všechna pole" panel.
    Shared by the single-variant fill component and the group fill page.

    Every swatch writes into the shape's `[data-shape-color-mirror]` field
    (Live-bound on the single page, the plain form field on the group page)
    through variant-fill-overlay#pickShapeColor; the popover carries no form
    name itself.

    Parameters:
    - ph: one FillShapePlaceholders row (inputId, name, options, freeColor,
      defaultColor, current; a document's shared row may add `resetLabel` —
      its first swatch then stands for EACH page's own designed colour)
    - arrangeable: (optional) show the admin's panel reorder handle
    - move / unit: (optional, single page) the element's FillMovableElements
      row when the user may move it — adds the "Poloha" row
#}
<div class="fill-popover fill-popover--shape card" role="dialog" aria-labelledby="fill-shape-label-{{ ph.inputId }}" data-variant-fill-overlay-target="popover" data-inputid="{{ ph.inputId }}">
    <div class="card-body">
        <div class="fill-popover__head">
            <span class="i i-grip s14 fill-popover__drag fill-popover__chrome" data-popover-drag-handle role="button" aria-label="Přesunout okno" title="Přesunout okno"></span>
            {% if arrangeable|default(false) %}{{ include('_fill_field_reorder_handle.html.twig') }}{% endif %}
            <span id="fill-shape-label-{{ ph.inputId }}" class="fill-popover__name">{{ ph.name ?: 'Barva tvaru' }}</span>
            <button type="button" class="btn btn-success xs fill-popover__ok fill-popover__chrome" data-action="variant-fill-overlay#close">{{ icon('check', 's14') }}Uložit</button>
            <button type="button" class="btn btn-ghost icon xs fill-popover__x fill-popover__chrome" aria-label="Zavřít" data-action="variant-fill-overlay#close">{{ icon('x', 's16') }}</button>
        </div>
        <div class="fill-popover__swatches" role="group" aria-label="Barva">
            {% for color in ph.options %}
                <button
                    type="button"
                    class="fill-richtext-swatch{{ color == ph.current ? ' is-active' }}"
                    style="background-color: {{ color }}"
                    title="{{ color }}{{ loop.first ? (ph.resetLabel ?? ' (výchozí)') }}"
                    aria-label="{{ color }}{{ loop.first ? (ph.resetLabel ?? ' (výchozí)') }}"
                    aria-pressed="{{ color == ph.current ? 'true' : 'false' }}"
                    data-shape-swatch="{{ ph.inputId }}"
                    data-color="{{ color }}"
                    data-action="variant-fill-overlay#pickShapeColor"
                    data-variant-fill-overlay-inputid-param="{{ ph.inputId }}"
                    data-variant-fill-overlay-color-param="{{ loop.first ? '' : color }}"
                ></button>
            {% endfor %}
            {% if ph.freeColor %}
                <label class="fill-richtext-swatch fill-richtext-swatch--custom mb-0" title="Vlastní barva">
                    {# Hex picker (color_picker_controller) — Safari's native picker has no hex field. #}
                    <input type="button" class="fill-richtext-swatch__input" aria-label="Vlastní barva"
                           value="{{ ph.current }}"
                           data-controller="color-picker"
                           data-shape-picker="{{ ph.inputId }}"
                           data-action="input->variant-fill-overlay#pickShapeColor"
                           data-variant-fill-overlay-inputid-param="{{ ph.inputId }}">
                </label>
            {% endif %}
        </div>
        {% if move|default(null) %}{{ include('_fill_move_position.html.twig', { m: move, unit: unit|default('px') }) }}{% endif %}
    </div>
</div>
