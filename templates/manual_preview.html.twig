            {% if manual.logo.vertical or manual.logo.verticalWithClaim %}
                {% set page = page+1 %}

                <div class="manual-page border-bottom border-2" id="page-{{ page }}">
                    {{ include('_manual_page_heading.html.twig', {'page': manual_page('vertical_monochrome'), 'number': page}) }}

                    <div class="page-content py-4 gx-5 row">
                        {{ include('_manual_page_description.html.twig', {'page': manual_page('vertical_monochrome')}) }}
                        <div class="page-designs col-9">

                            {% set colorsMapping = manual.logoColorMapping('vertical', 'whiteBackground') %}

                            <div class="row">
                                {% if manual.logo.vertical %}
                                    <div class="col-6">
                                        <div class="border border-1 p-5 rounded-4 mb-4 manual-image-wrapper manual-image-square" style="background: {{ '#' ~ manual.logoBackground('vertical', 'whiteBackground') }};">
                                            <twig:LogoColorsMapping manual="{{ manual }}" logoVariant="vertical" colorVariant="whiteBackground" />
                                            <twig:DownloadManualImage logoVariant="vertical" background="{{ manual.logoBackground('vertical', 'whiteBackground') }}" colorsMapping="{{ colorsMapping }}" manualId="{{ manual.id }}" />
                                            {{ logo_helpers.logo_image(manual.logo.vertical, colorsMapping) }}
                                        </div>
                                    </div>
                                {% endif %}

                                {% if manual.logo.verticalWithClaim %}
                                    {% set colorsMapping = manual.logoColorMapping('verticalWithClaim', 'whiteBackground') %}

                                    <div class="col-6">
                                        <div class="border border-1 p-5 rounded-4 manual-image-wrapper manual-image-square" style="{{ '#' ~ manual.logoBackground('verticalWithClaim', 'whiteBackground') }}">
                                            <twig:LogoColorsMapping manual="{{ manual }}" logoVariant="verticalWithClaim" colorVariant="whiteBackground" />
                                            <twig:DownloadManualImage logoVariant="verticalWithClaim" background="{{ manual.logoBackground('verticalWithClaim', 'whiteBackground') }}" colorsMapping="{{ colorsMapping }}" manualId="{{ manual.id }}" />
                                            {{ logo_helpers.logo_image(manual.logo.verticalWithClaim, colorsMapping) }}
                                        </div>
                                    </div>
                                {% endif %}

                                {% if manual.logo.vertical %}
                                    {% set colorsMapping = manual.logoColorMapping('vertical', 'blackBackground') %}

                                    <div class="col-6">
                                        <div class="border border-1 p-5 rounded-4 mb-4 manual-image-wrapper manual-image-square" style="background: {{ '#' ~ manual.logoBackground('vertical', 'blackBackground') }}">
                                            <twig:LogoColorsMapping manual="{{ manual }}" logoVariant="vertical" colorVariant="blackBackground" />
                                            <twig:DownloadManualImage logoVariant="vertical" background="{{ manual.logoBackground('vertical', 'blackBackground') }}" colorsMapping="{{ colorsMapping }}" manualId="{{ manual.id }}" />
