{% extends 'base.html.twig' %}

{% block title %}{{ manual.name }}{% endblock %}
{% set active_menu_item = 'manuals' %}

{#
    Renders a logo <img>, applying the per-variant display width (% of the card)
    when the designer set one. Height is unaffected: the card keeps its fixed
    height (flex-centered), the logo just gets narrower/wider. displayWidth null
    or 0 => no override => default width:100% from CSS.
#}
{% macro logo_image(logo, colorsMapping) %}<img src="{{ remap_svg_colors(logo.filePath, colorsMapping) }}"{% if logo.displayWidth %} style="width: {{ logo.displayWidth }}%;"{% endif %}>{% endmacro %}

{% block meta_viewport %}
    <meta name="viewport" content="width=1400, initial-scale=0.25, maximum-scale=1">
{% endblock %}

{% block custom_styles %}
    <style>
        {% for manual_font in fonts %}
            {% for font_face in manual_font.font.faces %}
                @font-face {
                    font-family: '{{ manual_font.font.name }} ({{ font_face.name }})';
                    src: url('{{ uploaded_asset(font_face.filePath) }}');
                }
            {% endfor %}
        {% endfor %}
    </style>
{% endblock %}

{% block full_content %}
    {% import _self as logo_helpers %}
    <div style="min-width: 1400px;" class="manual-{{ manual.slug }}">
        <div class="container-fluid" style="max-width: 1320px;">
            {% set page = 0 %}

            {% if manual.introImage %}
                {% set page = page+1 %}
                <div class="manual-page border-bottom border-2" id="page-{{ page }}">
                    {{ include('_manual_page_heading.html.twig', {'page': manual_page('intro'), 'number': page}) }}

                    <div class="page-content py-4 gx-5 row">
                        {{ include('_manual_page_description.html.twig', {'page': manual_page('intro'), 'class': 'col-12 fs-5 fst-italic text-center'}) }}

                        <div class="page-description col-12 text-center">
                            <img src="{{ uploaded_asset(manual.introImage) }}" style="max-width: 100%;" alt="Úvod">
                        </div>
                    </div>
                </div>
            {% endif %}

            {% set colorsMapping = {} %}

            {% if manual.logo.horizontal or manual.logo.vertical or manual.logo.symbol %}
                {% set page = page+1 %}
                <div class="manual-page border-bottom border-2" id="page-{{ page }}">
                    {{ include('_manual_page_heading.html.twig', {'page': manual_page('basic_logos'), 'number': page}) }}

                    <div class="page-content py-4 gx-5 row">
                        {{ include('_manual_page_description.html.twig', {'page': manual_page('basic_logos')}) }}
                        <div class="page-designs col-9">

                            {% if manual.logo.horizontal %}
                                <div class="border border-1 p-5 rounded-4 mb-4 manual-image-wrapper manual-image-vertical-big" style="background: #ffffff;">
                                    <twig:DownloadManualImage logoVariant="horizontal" background="ffffff" colorsMapping="{{ colorsMapping }}" manualId="{{ manual.id }}" />

                                    {{ logo_helpers.logo_image(manual.logo.horizontal, colorsMapping) }}
                                </div>
                            {% endif %}

                            {% if manual.logo.vertical or manual.logo.symbol %}
                                <div class="row">
                                    {% if manual.logo.vertical %}
                                        <div class="col-6">
                                            <div class="border border-1 p-5 rounded-4 manual-image-wrapper manual-image-square" style="background: #ffffff;">
                                                <twig:DownloadManualImage logoVariant="vertical" background="ffffff" colorsMapping="{{ colorsMapping }}" manualId="{{ manual.id }}" />
                                                {{ logo_helpers.logo_image(manual.logo.vertical, colorsMapping) }}
                                            </div>
                                        </div>
                                    {% endif %}

                                    {% if manual.logo.symbol %}
                                        <div class="col-6">
                                            <div class="border border-1 p-5 rounded-4 manual-image-wrapper manual-image-square" style="background: #ffffff;">
                                                <twig:DownloadManualImage logoVariant="symbol" background="ffffff" colorsMapping="{{ colorsMapping }}" manualId="{{ manual.id }}" />
                                                {{ logo_helpers.logo_image(manual.logo.symbol, colorsMapping) }}
                                            </div>
                                        </div>
                                    {% endif %}
                                </div>
                            {% endif %}
                        </div>
