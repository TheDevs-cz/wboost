                {% set page = page+1 %}

                <div class="manual-page border-bottom border-2" id="page-{{ page }}">
                    {{ include('_manual_page_heading.html.twig', {'page': manual_page('horizontal_monochrome'), 'number': page}) }}

                    <div class="page-content py-4 gx-5 row">
                        {{ include('_manual_page_description.html.twig', {'page': manual_page('horizontal_monochrome')}) }}
                        <div class="page-designs col-9">

                            <div class="row">
                                {% if manual.logo.horizontal %}
                                    {% set colorsMapping = manual.logoColorMapping('horizontal', 'whiteBackground') %}

                                    <div class="col-6">
                                        <div class="border border-1 p-5 rounded-4 mb-4 manual-image-wrapper manual-image-horizontal" style="background: {{ '#' ~ manual.logoBackground('horizontal', 'whiteBackground') }};">
                                            <twig:LogoColorsMapping manual="{{ manual }}" logoVariant="horizontal" colorVariant="whiteBackground" />
                                            <twig:DownloadManualImage logoVariant="horizontal" background="{{ manual.logoBackground('horizontal', 'whiteBackground') }}" colorsMapping="{{ colorsMapping }}" manualId="{{ manual.id }}" />
                                            {{ logo_helpers.logo_image(manual.logo.horizontal, colorsMapping) }}
                                        </div>
                                    </div>
                                {% endif %}

                                {% if manual.logo.horizontalWithClaim %}
                                    {% set colorsMapping = manual.logoColorMapping('horizontalWithClaim', 'whiteBackground') %}

                                    <div class="col-6">
                                        <div class="border border-1 p-5 rounded-4 manual-image-wrapper manual-image-horizontal" style="background: {{ '#' ~ manual.logoBackground('horizontalWithClaim', 'whiteBackground') }}">
                                            <twig:LogoColorsMapping manual="{{ manual }}" logoVariant="horizontalWithClaim" colorVariant="whiteBackground" />
                                            <twig:DownloadManualImage logoVariant="horizontalWithClaim" background="{{ manual.logoBackground('horizontalWithClaim', 'whiteBackground') }}" colorsMapping="{{ colorsMapping }}" manualId="{{ manual.id }}" />
                                            {{ logo_helpers.logo_image(manual.logo.horizontalWithClaim, colorsMapping) }}
                                        </div>
                                    </div>
                                {% endif %}

                                {% if manual.logo.horizontal %}
                                    {% set colorsMapping = manual.logoColorMapping('horizontal', 'blackBackground') %}

                                    <div class="col-6">
                                        <div class="border border-1 p-5 rounded-4 mb-4 manual-image-wrapper manual-image-horizontal" style="background: {{ '#' ~ manual.logoBackground('horizontal', 'blackBackground') }}">
                                            <twig:LogoColorsMapping manual="{{ manual }}" logoVariant="horizontal" colorVariant="blackBackground" />
                                            <twig:DownloadManualImage logoVariant="horizontal" background="{{ manual.logoBackground('horizontal', 'blackBackground') }}" colorsMapping="{{ colorsMapping }}" manualId="{{ manual.id }}" />
                                            {{ logo_helpers.logo_image(manual.logo.horizontal, colorsMapping) }}
                                        </div>
                                    </div>
                                {% endif %}

