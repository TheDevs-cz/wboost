                                            <twig:DownloadManualImage logoVariant="verticalWithClaim" background="{{ manual.logoBackground('verticalWithClaim', 'darkBackground') }}" colorsMapping="{{ colorsMapping }}" manualId="{{ manual.id }}" />
                                            {{ logo_helpers.logo_image(manual.logo.verticalWithClaim, colorsMapping) }}
                                        </div>

                                        {% set colorsMapping = manual.logoColorMapping('verticalWithClaim', 'lightBackground') %}

                                        <div class="border border-1 p-5 rounded-4 mb-4 manual-image-wrapper manual-image-square" style="background: {{ '#' ~ manual.logoBackground('verticalWithClaim', 'lightBackground') }}">
                                            <twig:LogoColorsMapping manual="{{ manual }}" logoVariant="verticalWithClaim" colorVariant="lightBackground" />
                                            <twig:DownloadManualImage logoVariant="verticalWithClaim" background="{{ manual.logoBackground('verticalWithClaim', 'lightBackground') }}" colorsMapping="{{ colorsMapping }}" manualId="{{ manual.id }}" />
                                            {{ logo_helpers.logo_image(manual.logo.verticalWithClaim, colorsMapping) }}
                                        </div>

