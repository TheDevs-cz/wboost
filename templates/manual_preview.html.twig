                    {{ include('_manual_page_heading.html.twig', {'page': manual_page('protection_zone'), 'number': page}) }}

                    <div class="page-content py-4 gx-5 row">
                        {{ include('_manual_page_description.html.twig', {'page': manual_page('protection_zone')}) }}
                        <div class="page-designs col-9">

                            {% set colorsMapping = {} %}

                            <div class="row">
                                {% if manual.logo.horizontal %}
                                    <div class="col-12">
                                        <div class="border border-1 p-5 rounded-4 mb-4 protected-zone-wrapper manual-image-wrapper manual-image-vertical-big position-relative d-flex justify-content-center">
                                            <div class="p-5 bg-dark-lighten position-relative">
                                                <div style="background: #ffffff;">
                                                    <twig:DownloadManualImage logoVariant="horizontal" background="ffffff" colorsMapping="{{ colorsMapping }}" manualId="{{ manual.id }}" />
                                                    <span class="protected-zone-top">1/3 výšky loga</span>
                                                    <span class="protected-zone-bottom">1/3</span>
                                                    <span class="protected-zone-left">1/3</span>
                                                    <span class="protected-zone-right">1/3</span>
                                                    {{ logo_helpers.logo_image(manual.logo.horizontal, colorsMapping) }}
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                {% endif %}

                                {% if manual.logo.vertical %}
                                    <div class="col-6">
                                        <div class="border border-1 p-5 rounded-4 mb-4 protected-zone-wrapper manual-image-wrapper manual-image-square-smaller manual-image-vertical position-relative d-flex justify-content-center">
                                            <div class="p-5 bg-dark-lighten position-relative">
                                                <div style="background: #ffffff;">
                                                    <twig:DownloadManualImage logoVariant="vertical" background="ffffff" colorsMapping="{{ colorsMapping }}" manualId="{{ manual.id }}" />
                                                    <span class="protected-zone-top">1/3 výšky loga</span>
                                                    <span class="protected-zone-bottom">1/3</span>
                                                    <span class="protected-zone-left">1/3</span>
                                                    <span class="protected-zone-right">1/3</span>
                                                    <img src="{{ remap_svg_colors(manual.logo.vertical.filePath, colorsMapping) }}" style="background: #ffffff;">
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                {% endif %}

                                {% if manual.logo.symbol %}
                                    <div class="col-6">
                                        <div class="border border-1 p-5 rounded-4 mb-4 protected-zone-wrapper manual-image-wrapper manual-image-square-smaller manual-image-symbol position-relative d-flex justify-content-center">
                                            <div class="p-5 bg-dark-lighten position-relative">
                                                <div style="background: #ffffff;">
                                                    <twig:DownloadManualImage logoVariant="symbol" background="ffffff" colorsMapping="{{ colorsMapping }}" manualId="{{ manual.id }}" />
                                                    <span class="protected-zone-top">1/3 výšky loga</span>
                                                    <span class="protected-zone-bottom">1/3</span>
                                                    <span class="protected-zone-left">1/3</span>
                                                    <span class="protected-zone-right">1/3</span>
                                                    <img src="{{ remap_svg_colors(manual.logo.symbol.filePath, colorsMapping) }}" style="background: #ffffff;">
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                {% endif %}
                            </div>

                        </div>
                    </div>
                </div>
            {% endif %}


            {% if
                (manual.logo.symbol and (manual.logo.symbol.widthInfo or manual.logo.symbol.heightInfo))
                or (manual.logo.horizontal and (manual.logo.horizontal.widthInfo or manual.logo.horizontal.heightInfo))
                or (manual.logo.vertical and (manual.logo.vertical.widthInfo or manual.logo.vertical.heightInfo))
                or (manual.logo.horizontalWithClaim and (manual.logo.horizontalWithClaim.widthInfo or manual.logo.horizontalWithClaim.heightInfo))
                or (manual.logo.verticalWithClaim and (manual.logo.verticalWithClaim.widthInfo or manual.logo.verticalWithClaim.heightInfo))
            %}
                {% set page = page+1 %}

                <div class="manual-page border-bottom border-2" id="page-{{ page }}">
                    {{ include('_manual_page_heading.html.twig', {'page': manual_page('minimum_dimensions'), 'number': page}) }}

                    <div class="page-content py-4 gx-5 row">
                        {{ include('_manual_page_description.html.twig', {'page': manual_page('minimum_dimensions')}) }}
                        <div class="page-designs col-9">
                            <div class="row">
                                {% if manual.logo.symbol and (manual.logo.symbol.widthInfo or manual.logo.symbol.heightInfo) %}
                                    {{ include('_logo_min_dimensions.html.twig', {'logo': manual.logo.symbol}) }}
                                {% endif %}

                                {% if manual.logo.horizontal and (manual.logo.horizontal.widthInfo or manual.logo.horizontal.heightInfo) %}
                                    {{ include('_logo_min_dimensions.html.twig', {'logo': manual.logo.horizontal}) }}
                                {% endif %}

                                {% if manual.logo.vertical and (manual.logo.vertical.widthInfo or manual.logo.vertical.heightInfo) %}
                                    {{ include('_logo_min_dimensions.html.twig', {'logo': manual.logo.vertical}) }}
                                {% endif %}

                                {% if manual.logo.horizontalWithClaim and (manual.logo.horizontalWithClaim.widthInfo or manual.logo.horizontalWithClaim.heightInfo) %}
                                    {{ include('_logo_min_dimensions.html.twig', {'logo': manual.logo.horizontalWithClaim}) }}
                                {% endif %}

                                {% if manual.logo.verticalWithClaim and (manual.logo.verticalWithClaim.widthInfo or manual.logo.verticalWithClaim.heightInfo) %}
                                    {{ include('_logo_min_dimensions.html.twig', {'logo': manual.logo.verticalWithClaim}) }}
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            {% endif %}

            {% if manual.primaryColors %}
                {% set page = page+1 %}

                <div class="manual-page border-bottom border-2" id="page-{{ page }}">
                    {{ include('_manual_page_heading.html.twig', {'page': manual_page('primary_colors'), 'number': page}) }}

                    <div class="page-content py-4 gx-5 row">
                        {{ include('_manual_page_description.html.twig', {'page': manual_page('primary_colors')}) }}
                        <div class="page-designs col-9">
                            <div class="row">
                                {% for primary_color in manual.primaryColors %}
                                    <div class="col">
                                        <div class="manual-preview-color rounded-4 {{ primary_color.color.white ? 'text-secondary' }}" style="background: {{ '#' ~ primary_color.color }};">
                                            <strong>HEX:</strong> {{ primary_color.color }}<br>
                                            {% if primary_color.cmyk %}
                                                <strong>CMYK:</strong> {{ primary_color.cmyk[0] ~ '-' ~ primary_color.cmyk[1] ~ '-' ~ primary_color.cmyk[2] ~ '-' ~ primary_color.cmyk[3] }}<br>
                                            {% endif %}
                                            {% if primary_color.pantone %}
                                                <strong>Pantone:</strong> {{ primary_color.pantone }}
                                            {% endif %}
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                </div>
            {% endif %}

            {% if manual.secondaryColors %}
                {% set page = page+1 %}

                <div class="manual-page border-bottom border-2" id="page-{{ page }}">
                    {{ include('_manual_page_heading.html.twig', {'page': manual_page('secondary_colors'), 'number': page}) }}

                    <div class="page-content py-4 gx-5 row">
                        {{ include('_manual_page_description.html.twig', {'page': manual_page('secondary_colors')}) }}
                        <div class="page-designs col-9">
                            <div class="row">
                                {% for secondary_color in manual.secondaryColors %}
                                    <div class="col">
                                        <div class="manual-preview-color rounded-4 {{ secondary_color.color.white ? 'text-secondary' }}" style="background: {{ '#' ~ secondary_color.color }};">
                                            <strong>HEX:</strong> {{ secondary_color.color }}<br>
                                            {% if secondary_color.cmyk %}
                                                <strong>CMYK:</strong> {{ secondary_color.cmyk[0] ~ '-' ~ secondary_color.cmyk[1] ~ '-' ~ secondary_color.cmyk[2] ~ '-' ~ secondary_color.cmyk[3] }}<br>
                                            {% endif %}
                                            {% if secondary_color.pantone %}
                                                <strong>Pantone:</strong> {{ secondary_color.pantone }}
                                            {% endif %}
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                </div>
            {% endif %}

            {% for manual_font in fonts %}
                {% if manual_font.fontFaces|length > 0 %}
                    {% set page = page+1 %}

                    <div class="manual-page border-bottom border-2" id="page-{{ page }}">
                        {# The font pages are keyed by the font's TYPE, so the primary and
                           the secondary page carry their own texts. #}
                        {% set font_page = manual_page(manual_font.type.value ~ '_font') %}

                        {{ include('_manual_page_heading.html.twig', {'page': font_page, 'number': page}) }}

                        <div class="page-content py-4 gx-5 row">
                            {{ include('_manual_page_description.html.twig', {'page': font_page, 'class': 'col-6 fs-5 fst-italic'}) }}
                        </div>

                        <div class="row mt-1 gx-5 gy-5 pb-5">
                            {% for font_face in manual_font.font.faces %}
                                {% if manual_font.faceEnabled(font_face.name) %}
                                    <div class="col-4 manual-font" style="font-family: '{{ manual_font.font.name }} ({{ font_face.name }})', sans-serif;font-size: 16px;color: {{ '#' ~ (manual_font.color ?? '6c757d') }};">
                                        {{ font_face.name }}<br>
                                        <span style="display: inline-block;font-size: 82px;">Aa</span><br>
                                        aábcčdeéěfghiíjklmnopqrřsštuúůvwxyýzžAÁBCČDEÉĚFGHIÍJKLMNOPQRŘSŠTUÚŮVWXYÝZŽ1234567890?!&*
                                    </div>
                                {% endif %}
                            {% endfor %}
                        </div>
                    </div>
                {% endif %}
            {% endfor %}

            {% for mockup_page in mockup_pages %}
                {% set page = page+1 %}

                <div class="manual-page border-bottom border-2" id="page-{{ page }}">
                    <div class="page-heading py-3 border-bottom">
                        <span class="d-inline-block pe-4 fs-4">{{ "%02d"|format(page) }}</span>
                        <span class="d-inline-block pe-4 fs-4">{{ manual.name }}</span>
                        <span class="d-inline-block pe-4 fs-4 fw-bold">{{ mockup_page.name }}</span>
                        <span class="d-inline-block float-end fs-4">{{ manual.brandManual ? 'Brand manuál' : 'Logo manuál' }}</span>
                        {{ include('_mockup_page_download_button.html.twig', {'extra_class': 'float-end me-3'}) }}
                    </div>

                    <div class="page-content py-4 gx-5 row">
                        <div class="page-designs col-12">
                            {{ include('_mockup_page.html.twig') }}
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}


