{% extends 'base_auth.html.twig' %}

{% block title %}Registrace{% endblock %}

{% block auth_body %}
    <div class="auth-top">
        <h1>Registrace</h1>
        <p>Registrace jsou na požádání. Zanechte nám svůj e-mail a my se vám ozveme.</p>
    </div>

    {{ include('_flashes.html.twig') }}

    {{ form_start(form, {'attr': {'class': 'auth-form'}}) }}
        {{ form_row(form.email, {'attr': {'placeholder': 'jmeno@firma.cz', 'autocomplete': 'email'}}) }}
        <button class="btn btn-primary auth-submit" type="submit">Požádat o registraci</button>
    {{ form_end(form) }}
{% endblock %}

{% block auth_below %}Už máte účet? <a href="{{ path('login') }}">Přihlaste se</a>{% endblock %}
