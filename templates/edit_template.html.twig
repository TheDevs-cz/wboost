{% extends 'base.html.twig' %}

{% block title %}Upravit šablonu{% endblock %}
{% set active_menu_item = 'templates' %}

{% block breadcrumb %}
    <ol class="breadcrumb m-0 pt-0">
        <li class="breadcrumb-item"><a href="{{ path('templates', {'projectId': project.id}) }}">Šablony</a></li>
        <li class="breadcrumb-item active">{{ block('title') }}</li>
    </ol>
{% endblock %}

{% block content %}
    {{ form_start(form, {attr: {class: 'tp-form'}}) }}
    {{ form_errors(form) }}

    {% if template.group is not null %}
        <div class="alert alert-info">
            {{ icon('refresh', 's16') }}
            <span>Synchronizovaná šablona — název se propíše i do skupiny. Design jednotlivých rozměrů se upravuje ve <a href="{{ path('template_group_editor', {'groupId': template.group.id}) }}">skupinovém editoru</a>.</span>
        </div>
    {% endif %}

    <section class="tp-sec">
        <div class="tp-sech"><h2>{{ icon('template', 's18') }}{{ template.name }}</h2></div>
        <div class="tp-formgrid">
            {{ form_row(form.name) }}
            {{ form_row(form.category) }}
        </div>
        {{ include('_template_image_field.html.twig', { field: form.image, current: template.image }) }}
    </section>

    {{ form_rest(form) }}

    <div class="tp-foot">
        <a href="{{ path('templates', {'projectId': project.id}) }}" class="btn btn-tertiary sm">Zrušit</a>
        <button class="btn btn-primary sm" type="submit">Uložit</button>
    </div>

    {{ form_end(form) }}
{% endblock %}
