{% extends 'base.html.twig' %}

{# "Historie skenů" (docs/ai-scan/ux.md §8) — every scan of the project.
   `rows` are AiScanLists::history() rows plus `when`. Rows are server-rendered;
   the ai-scan-history controller only runs the row actions. A calendar scan
   (`row.kind == 'calendar'`) lives in its calendar's wizard: its links open
   `calendar_workspace` with `?sken=`, and `restore` in its actions is
   „Vrátit původní rozvržení“. #}
{# The page belongs to Šablony and to Kalendáře: a project that has only
   Kalendáře gets it under that module (`has_templates`, `has_calendars` and
   `scan_calendar` — the project's ONLY 7-day calendar, else null — come from
   AiScanHistoryController). #}
{% set active_menu_item = has_templates ? 'templates' : 'calendars' %}
{# Where a calendar scan starts: the scan panel of the one 7-day calendar, else the calendar list. #}
{% set calendar_scan_url = scan_calendar ? path('calendar_workspace', {'calendarId': scan_calendar, 'sken': 1}) : path('calendars', {'projectId': project.id}) %}
{% set new_scan_url = has_templates ? path('ai_scan_new', {'projectId': project.id}) : calendar_scan_url %}
{% set nil_uuid = '00000000-0000-0000-0000-000000000000' %}
{% set pills = {
    checking: ['pch', 'Kontrola obrázku'], queued: ['pch', 'Ve frontě'], running: ['pch', 'Sken běží'],
    ready: ['pch', 'Připraveno ke kontrole'], accepted: ['mint', 'Šablona vytvořena'], discarded: ['neutral', 'Zahozeno'],
    cancelled: ['neutral', 'Zrušeno'], stopped: ['neutral', 'Potřebuje jiný obrázek'], failed: ['rose', 'Nepodařilo se'],
    refused: ['rose', 'Odmítnuto'], expired: ['neutral', 'Vypršelo']
} %}

{% block title %}Historie skenů{% endblock %}
{% block title_count %}{{ total }}{% endblock %}
{% block page_lead %}Všechny skeny v tomto projektu. Obrázky a nepřijaté návrhy uchováváme 30 dní.{% endblock %}

{% block breadcrumb %}
    {% if has_templates %}
        <a href="{{ path('templates', {'projectId': project.id}) }}" class="back">{{ icon('arrow-left', 's16') }}Šablony</a>
    {% else %}
        <a href="{{ path('calendars', {'projectId': project.id}) }}" class="back">{{ icon('arrow-left', 's16') }}Kalendáře</a>
    {% endif %}
{% endblock %}

{% block title_actions %}
    {% if can_start and has_calendars and has_templates %}
        <div class="dropdown">
            <button type="button" class="btn btn-primary" data-bs-toggle="dropdown" aria-expanded="false" aria-haspopup="menu">{{ icon('plus') }}Nový sken</button>
            <div class="dropdown-menu dropdown-menu-end">
                <a href="{{ path('ai_scan_new', {'projectId': project.id}) }}" class="dropdown-item">{{ icon('image', 's16') }}Šablona z obrázku</a>
                {# With one 7-day calendar the item opens its scan panel; otherwise the user picks a calendar first. #}
                <a href="{{ calendar_scan_url }}" class="dropdown-item">{{ icon('calendar', 's16') }}Naskenovat design kalendáře{{ scan_calendar ? '' : '…' }}</a>
            </div>
        </div>
    {% elseif can_start %}
        <a href="{{ new_scan_url }}" class="btn btn-primary">{{ icon('plus') }}Nový sken</a>
    {% endif %}
{% endblock %}

{% block mobile_primary_action %}
    {% if can_start %}
        <a href="{{ new_scan_url }}" class="btn btn-primary icon" aria-label="Nový sken">{{ icon('plus') }}</a>
    {% endif %}
{% endblock %}

{% block content %}
    <div class="as-page as-history"
         data-controller="ai-scan-history"
         data-ai-scan-history-page-url-value="{{ path('ai_scan_page', {'projectId': project.id, 'scanId': nil_uuid}) }}"
         data-ai-scan-history-action-url-value="{{ path('ai_scan_action', {'id': nil_uuid, 'action': 'discard'}) }}">
        {% if total == 0 %}
            <div class="empty">
                <span class="ico-c">{{ icon('sparkle') }}</span>
                <h2>Zatím tu není žádný sken</h2>
                <p>Nahrajte obrázek hotové grafiky nebo stránky kalendáře a AI z něj vytvoří upravitelný návrh.</p>
                {% if can_start %}
                    <a href="{{ new_scan_url }}" class="btn btn-primary sm">{{ icon('plus', 's16') }}Nový sken</a>
                {% endif %}
            </div>
        {% else %}
            <nav class="fbar" aria-label="Filtr">
                {% for key, label in filters %}
                    <a href="{{ path('ai_scan_history', key == 'all' ? {'projectId': project.id} : {'projectId': project.id, 'filter': key}) }}" class="chip{{ filter == key ? ' on' : '' }}"{% if filter == key %} aria-current="true"{% endif %}>{{ label }}{% if key == 'all' %} <span class="n">{{ total }}</span>{% endif %}</a>
                    {% if key in ['all', 'calendars'] %}<span class="sep" aria-hidden="true"></span>{% endif %}
                {% endfor %}
            </nav>

            {% if rows is empty %}
                <div class="empty">
                    <span class="ico-c">{{ icon('search') }}</span>
                    <h2>Tomuto filtru neodpovídá žádný sken</h2>
                    <a href="{{ path('ai_scan_history', {'projectId': project.id}) }}" class="btn btn-tertiary sm">Zobrazit vše</a>
                </div>
            {% else %}
                <div class="u-card">
                    <ul class="u-list">
                        {% for row in rows %}
                            {% set gone = row.status in ['expired', 'discarded'] %}
                            {% set name = row.name ?: (row.fileName ?: 'Sken') %}
                            {% set is_calendar = row.kind == 'calendar' %}
                            {# A calendar scan whose calendar is gone has nowhere to open. #}
                            {% set url = is_calendar
                                ? (row.calendarId ? path('calendar_workspace', {'calendarId': row.calendarId, 'sken': row.id}) : null)
                                : path('ai_scan_page', {'projectId': project.id, 'scanId': row.id}) %}
                            {% set gone = gone or url is null %}
                            {% set pill = is_calendar and row.status == 'accepted' ? ['mint', 'Rozvržení použito'] : (pills[row.status] ?? pills.expired) %}
                            <li class="as-hrow" data-scan="{{ row.id }}" data-status="{{ row.status }}">
                                <span class="as-scan-th as-hrow-th">
                                    {% if row.hasPicture and not gone %}
                                        <img src="{{ path('ai_scan_image', {'id': row.id, 'which': row.hasProposal ? 'proposal' : 'preview'}) }}" alt="" loading="lazy" data-fallback="{{ path('ai_scan_image', {'id': row.id, 'which': 'working'}) }}|{{ path('ai_scan_image', {'id': row.id, 'which': 'original'}) }}">
                                    {% endif %}
                                </span>
                                <span class="who">
                                    {% if gone %}
                                        <span class="u-nm as-muted" title="{{ name }}">{{ name }}</span>
                                    {% else %}
                                        <a href="{{ url }}" class="u-nm" title="{{ name }}">{{ name }}</a>
                                    {% endif %}
                                    <span class="cap">{{ row.kind == 'calendar' ? 'Kalendáře' : 'Šablony' }}{% if row.requestedBy %} · {{ row.requestedBy }}{% endif %} · {{ row.when }}</span>
                                </span>
                                <span class="st">
                                    <span class="pill {{ pill[0] }}">{{ pill[1] }}</span>
                                    {% if row.try > 1 %}<span class="cap">{{ row.try }}. pokus</span>{% endif %}
                                    {% if row.status == 'ready' and row.expiresAt %}<span class="cap">vyprší {{ row.expiresAt|date('j. n. Y', 'Europe/Prague') }}</span>{% endif %}
                                    {% if row.status == 'ready' and row.unfinished %}<span class="cap">nedokončeno</span>{% endif %}
                                </span>
                                {% set in_progress = row.status in ['checking', 'queued', 'running'] %}
                                {% if not gone and (row.actions|filter(a => a != 'open_calendar') is not empty or in_progress) %}
                                    <div class="dropdown">
                                        <button type="button" class="btn icon xs btn-ghost" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Akce: {{ name }}">{{ icon('more', 's16') }}</button>
                                        <div class="dropdown-menu dropdown-menu-end">
                                            {% if in_progress %}
                                                <a href="{{ url }}" class="dropdown-item">{{ icon('eye', 's16') }}Zobrazit průběh</a>
                                            {% endif %}
                                            {% if 'open_proposal' in row.actions %}
                                                <a href="{{ url }}" class="dropdown-item">{{ icon('eye', 's16') }}Otevřít návrh</a>
                                            {% endif %}
                                            {% if 'restore' in row.actions and row.calendarId %}
                                                <button type="button" class="dropdown-item" data-action="ai-scan-history#restore" data-id="{{ row.id }}" data-url="{{ path('calendar_scan', {'calendarId': row.calendarId, 'scanId': row.id, 'action': 'restore'}) }}">{{ icon('undo', 's16') }}Vrátit původní rozvržení</button>
                                            {% endif %}
                                            {% if is_calendar and row.status == 'accepted' and 'open_calendar' in row.actions %}
                                                <a href="{{ path('calendar_workspace', {'calendarId': row.calendarId}) }}" class="dropdown-item">{{ icon('calendar', 's16') }}Otevřít kalendář</a>
                                            {% endif %}
                                            {% if 'open_template' in row.actions and row.resultVariantId %}
                                                <a href="{{ path('template_variant_editor', {'variantId': row.resultVariantId}) }}" class="dropdown-item">{{ icon('edit', 's16') }}Otevřít šablonu</a>
                                            {% endif %}
                                            {% if 'retry' in row.actions %}
                                                <button type="button" class="dropdown-item" data-action="ai-scan-history#retry" data-id="{{ row.id }}"{% if is_calendar %} data-page-url="{{ url }}"{% endif %}>{{ icon('refresh', 's16') }}Zkusit znovu</button>
                                            {% endif %}
                                            {% if row.status in ['stopped', 'refused'] or ('continue' in row.actions) %}
                                                <a href="{{ url }}" class="dropdown-item">{{ icon('eye', 's16') }}Zobrazit</a>
                                            {% endif %}
                                            {% if 'discard' in row.actions %}
                                                <div class="dropdown-divider"></div>
                                                <button type="button" class="dropdown-item text-danger" data-action="ai-scan-history#discard" data-id="{{ row.id }}" data-proposal="{{ row.status == 'ready' ? '1' : '0' }}">{{ icon('trash', 's16') }}Zahodit</button>
                                            {% endif %}
                                        </div>
                                    </div>
                                {% else %}
                                    <span class="as-hrow-nomenu" aria-hidden="true"></span>
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}
        {% endif %}
    </div>
{% endblock %}
