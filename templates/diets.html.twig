{% extends 'base.html.twig' %}

{% set active_menu_item = 'weekly_menus' %}
{% set active_submenu_item = 'diets' %}

{% block title %}Diety{% endblock %}
{% block eyebrow %}Projekt · {{ project.name }} · Jídelníčky{% endblock %}
{% block title_count %}{{ diets|length }}{% endblock %}
{% block page_lead %}Diety s jejich kódy — u jídel a variant určují, pro koho je jídlo vhodné.{% endblock %}

{% block title_actions %}
    {% if is_granted('project_edit', project) %}
        <a href="{{ path('add_diet', {'projectId': project.id}) }}" class="btn btn-primary">{{ icon('plus', 's16') }}Nová dieta</a>
    {% endif %}
{% endblock %}

{% block mobile_primary_action %}
    {% if is_granted('project_edit', project) %}
        <a href="{{ path('add_diet', {'projectId': project.id}) }}" class="btn btn-primary icon" aria-label="Nová dieta">{{ icon('plus') }}</a>
    {% endif %}
{% endblock %}

{% block breadcrumb %}
    <ol class="breadcrumb m-0 pt-0">
        <li class="breadcrumb-item"><a href="{{ path('weekly_menus', {'projectId': project.id}) }}">Jídelníčky</a></li>
        <li class="breadcrumb-item active">{{ block('title') }}</li>
    </ol>
{% endblock %}

{% block content %}
    <div class="wm-page">
        {{ include('weekly_menu/_nav.html.twig') }}

        {% if diets|length == 0 %}
            <div class="empty">
                <span class="ico-c">{{ icon('list') }}</span>
                <h2>Zatím tu nejsou žádné diety</h2>
                <p>Dieta má název a kódy (např. „1, 2“). Jídla a jejich varianty pak k dietám přiřadíte.</p>
                {% if is_granted('project_edit', project) %}
                    <a href="{{ path('add_diet', {'projectId': project.id}) }}" class="btn btn-primary btn-sm">{{ icon('plus', 's16') }}Vytvořit první dietu</a>
                {% endif %}
            </div>
        {% else %}
            <ul class="wm-tiles">
                {% for diet in diets %}
                    <li class="wm-tile">
                        <div class="wm-tile-t">
                            <b>{{ diet.name }}</b>
                            {% if diet.codes|length > 0 %}
                                <span class="wm-codes">{% for code in diet.codes %}<span class="tag">{{ code }}</span>{% endfor %}</span>
                            {% endif %}
                        </div>
                        {% if is_granted('diet_edit', diet) %}
                            <div class="wm-acts">
                                <a href="{{ path('edit_diet', {'dietId': diet.id}) }}" class="btn btn-ghost icon xs" title="Upravit" aria-label="Upravit dietu {{ diet.name }}">{{ icon('edit', 's16') }}</a>
                                <a href="#"
                                   class="btn btn-ghost-danger icon xs"
                                   title="Smazat"
                                   aria-label="Smazat dietu {{ diet.name }}"
                                   data-modal-id="{{ diet.id }}"
                                   data-action="click->confirm-modal#showModal">{{ icon('trash', 's16') }}</a>

                                <twig:ConfirmModal
                                    id="{{ diet.id }}"
                                    url="{{ path('delete_diet', {'dietId': diet.id}) }}"
                                    confirmationText="Opravdu chcete smazat tuto dietu?" />
                            </div>
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </div>
{% endblock %}
