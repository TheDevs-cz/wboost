{% extends 'base.html.twig' %}

{% set active_menu_item = 'weekly_menus' %}
{% set active_submenu_item = 'dish_types' %}

{% block title %}Nový druh jídla{% endblock %}

{% block page_title_row %}
    <a href="{{ path('dish_types', {'projectId': project.id}) }}" class="back">{{ icon('arrow-left', 's16') }}Druhy jídel</a>
{% endblock %}

{% block content %}
    {{ form_start(form, {'attr': {'class': 'adm-sheet wm-sheet'}}) }}
        <div class="adm-sheet-h"><h1 class="page-title adm-sheet-title">Nový druh jídla</h1></div>
        <div class="adm-sheet-b">
            {{ form_widget(form) }}
        </div>
        <div class="adm-sheet-f">
            <a href="{{ path('dish_types', {'projectId': project.id}) }}" class="btn btn-tertiary sm">Zrušit</a>
            <button class="btn btn-primary sm" type="submit">Vytvořit</button>
        </div>
    {{ form_end(form) }}
{% endblock %}
