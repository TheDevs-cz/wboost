{% extends 'base.html.twig' %}

{% set active_menu_item = 'project_modules' %}

{% block title %}Kalendáře{% endblock %}

{% block page_lead %}Modul pro správu firemních kalendářů a jejich přípravu pro tisk.{% endblock %}

{% block breadcrumb %}
    <ol class="breadcrumb m-0 pt-0">
        <li class="breadcrumb-item"><a href="{{ path('project_dashboard', {'id': project.id}) }}">{{ project.name }}</a></li>
        <li class="breadcrumb-item active">{{ block('title') }}</li>
    </ol>
{% endblock %}

{% block content %}
<div class="stack cal-page">
    <section class="empty cal-hero">
        <span class="pill pch">{{ icon('sparkle') }}Připravujeme</span>
        <span class="ico-c">{{ icon('calendar') }}</span>
        <h2>Modul Kalendáře právě vzniká</h2>
        <p>Pracujeme na novém modulu, který vám umožní pohodlnou správu firemních kalendářů a jejich přípravu pro tisk — od návrhu přes naplnění obsahem až po bezproblémový export.</p>
    </section>

    <div class="cal-tiles">
        <div class="cal-tile">
            <span class="cal-ico">{{ icon('edit') }}</span>
            <h3>Snadná správa</h3>
            <p class="cap">Přehledná tvorba a úpravy kalendářů na jednom místě.</p>
        </div>
        <div class="cal-tile">
            <span class="cal-ico">{{ icon('download') }}</span>
            <h3>Připraveno pro tisk</h3>
            <p class="cap">Export ve správných rozměrech a kvalitě pro tiskárnu.</p>
        </div>
        <div class="cal-tile">
            <span class="cal-ico">{{ icon('palette') }}</span>
            <h3>Vaše značka</h3>
            <p class="cap">Kalendáře v souladu s firemním vizuálním stylem.</p>
        </div>
    </div>

    <div class="alert c-info cal-beta">
        {{ icon('mail') }}
        <div>
            <div class="alert-t">Máte zájem o beta testování?</div>
            <div class="alert-d">Hledáme uživatele, kteří si modul Kalendáře vyzkouší jako první a pomohou nám jej vyladit. Ozvěte se nám — rádi vás zapojíme. Nebo přímo na <a href="mailto:j.mikes@me.com">j.mikes@me.com</a>.</div>
        </div>
        <a href="mailto:j.mikes@me.com?subject=Beta%20testov%C3%A1n%C3%AD%20modulu%20Kalend%C3%A1%C5%99e" class="btn btn-primary sm">Napsat administrátorům</a>
    </div>
</div>
{% endblock %}
