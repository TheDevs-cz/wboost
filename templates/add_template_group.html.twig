{% extends 'base.html.twig' %}

{% set active_menu_item = 'templates' %}

{% block title %}Nová synchronizovaná šablona{% endblock %}
{% block page_lead %}Skupina vytvoří jednu šablonu se stejným designem ve všech vybraných rozměrech — pro sociální sítě i tiskoviny. Změna v jednom rozměru se propíše do ostatních.{% endblock %}

{% block breadcrumb %}
    <ol class="breadcrumb m-0 pt-0">
        <li class="breadcrumb-item"><a href="{{ path('templates', {'projectId': project.id}) }}">Šablony</a></li>
        <li class="breadcrumb-item active">{{ block('title') }}</li>
    </ol>
{% endblock %}

{# One custom-dimension row — rendered for existing rows and (is_new) as the
   collection prototype the form-collection controller clones. `.form-group`
   is the controller's row hook (index count + remove). #}
{% macro dimension_row(dimension, is_new) %}
    <div class="form-group tp-dimrow" data-controller="template-dimension">
        <div class="tp-chips">
            {% for p in [
                {label: 'A5', width: 148, height: 210},
                {label: 'A4', width: 210, height: 297},
                {label: 'A3', width: 297, height: 420},
            ] %}
                <button type="button" class="tp-chip"
                        data-action="template-dimension#applyPreset"
                        data-template-dimension-unit-param="mm"
                        data-template-dimension-width-param="{{ p.width }}"
                        data-template-dimension-height-param="{{ p.height }}"
                ><b>{{ p.label }}</b><small>{{ p.width }} × {{ p.height }} mm</small></button>
            {% endfor %}
            <button type="button" class="btn btn-ghost-danger sm tp-dimrow-del" data-action="form-collection#remove">{{ icon('trash', 's16') }}Odebrat</button>
        </div>
        <div class="tp-dims">
            {{ form_row(dimension.unit, { attr: { 'data-template-dimension-target': 'unit' }, row_attr: { class: 'mb-0' } }) }}
            {{ form_row(dimension.width, { attr: { 'data-template-dimension-target': 'width' }, row_attr: { class: 'mb-0' } }) }}
            {{ form_row(dimension.height, { attr: { 'data-template-dimension-target': 'height' }, row_attr: { class: 'mb-0' } }) }}
        </div>
        {% if is_new %}
            {{ include('_print_settings.html.twig', { bleed_field: dimension.bleed, crop_marks_field: dimension.cropMarks, bleed_value: constant('WBoost\\Web\\Value\\TemplateDimension::DEFAULT_PRINT_BLEED_MM'), crop_marks_checked: true }) }}
        {% else %}
            {{ include('_print_settings.html.twig', { bleed_field: dimension.bleed, crop_marks_field: dimension.cropMarks }) }}
        {% endif %}
        {{ include('_background_gallery_picker.html.twig', { field: dimension.backgroundImageId }) }}
    </div>
{% endmacro %}

{% block content %}
    {{ form_start(form, {attr: {'data-controller': 'form-validation', class: 'tp-form'}}) }}
    {{ form_errors(form) }}

    {% if source_variant %}
        {% set source_thumb = source_variant.previewImagePath ?: source_variant.backgroundImage %}
        <div class="tp-source">
            <span class="tp-src-thumb" style="height: 72px; aspect-ratio: {{ source_variant.dimension.width }} / {{ source_variant.dimension.height }};{% if source_thumb %} background-image: url('{{ uploaded_asset(source_thumb) }}');{% endif %}"></span>
            <div class="tp-source-b">
                <b>Výchozí design: {{ source_variant.template.name }} <span class="pill">{{ source_variant.dimension.label }}</span></b>
                <span class="cap">Každý vybraný rozměr vznikne jako kopie tohoto designu, poměrově přepočítaná. Pozadí jsou proto nepovinná — rozměry bez vlastního pozadí převezmou pozadí výchozí šablony. Původní šablona zůstane beze změny.</span>
            </div>
            <div class="tp-source-acts">
                <a href="{{ path('template_group_from_template', {'projectId': project.id}) }}" class="btn btn-tertiary sm">Změnit</a>
                <a href="{{ path('add_template_group', {'projectId': project.id}) }}" class="btn btn-ghost sm">Začít od nuly</a>
            </div>
        </div>
    {% endif %}

    <section class="tp-sec">
        <div class="tp-sech"><h2><span class="tp-step">1</span>Základní údaje</h2></div>
        <div class="tp-formgrid">
            {{ form_row(form.name, {row_attr: {class: 'mb-0'}}) }}
            {{ form_row(form.category, {row_attr: {class: 'mb-0'}}) }}
        </div>
    </section>

    <section class="tp-sec">
        <div class="tp-sech">
            <h2><span class="tp-step">2</span>Sociální sítě</h2>
            {% if source_variant %}
                <p class="cap">Zaškrtněte rozměry, které chcete vytvořit. Pozadí je nepovinné — rozměry bez vlastního pozadí převezmou pozadí výchozí šablony.</p>
            {% else %}
                <p class="cap">Zaškrtněte rozměry, které chcete vytvořit. Každá varianta potřebuje pozadí — vlastní, nebo společné (níže).</p>
            {% endif %}
        </div>

        {{ form_errors(form.presetDimensions) }}

        {# Keyed by preset value: the offered checkboxes are a subset (1:1 retired). #}
        {% set backgrounds = {'1:1': form.backgroundInstagramPost, '4:5': form.backgroundInstagramPortrait, '9:16': form.backgroundInstagramStory} %}
        <div class="tp-presetcards">
            {% for checkbox in form.presetDimensions %}
                <div class="tp-presetcard">
                    <div class="form-check form-switch">
                        {{ form_widget(checkbox, {'attr': {'class': 'form-check-input'}}) }}
                        {{ form_label(checkbox, null, {'label_attr': {'class': 'form-check-label'}}) }}
                    </div>
                    {% if backgrounds[checkbox.vars.value] is defined %}
                        {{ include('_background_gallery_picker.html.twig', { field: backgrounds[checkbox.vars.value], label: 'Pozadí ' ~ checkbox.vars.value }) }}
                    {% endif %}
                </div>
            {% endfor %}
        </div>
        {% for field in backgrounds %}
            {% if not field.rendered %}{{ form_widget(field) }}{% endif %}
        {% endfor %}
    </section>

    <section class="tp-sec" data-controller="form-collection">
        <div class="tp-sech">
            <h2><span class="tp-step">3</span>Tiskové a vlastní rozměry</h2>
            <p class="cap">Přidejte libovolný počet vlastních rozměrů — pro každý vznikne varianta šablony. Fyzické jednotky (mm/cm) se převádí v tiskové kvalitě 300 DPI.</p>
        </div>

        <div class="tp-dimrows" data-form-collection-target="collection"
             data-prototype="{{ _self.dimension_row(form.customDimensions.vars.prototype, true)|e('html_attr') }}">
            {% for dimensionForm in form.customDimensions %}
                {{ _self.dimension_row(dimensionForm, false) }}
            {% endfor %}

            <button type="button" class="tp-cat-add" data-action="form-collection#add">{{ icon('plus', 's14') }}Přidat rozměr</button>
        </div>

        {# Rows + prototype are rendered manually above — keep form_rest from
           re-emitting the empty collection with its label. #}
        {% do form.customDimensions.setRendered %}
    </section>

    <section class="tp-sec">
        <div class="tp-sech">
            <h2><span class="tp-step">4</span>Společné pozadí</h2>
            {% if source_variant %}
                <p class="cap">Nepovinné. Použije se pro každý vybraný rozměr, který nemá vybrané vlastní pozadí — bez něj se převezme pozadí výchozí šablony.</p>
            {% else %}
                <p class="cap">Použije se pro každý vybraný rozměr, který nemá vybrané vlastní pozadí (ořízne se na střed).</p>
            {% endif %}
        </div>

        {{ include('_background_gallery_picker.html.twig', { field: form.commonBackground, label: 'Společné pozadí' }) }}
    </section>

    {{ form_rest(form) }}

    <div class="tp-foot">
        <a href="{{ path('templates', {'projectId': project.id}) }}" class="btn btn-tertiary sm">Zrušit</a>
        <button class="btn btn-primary sm" type="submit">{{ icon('refresh', 's16') }}Vytvořit skupinu a otevřít editor</button>
    </div>

    {{ form_end(form) }}

    {{ include('_background_gallery_modal.html.twig') }}
{% endblock %}
