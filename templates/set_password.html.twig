{% extends 'base_auth.html.twig' %}

{% block title %}Nastavení hesla{% endblock %}

{% block auth_body %}
    {% if invalid %}
        <div class="auth-top">
            <span class="ico-c danger">{{ icon('alert') }}</span>
            <h1>Odkaz vypršel</h1>
            <p>Tento odkaz pro nastavení hesla je neplatný nebo již vypršel. Nechte si poslat nový.</p>
        </div>

        {{ include('_flashes.html.twig') }}

        <a class="btn btn-primary auth-submit" href="{{ path('forgotten_password') }}">Poslat nový odkaz</a>
    {% else %}
        <div class="auth-top">
            {% if isInvitation %}
                <h1>Vítejte ve WBoost</h1>
                <p>Pro aktivaci účtu si nastavte heslo.</p>
            {% else %}
                <h1>Zvolte si nové heslo</h1>
                <p>Zadejte nové heslo ke svému účtu.</p>
            {% endif %}
        </div>

        {{ include('_flashes.html.twig') }}

        {{ form_start(form, {'attr': {'class': 'auth-form'}}) }}
            {{ form_row(form.password.first, {'attr': {'autocomplete': 'new-password'}}) }}
            {{ form_row(form.password.second, {'attr': {'autocomplete': 'new-password'}}) }}
            <button class="btn btn-primary auth-submit" type="submit">
                {{ isInvitation ? 'Nastavit heslo a aktivovat účet' : 'Změnit heslo' }}
            </button>
        {{ form_end(form) }}
    {% endif %}
{% endblock %}

{% block auth_below %}Zpět na <a href="{{ path('login') }}">přihlášení</a>{% endblock %}
