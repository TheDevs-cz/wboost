{% extends 'base.html.twig' %}

{% block title %}Přidat variantu{% endblock %}
{% set active_menu_item = 'templates' %}

{% block page_lead %}Nový formát šablony „{{ template.name }}“ — vznikne s vybraným pozadím, design do něj pak doplníte v editoru.{% endblock %}

{% block breadcrumb %}
    <ol class="breadcrumb m-0 pt-0">
        <li class="breadcrumb-item"><a href="{{ path('template_variants', {'templateId': template.id}) }}">{{ template.name }}</a></li>
        <li class="breadcrumb-item active">{{ block('title') }}</li>
    </ol>
{% endblock %}

{% block content %}
    {{ form_start(form, {attr: {class: 'tp-form'}}) }}
    {{ form_errors(form) }}

    <section class="tp-sec" data-controller="template-dimension">
        <div class="tp-sech"><h2>{{ icon('grid', 's18') }}Rozměr</h2></div>

        {{ include('_template_dimension_fields.html.twig', {
            preset: form.preset,
            unit: form.unit,
            width: form.width,
            height: form.height,
        }) }}

        {{ include('_print_settings.html.twig', { bleed_field: form.bleed, crop_marks_field: form.cropMarks }) }}

        {{ include('_background_gallery_picker.html.twig', { field: form.backgroundImageId }) }}
    </section>

    {{ form_rest(form) }}

    <div class="tp-foot">
        <a href="{{ path('template_variants', {'templateId': template.id}) }}" class="btn btn-tertiary sm">Zrušit</a>
        <button class="btn btn-primary sm" type="submit">Přidat</button>
    </div>

    {{ form_end(form) }}

    {{ include('_background_gallery_modal.html.twig') }}
{% endblock %}
