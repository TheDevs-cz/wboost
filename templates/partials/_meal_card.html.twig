{#
    Meal Card Inner Content

    Usage: Include this inside a .meal-selector-item div. The outer div with data attributes
    should be in the calling template since they differ between use cases. The outer div
    sets `--mt` (the meal type colour) — it tints the left bar and the type dot only.

    Parameters:
    - meal: The meal entity
    - nutrition: NutritionalValues object (optional, defaults to meal.nutritionalValues)
    - showCloseButton: boolean (optional, default false)
    - closeButtonAction: string for data-action (required if showCloseButton)
    - closeButtonParam: string for data-live-variantmealid-param (required if showCloseButton)
#}

{% set nutrition = nutrition|default(meal.nutritionalValues) %}
{% set showCloseButton = showCloseButton|default(false) %}

<div class="meal-selector-header">
    <span class="meal-selector-type" title="{{ meal.mealType.label }}">{{ meal.mealType.label|slice(0,2)|upper }}</span>
    <span class="meal-selector-name" title="{{ meal.internalName }}">{{ meal.internalName }}</span>
    {% if showCloseButton %}
        <button
            type="button"
            class="meal-selector-remove"
            aria-label="Odebrat jídlo {{ meal.internalName }}"
            data-action="{{ closeButtonAction }}"
            data-live-action-param="removeMeal"
            data-live-variantmealid-param="{{ closeButtonParam }}">{{ icon('x', 's14') }}</button>
    {% endif %}
</div>

{% if meal.hasDiets %}
    <div class="meal-selector-meta">
        <span class="meal-selector-diet">{{ meal.dietCodesLabel }}</span>
    </div>
{% endif %}

{% if meal.hasVariants %}
    <div class="meal-selector-variants">
        {% for mealVariant in meal.variants %}
            <span class="meal-selector-variant">{{ mealVariant.displayName }}{% if mealVariant.dietCodesLabel %} ({{ mealVariant.dietCodesLabel }}){% endif %}</span>
        {% endfor %}
    </div>
{% endif %}

{% if nutrition.hasAnyValue %}
    <div class="meal-selector-nutrition">
        {% if nutrition.energyValue is not null %}<span>{{ nutrition.formatEnergyValue }}</span>{% endif %}
        {% if nutrition.fats is not null %}<span title="Tuky">T {{ nutrition.formatFats }}</span>{% endif %}
        {% if nutrition.carbohydrates is not null %}<span title="Sacharidy">S {{ nutrition.formatCarbohydrates }}</span>{% endif %}
        {% if nutrition.proteins is not null %}<span title="Bílkoviny">B {{ nutrition.formatProteins }}</span>{% endif %}
    </div>
{% endif %}
