{% extends 'base.html.twig' %}

{% set active_menu_item = 'weekly_menus' %}

{% block title %}{{ menu.name }}{% endblock %}
{% block eyebrow %}Jídelníček · Sestavit menu{% endblock %}
{% block page_lead %}{{ menu.validFrom|date('j. n. Y') }} – {{ menu.validTo|date('j. n. Y') }} · změny se ukládají průběžně{% endblock %}

{% block title_actions %}
    <a href="{{ path('meals', {'projectId': project.id}) }}" class="btn btn-tertiary">{{ icon('utensils', 's16') }}Spravovat jídla</a>
    <a href="{{ path('edit_weekly_menu', {'menuId': menu.id}) }}" class="btn btn-tertiary">{{ icon('edit', 's16') }}Upravit údaje</a>
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#menuPreviewModal">{{ icon('eye', 's16') }}Náhled</button>
{% endblock %}

{% block breadcrumb %}
    <ol class="breadcrumb m-0 pt-0">
        <li class="breadcrumb-item"><a href="{{ path('weekly_menus', {'projectId': project.id}) }}">Jídelníčky</a></li>
        <li class="breadcrumb-item"><a href="{{ path('edit_weekly_menu', {'menuId': menu.id}) }}">{{ menu.name }}</a></li>
        <li class="breadcrumb-item active">Sestavit menu</li>
    </ol>
{% endblock %}

{% block content %}
    <twig:WeeklyMenuPlanner :menu="menu" />

    {% include 'weekly_menu/_preview_modal.html.twig' %}
{% endblock %}
