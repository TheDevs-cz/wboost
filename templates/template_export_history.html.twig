{% extends 'base.html.twig' %}

{#
    The full export history of one fill surface ("Historie exportů" page) —
    the single-variant AND the group flavour, one template. Every stored
    version, pinned first, each with inline rename + pin and a "Načíst" link
    that opens the fill page seeded from it. The summary column is a digest
    of the stored fill (labelled texts, picture / hidden counts) so twenty
    same-day versions can be told apart without a render per row.

    Expects (from the two history controllers):
    - project, template (null for a group whose template is gone), variant | group | document
    - pin_route / rename_route: optional (a document's own curation routes)
    - subject_label:      heading
    - history:            ExportHistory
    - history_cap:        the unpinned pruning cap (explained to the user)
    - summaries:          version id → {texts: [{label, value}], pictures, hidden}
    - load_route_name / load_route_params: the fill page (version id merged in)
    - fill_url:           the fill page without a version
#}

{% block title %}Historie exportů{% endblock %}
{% set active_menu_item = 'templates' %}

{% block title_count %}{{ history.isEmpty ? '' : history.all|length }}{% endblock %}
{% block page_lead %}{{ subject_label }} — každý úspěšný export se uloží jako verze s hodnotami, které jste vyplnili. Verzi můžete pojmenovat a připnout: připnuté verze jsou v historii vždy nahoře a nikdy se nepromažou. Z ostatních se uchovává posledních {{ history_cap }}.{% endblock %}

{% block title_actions %}
    <a href="{{ fill_url }}" class="btn btn-primary">{{ icon('arrow-left', 's16') }}Zpět na vyplnění</a>
{% endblock %}

{% block breadcrumb %}
    <ol class="breadcrumb m-0 pt-0">
        <li class="breadcrumb-item"><a href="{{ fill_url }}">{{ subject_label }}</a></li>
        <li class="breadcrumb-item active">{{ block('title') }}</li>
    </ol>
{% endblock %}

{% block content %}
    {% set redirect_url = app.request.requestUri %}
    {% if history.isEmpty %}
        <div class="empty">
            <span class="ico-c">{{ icon('history') }}</span>
            <h2>Zatím nebyl proveden žádný export</h2>
            <p>Verze se tu objeví po prvním exportu z vyplnění.</p>
            <a href="{{ fill_url }}" class="btn btn-primary sm">{{ icon('download', 's16') }}Vyplnit a exportovat</a>
        </div>
    {% else %}
        <div class="tp-hist">
            <table class="table mb-0">
                <thead>
                    <tr>
                        <th class="tp-hist-pin"><span class="visually-hidden">Připnuto</span></th>
                        <th>Název</th>
                        <th>Exportováno</th>
                        <th>Obsah</th>
                        <th class="text-end"><span class="visually-hidden">Akce</span></th>
                    </tr>
                </thead>
                <tbody>
                    {% for version in history.all %}
                        {% set summary = summaries[version.id.toString] %}
                        <tr data-export-version="{{ version.id }}"{{ version.pinned ? ' data-export-version-pinned' }}{% if version.pinned %} class="is-pinned"{% endif %}>
                            <td class="tp-hist-pin">
                                {{ include('_export_version_pin_button.html.twig', {version: version, redirect_url: redirect_url}) }}
                            </td>
                            <td class="tp-hist-name">
                                {{ include('_export_version_rename_form.html.twig', {version: version, redirect_url: redirect_url}) }}
                            </td>
                            <td class="tp-hist-when">
                                <b>{{ version.lastExportedAt|date('j. n. Y H:i') }}</b>
                                <span class="cap">{{ version.exportedBy ? version.exportedBy.displayName : 'Neznámý uživatel' }}</span>
                                <span class="tp-hist-tags">
                                    {% if version.draft %}
                                        <span class="pill pch" title="Uložená rozpracovaná práce — zatím neexportováno">Rozpracováno</span>
                                    {% endif %}
                                    {% if version.channel.value != 'web' %}
                                        <span class="pill neutral">{{ version.channel.label }}</span>
                                    {% endif %}
                                    {% if version.exportCount > 1 %}
                                        <span class="pill neutral" title="Exportováno {{ version.exportCount }}×">{{ version.exportCount }}×</span>
                                    {% endif %}
                                </span>
                            </td>
                            <td class="tp-hist-sum">
                                {% if summary.texts is empty and summary.pictures == 0 and summary.hidden == 0 %}
                                    <span class="cap">Výchozí hodnoty</span>
                                {% else %}
                                    {% for entry in summary.texts|slice(0, 3) %}
                                        <div class="text-truncate">
                                            <span class="cap">{{ entry.label }}:</span> {{ entry.value }}
                                        </div>
                                    {% endfor %}
                                    {% set more = summary.texts|length - 3 %}
                                    <span class="cap tp-hist-more">
                                        {% if more > 0 %}<span>+ {{ more }} {{ more == 1 ? 'další text' : (more < 5 ? 'další texty' : 'dalších textů') }}</span>{% endif %}
                                        {% if summary.pictures > 0 %}<span>{{ icon('image', 's14') }} {{ summary.pictures }}</span>{% endif %}
                                        {% if summary.hidden > 0 %}<span title="Skryté prvky">{{ icon('eye-off', 's14') }} {{ summary.hidden }}</span>{% endif %}
                                    </span>
                                {% endif %}
                            </td>
                            <td class="text-end tp-hist-act">
                                <a class="btn btn-tertiary sm" href="{{ path(load_route_name, load_route_params|merge({'version': version.id})) }}" title="Načíst hodnoty této verze do formuláře">
                                    {{ icon('upload', 's16') }}Načíst
                                </a>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {# The rows' pin / rename controls carry no <form> of their own
           (see the partials) — they submit through these anchors. #}
        {{ include('_export_version_form_anchors.html.twig', {versions: history.all}) }}
    {% endif %}
{% endblock %}
