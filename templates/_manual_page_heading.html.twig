{# One manual page's heading row. The title is admin-overridable per page
   (the ManualPage default is the fallback) and an admin gets a pencil next to
   it that edits both the title and the page's description.

   Params: manual, page (ManualPage), number (int). #}
<div class="page-heading py-3 border-bottom">
    <span class="d-inline-block pe-4 fs-4">{{ "%02d"|format(number) }}</span>
    <span class="d-inline-block pe-4 fs-4">{{ manual.name }}</span>
    <span class="d-inline-block pe-4 fs-4 fw-bold">{{ manual.pageTitle(page) }}</span>
    <span class="d-inline-block float-end fs-4">{{ manual.brandManual ? 'Brand manuál' : 'Logo manuál' }}</span>
    <twig:ManualPageText manual="{{ manual }}" page="{{ page.value }}" class="float-end me-3" />
</div>
