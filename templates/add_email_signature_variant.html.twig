{% extends 'base.html.twig' %}

{% block title %}Nová varianta{% endblock %}
{% set active_menu_item = 'emails' %}

{% block page_title_row %}
    <a href="{{ path('email_signature_variants', {'id': email_template.id}) }}" class="back">{{ icon('arrow-left', 's16') }}{{ email_template.name }}</a>
{% endblock %}

{% block content %}
    {{ form_start(form, {'attr': {'class': 'adm-sheet es-sheet'}}) }}
        <div class="adm-sheet-h"><h1 class="page-title adm-sheet-title">Nová varianta</h1></div>
        <div class="adm-sheet-b">
            {{ form_row(form.name, {'attr': {'placeholder': 'Např. Jana Nováková'}}) }}
            <p class="hint cap">{{ icon('info', 's14') }}Texty podpisu vyplníte po vytvoření — začnou s výchozími texty šablony.</p>
            <div class="d-none">
                {{ form_widget(form.code) }}
            </div>
        </div>
        <div class="adm-sheet-f">
            <a href="{{ path('email_signature_variants', {'id': email_template.id}) }}" class="btn btn-tertiary sm">Zrušit</a>
            <input type="submit" name="submit" value="Přidat" class="btn btn-primary sm">
        </div>
    {{ form_end(form) }}
{% endblock %}
