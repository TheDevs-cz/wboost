{% extends 'base.html.twig' %}

{% set active_menu_item = 'templates' %}

{% block title %}Vyplnit a exportovat{% endblock %}

{% block breadcrumb %}
    <ol class="breadcrumb m-0 pt-0">
        <li class="breadcrumb-item"><i class="uil-home-alt"></i> <a href="{{ path('projects') }}">Projekty</a></li>
        <li class="breadcrumb-item"><a href="{{ path('project_dashboard', {'id': project.id}) }}">{{ project.name }}</a></li>
        <li class="breadcrumb-item"><a href="{{ path('templates', {'projectId': project.id}) }}">Šablony</a></li>
        <li class="breadcrumb-item active">{{ group.name }}</li>
    </ol>
{% endblock %}

{#
    Group fill & export page — the single-variant fill page's UX over EVERY
    member dimension at once (unified 2026-09-03):

    - one preview per dimension, each a fill SURFACE of the shared
      variant-fill-overlay controller: the same dashed boxes + pencil / eye
      clusters as the single page, drawn at THAT dimension's frames;
    - ONE popover per distinct input (the group join key is the shared
      inputId): the pencil on any dimension opens it, and what the user
      types lands in every dimension — the popover writes the ONE mirror
      field the group form posts (`textValues[<inputId>]`), exactly as the
      single page's popovers write their Live mirrors;
    - the "Všechna pole" panel docks those popovers (+ the image cards)
      into one stacked form;
    - a placement toolbar per picked picture per dimension: zoom / rotation /
      centre, opened by clicking that picture in THAT dimension's preview.

    The group-fill controller keeps owning what is group-specific: the
    per-dimension preview renders, the text echo per dimension, the image
    placement ghosts and the ZIP / per-dimension PNG export.
#}
{% block content %}
    {% if variants|length == 0 %}
        <div class="card">
            <div class="card-body text-center text-muted py-5">
                <i class="uil-layer-group" style="font-size: 2rem;"></i>
                <p class="mb-1 mt-2"><strong>Skupina zatím nemá žádné varianty.</strong></p>
                {% if is_granted('template_group_edit', group) %}
                    <p class="mb-0">Nejdřív <a href="{{ path('add_template_group_dimension', {'groupId': group.id}) }}">přidejte rozměr</a>, potom tu půjde vše najednou vyplnit a stáhnout.</p>
                {% else %}
                    <p class="mb-0">Jakmile správce šablony přidá rozměry, půjde tu vše najednou vyplnit a stáhnout.</p>
                {% endif %}
            </div>
        </div>
    {% else %}
        {# Shared editor modules + project fonts (the same set the
           single-variant fill page loads): the overlay measures wrapped text
           for the container reflow of every dimension's boxes, and the echo
           canvases draw with the exact Fabric build, break-word patch, reflow
           engine and glyphs the server render uses. #}
        <div hidden>
            <script src="{{ asset('editor/fabric_break_word.js') }}"></script>
            <script src="{{ asset('editor/container_layout.js') }}"></script>
            <script src="{{ asset('editor/rich_text_runs.js') }}"></script>
            <script src="{{ asset('editor/rich_text_blocks.js') }}"></script>
            <script src="{{ asset('editor/fill_text_echo.js') }}"></script>
            <style>
                {% for face in font_faces %}
                    @font-face {
                        font-family: '{{ face.family }}';
                        src: url('{{ face.url }}');
                    }
                {% endfor %}
            </style>
        </div>

        {% set imagePlaceholders = image_inputs|map(slot => {
            inputId: slot.input.inputId,
            name: slot.input.name,
            hidable: slot.input.hidable,
        }) %}

        <form method="post" action="{{ export_url }}" data-turbo="false"
              class="fill-form fill-highlight-on fill-captions-on"
              data-controller="group-fill variant-fill-overlay fill-draft"
              data-fill-draft-url-value="{{ path('template_group_fill_draft', {groupId: group.id}) }}"
              {# With the instant echo covering the gap, the settle render can
                 afford to be lazier than the echo-less 900ms. #}
              data-group-fill-debounce-value="{{ has_echo ? 1500 : 900 }}"
              data-group-fill-slots-value="{{ placement_slots|json_encode }}"
              data-group-fill-variants-value="{{ placement_variants|json_encode }}"
              data-group-fill-fonts-value="{{ font_faces|map(face => face.family)|json_encode }}"
              {# Loaded export version ("Historie exportů"): the picked pictures +
                 per-dimension placements the controller restores on connect —
                 connect() resets placement state to neutral, so server-rendered
                 field values alone would be wiped. #}
              data-group-fill-seed-value="{{ {'pictures': seed.images, 'placements': seed.placements}|json_encode }}"
              data-variant-fill-overlay-fonts-value="{{ font_faces|map(face => face.family)|json_encode }}"
              data-action="keydown->group-fill#blockEnter submit->group-fill#exportStarted rich-text-editor:changed->variant-fill-overlay#richTextChanged checklist-editor:changed->variant-fill-overlay#richTextChanged">

            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                <div>
                    <h3 class="my-0">{{ group.name }}</h3>
                    <p class="text-muted my-0">Vyplňte obsah jednou — propíše se do všech rozměrů najednou.</p>
                </div>
                <div class="d-flex align-items-center gap-2">
                    {{ include('_export_history_menu.html.twig', {
                        history: export_history,
                        loaded_version: loaded_version,
                        route_name: 'template_group_fill',
                        route_params: {'groupId': group.id},
                        history_url: path('template_group_export_history', {'groupId': group.id}),
                        redirect_url: app.request.requestUri,
                    }) }}
                    {% if is_granted('template_group_edit', group) %}
                        <a href="{{ path('template_group_editor', {'groupId': group.id}) }}" class="btn btn-outline-secondary rounded-pill"><i class="mdi mdi-pencil"></i> Upravit design</a>
                    {% endif %}
                    {# Saving work in progress never depends on the form being
                       exportable — this button is NOT an exportButton target, so
                       the overflow gate leaves it alone. #}
                    <button type="button" class="btn btn-outline-primary rounded-pill" data-fill-draft-target="button" data-action="fill-draft#save" title="Ctrl/⌘+S">
                        <i class="mdi mdi-content-save-outline"></i> Uložit rozpracované
                    </button>
                    <button type="submit" class="btn btn-primary rounded-pill" data-group-fill-target="exportButton" data-variant-fill-overlay-target="exportButton">
                        <i class="mdi mdi-folder-zip-outline"></i> Stáhnout vše (ZIP)
                    </button>
                </div>
            </div>

            {# The page's draft: the loaded version (the server only ever updates
               it when it IS a draft of this group) — "Uložit rozpracované"
               overwrites it, an export promotes it. #}
            <input type="hidden" name="draftVersionId" value="{{ loaded_version ? loaded_version.id : '' }}" data-fill-draft-target="versionField">
            <input type="hidden" name="_fill_draft_token" value="{{ csrf_token('template_fill_draft') }}">

            {# ---- Toolbar: the overlay switches + the panel button ----------- #}
            <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
                {{ include('_fill_overlay_toggles.html.twig') }}
            </div>

            {# Container-overflow validation (variant-fill-overlay): shown — and
               the ZIP button disabled — while a filled text doesn't fit its
               container in ANY dimension; the boxes of that dimension go red. #}
            <div class="alert alert-danger py-1 px-2 small d-none" role="alert" aria-live="polite"
                 data-variant-fill-overlay-target="overflowAlert"></div>

            {# ---- Form fields = the popovers' mirrors ------------------------
               The ONE field per unified input the group form posts. The
               popovers (and the WYSIWYG / checklist editors) write here by
               `data-text-mirror` / `data-font-mirror` / `data-hide-mirror`,
               the group-fill controller re-renders every dimension on their
               input/change events (data-input-id = the echo's handle).
               Pre-filled with the admin's sample text — the render's own
               fallback — so an untouched form previews and exports the
               designed state; an EMPTY field blanks the text (the single
               page's semantics). #}
            {% for ph in text_placeholders %}
                <input type="hidden"
                       name="textValues[{{ ph.inputId }}]"
                       value="{{ ph.value }}"
                       data-text-mirror="{{ ph.inputId }}"
                       data-input-id="{{ ph.inputId }}"
                       data-action="input->group-fill#changed">
                {% if ph.fontChoice %}
                    <input type="hidden"
                           name="fontValues[{{ ph.inputId }}]"
                           value="{{ ph.fontValue }}"
                           data-font-mirror="{{ ph.inputId }}"
                           data-input-id="{{ ph.inputId }}"
                           data-action="input->group-fill#changed">
                {% endif %}
                {% if ph.hidable %}
                    <input type="checkbox" class="visually-hidden" tabindex="-1" aria-hidden="true"
                           name="hiddenValues[{{ ph.inputId }}]"
                           value="1"
                           data-hide-mirror="{{ ph.inputId }}"
                           data-input-id="{{ ph.inputId }}"
                           {{ ph.hidden ? 'checked' }}
                           data-action="change->group-fill#changed">
                {% endif %}
            {% endfor %}

            {# Per-dimension placement of every adjustable image slot — what the
               preview POST and the export read. The controller writes them from
               its placement state (drag in the preview, the strip under each
               preview); every dimension always posts its own. #}
            {% for slot in image_inputs %}
                {% set input = slot.input %}
                {% if input.allowMove or input.allowResize or input.allowRotate %}
                    {% for v in variants %}
                        {% set fields = (input.allowResize ? ['scale'] : [])|merge(input.allowRotate ? ['rotation'] : [])|merge(input.allowMove ? ['offsetXRatio', 'offsetYRatio'] : []) %}
                        {% for field in fields %}
                            <input type="hidden" name="imagePlacements[{{ v.variant.id }}][{{ input.inputId }}][{{ field }}]" value=""
                                   data-group-fill-target="overrideField"
                                   data-variant-id="{{ v.variant.id }}" data-input-id="{{ input.inputId }}" data-field="{{ field }}">
                        {% endfor %}
                    {% endfor %}
                {% endif %}
            {% endfor %}

            <div class="fill-body">
                <div class="group-fill-previews">
                    <div class="row">
                        {% for v in variants %}
                            {% set variantId = v.variant.id %}
                            {# This dimension's text frames — the boxes are drawn where
                               THIS canvas puts each input, not where the first one does. #}
                            {% set textFrames = {} %}
                            {% for inputId, def in v.text_layout.inputs %}
                                {% set textFrames = textFrames|merge({(inputId): def.frame}) %}
                            {% endfor %}
                            <div class="col-sm-6 col-xl-4">
                                <div class="card group-fill-preview-card">
                                    {# Which dimension this is, ABOVE the image: a caption under a
                                       preview reads as belonging to whatever comes next. The
                                       download button submits the SAME fill form (formaction),
                                       so the PNG carries exactly what the ZIP entry would. #}
                                    <div class="group-fill-preview-heading d-flex align-items-center justify-content-between gap-2">
                                        <span>{{ v.dimension_label }}</span>
                                        <button type="submit" class="group-fill-variant-download"
                                                formaction="{{ v.export_variant_url }}"
                                                data-group-fill-variant-download
                                                title="Stáhnout tento rozměr jako PNG">
                                            <i class="mdi mdi-download"></i> PNG
                                        </button>
                                    </div>
                                    {# One fill SURFACE per dimension: the overlay controller
                                       scales this dimension's frames to the displayed preview
                                       and reflows its boxes with its own layout payload. #}
                                    <div class="fill-surface"
                                         data-variant-fill-overlay-target="surface"
                                         data-variant-id="{{ variantId }}"
                                         data-canvas-width="{{ v.width }}"
                                         data-layout="{{ v.text_layout|json_encode }}">
                                        <div class="group-fill-preview-frame" style="aspect-ratio: {{ v.width }} / {{ v.height }};">
                                            <img src="{{ (v.variant.previewImagePath ?: v.variant.backgroundImage) ? uploaded_asset(v.variant.previewImagePath ?: v.variant.backgroundImage) : asset('images/manual-placeholder.png') }}"
                                                 alt="{{ v.dimension_label }}"
                                                 data-group-fill-target="preview"
                                                 data-variant-fill-overlay-target="preview"
                                                 data-variant-id="{{ variantId }}"
                                                 data-preview-endpoint="{{ v.preview_endpoint }}">
                                            {% if v.echo %}
                                                {# Echo composite: the text-transparent base render (fetched
                                                   lazily on the first edit) + the client-drawn text layer.
                                                   Visible only while typing (is-echo on the frame); the
                                                   settle render stays the truth at rest. #}
                                                <img class="group-fill-echo-base" data-group-fill-target="echoBase" data-variant-id="{{ variantId }}" alt="" aria-hidden="true">
                                                <canvas class="group-fill-echo-canvas" data-group-fill-target="echoCanvas" data-variant-id="{{ variantId }}" aria-hidden="true"></canvas>
                                            {% endif %}
                                            {# Draggable stand-ins for the picked pictures, drawn where the
                                               server will render them in THIS dimension. Only visible while
                                               the user is placing (and until the fresh render lands). #}
                                            <div class="group-fill-placement-layer"
                                                 data-group-fill-target="placementLayer"
                                                 data-variant-id="{{ variantId }}"></div>
                                            {# Same loading treatment as the single-variant fill page: dimmed
                                               overlay + the white badge with a big ring. #}
                                            <div class="group-fill-preview-spinner">
                                                <div class="fill-spinner__badge">
                                                    <span class="fill-spinner__icon" role="status" aria-label="Generuji náhled…"></span>
                                                </div>
                                            </div>
                                            <div class="group-fill-preview-error">Náhled se nepodařilo načíst</div>
                                        </div>
                                        <div class="fill-overlay">
                                            {{ include('_fill_overlay_boxes.html.twig', {
                                                text_placeholders: text_placeholders,
                                                image_placeholders: imagePlaceholders,
                                                text_frames: textFrames,
                                                image_frames: v.image_frames,
                                                image_hidden: seed.imageHidden,
                                            }) }}
                                        </div>
                                        {# Placement toolbars: how a PICKED picture sits in THIS
                                           dimension (placement is always per dimension — a crop
                                           that works in 4:5 rarely works in 9:16). Shown only
                                           while the user has that picture selected in this
                                           preview (click / focus on its stand-in), anchored to
                                           its frame; the designed picture is never placeable. #}
                                        {% for slot in image_inputs %}
                                            {% set input = slot.input %}
                                            {% if (input.allowMove or input.allowResize or input.allowRotate) and v.image_frames[input.inputId] is defined %}
                                                {% set slot_name = input.name ?: 'Obrázek ' ~ loop.index %}
                                                <div class="group-fill-placement-toolbar" hidden
                                                     role="group" aria-label="{{ slot_name }} — úprava v rozměru {{ v.dimension_label }}"
                                                     data-group-fill-target="placementToolbar"
                                                     data-variant-id="{{ variantId }}" data-input-id="{{ input.inputId }}">
                                                    <div class="d-flex align-items-center justify-content-between gap-2">
                                                        <span class="group-fill-placement-toolbar__name text-truncate"><i class="mdi mdi-image-outline"></i> {{ slot_name }}</span>
                                                        <span class="d-inline-flex align-items-center gap-2">
                                                            <button type="button" class="btn btn-link btn-sm p-0 font-12"
                                                                    data-action="group-fill#resetVariantPlacement"
                                                                    data-group-fill-variantid-param="{{ variantId }}"
                                                                    data-group-fill-inputid-param="{{ input.inputId }}">Vycentrovat</button>
                                                            <button type="button" class="btn-close group-fill-placement-toolbar__close" aria-label="Zavřít"
                                                                    data-action="group-fill#deselectPlacement"></button>
                                                        </span>
                                                    </div>
                                                    {% if input.allowResize %}
                                                        <div class="group-fill-placement-control">
                                                            <label for="group-fill-zoom-{{ variantId }}-{{ input.inputId }}" title="Zvětšení"><i class="mdi mdi-magnify-plus-outline"></i><span class="visually-hidden">Zvětšení</span></label>
                                                            <input type="range" class="form-range" id="group-fill-zoom-{{ variantId }}-{{ input.inputId }}"
                                                                   min="1" max="4" step="0.01" value="1"
                                                                   data-group-fill-target="variantZoomRange"
                                                                   data-variant-id="{{ variantId }}" data-input-id="{{ input.inputId }}"
                                                                   data-action="input->group-fill#variantZoomChanged">
                                                            <span class="group-fill-placement-control__value" data-group-fill-target="variantZoomLabel" data-variant-id="{{ variantId }}" data-input-id="{{ input.inputId }}">100 %</span>
                                                        </div>
                                                    {% endif %}
                                                    {% if input.allowRotate %}
                                                        <div class="group-fill-placement-control">
                                                            <label for="group-fill-rotation-{{ variantId }}-{{ input.inputId }}" title="Otočení"><i class="mdi mdi-rotate-right"></i><span class="visually-hidden">Otočení</span></label>
                                                            <input type="range" class="form-range" id="group-fill-rotation-{{ variantId }}-{{ input.inputId }}"
                                                                   min="-180" max="180" step="1" value="0"
                                                                   data-group-fill-target="variantRotationRange"
                                                                   data-variant-id="{{ variantId }}" data-input-id="{{ input.inputId }}"
                                                                   data-action="input->group-fill#variantRotationChanged">
                                                            <span class="group-fill-placement-control__value" data-group-fill-target="variantRotationLabel" data-variant-id="{{ variantId }}" data-input-id="{{ input.inputId }}">0°</span>
                                                        </div>
                                                    {% endif %}
                                                    {% if input.allowMove %}
                                                        <p class="font-11 text-muted mb-0 mt-1"><i class="mdi mdi-cursor-move"></i> Posunete tažením obrázku{{ input.allowResize ? ', kolečkem myši přiblížíte' }}.</p>
                                                    {% endif %}
                                                </div>
                                            {% endif %}
                                        {% endfor %}
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>

                {{ include('_fill_layers.html.twig', { layers: layers }) }}
            </div>

            {# ---- Popovers + the "Všechna pole" panel ----------------------------
               ONE popover per unified text input (shared by every dimension's
               pencil) and one image card per slot. See the single-variant
               component for the floating-vs-docked contract. #}
            <div class="fill-panel-backdrop" data-action="click->variant-fill-overlay#closePanel"></div>
            {% set can_arrange_fields = group_template is not null and is_granted('ROLE_ADMIN') %}
            <div class="fill-popovers" data-variant-fill-overlay-target="panel" aria-labelledby="fill-panel-title"
                 {% if can_arrange_fields %}data-controller="fill-field-order" data-fill-field-order-url-value="{{ path('template_fill_field_order', {templateId: group_template.id}) }}"{% endif %}>
                {{ include('_fill_panel_header.html.twig', { arrangeable: can_arrange_fields }) }}

                {# Text and image fields in ONE sequence, in the template's
                   admin-arranged order (Template::$fillFieldOrder — the group is
                   1:1 with its template); admins drag them by the handle. #}
                {% set panel_fields = [] %}
                {% for ph in text_placeholders %}
                    {% set panel_fields = panel_fields|merge([{inputId: ph.inputId, kind: 'text', ph: ph}]) %}
                {% endfor %}
                {% for slot in image_inputs %}
                    {% set panel_fields = panel_fields|merge([{inputId: slot.input.inputId, kind: 'image', slot: slot, index: loop.index}]) %}
                {% endfor %}

                {% for field in panel_fields|arrange_fill_fields(fill_field_order) %}
                  {% if field.kind == 'text' %}
                    {{ include('_fill_text_popover.html.twig', { ph: field.ph, richToolbar: rich_toolbar, arrangeable: can_arrange_fields }) }}
                  {% else %}
                    {% set slot = field.slot %}
                    {% set input = slot.input %}
                    {% set seededImage = seed.images[input.inputId]|default(null) %}
                    {% set hidden = seed.imageHidden[input.inputId] is defined %}
                    <div class="fill-popover fill-popover--image card" data-inputid="{{ input.inputId }}">
                        <div class="card-body p-2">
                            <div class="d-flex justify-content-between align-items-start mb-1">
                                <span class="d-inline-flex align-items-center" style="min-width: 0;">
                                    {% if can_arrange_fields %}{{ include('_fill_field_reorder_handle.html.twig') }}{% endif %}
                                    <span class="small fw-bold text-truncate">{{ input.name ?: 'Obrázek ' ~ field.index }}</span>
                                </span>
                                {% if input.hidable %}
                                    <button type="button"
                                        class="fill-popover__eye{{ hidden ? ' is-active' : '' }}"
                                        data-hide-toggle="{{ input.inputId }}"
                                        aria-pressed="{{ hidden ? 'true' : 'false' }}"
                                        title="{{ hidden ? 'Zobrazit prvek' : 'Schovat prvek' }}"
                                        aria-label="{{ hidden ? 'Zobrazit prvek' : 'Schovat prvek' }}"
                                        data-action="variant-fill-overlay#toggleHide"
                                        data-variant-fill-overlay-inputid-param="{{ input.inputId }}"
                                    ><i class="mdi {{ hidden ? 'mdi-eye-off-outline' : 'mdi-eye-outline' }}" aria-hidden="true"></i></button>
                                {% endif %}
                            </div>
                            {% if input.description %}<p class="small text-muted mb-1">{{ input.description }}</p>{% endif %}
                            <div class="d-flex align-items-center gap-2">
                                <span class="fill-image-card__thumb"
                                      data-group-fill-target="imageThumb"
                                      data-input-id="{{ input.inputId }}"
                                      {% if seededImage %}style="background-image: url('{{ seededImage.url }}');"
                                      {% elseif slot.defaultImageUrl %}style="background-image: url('{{ slot.defaultImageUrl }}');"{% endif %}></span>
                                <button type="button" class="btn btn-sm btn-outline-secondary"
                                        data-action="variant-fill-overlay#openImageModal"
                                        data-variant-fill-overlay-inputid-param="{{ input.inputId }}">
                                    <i class="mdi mdi-image-search-outline"></i> {{ slot.canUpload ? 'Vybrat / nahrát obrázek' : 'Vybrat obrázek' }}
                                </button>
                            </div>
                            <input type="hidden" name="images[{{ input.inputId }}][imageId]" value="{{ seededImage ? seededImage.imageId : '' }}"
                                   data-group-fill-target="imageValue" data-input-id="{{ input.inputId }}">
                            {% if input.hidable %}
                                {# Hidden checkbox every eye of this slot toggles ("hide in
                                   every dimension"); its change re-renders the previews. #}
                                <input type="checkbox" class="visually-hidden" tabindex="-1" aria-hidden="true"
                                       value="1"
                                       name="images[{{ input.inputId }}][hide]"
                                       data-image-hide="{{ input.inputId }}"
                                       {{ hidden ? 'checked' }}
                                       data-action="change->group-fill#changed">
                            {% endif %}

                            {# The placement sliders open from the picture itself in each
                               dimension's preview (the toolbar) — not here, behind the
                               "Všechna pole" button. #}
                            {% if input.allowMove or input.allowResize or input.allowRotate %}
                                <p class="font-11 text-muted mt-2 mb-0">
                                    <i class="mdi mdi-information-outline"></i>
                                    Velikost, otočení a posun upravíte po kliknutí na obrázek v náhledu — v každém rozměru zvlášť.
                                </p>
                            {% endif %}
                        </div>
                    </div>
                  {% endif %}
                {% endfor %}

                {% if text_placeholders|length == 0 and image_inputs|length == 0 %}
                    <p class="text-muted small mb-0 fill-popovers__empty">
                        <i class="mdi mdi-information-outline"></i>
                        Šablony ve skupině nemají žádné vyplnitelné prvky — export stáhne všechny rozměry tak, jak jsou navržené.
                    </p>
                {% endif %}
            </div>

            {# Image pickers: one Bootstrap modal per unified slot (the overlay's
               openImageModal finds it by data-image-modal), plain thumbnails from
               the slot's allowed gallery folders + a "keep the designed picture"
               option, plus an upload field when the designer left the slot a
               folder to upload into. Picks land in the hidden imageId field; a
               fresh upload is appended as an option and auto-picked. #}
            {% for slot in image_inputs %}
                {% set input = slot.input %}
                <div class="modal fade" id="groupFillImageModal-{{ input.inputId }}" data-image-modal="{{ input.inputId }}" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h4 class="modal-title">{{ input.name ?: 'Vybrat obrázek' }}</h4>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Zavřít"></button>
                            </div>
                            <div class="modal-body"
                                 {% if slot.canUpload %}
                                 data-controller="fill-gallery"
                                 data-fill-gallery-upload-url-value="{{ path('template_group_placeholder_upload', {'groupId': group.id, 'inputId': input.inputId}) }}"
                                 data-fill-gallery-includes-root-value="{{ slot.includesRoot ? 'true' : 'false' }}"
                                 {% endif %}>
                                {% if slot.images|length == 0 and not slot.canUpload %}
                                    <p class="text-warning small mb-0">Tento obrázek zatím nelze vyplnit — šablona nemá nastavenou složku galerie. Kontaktujte správce šablony.</p>
                                {% else %}
                                    {% if slot.canUpload %}
                                        <nav class="d-flex align-items-center flex-wrap gap-1 mb-2 small">
                                            <button
                                                type="button"
                                                class="btn btn-sm btn-link p-0 text-decoration-none fw-bold text-body"
                                                data-fill-gallery-target="rootCrumb"
                                                data-action="fill-gallery#openRoot"
                                            ><i class="mdi mdi-folder-home"></i> Galerie</button>
                                            <span class="text-muted d-none" data-fill-gallery-target="crumbSep">/</span>
                                            <span class="fw-bold d-none" data-fill-gallery-target="crumbName"></span>
                                        </nav>

                                        {% if slot.directories is not empty %}
                                            <div class="d-flex flex-wrap gap-2 mb-2" data-fill-gallery-target="folders">
                                                {% for directory in slot.directories %}
                                                    <button
                                                        type="button"
                                                        class="btn border rounded p-2 d-flex align-items-center gap-1 text-start"
                                                        data-fill-gallery-target="folderCard"
                                                        data-action="fill-gallery#openFolder"
                                                        data-fill-gallery-id-param="{{ directory.id }}"
                                                        data-fill-gallery-name-param="{{ directory.name }}"
                                                        title="{{ directory.name }}"
                                                    >
                                                        <i class="mdi mdi-folder text-warning fs-4"></i>
                                                        <span class="text-truncate">{{ directory.name }}</span>
                                                    </button>
                                                {% endfor %}
                                            </div>
                                        {% endif %}
                                    {% endif %}

                                    <div class="row g-2"
                                         data-group-fill-target="imageOptions"
                                         {% if slot.canUpload %}data-fill-gallery-target="grid"{% endif %}
                                         data-input-id="{{ input.inputId }}">
                                        {# The keep-designed option belongs to no folder — visible in
                                           every view (data-always-visible). Same tile as the
                                           gallery pictures, captioned instead of a file name. #}
                                        <div class="col-6 col-sm-4 col-md-3" data-fill-gallery-target="thumb" data-always-visible="true">
                                            <div class="position-relative border rounded gallery-asset h-100">
                                                <button type="button" class="btn p-0 w-100 h-100 text-start gallery-asset__select group-fill-image-option selected"
                                                        data-action="group-fill#pickImage"
                                                        data-input-id="{{ input.inputId }}"
                                                        data-image-id=""
                                                        data-image-url="{{ slot.defaultImageUrl ?: '' }}"
                                                        data-bs-dismiss="modal"
                                                        title="Ponechat obrázek ze šablony">
                                                    <div class="p-1">
                                                        {% if slot.defaultImageUrl %}
                                                            <img crossorigin="anonymous" src="{{ slot.defaultImageUrl }}" alt="Výchozí obrázek" loading="lazy" class="img-fluid" style="aspect-ratio: 1; object-fit: cover; background: #f8f9fa;">
                                                        {% else %}
                                                            <div class="d-flex align-items-center justify-content-center text-muted rounded" style="aspect-ratio: 1; background: #f8f9fa;"><i class="mdi mdi-image-off-outline fs-2"></i></div>
                                                        {% endif %}
                                                    </div>
                                                    <div class="gallery-asset__caption">
                                                        <div class="gallery-asset__name"><span class="gallery-asset__name-base">Výchozí</span></div>
                                                        <div class="gallery-asset__meta"><span class="gallery-asset__size">Obrázek ze šablony</span></div>
                                                    </div>
                                                </button>
                                            </div>
                                        </div>
                                        {% for image in slot.images %}
                                            {{ include('_fill_gallery_tile.html.twig', {
                                                asset: image,
                                                class: 'group-fill-image-option',
                                                attrs: {
                                                    'data-action': 'group-fill#pickImage',
                                                    'data-input-id': input.inputId,
                                                    'data-image-id': image.id,
                                                    'data-image-url': image.url,
                                                    'data-bs-dismiss': 'modal',
                                                },
                                            }) }}
                                        {% endfor %}
                                    </div>

                                    {% if slot.canUpload %}
                                        <p class="text-muted small mt-2 mb-0 d-none" data-fill-gallery-target="emptyNote">Zatím tu nejsou žádné obrázky — nahrajte vlastní níže.</p>

                                        {# New-upload tile (this page's pick wiring), cloned by
                                           fill-gallery with the __KEY__ placeholders filled in. #}
                                        <template data-fill-gallery-target="thumbTemplate">
                                            {{ include('_fill_gallery_tile.html.twig', {
                                                class: 'group-fill-image-option',
                                                attrs: {
                                                    'data-action': 'group-fill#pickImage',
                                                    'data-input-id': input.inputId,
                                                    'data-image-id': '__ID__',
                                                    'data-image-url': '__URL__',
                                                    'data-bs-dismiss': 'modal',
                                                },
                                            }) }}
                                        </template>

                                        <hr class="my-3">

                                        <p class="text-muted small mb-0 d-none" data-fill-gallery-target="pickFolderHint">Pro nahrání vlastního obrázku otevřete složku.</p>
                                        {# The dropzone's file input is deliberately UNNAMED so it
                                           never lands in the export FormData — the upload POSTs
                                           separately and the form only carries the resulting imageId. #}
                                        <div data-fill-gallery-target="uploadWrap">
                                            <div
                                                class="gallery-dropzone"
                                                data-fill-gallery-target="dropzone"
                                                data-action="
                                                    click->fill-gallery#browse
                                                    keydown->fill-gallery#keydown
                                                    dragover->fill-gallery#dragOver
                                                    dragleave->fill-gallery#dragLeave
                                                    drop->fill-gallery#drop
                                                "
                                                role="button"
                                                tabindex="0"
                                            >
                                                <i class="mdi mdi-cloud-upload-outline gallery-dropzone__icon"></i>
                                                <div class="gallery-dropzone__title">Přetáhněte obrázky sem</div>
                                                <div class="text-muted small">nebo klikněte pro výběr z počítače</div>
                                                <div class="text-muted small mt-1">
                                                    Nahraje se do: <strong class="text-body"><i class="mdi mdi-folder-outline"></i> <span data-fill-gallery-target="uploadTargetLabel"></span></strong>
                                                    &middot; max. 10&nbsp;MB / soubor
                                                </div>
                                            </div>
                                            <input type="file" class="d-none" accept="image/*" multiple data-fill-gallery-target="fileInput" data-action="change->fill-gallery#filesChosen">
                                            <div class="mt-2 d-flex flex-column gap-2" data-fill-gallery-target="queue" aria-live="polite"></div>
                                        </div>
                                    {% endif %}
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </form>

        {# The dropdown's pin / rename controls above sit
           INSIDE the fill form and submit through these anchors — which must
           stay OUTSIDE it (a nested <form> would close the fill form and
           strand every field below the header; 2026-09-08). Turbo-enabled:
           a pin / rename re-renders the history chrome in place, the fill
           form's state survives. #}
        {{ include('_export_version_form_anchors.html.twig', {versions: export_history.menu(loaded_version), loaded_version: loaded_version, turbo: true}) }}
    {% endif %}
{% endblock %}
