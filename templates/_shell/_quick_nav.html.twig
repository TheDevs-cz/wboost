{#
    "Rychlá navigace" popover (spec §2.1 row 3): fixed, positioned next to the
    sidebar trigger by the `shell` controller. Search filters the rows; the
    controller moves the user's last 3 opened projects (localStorage
    'wb-recent') into "Naposledy otevřené" when the search is empty.
#}
<div class="qn-pop" id="qnPop" role="dialog" aria-label="Rychlá navigace" data-shell-target="qnPop" hidden>
    <label class="inp sm">
        {{ icon('search', 's14') }}
        <input type="search" placeholder="Hledat projekt" autocomplete="off" role="combobox" aria-expanded="true" aria-controls="qnList" aria-autocomplete="list"
               data-shell-target="qnSearch" data-action="input->shell#filterQuickNav keydown->shell#quickNavKey">
    </label>
    <div class="qn-list" id="qnList" role="listbox" aria-label="Projekty">
        <div class="qn-sec lbl" data-shell-target="qnRecentHead" hidden>Naposledy otevřené</div>
        <div data-shell-target="qnRecent"></div>
        <div class="qn-sec lbl" data-shell-target="qnAllHead">Všechny projekty</div>
        <div data-shell-target="qnAll">
            {% for row in shell_projects %}
                {% set is_current = project is defined and project.id.toString == row.id %}
                <a href="{{ path('project_dashboard', {'id': row.id}) }}" class="qn" role="option" id="qn-{{ row.id }}"
                   data-qn-id="{{ row.id }}" data-qn-name="{{ row.name|lower }}" aria-selected="{{ is_current ? 'true' : 'false' }}">
                    {% if row.iconPath %}
                        <span class="sym sm"><img src="{{ uploaded_asset(row.iconPath) }}" alt="" loading="lazy"></span>
                    {% else %}
                        <span class="sym sm mono">{{ row.initials }}</span>
                    {% endif %}
                    <span class="nm">{{ row.name }}</span>
                    {% if is_current %}<span class="chk" aria-label="Aktuální projekt">{{ icon('check') }}</span>{% endif %}
                </a>
            {% endfor %}
        </div>
        <div class="qn-empty" data-shell-target="qnEmpty" hidden>Žádný projekt neodpovídá hledání</div>
    </div>
</div>
