{# A multi-page document on the Šablony listing: ONE card for all its pages
   (the page templates themselves are hidden from the listing). The body
   leads designers to the document page (they arrange pages there) and
   everyone else to the fill page. Delete is two-mode, like a synchronized
   template.

   Vars: document; optional `is_top` + `uses` (the "Nejpoužívanější" row — no
   grip, no menu, no sort id). #}
{% set top = is_top ?? false %}
{% set can_edit_document = is_granted('template_document_edit', document) %}
{% set pages = document.pages %}
{% set count = pages|length %}
{% set card_url = (can_edit_document or pages is empty) ? path('template_document', {'documentId': document.id}) : path('template_document_fill', {'documentId': document.id}) %}
{% set first_page = pages|first %}
{% set thumb = first_page ? (first_page.variant.previewImagePath ?: first_page.variant.backgroundImage) : null %}

<li class="tp-card tp-card-doc"{% if not top %} data-entity-id="{{ document.id }}"{% endif %} data-name="{{ document.name|lower }}">
    <div class="tp-h">
        {% if not top and can_edit_document %}
            <span class="dragula-handle man-grip" title="Přetažením změníte pořadí">{{ icon('grip', 's16') }}</span>
        {% endif %}
        <h3 title="{{ document.name }}">{{ document.name }}</h3>

        {% if not top and can_edit_document %}
            <div class="dropdown tp-mb">
                <button type="button" class="btn btn-ghost icon xs" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Možnosti dokumentu {{ document.name }}">{{ icon('more', 's16') }}</button>
                <div class="dropdown-menu dropdown-menu-end">
                    <a href="{{ path('template_document', {'documentId': document.id}) }}" class="dropdown-item">{{ icon('book', 's16') }}Upravit stránky</a>
                    {% if pages is not empty %}
                        <a href="{{ path('template_document_fill', {'documentId': document.id}) }}" class="dropdown-item">{{ icon('download', 's16') }}Vyplnit a exportovat</a>
                    {% endif %}
                    <a href="{{ path('edit_template_document', {'documentId': document.id}) }}" class="dropdown-item">{{ icon('type', 's16') }}Upravit název</a>
                    <div class="dropdown-divider"></div>
                    <a href="#" class="dropdown-item text-danger" data-bs-toggle="modal" data-bs-target="#deleteDocumentModal-{{ document.id }}">{{ icon('trash', 's16') }}Smazat…</a>
                </div>
            </div>
        {% endif %}
    </div>

    <a href="{{ card_url }}" class="tp-prev tp-prev-doc{{ thumb ? '' : ' is-empty' }}{{ count > 1 ? ' is-stack' : '' }}" aria-label="{{ can_edit_document ? 'Upravit' : 'Vyplnit' }} dokument {{ document.name }}">
        {% if thumb %}
            <img src="{{ uploaded_asset(thumb) }}" alt="" loading="lazy" onerror="this.parentNode.classList.add('is-empty')">
        {% endif %}
        <span class="tp-ph" aria-hidden="true">{{ icon('book') }}</span>
    </a>

    <span class="cap tp-exp">
        {% if top %}
            {{ icon('history', 's14') }}{{ uses }}× exportováno za 30 dní
        {% else %}
            {{ icon('file', 's14') }}{{ count }} {{ count == 1 ? 'strana' : (count >= 2 and count <= 4 ? 'strany' : 'stran') }}
        {% endif %}
    </span>

    <div class="tp-vars" aria-label="Vícestránkový dokument, formát {{ document.dimension.label }}">
        <span class="tp-var tp-var-doc">{{ icon('book', 's12') }}Dokument</span>
        <span class="tp-var">{{ document.dimension.label }}</span>
    </div>

    {% if not top and can_edit_document %}
        <div class="modal fade" id="deleteDocumentModal-{{ document.id }}" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <form class="modal-content" method="post" action="{{ path('delete_template_document', {'documentId': document.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('template_document') }}">
                    <div class="modal-header">
                        <h4 class="modal-title">Smazat dokument „{{ document.name }}“?</h4>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Zavřít"></button>
                    </div>
                    <div class="modal-body tp-delmodes">
                        <p><b>Zrušit pouze dokument</b> — všechny stránky zůstanou zachovány a vrátí se mezi šablony jako samostatné šablony.</p>
                        <p class="tp-danger"><b>Smazat včetně stránek</b> — nevratně smaže dokument i všechny šablony jeho stránek.</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-tertiary sm" data-bs-dismiss="modal">Zpět</button>
                        <button type="submit" name="deletePages" value="0" class="btn btn-tertiary sm">Zrušit pouze dokument</button>
                        <button type="submit" name="deletePages" value="1" class="btn btn-danger sm">Smazat včetně stránek</button>
                    </div>
                </form>
            </div>
        </div>
    {% endif %}
</li>
