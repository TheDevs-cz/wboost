{% extends 'base.html.twig' %}

{% block title %}Upravit projekt{% endblock %}
{% set active_menu_item = 'projects' %}

{% block breadcrumb %}
    <ol class="breadcrumb m-0 pt-0">
        <li class="breadcrumb-item"><a href="{{ path('project_dashboard', {'id': project.id}) }}">{{ project.name }}</a></li>
        <li class="breadcrumb-item active">{{ block('title') }}</li>
    </ol>
{% endblock %}

{% block content %}

    <div class="pf-stack">
        {{ include('_project_form.html.twig', {
            'form': form,
            'submit_label': 'Uložit změny',
            'cancel_url': path('project_dashboard', {'id': project.id}),
            'current_icon': project.icon,
            'project_name': project.name,
        }) }}

        {# Admin-only module switches. Its own forms live OUTSIDE the project form
           above (never nest <form>s). Customers switch modules on themselves via
           "Objevte další moduly"; only an admin switches one off. The project
           overview carries the same switches (`back=dashboard`). #}
        {% if is_granted('ROLE_ADMIN') %}
            <section class="pd-box" id="project-modules" aria-labelledby="pmH">
                <div class="pd-box-h">
                    <div>
                        <h2 id="pmH">Moduly projektu <span class="pill pd-admin">{{ icon('shield', 's12') }}Jen administrátor</span></h2>
                        <span class="cap">Vypnuté moduly uživatelé nevidí v menu — najdou je v sekci „Objevte další moduly“, kde si je mohou sami zapnout. O každém takovém zapnutí přijde administrátorům e-mail. Vypnutím se žádná data nesmažou.</span>
                    </div>
                </div>

                <div class="pd-mods">
                    {% for module in enum('WBoost\\Web\\Value\\ProjectModule').cases() %}
                        {% set enabled = project.hasModule(module) %}
                        <div class="pd-mod{{ enabled ? ' on' : '' }}" data-module="{{ module.value }}">
                            <span class="pd-ico" aria-hidden="true">{{ icon(module.icon) }}</span>
                            <span class="who"><b>{{ module.label }}</b><span class="cap">{{ module.description }}</span></span>
                            <span class="pd-st">{{ enabled ? 'Zapnuto' : 'Vypnuto' }}</span>
                            {% if enabled %}
                                <form method="post" action="{{ path('project_module_disable', {'projectId': project.id, 'module': module.value}) }}" class="pd-mod-f">
                                    <input type="hidden" name="_token" value="{{ csrf_token('project_module_disable') }}">
                                    <button type="submit" class="sw c-success on" role="switch" aria-checked="true" aria-label="Vypnout modul {{ module.label }}" title="Vypnout"></button>
                                </form>
                            {% else %}
                                <form method="post" action="{{ path('project_module_enable', {'projectId': project.id, 'module': module.value}) }}" class="pd-mod-f">
                                    <input type="hidden" name="_token" value="{{ csrf_token('project_module_enable') }}">
                                    <input type="hidden" name="back" value="edit">
                                    <button type="submit" class="sw c-success" role="switch" aria-checked="false" aria-label="Zapnout modul {{ module.label }}" title="Zapnout"></button>
                                </form>
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>
                <p class="cap pd-foot">{{ icon('info', 's14') }}Galerie a Fonty jsou vždy zapnuté — čerpají z nich ostatní moduly.</p>

                {% if module_changes is not empty %}
                    <div class="pm-hist">
                        <span class="lbl">Historie změn</span>
                        <ul class="pu-list">
                            {% for change in module_changes %}
                                <li class="pu-row">
                                    <span>
                                        {{ change.changedBy ? change.changedBy.displayName : 'Neznámý uživatel' }}
                                        {{ change.enabled ? 'zapnul(a)' : 'vypnul(a)' }} modul {{ change.module.label }}
                                    </span>
                                    <span class="cap">{{ change.changedAt|date('j. n. Y H:i') }}</span>
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                {% endif %}
            </section>

            {# AI sken — a paid extra switched on per project by an admin
               (docs/architecture/ai-scan.md § "Permissions"). Two forms, never
               nested: the switch and the monthly limit. Switching it off
               deletes nothing — waiting scans are cancelled and not counted,
               running ones finish, proposals stay usable. #}
            <section class="pd-box" id="project-ai-scan" aria-labelledby="paiH">
                <div class="pd-box-h">
                    <div>
                        <h2 id="paiH">Funkce Premium <span class="pill pd-admin">{{ icon('shield', 's12') }}Jen administrátor</span></h2>
                        <span class="cap">Placené funkce zapínáme pro každý projekt zvlášť. Smí je pak použít každý, kdo může projekt upravovat.</span>
                    </div>
                </div>

                <div class="pd-mods">
                    <div class="pd-mod{{ project.aiScanEnabled ? ' on' : '' }}" data-feature="ai-scan">
                        <span class="pd-ico" aria-hidden="true">{{ icon('sparkle') }}</span>
                        <span class="who"><b>AI sken</b><span class="cap">Šablona z obrázku a naskenování designu kalendáře. Obrázky zpracovává Anthropic.</span></span>
                        <span class="pd-st">{{ project.aiScanEnabled ? 'Zapnuto' : 'Vypnuto' }}</span>
                        <form method="post" action="{{ path('project_ai_scan_set', {'projectId': project.id}) }}" class="pd-mod-f">
                            <input type="hidden" name="_token" value="{{ csrf_token('project_ai_scan') }}">
                            <input type="hidden" name="enabled" value="{{ project.aiScanEnabled ? '0' : '1' }}">
                            <button type="submit" class="sw c-success{{ project.aiScanEnabled ? ' on' : '' }}" role="switch" aria-checked="{{ project.aiScanEnabled ? 'true' : 'false' }}" aria-label="{{ project.aiScanEnabled ? 'Vypnout AI sken' : 'Zapnout AI sken' }}" title="{{ project.aiScanEnabled ? 'Vypnout' : 'Zapnout' }}"></button>
                        </form>
                    </div>
                </div>

                <form method="post" action="{{ path('project_ai_scan_set', {'projectId': project.id}) }}" class="pai-limit">
                    <input type="hidden" name="_token" value="{{ csrf_token('project_ai_scan') }}">
                    <label for="paiLimit" class="lbl">Měsíční limit skenů</label>
                    <input type="number" id="paiLimit" name="monthly_limit" class="form-control" min="0" max="100000" step="1" inputmode="numeric" placeholder="bez limitu" value="{{ project.aiScanMonthlyLimit }}">
                    <button type="submit" class="btn btn-light">Uložit limit</button>
                    <span class="cap">Tento měsíc {{ ai_scan_usage.month }}{% if project.aiScanMonthlyLimit is not null %} z {{ project.aiScanMonthlyLimit }}{% endif %} · Celkem {{ ai_scan_usage.total }}</span>
                </form>
                <p class="cap pd-foot">{{ icon('info', 's14') }}Vypnutím se nic nesmaže. Čekající skeny zrušíme a nezapočítáme, běžící doběhnou a hotové návrhy půjde dokončit. Prázdný limit znamená bez limitu.</p>
            </section>
        {% endif %}
    </div>
{% endblock %}
