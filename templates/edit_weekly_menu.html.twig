{% extends 'base.html.twig' %}

{% set active_menu_item = 'weekly_menus' %}

{% block title %}{{ menu.name }}{% endblock %}
{% block eyebrow %}Projekt · {{ project.name }} · Jídelníček{% endblock %}

{% block title_actions %}
    <a href="{{ path('download_weekly_menu_pdf', {'menuId': menu.id}) }}" class="btn btn-tertiary">{{ icon('download', 's16') }}Stáhnout PDF</a>
    <a href="{{ path('weekly_menu_planner', {'menuId': menu.id}) }}" class="btn btn-primary">{{ icon('edit', 's16') }}Sestavit menu</a>
{% endblock %}

{% block breadcrumb %}
    <ol class="breadcrumb m-0 pt-0">
        <li class="breadcrumb-item"><a href="{{ path('project_dashboard', {'id': project.id}) }}">{{ project.name }}</a></li>
        <li class="breadcrumb-item"><a href="{{ path('weekly_menus', {'projectId': project.id}) }}">Jídelníčky</a></li>
        <li class="breadcrumb-item active">{{ menu.name }}</li>
    </ol>
{% endblock %}

{% block content %}
    <div class="wm-edit">
        {{ form_start(form, {'attr': {'class': 'pd-box wm-box'}}) }}
            <div class="pd-box-h">
                <div>
                    <h2>Údaje jídelníčku</h2>
                    <p class="cap mb-0">Název, platnost a kdo jídelníček sestavil a schvaluje.</p>
                </div>
            </div>
            {{ include('weekly_menu/_menu_form_fields.html.twig') }}
            <div class="wm-box-f">
                <a href="{{ path('weekly_menus', {'projectId': project.id}) }}" class="btn btn-tertiary sm">Zrušit</a>
                <input type="submit" name="submit" value="Uložit" class="btn btn-primary sm">
            </div>
        {{ form_end(form) }}

        {% if menu.approvalEmail is not null %}
            <section class="pd-box wm-box" aria-labelledby="wm-approval-h">
                <div class="pd-box-h">
                    <div>
                        <h2 id="wm-approval-h">Schvalovací proces</h2>
                        <p class="cap mb-0">Žádost o schválení přijde na {{ menu.approvalEmail }}.</p>
                    </div>
                    <div class="wm-approval-acts">
                        {{ include('weekly_menu/_status_pill.html.twig', {status: menu.approvalStatus}) }}
                        {% if menu.approvalStatus.value in ['not_requested', 'denied'] %}
                            <form action="{{ path('request_weekly_menu_approval', {'menuId': menu.id}) }}" method="post">
                                <button type="submit" class="btn btn-tertiary sm" onclick="return confirm('Odeslat žádost o schválení na {{ menu.approvalEmail|e('js') }}?');">{{ icon('mail', 's16') }}Požádat o schválení</button>
                            </form>
                        {% endif %}
                    </div>
                </div>

                {% if menu.approvalComment is not empty %}
                    <div class="alert alert-{{ menu.approvalStatus.value == 'approved' ? 'success' : 'danger' }}">
                        <strong>Komentář schvalovatele:</strong> {{ menu.approvalComment }}
                    </div>
                {% endif %}

                {% if auditLogs|length > 0 %}
                    <ul class="wm-log">
                        {% for log in auditLogs %}
                            <li>
                                <span class="wm-log-dot" aria-hidden="true"></span>
                                <span class="wm-log-ev">{{ log.event }}</span>
                                <span class="cap">{{ log.performedBy ?? '–' }}</span>
                                <time class="cap" datetime="{{ log.createdAt|date('c') }}">{{ log.createdAt|date('j. n. Y H:i') }}</time>
                            </li>
                        {% endfor %}
                    </ul>
                {% else %}
                    <p class="cap mb-0">Zatím žádná historie schvalování.</p>
                {% endif %}
            </section>
        {% endif %}
    </div>
{% endblock %}
