{% extends 'base.html.twig' %}

{% block title %}Upravit šablonu e-mailu{% endblock %}
{% set active_menu_item = 'emails' %}

{% block page_title_row %}
    <a href="{{ path('email_signature_templates', {'id': project.id}) }}" class="back">{{ icon('arrow-left', 's16') }}E-maily</a>
{% endblock %}

{% block content %}
    {{ form_start(form, {'attr': {'class': 'adm-sheet es-sheet'}}) }}
        <div class="adm-sheet-h"><h1 class="page-title adm-sheet-title">Upravit šablonu e-mailu</h1></div>
        <div class="adm-sheet-b">
            {{ form_row(form.name) }}
            {{ form_row(form.backgroundImage) }}

            {% if email_template.backgroundImage %}
                <div class="es-bg-current">
                    <span class="cap">Současné pozadí</span>
                    <div class="es-bg-well"><img src="{{ uploaded_asset(email_template.backgroundImage) }}" alt="" onerror="this.parentElement.classList.add('is-broken'); this.remove();"></div>
                </div>
            {% endif %}
        </div>
        <div class="adm-sheet-f">
            <a href="{{ path('email_signature_templates', {'id': project.id}) }}" class="btn btn-tertiary sm">Zrušit</a>
            <button class="btn btn-primary sm" type="submit">Uložit</button>
        </div>
    {{ form_end(form) }}
{% endblock %}
