{% extends 'base_auth.html.twig' %}

{% block title %}Smazání dat{% endblock %}

{% block auth_body %}
    <div class="auth-top">
        <span class="ico-c">{{ icon('check-circle') }}</span>
        <h1>Žádost o smazání dat</h1>
        <p>
            Propojení vašeho facebookového účtu s aplikací WBoost bylo smazáno,
            včetně uloženého přístupového tokenu.
        </p>
    </div>
    {% if confirmationCode %}
        <div class="auth-code">
            <span>Potvrzovací kód</span>
            <code>{{ confirmationCode }}</code>
        </div>
    {% endif %}
{% endblock %}
