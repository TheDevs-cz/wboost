{% set is_own = project.owner.id.equals(app.user.id) %}
<div class="col-md-6 col-xxl-3">
    <div class="card {{ is_own ? '' : 'border border-secondary-subtle' }}">
        {% if is_granted('project_edit', project) %}
            <div class="card-img-overlay dropdown card-widgets" style="left: auto;bottom: auto;">
                <a href="#" class="dropdown-toggle arrow-none" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="ri-more-fill text-lighter"></i>
                </a>
                <div class="dropdown-menu dropdown-menu-end">
                    <a href="{{ path('edit_project', {'id': project.id}) }}" class="dropdown-item"><i class="mdi mdi-pencil me-1"></i>Upravit</a>
                    <a href="#"
                       class="dropdown-item"
                       data-modal-id="{{ project.id }}"
                       data-action="click->confirm-modal#showModal">
                        <i class="mdi mdi-delete me-1"></i> Smazat
                    </a>
                </div>
            </div>

            <twig:ConfirmModal
                id="{{ project.id }}"
                url="{{ path('delete_project', {'id': project.id}) }}"
                confirmationText="Opravdu chcete smazat tento projekt včetně všech náležitostí?" />
        {% endif %}

        <a href="{{ path('project_dashboard', {'id': project.id}) }}" class="text-body">
            <div class="card-body">
                {% set avatar = avatars[project.id.toString] ?? null %}
                <div class="d-flex align-items-center">
                    {% if avatar %}
                        {% if avatar.logoPath %}
                            <div class="flex-shrink-0 me-2 bg-light rounded d-flex align-items-center justify-content-center" style="width: 56px; height: 56px;">
                                <img src="{{ uploaded_asset(avatar.logoPath) }}" alt="{{ project.name }}" style="max-width: 46px; max-height: 46px; object-fit: contain;">
                            </div>
                        {% else %}
                            <div class="flex-shrink-0 me-2 rounded-circle d-flex align-items-center justify-content-center fw-semibold {{ is_own ? '' : 'opacity-75' }}" style="width: 56px; height: 56px; font-size: 1.15rem; letter-spacing: .5px; background: #{{ avatar.backgroundHex }}; color: #{{ avatar.textHex }};">
                                {{ avatar.initials }}
                            </div>
                        {% endif %}
                    {% endif %}
                    <div class="min-width-0">
                        <h4 class="m-0 {{ is_own ? '' : 'text-muted' }}">
                            {{ project.name }}
                        </h4>
                        {% if not is_own %}
                            <span class="badge bg-secondary mt-1">vlastník: {{ project.owner.getDisplayName() }}</span>
                        {% endif %}
                    </div>
                </div>
            </div>
        </a>

        {% if is_granted('ROLE_ADMIN') %}
            <div class="card-footer bg-transparent border-top-0 pt-0">
                <twig:ManageProjectSharing :project="project" />
            </div>
        {% endif %}
    </div>
</div>
