{
  "name": "wboost-scanner",
  "version": "0.2.0",
  "private": true,
  "description": "WBoost AI scan — the scanner service (engine, instruments, caps, finish).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "scanner": "bin/scanner.mjs"
  },
  "scripts": {
    "start": "node bin/scanner.mjs serve",
    "test": "node --test test/*.test.mjs",
    "test:slow": "node --test test/slow/*.slow.mjs",
    "scan": "node bin/scanner.mjs scan-file"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.322",
    "@anthropic-ai/sdk": "1.8.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  }
}
