<?xml version="1.0" encoding="UTF-8"?>
<!-- https://phpunit.readthedocs.io/en/latest/configuration.html -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.0/phpunit.xsd" colors="true"
         bootstrap="tests/bootstrap.php" cacheDirectory=".phpunit.cache">
    <php>
        <ini name="display_errors" value="1"/>
        <ini name="error_reporting" value="-1"/>
        <server name="APP_ENV" value="test" force="true"/>
    </php>

    <testsuites>
        <!--
            Three disjoint suites that together are the whole of tests/ — a
            plain `vendor/bin/phpunit` runs all of them. CI runs one per
            parallel job (`(dash dash)testsuite <name>`, .github/workflows/test.yml);
            the cut is balanced by measured run time, so keep a new slow
            directory in mind when one shard starts to dominate. Every path
            excluded from `rest` must be listed in another suite.
        -->
        <testsuite name="ai-scan">
            <directory>tests/Controller/AiScan</directory>
            <directory>tests/Controller/Internal</directory>
        </testsuite>
        <testsuite name="mcp-api">
            <directory>tests/Mcp</directory>
            <directory>tests/Api</directory>
        </testsuite>
        <testsuite name="rest">
            <directory>tests</directory>
            <exclude>tests/Controller/AiScan</exclude>
            <exclude>tests/Controller/Internal</exclude>
            <exclude>tests/Mcp</exclude>
            <exclude>tests/Api</exclude>
        </testsuite>
    </testsuites>

    <!--
        Tests that really talk to Gotenberg. Every other suite runs against
        tests/Fakes/FakeTemplateVariantImageRenderer, so the default run needs
        no headless Chromium at all; these are the handful that exercise the
        real render pipeline and are therefore opt-in, via:
        vendor/bin/phpunit  (dash dash)group gotenberg
    -->
    <groups>
        <exclude>
            <group>gotenberg</group>
            <!--
                AI scan fault injection (tests/FaultInjection): real races
                between forked processes against the real database, outside
                DAMA's transaction. Opt-in, in a run of its own:
                vendor/bin/phpunit (dash dash)group fault-injection
            -->
            <group>fault-injection</group>
        </exclude>
    </groups>

    <extensions>
        <bootstrap class="DAMA\DoctrineTestBundle\PHPUnit\PHPUnitExtension"/>
    </extensions>
</phpunit>
